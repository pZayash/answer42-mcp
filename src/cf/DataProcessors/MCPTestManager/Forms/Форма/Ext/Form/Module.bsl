	Для Каждого ТекущееОкно Из ВсеОкна Цикл
		СтрокаОкна = ОбъектВСтруктуру(ТекущееОкно, 0);
		СтрокаОкна.Вставить("index", Индекс);
		ЗаголовокОкна = БезопасноеСвойство(ТекущееОкно, "Заголовок", "");
		СсылкаОкна = БезопасноеСвойство(ТекущееОкно, "НавигационнаяСсылка", "");
