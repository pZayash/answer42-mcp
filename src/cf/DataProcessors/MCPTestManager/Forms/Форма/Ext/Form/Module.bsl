	Попытка
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		РезультатЯчейки.Вставить("current_row", СоответствиеВСтруктуру(ТекущаяСтрока));
	Исключение
		РезультатЯчейки.Вставить("current_row_error", ОписаниеОшибки());
	КонецПопытки;
	Возврат Новый Структура("found,cell", Истина, РезультатЯчейки);
