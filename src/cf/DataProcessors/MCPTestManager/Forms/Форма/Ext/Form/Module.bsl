Функция РазделыКомандногоИнтерфейса(Интерфейс)
	Результат = Новый Массив;
	Для Каждого Группа Из КомандныйИнтерфейсПодчиненныеРекурсивно(Интерфейс, "тестируемаягруппакомандногоинтерфейса") Цикл
		Если СтрНайти(НРег(БезопасныйЗаголовок(Группа)), "панель разделов") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Раздел Из БезопасныеПодчиненные(Группа) Цикл
			Если НормализованноеИмяТипа(Строка(ТипЗнч(Раздел))) <> "тестируемаякнопкакомандногоинтерфейса" Тогда
				Продолжить;
			КонецЕсли;
			ДанныеРаздела = КомандныйИнтерфейсОбъектВСтруктуру(Раздел, 0);
			ДанныеРаздела.Вставить("panel", БезопасныйЗаголовок(Группа));
			Результат.Добавить(ДанныеРаздела);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

