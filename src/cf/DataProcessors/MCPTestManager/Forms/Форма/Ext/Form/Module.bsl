&НаКлиенте
Функция ОжидатьОкноMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Таймаут = СвойствоСтруктуры(Параметры, "timeout", 15);

	ПараметрыПоиска = Новый Структура;
	Если Имя <> "" Тогда ПараметрыПоиска.Вставить("Имя", Имя); КонецЕсли;
	Если Заголовок <> "" Тогда ПараметрыПоиска.Вставить("Заголовок", Заголовок); КонецЕсли;
	ПараметрыПоиска.Вставить("Тип", "ТестируемоеОкноКлиентскогоПриложения");

	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецОжидания = Начало + Таймаут * 1000;
	НайденноеОкно = Неопределено;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() <= КонецОжидания Цикл
		Для Каждого ТекущееОкно Из ОкнаТестируемогоПриложения() Цикл
			ИмяОкна = БезопасноеСвойство(ТекущееОкно, "Имя", "");
			ЗаголовокОкна = БезопасноеСвойство(ТекущееОкно, "Заголовок", "");
			Если ОбъектСоответствует(ИмяОкна, ЗаголовокОкна, "тестируемоеокноклиентскогоприложения", Имя, Заголовок, "ТестируемоеОкноКлиентскогоПриложения") Тогда
				НайденноеОкно = ТекущееОкно;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НайденноеОкно <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Прошло = (Конец - Начало) / 1000;

	Если НайденноеОкно = Неопределено Тогда
		Возврат Новый Структура("found,elapsed_seconds,reason", Ложь, Прошло, "window_not_found");
	Иначе
		Возврат Новый Структура("found,elapsed_seconds,window", Истина, Прошло, ОбъектВСтруктуру(НайденноеОкно, 0));
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция СообщениеПользователюВСтруктуруMCP(СообщениеПользователю)
	Результат = Новый Структура;
	Результат.Вставить("text", БезопасноеСвойство(СообщениеПользователю, "Текст", ""));
	Результат.Вставить("field", БезопасноеСвойство(СообщениеПользователю, "Поле", ""));
	Результат.Вставить("data_path", БезопасноеСвойство(СообщениеПользователю, "ПутьКДанным", ""));
	Результат.Вставить("destination_id", Строка(БезопасноеСвойство(СообщениеПользователю, "ИдентификаторНазначения", "")));
	КлючДанных = БезопасноеСвойство(СообщениеПользователю, "КлючДанных", Неопределено);
	Если КлючДанных <> Неопределено Тогда
		Результат.Вставить("data_key", Строка(КлючДанных));
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция СообщенияПользователяMCP()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	Сообщения = Новый Массив;
	Тексты = Новый Массив;
	АктивноеОкно = Неопределено;
	Попытка
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		ТекстыСообщенийПользователю = АктивноеОкно.ПолучитьТекстыСообщенийПользователю();
		Для Каждого ТекстСообщенияПользователю Из ТекстыСообщенийПользователю Цикл
			Текст = Строка(ТекстСообщенияПользователю);
			Сообщения.Добавить(Новый Структура("text", Текст));
			Если Не ПустаяСтрока(Текст) Тогда
				Тексты.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ИнфоСообщений = ИнформацияОбОшибке();
		ТекстОшибкиСообщений = ПодробноеПредставлениеОшибки(ИнфоСообщений);
		Если СтрНайти(ТекстОшибкиСообщений, "Метод не может быть вызван для данного объекта") > 0 Тогда
			// По справке ТестируемоеОкноКлиентскогоПриложения.ПолучитьТекстыСообщенийПользователю()
			// генерирует эту ошибку, если окно сообщений закрыто. Это нормальное состояние: сообщений нет.
			Возврат Новый Структура("available,reason,error", Ложь, "user_messages_panel_closed", "");
		КонецЕсли;
		Возврат Новый Структура("available,reason,error", Ложь, "user_messages_api_failed", ТекстОшибкиСообщений);
	КонецПопытки;

	ОчисткаВыполнена = Ложь;
	ОшибкаОчистки = "";
	Если Сообщения.Количество() > 0 Тогда
		Попытка
			АктивноеОкно.ЗакрытьПанельСообщенийПользователю();
			ОчисткаВыполнена = Истина;
		Исключение
			ИнфоОчистки = ИнформацияОбОшибке();
			ОшибкаОчистки = ПодробноеПредставлениеОшибки(ИнфоОчистки);
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("available,messages,message_texts,cleared,clear_error", Истина, Сообщения, Тексты, ОчисткаВыполнена, ОшибкаОчистки);
КонецФункции

&НаКлиенте
Функция ЗакрытьПанельСообщенийMCP()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	Попытка
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		АктивноеОкно.ЗакрытьПанельСообщенийПользователю();
		Возврат Новый Структура("closed,cleared", Истина, Истина);
	Исключение
		ИнфоОчистки = ИнформацияОбОшибке();
		Возврат Новый Структура("closed,cleared,reason,error", Ложь, Ложь, "clear_messages_failed", ПодробноеПредставлениеОшибки(ИнфоОчистки));
	КонецПопытки;
КонецФункции

