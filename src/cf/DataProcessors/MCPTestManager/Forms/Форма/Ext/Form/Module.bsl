		Возврат Новый Структура("available,element", Истина, ОбъектВСтруктуру(Элемент, 0));
	Исключение
		Возврат Новый Структура("available,reason,window", Ложь, "not_supported", ОбъектВСтруктуру(АктивноеОкно, 0));
