		СписокКнопок.Добавить(Новый Структура("name,title", Кнопка, ""));
		СписокКнопок.Добавить(Новый Структура("name,title", "", Кнопка));
	КонецЕсли;
	СписокКнопок.Добавить(Новый Структура("name,title", "СписокВывестиСписок", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "ФормаВывестиСписок", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Вывести список..."));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Вывести список"));
	РезультатКнопки = НажатьПервуюКнопкуОкна(СписокКнопок);

	// After pressing "Вывести список", a dialog opens. Confirm it.
	КнопкиПодтверждения = Новый Массив;
	КнопкиПодтверждения.Добавить(Новый Структура("name,title", "", "Сформировать"));
	КнопкиПодтверждения.Добавить(Новый Структура("name,title", "", "ОК"));
	КнопкиПодтверждения.Добавить(Новый Структура("name,title", "", "Ok"));
	Попытка
		НажатьПервуюКнопкуОкна(КнопкиПодтверждения);
	Исключение
		// Dialog may not appear or may auto-close; proceed anyway.
	КонецПопытки;

	Пауза = ТекущаяДата() + СвойствоСтруктуры(Параметры, "wait_seconds", 2);
	Пока ТекущаяДата() < Пауза Цикл КонецЦикла;
	Документы = ТабличныеДокументы(Новый Структура("include_text", Истина));
	Возврат Новый Структура("executed,button,tabular_documents", Истина, РезультатКнопки.button, Документы);
КонецФункции

