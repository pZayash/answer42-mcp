&НаКлиенте
Функция ТекстТабличногоДокумента(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	Глубина = СвойствоСтруктуры(Параметры, "max_depth", 8);
	Поле = НайтиТабличныйДокументПоПараметрам(АктивноеОкно, Имя, Заголовок, 0, Глубина);
	Если Поле = Неопределено Тогда
		Возврат Новый Структура("found", Ложь);
	КонецЕсли;
	Попытка
		Поле.УстановитьТекущуюОбласть(1, 1, 1, 1);
		КоличествоСтрок = БезопасноеСвойство(Поле, "КоличествоСтрок", 0);
		КоличествоКолонок = БезопасноеСвойство(Поле, "КоличествоКолонок", 0);
		Если КоличествоСтрок = 0 Или КоличествоКолонок = 0 Тогда
			Возврат Новый Структура("found", Истина, "rows", 0, "columns", 0, "cells", Новый Массив);
		КонецЕсли;
		МаксСтрок = Мин(КоличествоСтрок, 50);
		МаксКолонок = Мин(КоличествоКолонок, 20);
		Ячейки = Новый Массив;
		Для НомерСтроки = 1 По МаксСтрок Цикл
			Строка = Новый Массив;
			Для НомерКолонки = 1 По МаксКолонок Цикл
				Попытка
					Область = Поле.Область(НомерСтроки, НомерКолонки);
					Текст = БезопасноеСвойство(Область, "Текст", "");
					Строка.Добавить(?(ТипЗнч(Текст) = Тип("Строка"), Текст, Строка(Текст)));
				Исключение
					Строка.Добавить("");
				КонецПопытки;
			КонецЦикла;
			Ячейки.Добавить(Строка);
		КонецЦикла;
		Возврат Новый Структура("found", Истина, "rows", КоличествоСтрок, "columns", КоличествоКолонок, "cells", Ячейки);
	Исключение
		Возврат Новый Структура("found", Истина, "error", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция НайтиТабличныйДокументПоПараметрам(РодительскийОбъект, Имя, Заголовок, ТекущаяГлубина, МаксимальнаяГлубина)
	Если ТекущаяГлубина > МаксимальнаяГлубина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если ТипТек = "тестируемоеполетабличногодокументаформы" Тогда
				ИмяТек = БезопасноеСвойство(Подчиненный, "Имя", "");
				ЗаголовокТек = БезопасноеСвойство(Подчиненный, "Заголовок", "");
				Если (ПустаяСтрока(Имя) Или ИмяТек = Имя) И (ПустаяСтрока(Заголовок) Или ЗаголовокТек = Заголовок) Тогда
					Возврат Подчиненный;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Результат = НайтиТабличныйДокументПоПараметрам(Подчиненный, Имя, Заголовок, ТекущаяГлубина + 1, МаксимальнаяГлубина);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

