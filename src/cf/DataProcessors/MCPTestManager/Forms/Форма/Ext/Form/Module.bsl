#Область Логирование
// BSLLS:DeprecatedCurrentDate-off

&НаКлиенте
Процедура Лог(Сообщение)
	Если ФайлЛога = Неопределено Тогда
		Если ПустаяСтрока(ИмяФайлаЛога) Тогда
			ИмяФайлаЛога = КаталогВременныхФайлов() + "mcp_manager_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "") + ".log";
		КонецЕсли;
		ФайлЛога = Новый Файл(ИмяФайлаЛога);
	КонецЕсли;
	Запись = Новый ЗаписьТекста(ФайлЛога.ПолноеИмя,,, Истина);
	Запись.ЗаписатьСтроку(Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + " | " + Сообщение);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КлючСоединенияWebSocket = "MCPTestManagerBridge";
	АдресWebSocket = АдресWebSocketИзПараметраЗапуска();
	WebSocketПодключен = Ложь;

	Лог("ПриОткрытии: ПараметрЗапуска=" + Строка(ПараметрЗапуска));
	Лог("ПриОткрытии: АдресWebSocket=" + АдресWebSocket);

	Попытка
		WS_Обработчики = Новый ОбработчикиWebSocketКлиентСоединения;
		WS_Обработчики.Модуль = ЭтаФорма;
		WS_Обработчики.ОбработчикОткрытияСоединения = "ПриОткрытииСоединения";
		WS_Обработчики.ОбработчикПолученияСообщения = "ПриПолученииСообщения";
		WS_Обработчики.ОбработчикОшибки = "ПриОшибкеСоединения";
		WS_Обработчики.ОбработчикЗакрытияСоединения = "ПриЗакрытииСоединения";

		Лог("ПриОткрытии: обработчики WS созданы, отложенный запуск через 1с");
		ПодключитьОбработчикОжидания("ОткрытьWebSocket", 1, Ложь);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ПриОткрытии: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
		Сообщить("MCP: ошибка при подготовке WebSocket: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция АдресWebSocketИзПараметраЗапуска()
	АдресПоУмолчанию = "ws://localhost:8765/bridge";
	Параметр = СокрЛП(Строка(ПараметрЗапуска));
	Если ПустаяСтрока(Параметр) Тогда
		Лог("АдресWebSocketИзПараметраЗапуска: пустой /C, fallback=" + АдресПоУмолчанию);
		Возврат АдресПоУмолчанию;
	КонецЕсли;

	Если Лев(НРег(Параметр), 5) = "ws://" Или Лев(НРег(Параметр), 6) = "wss://" Тогда
		Возврат Параметр;
	КонецЕсли;

	Лог("АдресWebSocketИзПараметраЗапуска: некорректный /C=" + Параметр + ", fallback=" + АдресПоУмолчанию);
	Возврат АдресПоУмолчанию;
КонецФункции

&НаКлиенте
Процедура ОткрытьWebSocket() Экспорт
	Если WS_Обработчики = Неопределено Тогда
		Лог("ОткрытьWebSocket: обработчики не инициализированы - пропуск");
		Возврат;
	КонецЕсли;

	Если WebSocketПодключен Тогда
		Лог("ОткрытьWebSocket: соединение уже открыто - пропуск");
		Возврат;
	КонецЕсли;

	Попытка
		ПараметрыСоединения = Новый ПараметрыWebSocketКлиентСоединения;
		ПараметрыСоединения.Таймаут = 10;
		Лог("ОткрытьWebSocket: вызываю WebSocketКлиентСоединения.ОткрытьСоединение");
		СоединениеWebSocket = WebSocketКлиентСоединения.ОткрытьСоединение(КлючСоединенияWebSocket, АдресWebSocket, WS_Обработчики);
		Лог("ОткрытьWebSocket: ОткрытьСоединение вернул " + Строка(СоединениеWebSocket));
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ОткрытьWebSocket: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область JSON

&НаКлиенте
Функция ЗначениеВJSON(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаКлиенте
Функция JSONВЗначение(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON);
КонецФункции

#КонецОбласти

#Область WebSocket

&НаКлиенте
Процедура ПриОткрытииСоединения(Соединение) Экспорт
	WebSocketПодключен = Истина;
	Лог("ПриОткрытииСоединения: WS открыт, отправляю hello");
	Сообщить("MCP: WebSocket соединение открыто, отправляю hello");
	Ответ = Новый Структура;
	Ответ.Вставить("type", "hello");
	Ответ.Вставить("role", "bridge");
	Ответ.Вставить("version", "0.1.0");
	Ответ.Вставить("platform", "1c-enterprise");
	Ответ.Вставить("manager_protocol_version", ВерсияПротоколаМенеджераMCP());
	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
	Лог("ПриОткрытииСоединения: hello отправлен");
КонецПроцедуры

&НаКлиенте
Функция ТекстИсключенияMCP(Инфо, Метод)
	ТекстОшибки = "";
	Попытка
		ТекстОшибки = ПодробноеПредставлениеОшибки(Инфо);
	Исключение
		ТекстОшибки = "";
	КонецПопытки;

	Если ПустаяСтрока(ТекстОшибки) Тогда
		Попытка
			ТекстОшибки = ОписаниеОшибки();
		Исключение
			ТекстОшибки = "";
		КонецПопытки;
	КонецЕсли;

	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Команда " + Метод + " завершилась исключением без текста ошибки";
	КонецЕсли;

	Возврат ТекстОшибки;
КонецФункции


&НаКлиенте
Процедура ОтправитьСобытиеПрогрессаMCP(Метод, Фаза, ДополнительныеДанные = Неопределено)
	Если Не WebSocketПодключен Или СоединениеWebSocket = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТекущийИдентификаторЗапросаMCP) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Событие = Новый Структура;
		Событие.Вставить("type", "event");
		Событие.Вставить("event", "progress");
		Событие.Вставить("id", ТекущийИдентификаторЗапросаMCP);
		Событие.Вставить("method", Метод);
		Событие.Вставить("phase", Фаза);
		Если НачалоТекущегоЗапросаMCP <> Неопределено И НачалоТекущегоЗапросаMCP <> 0 Тогда
			Событие.Вставить("elapsed_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоТекущегоЗапросаMCP);
		КонецЕсли;
		Если ДополнительныеДанные <> Неопределено Тогда
			Событие.Вставить("details", ДополнительныеДанные);
		КонецЕсли;
		СоединениеWebSocket.ОтправитьСообщение(ЗначениеВJSON(Событие));
	Исключение
		Лог("progress event failed method=" + Метод + " phase=" + Фаза + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриПолученииСообщения(Соединение, Сообщение) Экспорт
	Лог("ПриПолученииСообщения: " + Строка(Сообщение));
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Сообщение = ПолучитьСтрокуИзДвоичныхДанных(Сообщение, КодировкаТекста.UTF8);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("type", "response");

	Попытка
		Запрос = JSONВЗначение(Сообщение);
		Идентификатор = СвойствоСтруктуры(Запрос, "id", "");
		Метод = СвойствоСтруктуры(Запрос, "method", "");
		ПараметрыКоманды = СвойствоСтруктуры(Запрос, "params", Новый Структура);
		Ответ.Вставить("id", Идентификатор);
		ТекущийИдентификаторЗапросаMCP = Идентификатор;
		ТекущийМетодЗапросаMCP = Метод;
		НачалоТекущегоЗапросаMCP = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ОтправитьСобытиеПрогрессаMCP(Метод, "start");

		ЗаголовокОкнаДоКоманды = "";
		ИмяФормыОкнаДоКоманды = "";
		Попытка
			ОкноДоКоманды = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			ЗаголовокОкнаДоКоманды = БезопасноеСвойство(ОкноДоКоманды, "Заголовок", "");
			ФормаОкнаДоКоманды = НайтиОбъектРекурсивно(ОкноДоКоманды, "", "", "ТестируемаяФорма", 0);
			ИмяФормыОкнаДоКоманды = БезопасноеСвойство(ФормаОкнаДоКоманды, "ИмяФормы", "");
		Исключение
		КонецПопытки;

		Результат = ВыполнитьКоманду(Метод, ПараметрыКоманды);
		ДиагностикаКлиента = ПроверитьСостояниеКлиентаПослеШага(ЗаголовокОкнаДоКоманды, ИмяФормыОкнаДоКоманды);
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Результат.Вставить("client_diagnostics", ДиагностикаКлиента);
		КонецЕсли;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", Результат);
		Лог("ПриПолученииСообщения: метод=" + Метод + " выполнен");
	Исключение
		Инфо = ИнформацияОбОшибке();
		Если Не Ответ.Свойство("id") Тогда
			Ответ.Вставить("id", "");
		КонецЕсли;
		Ответ.Вставить("ok", Ложь);
		ТекстОшибки = ТекстИсключенияMCP(Инфо, Метод);
		ДиагностикаКлиента = ПроверитьСостояниеКлиентаПослеШага();
		Если ДиагностикаКлиента <> Неопределено Тогда
			ДиагностикаJSON = ЗначениеВJSON(ДиагностикаКлиента);
			Если Не ПустаяСтрока(ДиагностикаJSON) Тогда
				ТекстОшибки = ТекстОшибки + Символы.ПС + "client_diagnostics=" + ДиагностикаJSON;
			КонецЕсли;
		КонецЕсли;
		Ответ.Вставить("error", ТекстОшибки);
		Лог("ПриПолученииСообщения: ИСКЛЮЧЕНИЕ " + ТекстОшибки);
	КонецПопытки;

	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
	ТекущийИдентификаторЗапросаMCP = "";
	ТекущийМетодЗапросаMCP = "";
	НачалоТекущегоЗапросаMCP = 0;
КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеСоединения(Соединение, КодОшибки, Описание) Экспорт
	Лог("ПриОшибкеСоединения: код=" + Строка(КодОшибки) + " описание=" + Описание);
	Сообщить("MCP: ошибка WebSocket " + Строка(КодОшибки) + ": " + Описание);
	СоединениеWebSocket = Неопределено;
	WebSocketПодключен = Ложь;
	ЗапланироватьПереподключениеWebSocket();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииСоединения(Соединение, КодЗакрытия) Экспорт
	Лог("ПриЗакрытииСоединения: код=" + Строка(КодЗакрытия));
	Сообщить("MCP: WebSocket закрыт, код=" + Строка(КодЗакрытия));
	СоединениеWebSocket = Неопределено;
	WebSocketПодключен = Ложь;
	ЗапланироватьПереподключениеWebSocket();
КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьПереподключениеWebSocket()

	Если WS_Обработчики = Неопределено Тогда
		Лог("ЗапланироватьПереподключениеWebSocket: обработчики не инициализированы");
		Возврат;
	КонецЕсли;

	Попытка
		ОтключитьОбработчикОжидания("ОткрытьWebSocket");
	Исключение
		// Обработчик мог быть ещё не подключен.
	КонецПопытки;

	Лог("ЗапланироватьПереподключениеWebSocket: повтор через 3с");
	ПодключитьОбработчикОжидания("ОткрытьWebSocket", 3, Ложь);

КонецПроцедуры

#КонецОбласти

#Область КомандыMCP

&НаКлиенте
Функция ВерсияПротоколаМенеджераMCP()
	Возврат "2026.08.09.6";
КонецФункции

&НаКлиенте
Функция ИнформацияОМенеджереMCP()
	Возврат Новый Структура("manager_protocol_version", ВерсияПротоколаМенеджераMCP());
КонецФункции

&НаКлиенте
Процедура ПроверитьВерсиюПротоколаМенеджераMCP(Параметры)
	ОжидаемаяВерсия = СвойствоСтруктуры(Параметры, "expected_manager_protocol_version", "");
	Если Не ПустаяСтрока(ОжидаемаяВерсия) И ОжидаемаяВерсия <> ВерсияПротоколаМенеджераMCP() Тогда
		ВызватьИсключение "Несовместимая версия MCPTestManager.cf: Python ожидает протокол "
			+ ОжидаемаяВерсия + ", обработка поддерживает " + ВерсияПротоколаМенеджераMCP()
			+ ". Пересоберите MCPTestManager.cf из актуальных исходников и перезапустите Answer42 MCP.";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьКоманду(Метод, Параметры)
	Если Метод = "ping" Тогда
		Лог("ВыполнитьКоманду: ping");
		Возврат Новый Структура("pong,manager_protocol_version", Истина, ВерсияПротоколаМенеджераMCP());
	ИначеЕсли Метод = "manager_info" Тогда
		Возврат ИнформацияОМенеджереMCP();
	ИначеЕсли Метод = "connect_test_client" Тогда
		Лог("ВыполнитьКоманду: connect_test_client");
		Возврат ПодключитьКлиентТестирования(Параметры);
	ИначеЕсли Метод = "attach_test_client" Тогда
		Лог("ВыполнитьКоманду: attach_test_client");
		Возврат ПодключитьЗапущенныйКлиентТестирования(Параметры);
	ИначеЕсли Метод = "disconnect_test_client" Тогда
		Лог("ВыполнитьКоманду: disconnect_test_client");
		Возврат ОтключитьКлиентТестирования();
	ИначеЕсли Метод = "active_window" Тогда
		Возврат АктивноеОкноКакСтруктуру();
	ИначеЕсли Метод = "windows_list" Тогда
		Возврат СписокОконКакСтруктуру(Параметры);
	ИначеЕсли Метод = "activate_window" Тогда
		Возврат АктивироватьОкноMCP(Параметры);
	ИначеЕсли Метод = "goto_start_page" Тогда
		Возврат ПерейтиАктивнымОкномMCP("start_page", Параметры);
	ИначеЕсли Метод = "goto_previous_window" Тогда
		Возврат ПерейтиАктивнымОкномMCP("previous_window", Параметры);
	ИначеЕсли Метод = "goto_next_window" Тогда
		Возврат ПерейтиАктивнымОкномMCP("next_window", Параметры);
	ИначеЕсли Метод = "ui_tree" Тогда
		Возврат ДеревоИнтерфейса(Параметры);
	ИначеЕсли Метод = "command_bar" Тогда
		Возврат КоманднаяПанель();
	ИначеЕсли Метод = "click_button" Тогда
		Возврат НажатьКнопку(Параметры);
	ИначеЕсли Метод = "find_object" Тогда
		Возврат НайтиОбъектИнтерфейса(Параметры);
	ИначеЕсли Метод = "search_objects" Тогда
		Возврат НайтиВсеОбъектыИнтерфейса(Параметры);
	ИначеЕсли Метод = "get_object" Тогда
		Возврат ПолучитьОбъектПриложенияMCP(Параметры);
	ИначеЕсли Метод = "focus_object" Тогда
		Возврат ФокусироватьОбъектИнтерфейса(Параметры);
	ИначеЕсли Метод = "open_navigation_link" Тогда
		Возврат ОткрытьНавигационнуюСсылку(Параметры);
	ИначеЕсли Метод = "current_element" Тогда
		Возврат ТекущийЭлементФормы();
	ИначеЕсли Метод = "field_dropdown_state" Тогда
		Возврат СостояниеВыпадающегоСпискаПоляMCP(Параметры);
	ИначеЕсли Метод = "field_dropdown_close" Тогда
		Возврат ЗакрытьВыпадающийСписокПоляMCP(Параметры);
	ИначеЕсли Метод = "table_current_row" Тогда
		Возврат ТекущаяСтрокаТаблицы(Параметры);
	ИначеЕсли Метод = "table_selected_rows" Тогда
		Возврат ВыделенныеСтрокиТаблицы(Параметры);
	ИначеЕсли Метод = "table_cell_text" Тогда
		Возврат ТекстЯчейкиТаблицыMCP(Параметры);
	ИначеЕсли Метод = "tabular_documents" Тогда
		Возврат ТабличныеДокументы(Параметры);
	ИначеЕсли Метод = "tabular_document_text" Тогда
		Возврат ТекстТабличногоДокумента(Параметры);
	ИначеЕсли Метод = "tabular_document_save" Тогда
		Возврат СохранитьТабличныйДокументMCP(Параметры);
	ИначеЕсли Метод = "tabular_document_state_display" Тогда
		Возврат ОтображениеСостоянияТабличногоДокументаMCP(Параметры);
	ИначеЕсли Метод = "set_field_value" Тогда
