Функция СохранитьТабличныйДокументMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	Путь = СвойствоСтруктуры(Параметры, "path", "");
	ФорматФайла = НРег(СвойствоСтруктуры(Параметры, "format", "pdf"));
	Поле = НайтиТабличныйДокументПоПараметрам(АктивноеОкно, Имя, Заголовок, 0);
	Если Поле = Неопределено Тогда
		Возврат Новый Структура("found", Ложь);
	КонецЕсли;
	Если ПустаяСтрока(Путь) Тогда
		Путь = КаталогВременныхФайлов() + "tabular_document_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + "." + ФорматФайла;
	КонецЕсли;

	// Для tested form field extension for spreadsheet document direct Записать()
	// недоступен/ненадежен; сначала для любого формата перебираем фильтры
	// штатного файлового диалога, а Python-сторона проверяет сигнатуру/расширение
	// реально созданного файла нужного формата.
	ФайлыФильтров = Новый Массив;
	ОшибкиФильтров = Новый Массив;
	ВариантыСохранитьКак = Новый Массив;
	ВариантыСохранитьКак.Добавить(Истина);
	ВариантыСохранитьКак.Добавить(Ложь);
	Для Каждого СохранитьКак Из ВариантыСохранитьКак Цикл
		Для ИндексФильтра = 1 По 30 Цикл
			ПутьПопытки = ДобавитьСуффиксКПутиMCP(Путь, "_saveas_" + ?(СохранитьКак, "true", "false") + "_filter" + Строка(ИндексФильтра));
			Попытка
				ТестируемоеПриложение.УстановитьРезультатДиалогаВыбораФайла(Истина, ПутьПопытки, ИндексФильтра);
				Поле.ЗаписатьСодержимоеВФайл(СохранитьКак);
				// Не проверяем существование файла на стороне 1С синхронно: web/ws
				// клиент может материализовать файл чуть позже. Возвращаем все
				// успешные попытки, а Python-сторона проверяет факт, сигнатуру и формат.
				ФайлыФильтров.Добавить(Новый Структура("path,filter_index,save_as", ПутьПопытки, ИндексФильтра, СохранитьКак));
			Исключение
				ОшибкиФильтров.Добавить(Новый Структура("filter_index,save_as,error", ИндексФильтра, СохранитьКак, ОписаниеОшибки()));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Если ФайлыФильтров.Количество() > 0 Тогда
		Возврат Новый Структура("saved,path,format,method,files,errors", Истина, Путь, ФорматФайла, "write_content_to_file_dialog_filters", ФайлыФильтров, ОшибкиФильтров);
	КонецЕсли;

	Возврат Новый Структура("saved,path,format,method,files,errors,error", Ложь, Путь, ФорматФайла, "write_content_to_file_dialog_filters", ФайлыФильтров, ОшибкиФильтров, "Ни один фильтр файлового диалога не выполнил сохранение табличного документа");
КонецФункции

&НаКлиенте
Функция ДобавитьСуффиксКПутиMCP(Путь, Суффикс)
	ПозицияТочки = 0;
	Для Индекс = СтрДлина(Путь) По 1 Цикл
		Если Сред(Путь, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияТочки = 0 Тогда
		Возврат Путь + Суффикс;
	КонецЕсли;
	Возврат Лев(Путь, ПозицияТочки - 1) + Суффикс + Сред(Путь, ПозицияТочки);
КонецФункции

&НаКлиенте
Функция ТипФайлаТабличногоДокументаMCP(ФорматФайла)
	Формат = НРег(Строка(ФорматФайла));
	Если Формат = "pdf" Тогда
		Возврат ТипФайлаТабличногоДокумента.PDF;
	ИначеЕсли Формат = "xlsx" Тогда
		Возврат ТипФайлаТабличногоДокумента.XLSX;
	ИначеЕсли Формат = "xls" Тогда
		Возврат ТипФайлаТабличногоДокумента.XLS;
	ИначеЕсли Формат = "html" Или Формат = "htm" Тогда
		Возврат ТипФайлаТабличногоДокумента.HTML;
	ИначеЕсли Формат = "txt" Тогда
		Возврат ТипФайлаТабличногоДокумента.TXT;
	Иначе
		Возврат ТипФайлаТабличногоДокумента.PDF;
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ИндексФильтраДиалогаТабличногоДокументаMCP(ФорматФайла)
	Формат = НРег(Строка(ФорматФайла));
	Если Формат = "pdf" Тогда
		Возврат 1;
	ИначеЕсли Формат = "xlsx" Тогда
		Возврат 2;
	ИначеЕсли Формат = "xls" Тогда
		Возврат 3;
	ИначеЕсли Формат = "html" Или Формат = "htm" Тогда
		Возврат 5;
	ИначеЕсли Формат = "txt" Тогда
		Возврат 6;
	Иначе
		Возврат 1;
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция НайтиТабличныйДокументПоПараметрам(РодительскийОбъект, Имя, Заголовок, ТекущаяГлубина)
	Попытка
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			Если ЭтоИскомоеПолеТабличногоДокумента(Подчиненный, Имя, Заголовок) Тогда
				Возврат Подчиненный;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Результат = НайтиТабличныйДокументПоПараметрам(Подчиненный, Имя, Заголовок, ТекущаяГлубина + 1);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ЭтоИскомоеПолеТабличногоДокумента(Объект, Имя, Заголовок)
	ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Объект)));
	ЭтоПолеТабличногоДокумента = ТипТек = "тестируемоеполетабличногодокументаформы";
	Если Не ЭтоПолеТабличногоДокумента И ТипТек = "тестируемоеполеформы" Тогда
		// На некоторых отчетах ПолучитьПредставлениеДанных() у поля табличного
		// документа падает, пока поле недоступно для интерактивных действий.
		// Поэтому сначала проверяем Вид поля, затем представление данных.
		ЭтоПолеТабличногоДокумента = ВидПоляТабличныйДокумент(Объект) Или ПредставлениеДанныхПоляТабличныйДокумент(Объект);
	КонецЕсли;
	Если Не ЭтоПолеТабличногоДокумента Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяТек = БезопасноеСвойство(Объект, "Имя", "");
	ЗаголовокТек = БезопасныйЗаголовок(Объект);
	Возврат (ПустаяСтрока(Имя) Или ИмяТек = Имя) И (ПустаяСтрока(Заголовок) Или ЗаголовокТек = Заголовок);
КонецФункции

