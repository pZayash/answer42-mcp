&НаКлиенте
Функция ВыполнитьКодРазработчикаMCP(Параметры)
	Код = СвойствоСтруктуры(Параметры, "code", "");
	Если ПустаяСтрока(Код) Тогда
		ВызватьИсключение "Параметр code обязателен для dev_eval";
	КонецЕсли;

	Выражение = СокрЛП(Код);
	ЭтоВозврат = НРег(Лев(Выражение, 7)) = "возврат";
	Если ЭтоВозврат Тогда
		Выражение = СокрЛП(Сред(Выражение, 8));
		Если Прав(Выражение, 1) = ";" Тогда
			Выражение = Лев(Выражение, СтрДлина(Выражение) - 1);
		КонецЕсли;
		Результат = Вычислить(Выражение);
		Возврат Новый Структура("value,type,presentation,executed_as", Результат, Строка(ТипЗнч(Результат)), Строка(Результат), "expression");
	КонецЕсли;

	Выполнить(Код);
	Возврат Новый Структура("executed,executed_as", Истина, "statement");
КонецФункции

