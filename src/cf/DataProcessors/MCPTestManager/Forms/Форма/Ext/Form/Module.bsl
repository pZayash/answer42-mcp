	ПроверитьВерсиюПротоколаМенеджераMCP(Параметры);
	URLБазы = СвойствоСтруктуры(Параметры, "base_url", "");
	ТипПодключения = НРег(СвойствоСтруктуры(Параметры, "connection_mode", "ws"));
	СтрокаПодключения = СвойствоСтруктуры(Параметры, "connection_value", URLБазы);
	Пользователь = СвойствоСтруктуры(Параметры, "username", "");
	Порт = СвойствоСтруктуры(Параметры, "port", 1538);
	АдресКлиентаТестирования = СвойствоСтруктуры(Параметры, "host", "localhost");
	ИдентификаторПроцесса = СвойствоСтруктуры(Параметры, "client_pid", 0);
	ФайлЛогаТестКлиента = СвойствоСтруктуры(Параметры, "client_log", "");

	Лог("ПодключитьЗапущенныйКлиентТестирования: mode=" + ТипПодключения + " value=" + СтрокаПодключения + " Порт=" + Строка(Порт) + " pid=" + Строка(ИдентификаторПроцесса));
	ТестируемоеПриложение = Новый ТестируемоеПриложение(АдресКлиентаТестирования, Порт);
	ПодключитьсяКТестовомуКлиенту(Пользователь, ФайлЛогаТестКлиента);
