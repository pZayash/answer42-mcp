		// не открылся — не открываем его кодом, а возвращаем честную ошибку.
		НеподтвержденноеПредставлениеПослеВвода = ПредставлениеПослеВвода;
	Исключение
		Ошибки.Добавить("ВвестиТекст=" + ОписаниеОшибки());
	КонецПопытки;

