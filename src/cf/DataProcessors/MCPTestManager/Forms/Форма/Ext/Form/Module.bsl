		ЗакрытьКомандныйИнтерфейсПослеРаботыMCP(АктивноеОкно, КнопкаРаздела);
		Возврат РезультатПоиска;
	Исключение
		Если АктивноеОкно <> Неопределено Тогда
			ЗакрытьКомандныйИнтерфейсПослеРаботыMCP(АктивноеОкно, КнопкаРаздела);
		КонецЕсли;
		Возврат Новый Структура("available,reason,error", Ложь, "not_supported", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ЗакрытьКомандныйИнтерфейсПослеРаботыMCP(Окно, КнопкаРаздела = Неопределено)
	// Некоторые методы test-client оставляют раскрытый командный интерфейс поверх
	// формы. После этого интерактивные действия по форме могут падать с
	// "Недоступный пользователю элемент управления...". Возвращаем UI в форму:
	// если нажимали кнопку раздела — нажимаем её повторно (переключатель панели),
	// затем активизируем окно и первую найденную форму.
	Если КнопкаРаздела <> Неопределено Тогда
		Попытка
			КнопкаРаздела.Нажать();
		Исключение
			// Игнорируем: cleanup не должен ломать полезный результат команды.
		КонецПопытки;
	КонецЕсли;
	Попытка
		Окно.Активизировать();
	Исключение
	КонецПопытки;
	Попытка
		Форма = НайтиОбъектРекурсивно(Окно, "", "", "тестируемаяформа", 0);
		Если Форма <> Неопределено Тогда
			Форма.Активизировать();
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция КомандныйИнтерфейсЦелевоеОкно(Параметры)
	ОкноЗаголовок = СвойствоСтруктуры(Параметры, "window_title", "");
	Если ПустаяСтрока(ОкноЗаголовок) Тогда
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если КомандныйИнтерфейсОкнаПоддерживается(АктивноеОкно) Тогда
			Возврат АктивноеОкно;
		КонецЕсли;
		Для Каждого ТекущееОкно Из ОкнаТестируемогоПриложения() Цикл
			Если КомандныйИнтерфейсОкнаПоддерживается(ТекущееОкно) Тогда
				ТекущееОкно.Активизировать();
				Возврат ТекущееОкно;
			КонецЕсли;
		КонецЦикла;
		Возврат АктивноеОкно;
	КонецЕсли;

	Для Каждого ТекущееОкно Из ОкнаТестируемогоПриложения() Цикл
		ЗаголовокТекущегоОкна = БезопасноеСвойство(ТекущееОкно, "Заголовок", "");
		Если СтрНайти(НРег(ЗаголовокТекущегоОкна), НРег(ОкноЗаголовок)) > 0
			И КомандныйИнтерфейсОкнаПоддерживается(ТекущееОкно) Тогда
			ТекущееОкно.Активизировать();
			Возврат ТекущееОкно;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Окно не найдено: " + ОкноЗаголовок;
КонецФункции

&НаКлиенте
Функция КомандныйИнтерфейсОкнаПоддерживается(Окно)
	Попытка
		Окно.ПолучитьКомандныйИнтерфейс();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция КомандныйИнтерфейсНайтиРаздел(Интерфейс, ЗаголовокРаздела)
	Для Каждого Раздел Из КомандныйИнтерфейсПодчиненныеРекурсивно(Интерфейс, "тестируемаякнопкакомандногоинтерфейса") Цикл
		ЗаголовокРазделаТекущий = БезопасныйЗаголовок(Раздел);
		Если СтрНайти(НРег(ЗаголовокРазделаТекущий), НРег(ЗаголовокРаздела)) > 0 Тогда
			Возврат Раздел;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция РазделыКомандногоИнтерфейса(Интерфейс)
	Результат = Новый Массив;
	Для Каждого Группа Из КомандныйИнтерфейсПодчиненныеРекурсивно(Интерфейс, "тестируемаягруппакомандногоинтерфейса") Цикл
		Если СтрНайти(НРег(БезопасныйЗаголовок(Группа)), "панель разделов") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Раздел Из БезопасныеПодчиненные(Группа) Цикл
			Если НормализованноеИмяТипа(Строка(ТипЗнч(Раздел))) <> "тестируемаякнопкакомандногоинтерфейса" Тогда
				Продолжить;
			КонецЕсли;
			ДанныеРаздела = КомандныйИнтерфейсОбъектВСтруктуру(Раздел, 0);
			ДанныеРаздела.Вставить("panel", БезопасныйЗаголовок(Группа));
			Результат.Добавить(ДанныеРаздела);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КомандныйИнтерфейсПодчиненныеРекурсивно(Объект, ИскомыйТип)
	Результат = Новый Массив;
	КомандныйИнтерфейсПодчиненныеРекурсивноВнутр(Объект, ИскомыйТип, Результат);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура КомандныйИнтерфейсПодчиненныеРекурсивноВнутр(Объект, ИскомыйТип, Результат)
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Подчиненный Из БезопасныеПодчиненные(Объект) Цикл
		Если НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный))) = ИскомыйТип Тогда
			Результат.Добавить(Подчиненный);
		КонецЕсли;
		КомандныйИнтерфейсПодчиненныеРекурсивноВнутр(Подчиненный, ИскомыйТип, Результат);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КомандныйИнтерфейсОбъектВСтруктуру(Объект, ТекущаяГлубина)
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	ТипОбъекта = Строка(ТипЗнч(Объект));
	НормТип = НормализованноеИмяТипа(ТипОбъекта);
	Результат.Вставить("type", ТипОбъекта);
	Результат.Вставить("kind", НормТип);
	Результат.Вставить("title", БезопасныйЗаголовок(Объект));
	Результат.Вставить("navigation_url", БезопасноеСвойство(Объект, "НавигационнаяСсылка", ""));

	Если НормТип = "тестируемыйкомандныйинтерфейс" Тогда
		Результат.Вставить("role", "root");
	ИначеЕсли НормТип = "тестируемаягруппакомандногоинтерфейса" Тогда
		Результат.Вставить("role", "section");
	ИначеЕсли НормТип = "тестируемаякнопкакомандногоинтерфейса" Тогда
		Результат.Вставить("role", "command");
	Иначе
		Результат.Вставить("role", "object");
	КонецЕсли;

	Попытка
		Результат.Вставить("visible", Объект.ТекущаяВидимость());
	Исключение
		Результат.Вставить("visible", Истина);
	КонецПопытки;
	Попытка
		Результат.Вставить("available", Объект.ТекущаяДоступность());
	Исключение
		Результат.Вставить("available", Истина);
	КонецПопытки;

	Если Истина Тогда
		Дети = Новый Массив;
		Для Каждого Подчиненный Из БезопасныеПодчиненные(Объект) Цикл
			ДанныеПодчиненного = КомандныйИнтерфейсОбъектВСтруктуру(Подчиненный, ТекущаяГлубина + 1);
			Если ДанныеПодчиненного <> Неопределено Тогда
				Дети.Добавить(ДанныеПодчиненного);
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("children", Дети);
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КомандыКомандногоИнтерфейса(Корень, ИсключатьСлужебныеПанели = Ложь)
	Результат = Новый Массив;
	КомандыКомандногоИнтерфейсаРекурсивно(Корень, Результат, Новый Массив, ИсключатьСлужебныеПанели);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура КомандыКомандногоИнтерфейсаРекурсивно(Объект, Результат, Путь, ИсключатьСлужебныеПанели)
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипОбъекта = НормализованноеИмяТипа(Строка(ТипЗнч(Объект)));
	Заголовок = БезопасныйЗаголовок(Объект);
	СлужебнаяПанель = ИсключатьСлужебныеПанели И КомандныйИнтерфейсПутьСодержитСлужебнуюПанель(Путь);
	Если ТипОбъекта = "тестируемаякнопкакомандногоинтерфейса" И Не СлужебнаяПанель Тогда
		Команда = Новый Структура;
		Команда.Вставить("title", Заголовок);
		Команда.Вставить("navigation_url", БезопасноеСвойство(Объект, "НавигационнаяСсылка", ""));
		Команда.Вставить("path", Путь);
		Результат.Добавить(Команда);
	КонецЕсли;

	НовыйПуть = Новый Массив;
	Для Каждого ЭлементПути Из Путь Цикл
		НовыйПуть.Добавить(ЭлементПути);
	КонецЦикла;
	Если ТипОбъекта = "тестируемаягруппакомандногоинтерфейса" И Не ПустаяСтрока(Заголовок) Тогда
		НовыйПуть.Добавить(Заголовок);
	КонецЕсли;

	Для Каждого Подчиненный Из БезопасныеПодчиненные(Объект) Цикл
		КомандыКомандногоИнтерфейсаРекурсивно(Подчиненный, Результат, НовыйПуть, ИсключатьСлужебныеПанели);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КомандныйИнтерфейсПутьСодержитСлужебнуюПанель(Путь)
	Для Каждого ЭлементПути Из Путь Цикл
		НормЭлемент = НРег(ЭлементПути);
		Если СтрНайти(НормЭлемент, "панель разделов") > 0
			Или СтрНайти(НормЭлемент, "панель открытых") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ПоискВКомандахКомандногоИнтерфейса(Команды, СтрокаПоиска, Максимум)
	Результат = Новый Массив;
	НормПоиск = НРег(СтрокаПоиска);
	КороткийПоиск = НормПоиск;
	Если СтрДлина(КороткийПоиск) > 3 Тогда
		КороткийПоиск = Лев(КороткийПоиск, СтрДлина(КороткийПоиск) - 1);
	КонецЕсли;
	Для Каждого Команда Из Команды Цикл
		Заголовок = СвойствоСтруктуры(Команда, "title", "");
		Ссылка = СвойствоСтруктуры(Команда, "navigation_url", "");
		Путь = СвойствоСтруктуры(Команда, "path", Новый Массив);
		ТекстПути = КомандныйИнтерфейсПутьВСтроку(Путь);
		ТекстДляПоиска = НРег(Заголовок + " " + ТекстПути + " " + Ссылка);
		Если СтрНайти(ТекстДляПоиска, НормПоиск) > 0
			Или (КороткийПоиск <> НормПоиск И СтрНайти(ТекстДляПоиска, КороткийПоиск) > 0) Тогда
			Совпадение = Новый Структура;
			Совпадение.Вставить("title", Заголовок);
			Совпадение.Вставить("navigation_url", Ссылка);
			Совпадение.Вставить("path", Путь);
			Совпадение.Вставить("path_text", ТекстПути);
			Совпадение.Вставить("score", КомандныйИнтерфейсОценкаСовпадения(Заголовок, ТекстПути, Ссылка, НормПоиск));
			Результат.Добавить(Совпадение);
			Если Максимум > 0 И Результат.Количество() >= Максимум Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КомандныйИнтерфейсПутьВСтроку(Путь)
	Результат = "";
	Для Каждого ЭлементПути Из Путь Цикл
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + " / ";
		КонецЕсли;
		Результат = Результат + ЭлементПути;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КомандныйИнтерфейсОценкаСовпадения(Заголовок, ТекстПути, Ссылка, НормПоиск)
	Если НРег(Заголовок) = НормПоиск Тогда
		Возврат 100;
	КонецЕсли;
	Если СтрНайти(НРег(Заголовок), НормПоиск) > 0 Тогда
		Возврат 80;
	КонецЕсли;
	Если СтрНайти(НРег(ТекстПути), НормПоиск) > 0 Тогда
		Возврат 50;
	КонецЕсли;
	Если СтрНайти(НРег(Ссылка), НормПоиск) > 0 Тогда
		Возврат 30;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаКлиенте
Функция РазвернутьГруппуMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();

	ПараметрыПоиска = Новый Структура;
	Если Имя <> "" Тогда ПараметрыПоиска.Вставить("Имя", Имя); КонецЕсли;
	Если Заголовок <> "" Тогда ПараметрыПоиска.Вставить("Заголовок", Заголовок); КонецЕсли;
	Группа = НайтиОбъектРекурсивно(АктивноеОкно, Имя, Заголовок, "", 0);
	Если Группа = Неопределено Тогда
		Возврат Новый Структура("found,group,reason", Ложь, Неопределено, "group_not_found");
	КонецЕсли;

	Попытка
		Группа.Развернуть();
		Возврат Новый Структура("expanded,group", Истина, ОбъектВСтруктуру(Группа, 0));
	Исключение
		Возврат Новый Структура("expanded,group,reason,error", Ложь, ОбъектВСтруктуру(Группа, 0), "not_supported", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

