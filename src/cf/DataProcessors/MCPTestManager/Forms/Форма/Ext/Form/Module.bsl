	Попытка
		Представление = Поле.ПолучитьПредставлениеДанных();
		Возврат НРег(Строка(Представление)) = "табличныйдокумент";
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции



&НаКлиенте
Функция СостояниеВыпадающегоСпискаПоляMCP(Параметры)
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ЗаголовокПоля = СвойствоСтруктуры(Параметры, "title", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Таймаут = СвойствоСтруктуры(Параметры, "timeout", 60);
	Если ИскатьПоЗаголовку Тогда
		ЗаголовокПоля = ИмяПоля;
		ИмяПоля = "";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ?(ПустаяСтрока(ИмяПоля), ЗаголовокПоля, ИмяПоля);
	КонецЕсли;
	Открыт = ОткрытВыпадающийСписокПоляMCP(Поле);
	Сформирован = Ложь;
	ПредставленияСтрокой = Новый Массив;
	Если Открыт Тогда
		Попытка
			Сформирован = Поле.ОжидатьФормированияВыпадающегоСписка(Таймаут);
		Исключение
		КонецПопытки;
		Попытка
			Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
			Для Каждого Представление Из Представления Цикл
				ПредставленияСтрокой.Добавить(ПредставлениеВариантаСпискаВыбораMCP(Представление));
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("field,opened,formed,count,items,value", ?(ПустаяСтрока(ИмяПоля), ЗаголовокПоля, ИмяПоля), Открыт, Сформирован, ПредставленияСтрокой.Количество(), ПредставленияСтрокой, ПредставлениеДанныхПоля(Поле));
КонецФункции

&НаКлиенте
Функция ЗакрытьВыпадающийСписокПоляMCP(Параметры)
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ЗаголовокПоля = СвойствоСтруктуры(Параметры, "title", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Если ИскатьПоЗаголовку Тогда
		ЗаголовокПоля = ИмяПоля;
		ИмяПоля = "";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ?(ПустаяСтрока(ИмяПоля), ЗаголовокПоля, ИмяПоля);
	КонецЕсли;
	БылОткрыт = ОткрытВыпадающийСписокПоляMCP(Поле);
	Если БылОткрыт Тогда
		Поле.ЗакрытьВыпадающийСписок();
	КонецЕсли;
	Возврат Новый Структура("field,closed,was_opened,value", ?(ПустаяСтрока(ИмяПоля), ЗаголовокПоля, ИмяПоля), БылОткрыт, БылОткрыт, ПредставлениеДанныхПоля(Поле));
КонецФункции


&НаКлиенте
Функция ИндексРелевантногоВариантаСпискаВыбораMCP(Представления, ИскомоеПредставление)
	ИскомоеНРег = НРег(ИскомоеПредставление);
	Индекс = 0;
	ПервыйСодержащий = Неопределено;
	Для Каждого Представление Из Представления Цикл
		ТекстВарианта = ПредставлениеВариантаСпискаВыбораMCP(Представление);
		ОтображаемыйТекст = "";
		Если ТипЗнч(Представление) = Тип("Структура") Тогда
			Если Не Представление.Свойство("ОтображаемыйТекст", ОтображаемыйТекст) Тогда
				ОтображаемыйТекст = "";
			КонецЕсли;
		КонецЕсли;
		ТекстНРег = НРег(ТекстВарианта);
		ОтображаемыйНРег = НРег(ОтображаемыйТекст);
		Если ТекстНРег = ИскомоеНРег Или ОтображаемыйНРег = ИскомоеНРег Тогда
			Возврат Индекс;
		КонецЕсли;
		Если ПервыйСодержащий = Неопределено Тогда
			Если СтрНайти(ТекстНРег, ИскомоеНРег) > 0 Или СтрНайти(ОтображаемыйНРег, ИскомоеНРег) > 0 Тогда
				ПервыйСодержащий = Индекс;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат ПервыйСодержащий;
КонецФункции

&НаКлиенте
Функция ИндексВариантаСпискаВыбораMCP(Представления, ИскомоеПредставление)
	Индекс = 0;
	Для Каждого Представление Из Представления Цикл
		ТекстВарианта = ПредставлениеВариантаСпискаВыбораMCP(Представление);
		ОтображаемыйТекст = "";
		Если ТипЗнч(Представление) = Тип("Структура") Тогда
			Если Не Представление.Свойство("ОтображаемыйТекст", ОтображаемыйТекст) Тогда
				ОтображаемыйТекст = "";
			КонецЕсли;
		КонецЕсли;
		Если ТекстВарианта = ИскомоеПредставление Или ОтображаемыйТекст = ИскомоеПредставление Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПереключитьПолеMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	Значение = СвойствоСтруктуры(Параметры, "value", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, "", "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;
	ОшибкаАктивности = ПроверитьАктивностьСтраницыРодителя(Поле);
	Если ОшибкаАктивности <> Неопределено Тогда
		ВызватьИсключение ОшибкаАктивности;
	КонецЕсли;
	НужноДа = (Значение = Истина) Или (НРег(Строка(Значение)) = "да") Или (НРег(Строка(Значение)) = "true") Или (Строка(Значение) = "1");
	ТекущееПредставление = ПредставлениеДанныхПоля(Поле);
	СейчасДа = (НРег(Строка(ТекущееПредставление)) = "да") Или (НРег(Строка(ТекущееПредставление)) = "true") Или (Строка(ТекущееПредставление) = "1");
	Если НужноДа = СейчасДа Тогда
		Возврат Новый Структура("toggled,field,value,method", Истина, ИмяПоля, Значение, "ТекущееЗначение");
	КонецЕсли;
	Попытка
		Поле.УстановитьОтметку();
	Исключение
		ВызватьИсключение "Не удалось переключить поле " + ИмяПоля + ": " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Новый Структура("toggled,field,value,method", Истина, ИмяПоля, Значение, "УстановитьОтметку");
КонецФункции


&НаКлиенте
Процедура ДобавитьДиагностикуМодальногоОкнаЕслиОткрылосьMCP(Результат, ЗаголовокОкнаДоДействия)
	Попытка
		АктивноеОкноПослеДействия = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		ЗаголовокОкнаПослеДействия = БезопасноеСвойство(АктивноеОкноПослеДействия, "Заголовок", "");
		НормализованныйЗаголовокДо = СтрЗаменить(ЗаголовокОкнаДоДействия, " *", "");
		НормализованныйЗаголовокПосле = СтрЗаменить(ЗаголовокОкнаПослеДействия, " *", "");
		Если Не ПустаяСтрока(ЗаголовокОкнаПослеДействия) И НормализованныйЗаголовокПосле <> НормализованныйЗаголовокДо Тогда
			Результат.Вставить("modal_opened", Истина);
			Результат.Вставить("modal_title", ЗаголовокОкнаПослеДействия);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция НормализоватьЗаголовокОкнаMCP(Заголовок)
	Возврат СтрЗаменить(Строка(Заголовок), " *", "");
КонецФункции

&НаКлиенте
Процедура ДобавитьСостояниеОкнаПослеДействияMCP(Результат, ЗаголовокОкнаДоДействия, ФормаДоДействия = Неопределено, ОжидатьЗакрытияФормы = Ложь)
	Если ОжидатьЗакрытияФормы И ФормаДоДействия <> Неопределено Тогда
		Попытка
			// Штатный test-client API надежнее эвристики по заголовкам: форма сама
			// сообщает, закрылась ли она после действия (кнопка "Записать и закрыть",
			// закрытие окна и т.п.).
			Результат.Вставить("form_closed", ФормаДоДействия.ОжидатьЗакрытие());
		Исключение
			Результат.Вставить("form_closed_error", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Попытка
		АктивноеОкноПослеДействия = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		ЗаголовокОкнаПослеДействия = БезопасноеСвойство(АктивноеОкноПослеДействия, "Заголовок", "");
		Результат.Вставить("window_title_before", ЗаголовокОкнаДоДействия);
		Результат.Вставить("window_title_after", ЗаголовокОкнаПослеДействия);
		Результат.Вставить("window_changed", НормализоватьЗаголовокОкнаMCP(ЗаголовокОкнаПослеДействия) <> НормализоватьЗаголовокОкнаMCP(ЗаголовокОкнаДоДействия));
	Исключение
		Результат.Вставить("window_state_error", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ПодсказкаСозданияСсылочногоЗначенияMCP(ИмяПоля, Значение)
	Возврат "Возможно значение '" + Строка(Значение) + "' не найдено для поля '" + Строка(ИмяПоля) + "'. Для ссылочного поля откройте форму выбора (choose_field_from_list/table_choose_field_from_list), найдите или создайте элемент справочника/вида/единицы, затем выберите его.";
КонецФункции

&НаКлиенте
Функция УстановитьЗначениеПоля(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	Значение = СвойствоСтруктуры(Параметры, "value", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	ОтменятьРедактированиеПриОшибке = СвойствоСтруктуры(Параметры, "cancel_on_error", Истина);
	Если ПустаяСтрока(ИмяПоля) Тогда
		ВызватьИсключение "Не задано имя поля.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокПоля = ?(ИскатьПоЗаголовку, ИмяПоля, "");
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0);
	Если Поле = Неопределено Тогда
		Попытка
			Поле = ТестируемоеПриложение.ПолучитьОбъект(Неопределено, ЗаголовокПоля, ИмяПоля, 1);
		Исключение
			Поле = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;

	// Если поле уже содержит целевое значение, не пытаемся выполнять
	// интерактивный ввод. Это важно для автозаполненных реквизитов вроде
	// Организации: в форме может остаться только скрытый readonly runtime-
	// элемент с актуальным значением, и попытка ВвестиТекст() по нему ошибочна.
	ТекущееПредставлениеДоВвода = ПредставлениеДанныхПоля(Поле);
	Если ТекущееПредставлениеДоВвода = Значение Или (Не ПустаяСтрока(Значение) И СтрНайти(ТекущееПредставлениеДоВвода, Значение) > 0) Тогда
		Возврат Новый Структура("set,field,value,method,current", Истина, ИмяПоля, Значение, "ТекущееЗначение", ТекущееПредставлениеДоВвода);
	КонецЕсли;

	ОшибкаАктивности = ПроверитьАктивностьСтраницыРодителя(Поле);
	Если ОшибкаАктивности <> Неопределено Тогда
		ВызватьИсключение ОшибкаАктивности;
	КонецЕсли;

	Ошибки = Новый Массив;

	ВидПоля = "";
	Попытка
		ВидПоля = Строка(Поле.Вид);
	Исключение
		ВидПоля = "";
	КонецПопытки;

	Если ВидПоля = "Поле переключателя" Тогда
		ОшибкиПереключателя = Новый Массив;
		Для НомерПопытки = 1 По 20 Цикл
			// После смены варианта платформа может перестроить часть формы, поэтому
			// каждый раз перечитываем объект поля из актуального активного окна.
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			СвежееПоле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0);
			Если СвежееПоле <> Неопределено Тогда
				Поле = СвежееПоле;
			КонецЕсли;
			ТекущееПредставление = ПредставлениеДанныхПоля(Поле);
			Если ТекущееПредставление = Значение Тогда
				Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ПолеПереключателя.ТекущееЗначение");
			КонецЕсли;
			ЗначениеДляВыбора = ЗначениеВариантаПереключателя(Поле, Значение);
			БылоИсключениеВыбора = Ложь;
			Попытка
				Поле.ВыбратьВариант(ЗначениеДляВыбора);
			Исключение
				// В 8.5 у некоторых полей-переключателей test-client может бросить
				// "Недоступный пользователю элемент...", но значение при этом уже
				// успевает перейти к следующему варианту. Поэтому не выходим сразу,
				// а перечитываем поле и проверяем состояние ниже.
				БылоИсключениеВыбора = Истина;
				Если ОшибкиПереключателя.Количество() < 3 Тогда
					ОшибкиПереключателя.Добавить(ОписаниеОшибки());
				КонецЕсли;
			КонецПопытки;

			// ВыбратьВариант() на web-клиенте может менять значение асинхронно:
			// сразу после вызова/исключения представление еще старое, а через доли
			// секунды уже целевое. Коротко ждем именно состояния поля, не открытия
			// модальных окон и не пользовательского клика.
			НачалоОжиданияПереключателя = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжиданияПереключателя < 1000 Цикл
				АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
				СвежееПоле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0);
				Если СвежееПоле <> Неопределено Тогда
					Поле = СвежееПоле;
				КонецЕсли;
				ТекущееПредставление = ПредставлениеДанныхПоля(Поле);
				Если ТекущееПредставление = Значение Тогда
					МетодПереключателя = ?(БылоИсключениеВыбора, "ПолеПереключателя.ТекущееЗначениеПослеИсключения", "ПолеПереключателя.ВыбратьВариант");
					Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, МетодПереключателя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		НачалоОжиданияПереключателя = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжиданияПереключателя < 2000 Цикл
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			СвежееПоле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0);
			Если СвежееПоле <> Неопределено Тогда
				Поле = СвежееПоле;
			КонецЕсли;
			ТекущееПредставление = ПредставлениеДанныхПоля(Поле);
			Если ТекущееПредставление = Значение Тогда
				Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ПолеПереключателя.ТекущееЗначениеПослеОжидания");
			КонецЕсли;
		КонецЦикла;
		Если ОшибкиПереключателя.Количество() > 0 Тогда
			Ошибки.Добавить("ПолеПереключателя.ВыбратьВариант=" + СтрСоединить(ОшибкиПереключателя, "; ") + "; целевое значение не выбрано, текущее значение: " + ТекущееПредставление);
		Иначе
			Ошибки.Добавить("ПолеПереключателя.ВыбратьВариант=Значение не выбрано после 20 переключений, текущее значение: " + ТекущееПредставление);
		КонецЕсли;
	КонецЕсли;

	Если ВидПоля = "Поле флажка" Тогда
		Попытка
			ТекущееПредставление = Поле.ПолучитьПредставлениеДанных();
		Исключение
			Попытка
				ТекущееПредставление = Поле.ПолучитьОтображаемыйТекст();
			Исключение
				ТекущееПредставление = "";
			КонецПопытки;
		КонецПопытки;
		НужноДа = (Значение = Истина) Или (НРег(Строка(Значение)) = "да") Или (НРег(Строка(Значение)) = "true") Или (Строка(Значение) = "1");
		СейчасДа = (НРег(Строка(ТекущееПредставление)) = "да") Или (НРег(Строка(ТекущееПредставление)) = "true") Или (Строка(ТекущееПредставление) = "1");
		Если НужноДа <> СейчасДа Тогда
			Попытка
				Поле.УстановитьОтметку();
			Исключение
				Ошибки.Добавить("ПолеФлажка.УстановитьОтметку=" + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		Если Ошибки.Количество() = 0 Тогда
			Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ПолеФлажка.УстановитьОтметку");
		КонецЕсли;
	КонецЕсли;

	// Обычные поля ввода. На web-клиенте ВвестиТекст() может обновлять
	// представление асинхронно и/или пересоздавать объект поля. Поэтому после
	// ввода перечитываем поле из активного окна и коротко ждем фактическое
	// представление данных, прежде чем переходить к fallback-методам.
	//
	// Для полей с выпадающим списком (ссылочные поля, поля выбора) платформа
	// после ВвестиТекст() часто открывает dropdown с отфильтрованными вариантами.
	// В этом случае выбираем первый вариант и возвращаем его представление.
	ТекстовыйВводВыполнен = Ложь;
	НеподтвержденноеПредставлениеПослеВвода = "";
	Попытка
		ЗаголовокОкнаДоВвода = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
		Поле.ВвестиТекст(Значение);
		ТекстовыйВводВыполнен = Истина;
		Если ПустаяСтрока(Значение) Тогда
			Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ВвестиТекст");
		КонецЕсли;

		// ВвестиТекст() на web-клиенте может пересоздать/подменить объект поля.
		// Перед проверкой dropdown перечитываем поле из активного окна.
		АктивноеОкноПослеВвода = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		СвежееПолеПослеВвода = НайтиОбъектРекурсивно(АктивноеОкноПослеВвода, ИмяПоля, ЗаголовокПоля, "", 0);
		Если СвежееПолеПослеВвода <> Неопределено Тогда
			Поле = СвежееПолеПослеВвода;
		КонецЕсли;

		// Сначала проверяем, изменилось ли значение поля сразу после ввода.
		// Если да — возвращаем успех без ожидания dropdown.
		ПредставлениеСразуПослеВвода = ПредставлениеДанныхПоля(Поле);
		Если ПредставлениеСразуПослеВвода = Значение Или СтрНайти(ПредставлениеСразуПослеВвода, Значение) > 0 Тогда
			// Значение могло подтвердиться только временно в активном редакторе
			// поля. Для ссылочных полей web-клиента (например, ЕдиницаИзмерения в
			// карточке номенклатуры) ВвестиТекст("шт") может показать текст в
			// редакторе, но после ухода фокуса значение снова становится пустым,
			// если подходящего элемента справочника/списка выбора нет. Поэтому не
			// возвращаем success сразу: сначала даем dropdown-у сформироваться,
			// затем смещаем фокус и повторно проверяем уже закрепленное значение.
			НачалоПостОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Пока Не ОткрытВыпадающийСписокПоляMCP(Поле)
				И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПостОжидания < 1000 Цикл
				АктивноеОкноПослеВвода = ТестируемоеПриложение.ПолучитьАктивноеОкно();
				СвежееПолеПослеВвода = НайтиОбъектРекурсивно(АктивноеОкноПослеВвода, ИмяПоля, ЗаголовокПоля, "", 0);
				Если СвежееПолеПослеВвода <> Неопределено Тогда
					Поле = СвежееПолеПослеВвода;
				КонецЕсли;
			КонецЦикла;
			Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
				Попытка
					Поле.ОжидатьФормированияВыпадающегоСписка(3);
					Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
					Если Представления.Количество() > 0 Тогда
						ИндексВыбора = ИндексРелевантногоВариантаСпискаВыбораMCP(Представления, Значение);
						Если ИндексВыбора <> Неопределено Тогда
							ПредставлениеВыбираемогоВарианта = ПредставлениеВариантаСпискаВыбораMCP(Представления[ИндексВыбора]);
							Попытка
								Поле.ВыполнитьВыборИзСпискаВыбора(ПредставлениеВыбираемогоВарианта);
							Исключение
								Поле.ВыполнитьВыборИзСпискаВыбора(ИндексВыбора);
							КонецПопытки;
						Иначе
							Поле.ЗакрытьВыпадающийСписок();
						КонецЕсли;
					Иначе
						Поле.ЗакрытьВыпадающийСписок();
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Попытка
				ФормаПоляПослеБыстрогоВвода = НайтиРодительскуюФорму(Поле);
				Если ФормаПоляПослеБыстрогоВвода <> Неопределено Тогда
					ФормаПоляПослеБыстрогоВвода.ПерейтиКСледующемуЭлементу();
				КонецЕсли;
			Исключение
			КонецПопытки;

			ПредставлениеПослеЗакрепления = ПредставлениеДанныхПоля(Поле);
			НачалоПроверкиЗакрепления = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Пока Не (ПредставлениеПослеЗакрепления = Значение Или СтрНайти(ПредставлениеПослеЗакрепления, Значение) > 0)
				И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроверкиЗакрепления < 2000 Цикл
				АктивноеОкноПослеЗакрепления = ТестируемоеПриложение.ПолучитьАктивноеОкно();
				СвежееПолеПослеЗакрепления = НайтиОбъектРекурсивно(АктивноеОкноПослеЗакрепления, ИмяПоля, ЗаголовокПоля, "", 0);
				Если СвежееПолеПослеЗакрепления <> Неопределено Тогда
					Поле = СвежееПолеПослеЗакрепления;
				КонецЕсли;
				ПредставлениеПослеЗакрепления = ПредставлениеДанныхПоля(Поле);
			КонецЦикла;
			Если ПредставлениеПослеЗакрепления = Значение Или СтрНайти(ПредставлениеПослеЗакрепления, Значение) > 0 Тогда
				Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ВвестиТекст");
			КонецЕсли;

			НеподтвержденноеПредставлениеПослеВвода = ПредставлениеПослеЗакрепления;
		КонецЕсли;

		// Значение не изменилось — ждём, не откроется ли dropdown асинхронно.
		// Это характерно для ссылочных полей и полей с выбором из справочника.
		// На web-клиенте список может открыться асинхронно уже после возврата
		// ВвестиТекст(), поэтому коротко ждём именно факта открытия dropdown.
		НачалоОжиданияСписка = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока Не ОткрытВыпадающийСписокПоляMCP(Поле)
			И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжиданияСписка < 2000 Цикл
			АктивноеОкноПослеВвода = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			СвежееПолеПослеВвода = НайтиОбъектРекурсивно(АктивноеОкноПослеВвода, ИмяПоля, ЗаголовокПоля, "", 0);
			Если СвежееПолеПослеВвода <> Неопределено Тогда
				Поле = СвежееПолеПослеВвода;
			КонецЕсли;
		КонецЦикла;
		Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
			СписокСформирован = Ложь;
			Попытка
				СписокСформирован = Поле.ОжидатьФормированияВыпадающегоСписка(3);
			Исключение
			КонецПопытки;
			Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
			Если Представления.Количество() > 0 Тогда
				ИндексВыбора = ИндексРелевантногоВариантаСпискаВыбораMCP(Представления, Значение);
				Если ИндексВыбора = Неопределено Тогда
					ОтменитьРедактированиеПоляЕслиНужноMCP(Поле);
					ВызватьИсключение "Выпадающий список открыт, но релевантный вариант для значения " + Значение + " не найден. " + ПодсказкаСозданияСсылочногоЗначенияMCP(ИмяПоля, Значение);
				КонецЕсли;
				ПредставлениеВыбираемогоВарианта = ПредставлениеВариантаСпискаВыбораMCP(Представления[ИндексВыбора]);
				Попытка
					Поле.ВыполнитьВыборИзСпискаВыбора(ПредставлениеВыбираемогоВарианта);
				Исключение
					Поле.ВыполнитьВыборИзСпискаВыбора(ИндексВыбора);
				КонецПопытки;
				ВыбранноеПредставление = ПредставлениеДанныхПоля(Поле);
				Если ПустаяСтрока(ВыбранноеПредставление) Тогда
					ВыбранноеПредставление = ПредставлениеВыбираемогоВарианта;
				КонецЕсли;
				РезультатВыбора = Новый Структура("set,field,value,method,selected,dropdown_formed,dropdown_index", Истина, ИмяПоля, Значение, "ВвестиТекст+ВыполнитьВыборИзСпискаВыбора", ВыбранноеПредставление, СписокСформирован, ИндексВыбора);
				ДобавитьДиагностикуМодальногоОкнаЕслиОткрылосьMCP(РезультатВыбора, ЗаголовокОкнаДоВвода);
				Возврат РезультатВыбора;
			Иначе
				// Список выбора пуст — просто закрываем dropdown.
				Попытка
					Поле.ЗакрытьВыпадающийСписок();
				Исключение
				КонецПопытки;
				Ошибки.Добавить("Открытый выпадающий список пуст. " + ПодсказкаСозданияСсылочногоЗначенияMCP(ИмяПоля, Значение));
			КонецЕсли;
		КонецЕсли;

		// Смещаем фокус на следующий элемент, чтобы сработали обработчики
		// ПриИзменении() и платформа обновила представление данных.
		Попытка
			ФормаПоля = НайтиРодительскуюФорму(Поле);
			Если ФормаПоля <> Неопределено Тогда
				ФормаПоля.ПерейтиКСледующемуЭлементу();
			КонецЕсли;
		Исключение
		КонецПопытки;

		НачалоОжиданияВвода = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжиданияВвода < 2000 Цикл
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			СвежееПоле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0);
			Если СвежееПоле <> Неопределено Тогда
				Поле = СвежееПоле;
			КонецЕсли;
			ПредставлениеПослеВвода = ПредставлениеДанныхПоля(Поле);
			Если ПредставлениеПослеВвода = Значение Или СтрНайти(ПредставлениеПослеВвода, Значение) > 0 Тогда
				Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ВвестиТекст");
			КонецЕсли;
		КонецЦикла;

		// Текст введён, но представление не подтвердилось. Если dropdown сам
		// не открылся — не открываем его кодом, а возвращаем честную ошибку.
		НеподтвержденноеПредставлениеПослеВвода = ПредставлениеПослеВвода;
	Исключение
		Ошибки.Добавить("ВвестиТекст=" + ОписаниеОшибки());
	КонецПопытки;

	Если ТекстовыйВводВыполнен Тогда
		// Для полей выбора, особенно редакторов ячеек таблиц настроек, ВвестиТекст()
		// может не менять представление напрямую, но после этого остаются доступны
		// штатные методы выбора из списка/меню. Не отменяем редактирование сразу:
		// сначала пробуем choice/menu fallback-и ниже. Если они тоже не сработают,
		// финальный обработчик ошибок отменит редактирование ячейки через
		// ЗакончитьРедактированиеСтроки(Истина).
		Ошибки.Добавить("ВвестиТекст=выполнен, но значение не подтвердилось; текущее представление: " + НеподтвержденноеПредставлениеПослеВвода);
	КонецЕсли;

	// Переключатели/радиокнопки и поля со списком выбора: после активации
	// форма умеет выбирать значение из текущего открытого списка выбора.
	Попытка
		Поле.Активизировать();
		ФормаПоля = НайтиРодительскуюФорму(Поле);
		Если ФормаПоля = Неопределено Тогда
			ВызватьИсключение "Родительская форма не найдена";
		КонецЕсли;
		ФормаПоля.ВыполнитьВыборИзСписка(Значение);
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "Форма.ВыполнитьВыборИзСписка");
	Исключение
		Ошибки.Добавить("Форма.ВыполнитьВыборИзСписка=" + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Поле.Активизировать();
		ФормаПоля = НайтиРодительскуюФорму(Поле);
		Если ФормаПоля = Неопределено Тогда
			ВызватьИсключение "Родительская форма не найдена";
		КонецЕсли;
		ФормаПоля.ВыполнитьВыборИзМеню(Значение);
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "Форма.ВыполнитьВыборИзМеню");
	Исключение
		Ошибки.Добавить("Форма.ВыполнитьВыборИзМеню=" + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Поле.Активизировать();
		Поле.ВыполнитьВыборИзСписка(Значение);
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "Поле.ВыполнитьВыборИзСписка");
	Исключение
		Ошибки.Добавить("Поле.ВыполнитьВыборИзСписка=" + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Поле.Активизировать();
		Поле.ВыполнитьВыборИзМеню(Значение);
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "Поле.ВыполнитьВыборИзМеню");
	Исключение
		Ошибки.Добавить("Поле.ВыполнитьВыборИзМеню=" + ОписаниеОшибки());
	КонецПопытки;

	// Поля со стандартным выпадающим списком.
	Попытка
		Поле.ВыполнитьВыборИзСпискаВыбора(Значение);
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ВыполнитьВыборИзСпискаВыбора");
	Исключение
		Ошибки.Добавить("ВыполнитьВыборИзСпискаВыбора=" + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		ЗаголовокОкнаДоВыбора = БезопасноеСвойство(ТестируемоеПриложение.ПолучитьАктивноеОкно(), "Заголовок", "");
		Поле.ОткрытьВыпадающийСписок();
		Поле.ОжидатьФормированияВыпадающегоСписка(10);
		Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
		ИндексВыбора = ИндексВариантаСпискаВыбораMCP(Представления, Значение);
		Если ИндексВыбора = Неопределено Тогда
			Ошибки.Добавить("В открытом списке выбора нет значения '" + Строка(Значение) + "'. " + ПодсказкаСозданияСсылочногоЗначенияMCP(ИмяПоля, Значение));
			Поле.ВыполнитьВыборИзСпискаВыбора(Значение);
		Иначе
			Поле.ВыполнитьВыборИзСпискаВыбора(ИндексВыбора);
		КонецЕсли;
		ВыбранноеПредставление = ПредставлениеДанныхПоля(Поле);
		Если ПустаяСтрока(ВыбранноеПредставление) Тогда
			ВыбранноеПредставление = Значение;
		КонецЕсли;
		РезультатВыбора = Новый Структура("set,field,value,method,selected", Истина, ИмяПоля, Значение, "ОткрытьВыпадающийСписок+ВыполнитьВыборИзСпискаВыбора", ВыбранноеПредставление);
		ДобавитьДиагностикуМодальногоОкнаЕслиОткрылосьMCP(РезультатВыбора, ЗаголовокОкнаДоВыбора);
		Возврат РезультатВыбора;
	Исключение
		Ошибки.Добавить("ОткрытьВыпадающийСписок=" + ОписаниеОшибки());
	КонецПопытки;

	// Последние fallback-варианты для нестандартных тестируемых полей.
	Попытка
		Поле.Значение = Значение;
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "Значение");
	Исключение
		Ошибки.Добавить("Значение=" + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Поле.Текст = Значение;
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "Текст");
	Исключение
		Ошибки.Добавить("Текст=" + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Поле.УстановитьЗначение(Значение);
		Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "УстановитьЗначение");
	Исключение
		Ошибки.Добавить("УстановитьЗначение=" + ОписаниеОшибки());
	КонецПопытки;

	Если ОтменятьРедактированиеПриОшибке Тогда
		ОтменитьРедактированиеПоляЕслиНужноMCP(Поле);
	КонецЕсли;
	ФинальнаяПодсказка = "";
	Если ТекстовыйВводВыполнен Тогда
		ФинальнаяПодсказка = "; " + ПодсказкаСозданияСсылочногоЗначенияMCP(ИмяПоля, Значение);
	КонецЕсли;
	ВызватьИсключение "Не удалось установить поле " + ИмяПоля + ": " + СтрСоединить(Ошибки, "; ") + ФинальнаяПодсказка;
КонецФункции

&НаКлиенте
Функция ПредставлениеДанныхПоля(Поле)
	Попытка
		ПредставлениеДанных = Поле.ПолучитьПредставлениеДанных();
		Если Не ПустаяСтрока(ПредставлениеДанных) Тогда
			Возврат ПредставлениеДанных;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Возврат Поле.ПолучитьОтображаемыйТекст();
	Исключение
		Попытка
			Возврат Строка(БезопасноеСвойство(Поле, "Данные", ""));
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ЗначениеВариантаПереключателя(Поле, Представление)
	// ВыбратьВариант() ожидает значение элемента списка выбора, а не всегда
	// пользовательское представление. Для перечислений и других типизированных
	// значений строка "Основная" может не быть тем самым значением, хотя именно
	// она показывается пользователю.
	Попытка
		СписокВыбора = БезопасноеСвойство(Поле, "СписокВыбора", Неопределено);
		Если СписокВыбора <> Неопределено Тогда
			Для Каждого ЭлементСписка Из СписокВыбора Цикл
				ЗначениеВарианта = БезопасноеСвойство(ЭлементСписка, "Значение", Неопределено);
				ПредставлениеВарианта = БезопасноеСвойство(ЭлементСписка, "Представление", "");
				Если ПустаяСтрока(ПредставлениеВарианта) Тогда
					ПредставлениеВарианта = БезопасноеСвойство(ЭлементСписка, "Текст", "");
				КонецЕсли;
				Если ПустаяСтрока(ПредставлениеВарианта) И ЗначениеВарианта <> Неопределено Тогда
					ПредставлениеВарианта = Строка(ЗначениеВарианта);
				КонецЕсли;
				Если ПредставлениеВарианта = Представление Или Строка(ЗначениеВарианта) = Представление Тогда
					Возврат ЗначениеВарианта;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
		Для Каждого ВариантПредставления Из Представления Цикл
			Если ТипЗнч(ВариантПредставления) = Тип("Структура") Тогда
				ЗначениеВарианта = Неопределено;
				Если ВариантПредставления.Свойство("Значение", ЗначениеВарианта) Тогда
					ТекстВарианта = "";
					Если ВариантПредставления.Свойство("ПредставлениеДанных", ТекстВарианта) Или ВариантПредставления.Свойство("ОтображаемыйТекст", ТекстВарианта) Или ВариантПредставления.Свойство("Представление", ТекстВарианта) Тогда
						Если ТекстВарианта = Представление Тогда
							Возврат ЗначениеВарианта;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Представление;
КонецФункции

&НаКлиенте
Функция НайтиРодительскуюФорму(Объект)
	Текущий = Объект;
	Пока Текущий <> Неопределено Цикл
		Если НормализованноеИмяТипа(ТипЗнч(Текущий)) = "тестируемаяформа" Тогда
			Возврат Текущий;
		КонецЕсли;
		Попытка
			Текущий = Текущий.ПолучитьРодителя();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ВидГруппыФормы(Объект)
	Попытка
		Если Найти(НРег(Строка(ТипЗнч(Объект))), "тестируемаягруппаформы") = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Объект.Вид);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ЭтоСкрываемаяГруппа(Объект)
	Вид = ВидГруппыФормы(Объект);
	Возврат Вид = "ОбычнаяГруппа" Или Вид = "ГруппаКнопок";
КонецФункции

&НаКлиенте
Функция НайтиРодительскуюСтраницу(Объект)
	Текущий = Объект;
	Пока Текущий <> Неопределено Цикл
		Попытка
			Если Найти(НРег(Строка(ТипЗнч(Текущий))), "тестируемаягруппаформы") > 0 Тогда
				Вид = Строка(Текущий.Вид);
				Если Вид = "Страница" Тогда
					Возврат Текущий;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Текущий = Текущий.ПолучитьРодителя();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПроверитьАктивностьСтраницыРодителя(Объект)
	Страница = НайтиРодительскуюСтраницу(Объект);
	Если Страница = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяСтраницы = БезопасноеСвойство(Страница, "Имя", "");
	ЗаголовокСтраницы = БезопасныйЗаголовок(Страница);
	РодительСтраницы = Неопределено;
	Попытка
		РодительСтраницы = Страница.ПолучитьРодителя();
	Исключение
	КонецПопытки;
	Если РодительСтраницы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекущаяСтраница = Неопределено;
	Попытка
		ТекущаяСтраница = РодительСтраницы.ПолучитьТекущуюСтраницу();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТекущаяСтраница = Страница Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяТекущей = БезопасноеСвойство(ТекущаяСтраница, "Имя", "");
	ТекстОшибки = "Элемент находится на неактивной странице '" + ?(ПустаяСтрока(ЗаголовокСтраницы), ИмяСтраницы, ЗаголовокСтраницы) + "'";
	Если Не ПустаяСтрока(ИмяТекущей) Тогда
		ТекстОшибки = ТекстОшибки + ". Активная страница: '" + ИмяТекущей + "'";
	КонецЕсли;
	ТекстОшибки = ТекстОшибки + ". Активируйте страницу '" + ?(ПустаяСтрока(ЗаголовокСтраницы), ИмяСтраницы, ЗаголовокСтраницы) + "' через focus_object";
	Возврат ТекстОшибки;
КонецФункции
&НаКлиенте
Функция АктивизироватьПоле(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ?(ИскатьПоЗаголовку, ИмяПоля, ""), "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;
	Если ВидГруппыФормы(Поле) <> "Страница" Тогда
		ОшибкаАктивности = ПроверитьАктивностьСтраницыРодителя(Поле);
		Если ОшибкаАктивности <> Неопределено Тогда
			ВызватьИсключение ОшибкаАктивности;
		КонецЕсли;
	КонецЕсли;
	Поле.Активизировать();
	Возврат Новый Структура("activated,field", Истина, ИмяПоля);
КонецФункции

&НаКлиенте
Функция ВыбратьПолеИзСпискаMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ?(ИскатьПоЗаголовку, ИмяПоля, ""), "", 0);
	Если Поле = Неопределено Тогда
		Попытка
			Поле = ТестируемоеПриложение.ПолучитьОбъект(Неопределено, ?(ИскатьПоЗаголовку, ИмяПоля, ""), ИмяПоля, 2);
		Исключение
			Поле = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;
	Поле.Активизировать();
