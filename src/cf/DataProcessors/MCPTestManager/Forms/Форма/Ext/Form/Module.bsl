		ТекстЯчейки = Таблица.ПолучитьТекстЯчейки("Доступные поля");
		Если Не ПустаяСтрока(ТекстЯчейки) Тогда Возврат ТекстЯчейки; КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		ТекстЯчейки = Таблица.ПолучитьТекстЯчейки("Доступное поле");
		Если Не ПустаяСтрока(ТекстЯчейки) Тогда Возврат ТекстЯчейки; КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		ТекстЯчейки = Таблица.ПолучитьТекстЯчейки("Заголовок");
		Если Не ПустаяСтрока(ТекстЯчейки) Тогда Возврат ТекстЯчейки; КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ТекстИзТекущейСтрокиДоступныхПолейMCP(Таблица);
КонецФункции

&НаКлиенте
Функция ТекстыПоляСовпадаютMCP(Факт, Ожидание)
	ФактНорм = НРег(СокрЛП(Строка(Факт)));
	ОжиданиеНорм = НРег(СокрЛП(Строка(Ожидание)));
	Если ПустаяСтрока(ОжиданиеНорм) Тогда Возврат Ложь; КонецЕсли;
	Возврат ФактНорм = ОжиданиеНорм
		Или ФактНорм = НРег("(" + ОжиданиеНорм + ")")
		Или Прав(ФактНорм, СтрДлина("." + ОжиданиеНорм)) = "." + ОжиданиеНорм;
КонецФункции

&НаКлиенте
Функция ПерейтиКДоступномуПолюНастроекСпискаMCP(Таблица, Поле, Лимит)
	Искомое = СокрЛП(Строка(Поле));
	Если ПустаяСтрока(Искомое) Тогда
		Возврат Новый Структура("found,index,text,rows_checked", Ложь, Неопределено, "", 0);
	КонецЕсли;
	Попытка
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
	Исключение
		Возврат Новый Структура("found,index,text,rows_checked,error", Ложь, Неопределено, "", 0, ОписаниеОшибки());
	КонецПопытки;
	ПервоеЧастичное = Новый Структура("found,index,text,rows_checked", Ложь, Неопределено, "", 0);
	ПредыдущееЗначение = "";
	ПовторыБезСмещения = 0;
	ПустыхСтрокПодряд = 0;
	Для Индекс = 0 По Лимит - 1 Цикл
		ТекстПоля = ТекстТекущегоДоступногоПоляНастроекСпискаMCP(Таблица);
		Если ПустаяСтрока(ТекстПоля) Тогда
			ПустыхСтрокПодряд = ПустыхСтрокПодряд + 1;
			Если ПустыхСтрокПодряд >= 20 Тогда Прервать; КонецЕсли;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
			Продолжить;
		КонецЕсли;
		ПустыхСтрокПодряд = 0;
		Если ТекстыПоляСовпадаютMCP(ТекстПоля, Искомое) Тогда
			Возврат Новый Структура("found,index,text,rows_checked,match", Истина, Индекс, ТекстПоля, Индекс + 1, "exact");
		КонецЕсли;
		Если Не ПервоеЧастичное.found И СтрНайти(НРег(ТекстПоля), НРег(Искомое)) > 0 Тогда
			ПервоеЧастичное = Новый Структура("found,index,text,rows_checked,match", Истина, Индекс, ТекстПоля, Индекс + 1, "contains");
		КонецЕсли;
		Если ТекстПоля = ПредыдущееЗначение Тогда
			ПовторыБезСмещения = ПовторыБезСмещения + 1;
			Если ПовторыБезСмещения >= 5 Тогда Прервать; КонецЕсли;
		Иначе
			ПредыдущееЗначение = ТекстПоля;
			ПовторыБезСмещения = 0;
		КонецЕсли;
		Попытка
			Таблица.ПерейтиКСледующейСтроке();
		Исключение
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Если ПервоеЧастичное.found Тогда
		Попытка
			Таблица.ПерейтиКПервойСтроке();
			Для НомерШага = 1 По ПервоеЧастичное.index Цикл
				Таблица.ПерейтиКСледующейСтроке();
			КонецЦикла;
		Исключение
		КонецПопытки;
		Возврат ПервоеЧастичное;
	КонецЕсли;
	Возврат Новый Структура("found,index,text,rows_checked", Ложь, Неопределено, "", Лимит);
КонецФункции

&НаКлиенте
Функция АктивизироватьТекущуюСтрокуНастройкиСпискаMCP(Таблица, ТекущаяСтрока)
	Результат = Новый Структура("activated,errors", Ложь, Новый Массив);
	Попытка
		Если ТекущаяСтрока <> Неопределено Тогда
			Таблица.ПерейтиКСтроке(ТекущаяСтрока);
		КонецЕсли;
	Исключение
		Результат.errors.Добавить("ПерейтиКСтроке: " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Если ТекущаяСтрока <> Неопределено Тогда
			Таблица.СнятьВыделениеВсехСтрок();
			Таблица.ВыделитьСтроку(ТекущаяСтрока);
		КонецЕсли;
	Исключение
		Результат.errors.Добавить("ВыделитьСтроку: " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Таблица.Выбрать();
		Результат.activated = Истина;
	Исключение
		// Выбрать() может открывать отдельный редактор/диалог или быть недоступным;
		// это не fatal, если смена строки уже произошла.
		Результат.errors.Добавить("Выбрать: " + ОписаниеОшибки());
	КонецПопытки;
	Если Не Результат.activated Тогда
		Попытка
			Таблица.Активизировать();
			Результат.activated = Истина;
		Исключение
			Результат.errors.Добавить("Активизировать: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПерейтиКСтрокеНастройкиСпискаПоПолюMCP(Таблица, Поле, Лимит)
	Искомое = СокрЛП(Строка(Поле));
	Если ПустаяСтрока(Искомое) Тогда
		Возврат Новый Структура("found,index,rows_checked", Ложь, Неопределено, 0);
	КонецЕсли;
	Попытка
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
	Исключение
		Возврат Новый Структура("found,index,rows_checked,error", Ложь, Неопределено, 0, ОписаниеОшибки());
	КонецПопытки;
	ПервоеЧастичное = Новый Структура("found,index,rows_checked", Ложь, Неопределено, 0);
	ПредыдущаяСтрокаJSON = "";
	ПовторыБезСмещения = 0;
	Для Индекс = 0 По Лимит - 1 Цикл
		Попытка
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			Если ТекущаяСтрока = Неопределено Тогда Прервать; КонецЕсли;
			СтруктураСтроки = СоответствиеВСтруктуру(ТекущаяСтрока);
			ЗначениеПоля = ЗначениеПарыСтрокиMCP(СтруктураСтроки, "Поле");
			Если ТекстыПоляСовпадаютMCP(ЗначениеПоля, Искомое) Тогда
				АктивацияСтроки = АктивизироватьТекущуюСтрокуНастройкиСпискаMCP(Таблица, ТекущаяСтрока);
				Возврат Новый Структура("found,index,rows_checked,field,activation", Истина, Индекс, Индекс + 1, ЗначениеПоля, АктивацияСтроки);
			КонецЕсли;
			Если Не ПервоеЧастичное.found И Не ПустаяСтрока(ЗначениеПоля) И СтрНайти(НРег(ЗначениеПоля), НРег(Искомое)) > 0 Тогда
				ПервоеЧастичное = Новый Структура("found,index,rows_checked,field", Истина, Индекс, Индекс + 1, ЗначениеПоля);
			КонецЕсли;
			СтрокаJSON = ЗначениеВJSON(СтруктураСтроки);
			Если СтрокаJSON = ПредыдущаяСтрокаJSON Тогда
				ПовторыБезСмещения = ПовторыБезСмещения + 1;
				Если ПовторыБезСмещения >= 5 Тогда Прервать; КонецЕсли;
			Иначе
				ПредыдущаяСтрокаJSON = СтрокаJSON;
				ПовторыБезСмещения = 0;
			КонецЕсли;
		Исключение
			Возврат Новый Структура("found,index,rows_checked,error", Ложь, Неопределено, Индекс, ОписаниеОшибки());
		КонецПопытки;
		Попытка
			Таблица.ПерейтиКСледующейСтроке();
		Исключение
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Если ПервоеЧастичное.found Тогда
		Попытка
			Таблица.ПерейтиКПервойСтроке();
			Для НомерШага = 1 По ПервоеЧастичное.index Цикл
				Таблица.ПерейтиКСледующейСтроке();
			КонецЦикла;
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			ПервоеЧастичное.Вставить("activation", АктивизироватьТекущуюСтрокуНастройкиСпискаMCP(Таблица, ТекущаяСтрока));
		Исключение
			ПервоеЧастичное.found = Ложь;
			ПервоеЧастичное.Вставить("reposition_error", ОписаниеОшибки());
		КонецПопытки;
		Возврат ПервоеЧастичное;
	КонецЕсли;
	Возврат Новый Структура("found,index,rows_checked", Ложь, Неопределено, Лимит);
КонецФункции

&НаКлиенте
Функция ЗначениеПарыСтрокиMCP(СтрокаТаблицы, ИмяКолонки)
	Если СтрокаТаблицы = Неопределено Тогда Возврат ""; КонецЕсли;
	Если СтрокаТаблицы.Свойство("pairs") Тогда
		Для Каждого Пара Из СтрокаТаблицы.pairs Цикл
			Если Пара.Свойство("key") И Пара.Свойство("value") И (ПустаяСтрока(ИмяКолонки) Или Пара.key = ИмяКолонки) Тогда
				Возврат Строка(Пара.value);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Функция ЛегкаяСтрокаДоступногоПоляНастроекСпискаMCP(ЗначениеПоля)
	Результат = Новый Структура;
	Результат.Вставить("available", Истина);
	Результат.Вставить("pairs", Новый Массив);
	Результат.pairs.Добавить(Новый Структура("key,value", "Доступные поля", ЗначениеПоля));
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьДоступныеПоляНастроекСпискаMCP(Таблица, Лимит, РазворачиватьДерево)
	// Форма настроек списка содержит большое дерево СКД. Для списка доступных
	// полей не сериализуем строки и не вызываем Видимость()/Доступность()/
	// ПолучитьПредставлениеДанных(): читаем только текст текущей ячейки
	// "Доступные поля". Разворачивание дерева отключено по умолчанию на уровне
	// Python tool и даже при явном expand_tree=True ограничено отдельным
	// бюджетом, потому что ВозможноРазвернуть()/Развернут()/Развернуть() на
	// живых web-базах заметно дороже простого чтения строки.
	Ошибки = Новый Массив;
	Поля = Новый Массив;
	Уникальные = Новый Соответствие;
	Таймаут = Ложь;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МаксДлительностьМС = 5000;
	МаксРазворачиваний = ?(РазворачиватьДерево, 50, 1);
	Разворачиваний = 0;
	Попытка
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
	Исключение
		Ошибки.Добавить("Активизировать/ПерейтиКПервойСтроке: " + ОписаниеОшибки());
		РезультатПустой = Новый Структура("fields,count,errors,timeout", Поля, 0, Ошибки, Ложь);
		РезультатПустой.Вставить("expanded", Разворачиваний);
		Возврат РезультатПустой;
	КонецПопытки;

	ПредыдущееЗначение = "";
	ПовторыБезСмещения = 0;
	ПустыхСтрокПодряд = 0;
	ПросмотреноСтрок = 0;
	Пока Поля.Количество() < Лимит И ПросмотреноСтрок < Лимит * 5 Цикл
		ПросмотреноСтрок = ПросмотреноСтрок + 1;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > МаксДлительностьМС Тогда
			Таймаут = Истина;
			Ошибки.Добавить("available_fields traversal timeout after " + Строка(МаксДлительностьМС) + " ms; returned partial result");
			Прервать;
		КонецЕсли;
		Попытка
			Если Разворачиваний < МаксРазворачиваний Тогда
				Попытка
					Если Таблица.ВозможноРазвернуть() И Не Таблица.Развернут() Тогда
						Таблица.Развернуть();
						Разворачиваний = Разворачиваний + 1;
					КонецЕсли;
				Исключение
					// Разворачивание отдельных узлов не обязательно для результата.
				КонецПопытки;
			КонецЕсли;
			ЗначениеПоля = "";
			ЗначениеПоля = ТекстТекущегоДоступногоПоляНастроекСпискаMCP(Таблица);
			Если ПустаяСтрока(ЗначениеПоля) Тогда
				ПустыхСтрокПодряд = ПустыхСтрокПодряд + 1;
				Если ПустыхСтрокПодряд >= 20 Тогда Прервать; КонецЕсли;
				Попытка
					Таблица.ПерейтиКСледующейСтроке();
				Исключение
					Прервать;
				КонецПопытки;
				Продолжить;
			КонецЕсли;
			ПустыхСтрокПодряд = 0;
			Если ЗначениеПоля = ПредыдущееЗначение Тогда
				ПовторыБезСмещения = ПовторыБезСмещения + 1;
				Если ПовторыБезСмещения >= 5 Тогда Прервать; КонецЕсли;
			Иначе
				ПовторыБезСмещения = 0;
				ПредыдущееЗначение = ЗначениеПоля;
			КонецЕсли;
			Если Уникальные[ЗначениеПоля] = Неопределено Тогда
				Уникальные.Вставить(ЗначениеПоля, Истина);
				Элемент = Новый Структура;
				Элемент.Вставить("title", ЗначениеПоля);
				Элемент.Вставить("presentation", ЗначениеПоля);
				Элемент.Вставить("row", ЛегкаяСтрокаДоступногоПоляНастроекСпискаMCP(ЗначениеПоля));
				Поля.Добавить(Элемент);
			КонецЕсли;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		Исключение
			Ошибки.Добавить(ОписаниеОшибки());
			Прервать;
		КонецПопытки;
	КонецЦикла;
	РезультатПолей = Новый Структура("fields,count,errors,timeout", Поля, Поля.Количество(), Ошибки, Таймаут);
	РезультатПолей.Вставить("expanded", Разворачиваний);
	Возврат РезультатПолей;
КонецФункции

&НаКлиенте
Функция ДоступныеПоляНастроекДинамическогоСпискаMCP(Параметры)
	Раздел = СвойствоСтруктуры(Параметры, "section", СвойствоСтруктуры(Параметры, "kind", "filter"));
	Лимит = СвойствоСтруктуры(Параметры, "limit", 500);
	РазворачиватьДерево = СвойствоСтруктуры(Параметры, "expand_tree", Истина);
	Закрывать = СвойствоСтруктуры(Параметры, "close", Ложь);
	Открытие = ОбеспечитьОкноНастроекСпискаMCP(Параметры);
	Активация = АктивироватьРазделНастроекСпискаMCP(Раздел);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = ИмяТаблицыДоступныхПолейНастроекСпискаMCP(Раздел);
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "Доступные поля", 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,section,table,error,open,activate", Ложь, Раздел, ИмяТаблицы, "Таблица доступных полей не найдена", Открытие, Активация);
	КонецЕсли;
	Поля = ПолучитьДоступныеПоляНастроекСпискаMCP(Таблица, Лимит, РазворачиватьДерево);
	Если Закрывать Тогда
		Попытка ЗакрытьФорму(); Исключение КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("found,section,section_title,table,fields,count,errors,timeout,expanded,open,activate", Истина, Раздел, ЗаголовокЭлементаНастроекСпискаMCP(Раздел), ИмяТаблицы, Поля.fields, Поля.count, Поля.errors, Поля.timeout, СвойствоСтруктуры(Поля, "expanded", 0), Открытие, Активация);
КонецФункции

&НаКлиенте
Функция НормализоватьНаправлениеСортировкиMCP(Направление)
	НормНаправление = НРег(СокрЛП(Строка(Направление)));
	Если ПустаяСтрока(НормНаправление) Тогда
		Возврат "";
	КонецЕсли;
	Если НормНаправление = "asc" Или НормНаправление = "ascending" Или НормНаправление = "возр" Или НормНаправление = "возрастание" Или НормНаправление = "по возрастанию" Тогда
		Возврат "По возрастанию";
	КонецЕсли;
	Если НормНаправление = "desc" Или НормНаправление = "descending" Или НормНаправление = "убыв" Или НормНаправление = "убывание" Или НормНаправление = "по убыванию" Тогда
		Возврат "По убыванию";
	КонецЕсли;
	Возврат Строка(Направление);
КонецФункции

&НаКлиенте
Функция НайтиФормуРодителяMCP(Объект)
	Пока Объект <> Неопределено Цикл
		Попытка
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Объект)));
			Если ТипТек = "тестируемаяформа" Тогда
				Возврат Объект;
			КонецЕсли;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		Попытка
			Объект = Объект.ПолучитьРодителя();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ДобавитьЭлементНастройкиСпискаMCP(Раздел, Поле, Значение, ВидСравнения, Направление)
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = ИмяТаблицыЭлементовНастроекСпискаMCP(Раздел);
	Ошибки = Новый Массив;

	// Правильный путь добавления настройки: на вкладке раздела выбрать нужное поле
	// в дереве "Доступные поля" и нажать кнопку "Выбрать", которая добавляет
	// выбранное поле в таблицу настроек текущего раздела. Не создаём пустую строку
	// и не пытаемся ввести поле текстом: колонка "Поле" в таблицах компоновщика —
	// это поле выбора, и ВвестиТекст() для него не работает.

	// 1. Найти таблицу доступных полей текущего раздела.
	ИмяТаблицыДоступных = ИмяТаблицыДоступныхПолейНастроекСпискаMCP(Раздел);
	ТаблицаДоступных = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицыДоступных, "Доступные поля", 0);
	Если ТаблицаДоступных = Неопределено Тогда
		Ошибки.Добавить("Таблица доступных полей не найдена: " + ИмяТаблицыДоступных);
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецЕсли;

	// 2. Перейти к строке с нужным полем в дереве доступных полей.
	РезультатПоиска = ПерейтиКДоступномуПолюНастроекСпискаMCP(ТаблицаДоступных, Поле, 500);
	Если Не РезультатПоиска.found Тогда
		Ошибки.Добавить("Поле '" + Поле + "' не найдено в доступных полях раздела " + ЗаголовокЭлементаНастроекСпискаMCP(Раздел) + "; checked=" + Строка(СвойствоСтруктуры(РезультатПоиска, "rows_checked", 0)));
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецЕсли;

	// 3. Нажать кнопку "Выбрать", которая добавляет выбранное поле в таблицу настроек.
	// Ищем кнопку строго в родительской группе таблицы доступных полей, а не по всему
	// окну: рекурсивный обход всего окна настроек списка (дерево компоновщика) может
	// занимать десятки секунд.
	КнопкаВыбрать = Неопределено;
	Попытка
		РодительДоступных = ТаблицаДоступных.ПолучитьРодителя();
		Если РодительДоступных <> Неопределено Тогда
			КнопкаВыбрать = НайтиКнопку(РодительДоступных, "", "Выбрать", 0);
			Если КнопкаВыбрать = Неопределено Тогда
				КнопкаВыбрать = НайтиКнопку(РодительДоступных, "КомпоновщикНастроекПользовательскиеНастройкиВыбрать", "", 0);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Ошибки.Добавить("Поиск кнопки 'Выбрать': " + ОписаниеОшибки());
	КонецПопытки;
	Если КнопкаВыбрать = Неопределено Тогда
		Ошибки.Добавить("Кнопка 'Выбрать' для добавления поля не найдена");
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецЕсли;
	Попытка
		КнопкаВыбрать.Нажать();
	Исключение
		Ошибки.Добавить("Нажать 'Выбрать': " + ОписаниеОшибки());
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецПопытки;

	// После выбора форма перестраивается, поэтому искать таблицу нужно уже в
	// текущем активном окне, а не в объекте, взятом до клика.
	Попытка
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Исключение
	КонецПопытки;

	// 4. Найти добавленную строку настроек и заполнить параметры раздела.
	ЗаголовокТаблицыЭлементов = ЗаголовокТаблицыЭлементовНастроекСпискаMCP(Раздел);
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицыЭлементов, 0);
	Если Таблица = Неопределено И Не ПустаяСтрока(ЗаголовокТаблицыЭлементов) Тогда
		Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
	КонецЕсли;
	Если Таблица = Неопределено Тогда
		Ошибки.Добавить("Таблица элементов настройки не найдена после добавления поля: " + ИмяТаблицы);
	Иначе
		Попытка
			Таблица.Активизировать();
		Исключение
			Ошибки.Добавить("Активизировать таблицу элементов настройки: " + ОписаниеОшибки());
		КонецПопытки;

		// После добавления через дерево доступных полей web-клиент не всегда
		// оставляет текущей именно добавленную строку. Перед установкой значения
		// обязательно позиционируемся на строке с нужным полем, иначе второй
		// отбор может записать значение в предыдущий элемент настройки.
		ПозиционированиеСтроки = ПерейтиКСтрокеНастройкиСпискаПоПолюMCP(Таблица, Поле, 200);
		Если Не СвойствоСтруктуры(ПозиционированиеСтроки, "found", Ложь) Тогда
			Ошибки.Добавить("Добавленная строка настройки для поля '" + Поле + "' не найдена; checked=" + Строка(СвойствоСтруктуры(ПозиционированиеСтроки, "rows_checked", 0)));
		ИначеЕсли НомерЭлементаНастроекСпискаMCP(Раздел) = 0 Тогда
			// Для отбора здесь только добавляем строку через "Доступные поля".
			// Колонки "Вид сравнения" и "Значение" заполняются отдельным проходом
			// после добавления всех строк отбора, через table_goto_row + table_set_field.
			// Quick-поля формы здесь не используем.
		ИначеЕсли НомерЭлементаНастроекСпискаMCP(Раздел) = 1 И Не ПустаяСтрока(Направление) Тогда
			// После добавления поля через "Выбрать" платформа сама выставляет
			// направление по умолчанию. Если нужно не оно — меняем именно в режиме
			// редактирования текущей строки таблицы настроек или через быстрые поля
			// группы порядка, если таблица СКД на web-клиенте не редактируется.
			ЦелевоеНаправление = НормализоватьНаправлениеСортировкиMCP(Направление);
			ТекущееНаправление = ТекущееЗначениеПоляНастройкиСпискаMCP(Таблица, ИмяТаблицы, "Направление");
			Если Не (ПустаяСтрока(ТекущееНаправление) И ЦелевоеНаправление = "По возрастанию") И (ПустаяСтрока(ТекущееНаправление) Или ТекущееНаправление <> ЦелевоеНаправление) Тогда
				ВариантыНаправления = Новый Массив;
				ВариантыНаправления.Добавить(Направление);
				Если ЦелевоеНаправление <> Направление Тогда
					ВариантыНаправления.Добавить(ЦелевоеНаправление);
				КонецЕсли;
				НаправлениеУстановлено = Ложь;
				Для Каждого ВариантНаправления Из ВариантыНаправления Цикл
					Если НаправлениеУстановлено Тогда
						Прервать;
					КонецЕсли;

					// Live-проверенный путь для таблицы порядка СКД: ровно тот же table-editor
					// сценарий, что использует tool table_set_field. Он входит в edit-mode,
					// активизирует колонку "Направление сортировки", вводит текст в editor,
					// выбирает вариант выпадающего списка и подтверждает значение в текущей
					// строке формы настроек. Это не post-close fallback на динамический список.
					ЛокальныеОшибкиНаправления = Новый Массив;
					Попытка
						ПараметрыНаправления = Новый Структура("table,field,value,search_by_title", ИмяТаблицы, "Направление сортировки", ВариантНаправления, Истина);
						РезультатНаправления = УстановитьПолеТаблицыMCP(ПараметрыНаправления);
						Если СвойствоСтруктуры(РезультатНаправления, "set", Ложь) Тогда
							НаправлениеУстановлено = Истина;
							Прервать;
						КонецЕсли;
						ЛокальныеОшибкиНаправления.Добавить("table_set_field returned set=false");
					Исключение
						ЛокальныеОшибкиНаправления.Добавить("table_set_field direction: " + ОписаниеОшибки());
					КонецПопытки;
				КонецЦикла;
				Если Не НаправлениеУстановлено Тогда
					Ошибки.Добавить("Направление сортировки для поля '" + Поле + "' не установлено в форме настроек: " + СтрСоединить(ЛокальныеОшибкиНаправления, "; "));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Попытка
			Если ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
				Таблица.ЗакончитьРедактированиеСтроки(Ложь);
			КонецЕсли;
		Исключение
			Ошибки.Добавить("Завершить редактирование строки настройки: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ошибки.Количество() = 0, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
КонецФункции



&НаКлиенте
Функция ТекущаяСтрокаНастройкиУжеСодержитЗначениеMCP(Таблица, ИмяКолонки, Значение, ИскатьПоЗаголовку)
	Попытка
		Проверка = ЗначениеКолонкиТекущейСтрокиMCP(Таблица, ИмяКолонки, ИскатьПоЗаголовку);
		Если СвойствоСтруктуры(Проверка, "found", Ложь) И ЗначенияСовпадаютДляПроверкиMCP(СвойствоСтруктуры(Проверка, "value", ""), Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция УстановитьКолонкуСтрокиНастройкиСпискаВТаблицеMCP(Таблица, ИмяТаблицы, Раздел, ПолеНастройки, ИмяКолонки, Значение, ИскатьПоЗаголовку, Ошибки)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		// После commit editor-а активный объект формы настроек СКД может быть уже не
		// таблицей. Перед каждым вводом заново активируем нужный раздел, находим
		// таблицу элементов настройки и позиционируемся на строку по колонке "Поле".
		АктивироватьРазделНастроекСпискаMCP(Раздел);
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		ЗаголовокТаблицыЭлементов = ЗаголовокТаблицыЭлементовНастроекСпискаMCP(Раздел);
		РабочаяТаблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
		Если РабочаяТаблица = Неопределено Тогда
			Если Таблица <> Неопределено Тогда
				РабочаяТаблица = Таблица;
			Иначе
				Если Ошибки <> Неопределено Тогда Ошибки.Добавить("Таблица элементов настройки не найдена перед вводом колонки '" + ИмяКолонки + "': " + ИмяТаблицы); КонецЕсли;
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		// После предыдущего table-editor commit web-клиент 8.5 иногда оставляет таблицу
		// в промежуточном состоянии, где навигация ПерейтиКПервойСтроке() запрещена.
		// Перед повторением live-проверенной связки table_goto_row + table_set_field
		// явно завершаем/сбрасываем редактирование, если оно ещё висит.
		Попытка
			Если ТаблицаВРежимеРедактированияMCP(РабочаяТаблица) Тогда
				РабочаяТаблица.ЗакончитьРедактированиеСтроки(Ложь);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			РабочаяТаблица.Активизировать();
		Исключение
		КонецПопытки;
		// Повторяем live-проверенную связку table_goto_row + table_set_field:
		// сначала находим строку через общий table_goto logic по тексту поля, затем
		// используем table_set_field logic для ввода значения в колонку.
		ПараметрыПерехода = Новый Структура("name,title,text,limit", ИмяТаблицы, "", ПолеНастройки, 200);
		ПозиционированиеСтроки = ПерейтиКСтрокеТаблицыMCP(ПараметрыПерехода);
		Если Не СвойствоСтруктуры(ПозиционированиеСтроки, "found", Ложь) Тогда
			Если Ошибки <> Неопределено Тогда Ошибки.Добавить("Строка настройки для поля '" + ПолеНастройки + "' не найдена перед вводом колонки '" + ИмяКолонки + "'; checked=" + Строка(СвойствоСтруктуры(ПозиционированиеСтроки, "rows_checked", 0)) + ?(ПозиционированиеСтроки.Свойство("error"), "; error=" + ПозиционированиеСтроки.error, "")); КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
		Если ТекущаяСтрокаНастройкиУжеСодержитЗначениеMCP(РабочаяТаблица, ИмяКолонки, Значение, ИскатьПоЗаголовку) Тогда
			Возврат Истина;
		КонецЕсли;
		ПараметрыКолонки = Новый Структура("table,field,value,search_by_title", ИмяТаблицы, ИмяКолонки, Значение, ИскатьПоЗаголовку);
		РезультатКолонки = УстановитьПолеТаблицыMCP(ПараметрыКолонки);
		Если СвойствоСтруктуры(РезультатКолонки, "set", Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
		Если Ошибки <> Неопределено Тогда Ошибки.Добавить("Колонка '" + ИмяКолонки + "' для поля '" + ПолеНастройки + "' не установлена через table-editor: set=false"); КонецЕсли;
	Исключение
		Если Ошибки <> Неопределено Тогда Ошибки.Добавить("Колонка '" + ИмяКолонки + "' для поля '" + ПолеНастройки + "' не установлена через table-editor: " + ОписаниеОшибки()); КонецЕсли;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция УстановитьКолонкуСтрокиНастройкиСпискаЧерезТаблицуMCP(Раздел, ПолеНастройки, ИмяКолонки, Значение, ИскатьПоЗаголовку, Ошибки)
	ИмяТаблицы = ИмяТаблицыЭлементовНастроекСпискаMCP(Раздел);
	Возврат УстановитьКолонкуСтрокиНастройкиСпискаВТаблицеMCP(Неопределено, ИмяТаблицы, Раздел, ПолеНастройки, ИмяКолонки, Значение, ИскатьПоЗаголовку, Ошибки);
КонецФункции

&НаКлиенте
Функция ТекущееЗначениеПоляНастройкиСпискаMCP(Таблица, ИмяТаблицы, ИмяПоля)
	Попытка
		Проверка = ЗначениеКолонкиТекущейСтрокиMCP(Таблица, ИмяПоля, Ложь);
		Если СвойствоСтруктуры(Проверка, "found", Ложь) И Не ПустаяСтрока(СвойствоСтруктуры(Проверка, "value", "")) Тогда
			Возврат СвойствоСтруктуры(Проверка, "value", "");
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		Если ТекущаяСтрока <> Неопределено Тогда
			СтруктураСтроки = СоответствиеВСтруктуру(ТекущаяСтрока);
			ВозможныеИмена = Новый Массив;
			ВозможныеИмена.Добавить(ИмяПоля);
			Если СтрНайти(НРег(ИмяПоля), "направ") > 0 Или СтрНайти(НРег(ИмяПоля), "упорядоч") > 0 Тогда
				ВозможныеИмена.Добавить("Направление сортировки");
				ВозможныеИмена.Добавить("Направление");
				ВозможныеИмена.Добавить("Тип упорядочивания");
				ВозможныеИмена.Добавить("ТипУпорядочивания");
			КонецЕсли;
			Для Каждого ИмяКолонки Из ВозможныеИмена Цикл
				ЗначениеКолонки = ЗначениеПарыСтрокиMCP(СтруктураСтроки, ИмяКолонки);
				Если Не ПустаяСтрока(ЗначениеКолонки) Тогда
					Возврат ЗначениеКолонки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции

&НаКлиенте
Функция КандидатыПолейЭлементаНастройкиСпискаMCP(ИмяТаблицы, ИмяПоля)
	Кандидаты = Новый Массив;
	Если Не ПустаяСтрока(ИмяТаблицы) И Не ПустаяСтрока(ИмяПоля) Тогда
		Кандидаты.Добавить(ИмяТаблицы + ИмяПоля);
	КонецЕсли;
	Кандидаты.Добавить(ИмяПоля);
	НормИмяПоля = НРег(Строка(ИмяПоля));
	Если СтрНайти(НормИмяПоля, "значение") > 0 Или НормИмяПоля = "правоезначение" Тогда
		Кандидаты.Добавить(ИмяТаблицы + "ПравоеЗначение");
		Кандидаты.Добавить(ИмяТаблицы + "Значение");
		Кандидаты.Добавить("ПравоеЗначение");
		Кандидаты.Добавить("Значение");
	ИначеЕсли СтрНайти(НормИмяПоля, "сравнен") > 0 Тогда
		Кандидаты.Добавить(ИмяТаблицы + "ВидСравнения");
		Кандидаты.Добавить(ИмяТаблицы + "Вид сравнения");
		Кандидаты.Добавить("ВидСравнения");
		Кандидаты.Добавить("Вид сравнения");
	ИначеЕсли СтрНайти(НормИмяПоля, "направ") > 0 Или СтрНайти(НормИмяПоля, "упорядоч") > 0 Тогда
		Кандидаты.Добавить(ИмяТаблицы + "ТипУпорядочивания");
		Кандидаты.Добавить(ИмяТаблицы + "ПорядокТипУпорядочивания");
		Кандидаты.Добавить(ИмяТаблицы + "Направление");
		Кандидаты.Добавить("ТипУпорядочивания");
		Кандидаты.Добавить("Направление");
		Кандидаты.Добавить("Направление сортировки");
	КонецЕсли;
	Возврат Кандидаты;
КонецФункции

&НаКлиенте
Функция УстановитьПолеЭлементаНастройкиСпискаMCP(Таблица, ИмяТаблицы, ИмяПоля, Значение, Ошибки)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Истина;
	КонецЕсли;

	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ФормаНастроек = НайтиФормуРодителяMCP(Таблица);
	Если ФормаНастроек = Неопределено Тогда
		ФормаНастроек = АктивноеОкно;
	КонецЕсли;

	ЭтоНаправлениеПорядкаКомпоновщика = Лев(ИмяТаблицы, СтрДлина("КомпоновщикНастроек")) = "КомпоновщикНастроек"
		И СтрНайти(ИмяТаблицы, "Порядок") > 0
		И (СтрНайти(НРег(ИмяПоля), "направ") > 0 Или СтрНайти(НРег(ИмяПоля), "упорядоч") > 0);
	// Для направления сортировки не активизируем колонку перед ИзменитьСтроку().
	// Live-проверенный путь table_begin_edit делает только ИзменитьСтроку() на
	// текущей строке, после чего editor направления появляется как видимое поле
	// формы. Переходы по колонкам в форме СКД web-клиента 8.5 часто сбрасывают
	// edit-mode или оставляют служебную колонку без рабочего dropdown.

	Если ЭтоНаправлениеПорядкаКомпоновщика Тогда
		// Здесь нельзя вызывать общий ОбеспечитьРедактирование...: он начинает с
		// Таблица.Активизировать(), а это сбрасывает предварительно выбранную колонку
		// направления. Нужен ровно сценарий table_begin_edit: ИзменитьСтроку() на
		// текущей колонке без переактивации таблицы.
		Попытка
			Если ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
				РезультатРедактирования = Новый Структура("editing,changed,error,method", Истина, Ложь, "", "already_editing_direction");
			Иначе
				Таблица.ИзменитьСтроку();
				РезультатРедактирования = Новый Структура("editing,changed,error,method", ТаблицаВРежимеРедактированияMCP(Таблица), Истина, "", "ИзменитьСтроку_direction_current_column");
			КонецЕсли;
		Исключение
			РезультатРедактирования = Новый Структура("editing,changed,error,method", ТаблицаВРежимеРедактированияMCP(Таблица), Истина, ОписаниеОшибки(), "ИзменитьСтроку_direction_exception");
		КонецПопытки;
	Иначе
		РезультатРедактирования = ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица, ИмяТаблицы);
	КонецЕсли;
	Если СвойствоСтруктуры(РезультатРедактирования, "editing", Ложь) Тогда
		// ИзменитьСтроку() в форме настроек СКД пересоздаёт/подменяет редакторы
		// ячеек. Не используем объект формы, полученный до входа в edit mode:
		// перечитываем активное окно, иначе поиск находит старую колонку таблицы,
		// у которой dropdown есть в дереве, но методы выбора неприменимы.
		Попытка
			ФормаНастроек = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Исключение
		КонецПопытки;
		// Для enum-колонки "Направление сортировки" в таблице порядка СКД обычный
		// УстановитьЗначениеПоля() видит открытый список, но пытается выбрать строку
		// через неподходящие методы формы/поля. Используем специализированный прямой
		// путь с ОткрытьВыпадающийСписок()+ВыполнитьВыборИзСпискаВыбора().
		ПрямойВыборНастройкиСКД = Лев(ИмяТаблицы, СтрДлина("КомпоновщикНастроек")) = "КомпоновщикНастроек"
			И (СтрНайти(НРег(ИмяПоля), "направ") > 0 Или СтрНайти(НРег(ИмяПоля), "упорядоч") > 0);
		Если УстановитьПолеЭлементаНастройкиСпискаЧерезРедакторMCP(Таблица, ИмяТаблицы, ИмяПоля, Значение, ФормаНастроек, ПрямойВыборНастройкиСКД, Ошибки) Тогда
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли Лев(ИмяТаблицы, СтрДлина("КомпоновщикНастроек")) = "КомпоновщикНастроек" Тогда
		// Web-клиент 1С 8.5 для таблиц настроек компоновщика может не поддерживать
		// ИзменитьСтроку()/ТекущийРежимРедактирование(), но редактор значения
		// текущей строки при этом доступен как отдельное поле формы. Это не общий
		// обход table-edit guard: путь разрешен только для формы настроек списка и
		// подтверждается чтением фактического значения из текущей строки.
		Если УстановитьПолеЭлементаНастройкиСпискаЧерезРедакторMCP(Таблица, ИмяТаблицы, ИмяПоля, Значение, ФормаНастроек, Истина, Ошибки) Тогда
			Возврат Истина;
		КонецЕсли;
	Иначе
		Ошибки.Добавить(ИмяПоля + ": строка настройки не перешла в режим редактирования; "
			+ СвойствоСтруктуры(РезультатРедактирования, "error", "ТекущийРежимРедактирование() остался Ложь")
			+ "; table_diag=" + ДиагностикаТаблицыMCP(Таблица));
		Возврат Ложь;
	КонецЕсли;

	Если Ошибки.Количество() = 0 Тогда
		Ошибки.Добавить(ИмяПоля + ": значение не установлено; table_diag=" + ДиагностикаТаблицыMCP(Таблица));
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция УстановитьПолеЭлементаНастройкиСпискаЧерезРедакторMCP(Таблица, ИмяТаблицы, ИмяПоля, Значение, ФормаНастроек, РазрешитьБезРежимаРедактирования, Ошибки)
	ЛокальныеОшибки = Новый Массив;
	Кандидаты = КандидатыПолейЭлементаНастройкиСпискаMCP(ИмяТаблицы, ИмяПоля);
	Если Лев(ИмяТаблицы, СтрДлина("КомпоновщикНастроек")) = "КомпоновщикНастроек"
		И СтрНайти(ИмяТаблицы, "Порядок") > 0
		И (СтрНайти(НРег(ИмяПоля), "направ") > 0 Или СтрНайти(НРег(ИмяПоля), "упорядоч") > 0) Тогда
		Кандидаты = Новый Массив;
		Кандидаты.Добавить(ИмяТаблицы + "ТипУпорядочивания");
		Кандидаты.Добавить("ТипУпорядочивания");
	КонецЕсли;
	Для Каждого КандидатПоля Из Кандидаты Цикл
		Если ПустаяСтрока(КандидатПоля) Тогда
			Продолжить;
		КонецЕсли;
		ПолеРедактора = Неопределено;
		ЭтоПолеНаправленияПорядка = СтрНайти(НРег(КандидатПоля), "направ") > 0 Или СтрНайти(НРег(КандидатПоля), "упорядоч") > 0;
		ЭтоТаблицаПорядкаКомпоновщика = Лев(ИмяТаблицы, СтрДлина("КомпоновщикНастроек")) = "КомпоновщикНастроек"
			И СтрНайти(ИмяТаблицы, "Порядок") > 0;
		Если ЭтоТаблицаПорядкаКомпоновщика И ЭтоПолеНаправленияПорядка Тогда
			// Важно: после ИзменитьСтроку() не трогаем таблицу до поиска editor-а.
			// Повторная Активизировать()/переходы по колонкам в форме настроек СКД
			// web-клиента 8.5 сбрасывают edit-mode, и дальше находится не editor,
			// а одноимённая колонка без рабочего dropdown. Ищем поле ровно так же, как
			// live-проверенный field_dropdown_items: по активной форме сразу после
			// входа в редактирование строки.
			ПолеРедактора = НайтиВидимыйРедакторПоляНастройкиСпискаСОжиданиемMCP(КандидатПоля);
		ИначеЕсли Не РазрешитьБезРежимаРедактирования Тогда
			// Для обычных таблиц сначала берём текущий editor ячейки после активации
			// нужной колонки.
			ПолеРедактора = НайтиПолеРедактораТаблицыMCP(Таблица, Таблица, ИмяТаблицы, КандидатПоля, Истина);
		КонецЕсли;
		Если ПолеРедактора = Неопределено Тогда
			Лог("УстановитьПолеЭлементаНастройкиСпискаЧерезРедакторMCP: visible editor not found for " + КандидатПоля + "; edit=" + Строка(ТаблицаВРежимеРедактированияMCP(Таблица)));
			Если Не (ЭтоТаблицаПорядкаКомпоновщика И ЭтоПолеНаправленияПорядка) Тогда
				ПолеРедактора = НайтиПолеРедактораТаблицыMCP(ФормаНастроек, Таблица, ИмяТаблицы, КандидатПоля, Ложь);
			КонецЕсли;
		КонецЕсли;
		Если ПолеРедактора = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Если РазрешитьБезРежимаРедактирования Тогда
				РезультатУстановки = УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP(ПолеРедактора, Значение);
			Иначе
				ПараметрыПоля = Новый Структура("field_name,value,search_by_title,cancel_on_error", БезопасноеСвойство(ПолеРедактора, "Имя", ""), Значение, Ложь, Ложь);
				РезультатУстановки = УстановитьЗначениеПоля(ПараметрыПоля);
			КонецЕсли;
			Если СвойствоСтруктуры(РезультатУстановки, "set", Ложь) Тогда
				Проверка = ЗначениеКолонкиТекущейСтрокиMCP(Таблица, ИмяПоля, Ложь);
				Если СвойствоСтруктуры(Проверка, "found", Ложь) И ЗначенияСовпадаютДляПроверкиMCP(СвойствоСтруктуры(Проверка, "value", ""), Значение) Тогда
					Возврат Истина;
				КонецЕсли;
				ЛокальныеОшибки.Добавить(КандидатПоля + ": set=true, но проверка значения не совпала: " + СвойствоСтруктуры(Проверка, "value", ""));
			Иначе
				ЛокальныеОшибки.Добавить(КандидатПоля + ": set=false" + ?(СвойствоСтруктуры(РезультатУстановки, "error", "") = "", "", ": " + СвойствоСтруктуры(РезультатУстановки, "error", "")));
			КонецЕсли;
		Исключение
			ЛокальныеОшибки.Добавить(КандидатПоля + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Если ЛокальныеОшибки.Количество() = 0 Тогда
		Ошибки.Добавить(ИмяПоля + ": поле редактора не найдено; candidates=" + СтрСоединить(Кандидаты, ", "));
	Иначе
		Ошибки.Добавить(ИмяПоля + ": " + СтрСоединить(ЛокальныеОшибки, "; "));
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP(Поле, Значение)
	Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: start поле=" + БезопасноеСвойство(Поле, "Имя", "") + " значение=" + Строка(Значение));
	Поле.Активизировать();
	Ошибки = Новый Массив;
	ИмяПоля = БезопасноеСвойство(Поле, "Имя", "");
	ЗаголовокПоля = БезопасныйЗаголовок(Поле);
	НормПоле = НРег(ИмяПоля + " " + ЗаголовокПоля);
	ЭтоНаправлениеПорядка = СтрНайти(НормПоле, "направ") > 0 Или СтрНайти(НормПоле, "упорядоч") > 0;
	Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: направление=" + Строка(ЭтоНаправлениеПорядка));
	ТекстовыйВводВыполнен = Ложь;
	Если Не ЭтоНаправлениеПорядка Тогда
		Попытка
			Поле.ВвестиТекст(Значение);
			ТекстовыйВводВыполнен = Истина;
		Исключение
			Ошибки.Добавить("ВвестиТекст=" + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Попытка
		Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: перед открытием dropdown");
		Если Не ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
			Попытка
				Поле.ОткрытьВыпадающийСписок();
				Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ОткрытьВыпадающийСписок выполнен");
			Исключение
				// Не все поля таблиц СКД поддерживают явное открытие списка. Н��же всё
				// равно попробуем остальные штатные способы выбора и вернём диагностику.
				Ошибки.Добавить("ОткрытьВыпадающийСписок=" + ОписаниеОшибки());
				Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ОткрытьВыпадающийСписок ИСКЛЮЧЕНИЕ " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
			Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: dropdown открыт, жду формирования");
			Поле.ОжидатьФормированияВыпадающегоСписка(3);
			Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: формирование завершено, читаю представления");
			Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
			Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: представлений=" + Строка(Представления.Количество()));
			ИндексВыбора = ИндексРелевантногоВариантаСпискаВыбораMCP(Представления, Значение);
			Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: индекс=" + Строка(ИндексВыбора));
			Если ИндексВыбора <> Неопределено Тогда
				ВыбранноеПредставление = ПредставлениеВариантаСпискаВыбораMCP(Представления[ИндексВыбора]);
				Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: выбранное=" + ВыбранноеПредставление);
				// Dropdown открыт у редактора ячейки, но методы выбора принадлежат форме
				// (ТестируемаяФорма.ВыполнитьВыборИзСписка), а не ТестируемомуПолюФормы.
				ФормаПоля = НайтиРодительскуюФорму(Поле);
				Если ФормаПоля = Неопределено Тогда
					ВызватьИсключение "Родительская форма поля не найдена";
				КонецЕсли;
				Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: пробую ФормаПоля.ВыполнитьВыборИзСписка(представление)");
				Попытка
					ФормаПоля.ВыполнитьВыборИзСписка(ВыбранноеПредставление);
					Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ФормаПоля.ВыполнитьВыборИзСписка(представление) выполнен");
					Возврат Новый Структура("set,method,selected", Истина, "settings_editor_form_choice_list", ВыбранноеПредставление);
				Исключение
					Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ФормаПоля.ВыполнитьВыборИзСписка(представление) ИСКЛЮЧЕНИЕ " + ОписаниеОшибки());
					Ошибки.Добавить("ФормаПоля.ВыполнитьВыборИзСписка=" + ОписаниеОшибки());
				КонецПопытки;
				Попытка
					ФормаПоля.ВыполнитьВыборИзСписка(ИндексВыбора);
					Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ФормаПоля.ВыполнитьВыборИзСписка(индекс) выполнен");
					Возврат Новый Структура("set,method,selected,index", Истина, "settings_editor_form_choice_list_index", ВыбранноеПредставление, ИндексВыбора);
				Исключение
					Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ФормаПоля.ВыполнитьВыборИзСписка(индекс) ИСКЛЮЧЕНИЕ " + ОписаниеОшибки());
					Ошибки.Добавить("ФормаПоля.ВыполнитьВыборИзСписка(индекс)=" + ОписаниеОшибки());
				КонецПопытки;
				// Если выбор через форму не сработал — закрываем dropdown и пробуем
				// переключить enum-редактор как поле-переключатель.
				Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
					Попытка
						Поле.ЗакрытьВыпадающийСписок();
					Исключение
					КонецПопытки;
				КонецЕсли;
				Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: пробую ВыбратьВариант цикл");
				Для НомерПереключения = 1 По 4 Цикл
					Попытка
						Поле.ВыбратьВариант(ВыбранноеПредставление);
					Исключение
						Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ВыбратьВариант ИСКЛЮЧЕНИЕ " + ОписаниеОшибки());
					КонецПопытки;
					ТекущееПредставлениеПослеВыбора = ПредставлениеДанныхПоля(Поле);
					Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: ВыбратьВариант шаг=" + Строка(НомерПереключения) + " текущее=" + ТекущееПредставлениеПослеВыбора);
					Если ЗначенияСовпадаютДляПроверкиMCP(ТекущееПредставлениеПослеВыбора, Значение)
						Или ЗначенияСовпадаютДляПроверкиMCP(ТекущееПредставлениеПослеВыбора, ВыбранноеПредставление) Тогда
						Возврат Новый Структура("set,method,selected", Истина, "settings_editor_select_variant_cycle", ВыбранноеПредставление);
					КонецЕсли;
				КонецЦикла;
				Ошибки.Добавить("ВыбратьВариант=значение не выбрано, текущее представление: " + ПредставлениеДанныхПоля(Поле));
			Иначе
				Поле.ЗакрытьВыпадающийСписок();
				Ошибки.Добавить("dropdown: вариант '" + Значение + "' не найден");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Ошибки.Добавить("dropdown=" + ОписаниеОшибки());
		Лог("УстановитьЗначениеПоляНастройкиСпискаНапрямуюMCP: dropdown блок ИСКЛЮЧЕНИЕ " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Поле.Активизировать();
		Поле.ВыбратьВариант(Значение);
		Возврат Новый Структура("set,method", Истина, "settings_editor_select_variant_value");
	Исключение
		Ошибки.Добавить("ВыбратьВариант=" + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Поле.Активизировать();
		Поле.ВыполнитьВыборИзСписка(Значение);
		Возврат Новый Структура("set,method", Истина, "settings_editor_direct_choice_list");
	Исключение
		Ошибки.Добавить("ВыполнитьВыборИзСписка=" + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Поле.Активизировать();
		Поле.ВыполнитьВыборИзМеню(Значение);
		Возврат Новый Структура("set,method", Истина, "settings_editor_direct_choice_menu");
	Исключение
		Ошибки.Добавить("ВыполнитьВыборИзМеню=" + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Поле.Активизировать();
		Поле.ВыполнитьВыборИзСпискаВыбора(Значение);
		Возврат Новый Структура("set,method", Истина, "settings_editor_direct_choice_dropdown_value");
	Исключение
		Ошибки.Добавить("ВыполнитьВыборИзСпискаВыбора=" + ОписаниеОшибки());
	КонецПопытки;

	Если ТекстовыйВводВыполнен Тогда
		Возврат Новый Структура("set,method", Истина, "settings_editor_direct_text");
	КонецЕсли;
	Возврат Новый Структура("set,method,error", Ложь, "settings_editor_direct", СтрСоединить(Ошибки, "; "));
КонецФункции

&НаКлиенте
Функция ДозаполнитьТабличныеПоляОтборовНастройкиСпискаMCP(Фильтры)
	Результаты = Новый Массив;
	Попытка
		АктивироватьРазделНастроекСпискаMCP("filter");
	Исключение
		// Ошибку активации отразит попытка заполнения конкретной строки ниже.
	КонецПопытки;
	Для Каждого Спек Из Фильтры Цикл
		ИмяПоляОтбора = СвойствоСтруктуры(Спек, "field", "");
		ЗначениеОтбора = СвойствоСтруктуры(Спек, "value", "");
		СравнениеОтбора = СвойствоСтруктуры(Спек, "comparison", "Равно");
		Ошибки = Новый Массив;
		СравнениеУстановлено = Истина;
		ЗначениеУстановлено = Истина;
		Если Не ПустаяСтрока(СравнениеОтбора) Тогда
			СравнениеУстановлено = УстановитьКолонкуСтрокиНастройкиСпискаЧерезТаблицуMCP("filter", ИмяПоляОтбора, "Вид сравнения", СравнениеОтбора, Истина, Ошибки);
			Если Не СравнениеУстановлено Тогда
				Ошибки.Добавить("Вид сравнения для поля '" + ИмяПоляОтбора + "' не установлен в таблице настроек");
			КонецЕсли;
		КонецЕсли;
		Если Не ПустаяСтрока(ЗначениеОтбора) Тогда
			ЗначениеУстановлено = УстановитьКолонкуСтрокиНастройкиСпискаЧерезТаблицуMCP("filter", ИмяПоляОтбора, "Значение", ЗначениеОтбора, Истина, Ошибки);
			Если Не ЗначениеУстановлено Тогда
				Ошибки.Добавить("Значение отбора для поля '" + ИмяПоляОтбора + "' не установлено в таблице настроек");
			КонецЕсли;
		КонецЕсли;
		Применено = СравнениеУстановлено И ЗначениеУстановлено;
		Результаты.Добавить(Новый Структура("applied,section,field,value,comparison,direction,errors,table_post_fill", Применено, "filter", ИмяПоляОтбора, ЗначениеОтбора, СравнениеОтбора, "", Ошибки, Истина));
	КонецЦикла;
	Возврат Результаты;
КонецФункции

&НаКлиенте
Функция УстановитьНастройкиДинамическогоСпискаMCP(Параметры)
	Закрывать = СвойствоСтруктуры(Параметры, "close", Истина);
	РезультатОчистки = Неопределено;
	Если СвойствоСтруктуры(Параметры, "clear_first", Ложь) Тогда
		АктивноеОкноПередОчисткой = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкноПередОчисткой, "Заголовок", "") = "Настройка списка" Тогда
			// dynamic_list_settings_available_fields по умолчанию оставляет окно
			// настроек открытым. Команда стандартных настроек принадлежит форме
			// списка, поэтому сначала возвращаемся к списку, затем честно очищаем
			// настройки и снова открываем форму ниже через ОбеспечитьОкно...
			Попытка
				ЗакрытьФорму();
			Исключение
				Попытка АктивноеОкноПередОчисткой.Закрыть(); Исключение КонецПопытки;
			КонецПопытки;
		КонецЕсли;
		РезультатОчистки = ОчиститьНастройкиДинамическогоСпискаMCP(Параметры);
	КонецЕсли;
	Открытие = ОбеспечитьОкноНастроекСпискаMCP(Параметры);
	Результаты = Новый Массив;
	Если Параметры.Свойство("filters") Тогда
		АктивацияОтбора = АктивироватьРазделНастроекСпискаMCP("filter");
		Для Каждого Спек Из Параметры.filters Цикл
			// Первый проход только добавляет строки отбора. Значения колонок задаём
			// вторым проходом через table-editor, когда все строки уже построены.
			Результаты.Добавить(ДобавитьЭлементНастройкиСпискаMCP("filter", СвойствоСтруктуры(Спек, "field", ""), "", "", ""));
		КонецЦикла;
		Для Каждого РезультатЗаполнения Из ДозаполнитьТабличныеПоляОтборовНастройкиСпискаMCP(Параметры.filters) Цикл
			Результаты.Добавить(РезультатЗаполнения);
		КонецЦикла;
	КонецЕсли;
	Если Параметры.Свойство("orders") Тогда
		АктивацияПорядка = АктивироватьРазделНастроекСпискаMCP("order");
		Для Каждого Спек Из Параметры.orders Цикл
			Результаты.Добавить(ДобавитьЭлементНастройкиСпискаMCP("order", СвойствоСтруктуры(Спек, "field", ""), "", "", СвойствоСтруктуры(Спек, "direction", СвойствоСтруктуры(Спек, "order", ""))));
		КонецЦикла;
	КонецЕсли;
	Если Закрывать Тогда
		Попытка
			Кнопка = НайтиКнопку(ТестируемоеПриложение.ПолучитьАктивноеОкно(), "ФормаЗакончитьРедактирование", "", 0);
			Если Кнопка = Неопределено Тогда Кнопка = НайтиКнопку(ТестируемоеПриложение.ПолучитьАктивноеОкно(), "", "Завершить редактирование", 0); КонецЕсли;
			Если Кнопка <> Неопределено Тогда Кнопка.Нажать(); Иначе ЗакрытьФорму(); КонецЕсли;
		Исключение
			Попытка ЗакрытьФорму(); Исключение КонецПопытки;
		КонецПопытки;
	КонецЕсли;
	Применено = Истина;
	Для Каждого РезультатЭлемента Из Результаты Цикл
		Если Не СвойствоСтруктуры(РезультатЭлемента, "applied", Ложь) Тогда
			Применено = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("applied,open,clear,items", Применено, Открытие, РезультатОчистки, Результаты);
КонецФункции

&НаКлиенте
Функция ТекущиеНастройкиДинамическогоСпискаMCP(Параметры)
	Раздел = СвойствоСтруктуры(Параметры, "section", СвойствоСтруктуры(Параметры, "kind", "filter"));
	Закрывать = СвойствоСтруктуры(Параметры, "close", Ложь);
	Открытие = ОбеспечитьОкноНастроекСпискаMCP(Параметры);
	Активация = АктивироватьРазделНастроекСпискаMCP(Раздел);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = ИмяТаблицыЭлементовНастроекСпискаMCP(Раздел);
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,section,table,error,open,activate", Ложь, Раздел, ИмяТаблицы, "Таблица элементов настройки не найдена", Открытие, Активация);
	КонецЕсли;
	ЭлементыНастройки = Новый Массив;
	Ошибки = Новый Массив;
	Попытка
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
	Исключение
		Ошибки.Добавить("Активизировать/ПерейтиКПервойСтроке: " + ОписаниеОшибки());
	КонецПопытки;
	ПредыдущаяСтрокаJSON = "";
	Пока Истина Цикл
		Попытка
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			Если ТекущаяСтрока = Неопределено Тогда Прервать; КонецЕсли;
			СтруктураСтроки = СоответствиеВСтруктуру(ТекущаяСтрока);
			СтрокаJSON = ЗначениеВJSON(СтруктураСтроки);
			Если СтрокаJSON = ПредыдущаяСтрокаJSON Тогда Прервать; КонецЕсли;
			ПредыдущаяСтрокаJSON = СтрокаJSON;
			Элемент = Новый Структура;
			Элемент.Вставить("row", СтруктураСтроки);
			ЭлементыНастройки.Добавить(Элемент);
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		Исключение
			Ошибки.Добавить(ОписаниеОшибки());
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Если Закрывать Тогда
		Попытка ЗакрытьФорму(); Исключение КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("found,section,section_title,table,items,count,errors,open,activate", Истина, Раздел, ЗаголовокЭлементаНастроекСпискаMCP(Раздел), ИмяТаблицы, ЭлементыНастройки, ЭлементыНастройки.Количество(), Ошибки, Открытие, Активация);
КонецФункции


&НаКлиенте
Процедура ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска)
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("FieldSelector");
	ИменаПолей.Добавить("Pattern");
	ИменаПолей.Добавить("CompareType");
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Попытка
			Поле = НайтиОбъектРекурсивно(ОкноПоиска, ИмяПоля, "", "", 0);
			Если Поле <> Неопределено И ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
				Поле.ЗакрытьВыпадающийСписок();
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска)
	Результат = Новый Структура("closed,method,errors", Ложь, "", Новый Массив);
	Если ОкноПоиска = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЗаголовокОкнаПоиска = БезопасноеСвойство(ОкноПоиска, "Заголовок", "");
	ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска);
	Попытка
		КнопкаЗакрыть = НайтиКнопку(ОкноПоиска, "Cancel", "", 0);
		Если КнопкаЗакрыть = Неопределено Тогда
			КнопкаЗакрыть = НайтиКнопку(ОкноПоиска, "", "Закрыть", 0);
		КонецЕсли;
		Если КнопкаЗакрыть <> Неопределено Тогда
			КнопкаЗакрыть.Нажать();
			Результат.method = "Cancel";
		КонецЕсли;
	Исключение
		Результат.errors.Добавить("Cancel: " + ОписаниеОшибки());
	КонецПопытки;

	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 1000 Цикл
		Попытка
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") <> ЗаголовокОкнаПоиска Тогда
				Результат.closed = Истина;
				Возврат Результат;
			КонецЕсли;
		Исключение
			Результат.closed = Истина;
			Возврат Результат;
		КонецПопытки;
	КонецЦикла;

	КомандыЗакрытия = Новый Массив;
	КомандыЗакрытия.Добавить("Cancel");
	КомандыЗакрытия.Добавить("ФормаЗакрыть");
	КомандыЗакрытия.Добавить("Закрыть");
	Для Каждого ИмяКомандыЗакрытия Из КомандыЗакрытия Цикл
		Попытка
			ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска);
			ОкноПоиска.ВыполнитьКоманду(ИмяКомандыЗакрытия);
			Результат.method = ?(ПустаяСтрока(Результат.method), "command:" + ИмяКомандыЗакрытия, Результат.method + "+command:" + ИмяКомандыЗакрытия);
		Исключение
			Результат.errors.Добавить("Command(" + ИмяКомандыЗакрытия + "): " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 1000 Цикл
			Попытка
				АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
				Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") <> ЗаголовокОкнаПоиска Тогда
					Результат.closed = Истина;
					Возврат Результат;
				КонецЕсли;
			Исключение
				Результат.closed = Истина;
				Возврат Результат;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Попытка
		ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска);
		ОкноПоиска.Закрыть();
		Результат.method = ?(ПустаяСтрока(Результат.method), "window.close", Результат.method + "+window.close");
	Исключение
		Результат.errors.Добавить("Window.Close: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 2000 Цикл
		Попытка
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") <> ЗаголовокОкнаПоиска Тогда
				Результат.closed = Истина;
				Возврат Результат;
			КонецЕсли;
		Исключение
			Результат.closed = Истина;
			Возврат Результат;
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция УстановитьТекстовоеПолеОкнаПоискаMCP(ОкноПоиска, ИмяПоля, Значение)
	Поле = НайтиОбъектРекурсивно(ОкноПоиска, ИмяПоля, "", "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле поиска не найдено: " + ИмяПоля;
	КонецЕсли;
	Поле.Активизировать();
	Поле.ВвестиТекст(Значение);
	Попытка
		Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
			Поле.ЗакрытьВыпадающийСписок();
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ВвестиТекстБезПодтверждения");
КонецФункции

&НаКлиенте
Функция НормализоватьРежимПоискаДинамическогоСпискаMCP(Значение)
	Норм = НРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Норм) Тогда
		Возврат "";
	КонецЕсли;
	Если Норм = "содержит" Или Норм = "по части строки" Или Норм = "часть" Или Норм = "подстрока" Или Норм = "substring" Или Норм = "contains" Тогда
		Возврат "По части строки";
	КонецЕсли;
	Если Норм = "с начала" Или Норм = "сначала" Или Норм = "по началу строки" Или Норм = "начало" Или Норм = "start" Или Норм = "starts" Или Норм = "startswith" Тогда
		Возврат "По началу строки";
	КонецЕсли;
	Если Норм = "точно" Или Норм = "точное" Или Норм = "по точному совпадению" Или Норм = "равно" Или Норм = "exact" Или Норм = "equals" Тогда
		Возврат "По точному совпадению";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

&НаКлиенте
Функция КодРежимаПоискаДинамическогоСпискаMCP(Значение)
	Норм = НормализоватьРежимПоискаДинамическогоСпискаMCP(Значение);
	Если Норм = "По началу строки" Тогда
		Возврат 0;
	ИначеЕсли Норм = "По части строки" Тогда
		Возврат 1;
	ИначеЕсли Норм = "По точному совпадению" Тогда
		Возврат 2;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПредставлениеРежимаПоискаДинамическогоСпискаMCP(Значение)
	Код = Неопределено;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Код = Значение;
	ИначеЕсли Строка(Значение) = "0" Или Строка(Значение) = "1" Или Строка(Значение) = "2" Тогда
		Код = Число(Значение);
	Иначе
		Код = КодРежимаПоискаДинамическогоСпискаMCP(Значение);
	КонецЕсли;
	Если Код = 0 Тогда
		Возврат "По началу строки";
	ИначеЕсли Код = 1 Тогда
		Возврат "По части строки";
	ИначеЕсли Код = 2 Тогда
		Возврат "По точному совпадению";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

&НаКлиенте
Функция УстановитьПолеГдеИскатьОкнаПоискаMCP(ОкноПоиска, ПолеПоиска)
	Если ПустаяСтрока(ПолеПоиска) Тогда
		Возврат Новый Структура("set,field,value,method", Истина, "FieldSelector", ПолеПоиска, "not_requested");
	КонецЕсли;
	Поле = НайтиОбъектРекурсивно(ОкноПоиска, "FieldSelector", "", "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле поиска не найдено: FieldSelector";
	КонецЕсли;
	Поле.Активизировать();
	Поле.ВвестиТекст(ПолеПоиска);
	НачалоОжиданияСписка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Не ОткрытВыпадающийСписокПоляMCP(Поле)
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжиданияСписка < 2000 Цикл
	КонецЦикла;
	Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
		Поле.ОжидатьФормированияВыпадающегоСписка(5);
		Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
		ИндексВыбора = ИндексРелевантногоВариантаСпискаВыбораMCP(Представления, ПолеПоиска);
		Если ИндексВыбора = Неопределено Тогда
			Поле.ЗакрытьВыпадающийСписок();
			ВызватьИсключение "В списке реквизитов поиска не найдено поле: " + ПолеПоиска;
		КонецЕсли;
		ПредставлениеВыбираемогоВарианта = ПредставлениеВариантаСпискаВыбораMCP(Представления[ИндексВыбора]);
		Попытка
			Поле.ВыполнитьВыборИзСпискаВыбора(ПредставлениеВыбираемогоВарианта);
		Исключение
			Поле.ВыполнитьВыборИзСпискаВыбора(ИндексВыбора);
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("set,field,value,method", Истина, "FieldSelector", ПолеПоиска, "ВвестиТекст+ВыполнитьВыборИзСпискаВыбора");
КонецФункции

&НаКлиенте
Функция УстановитьРежимПоискаОкнаПоискаMCP(ОкноПоиска, РежимПоиска)
	Если ПустаяСтрока(РежимПоиска) Тогда
		Возврат Новый Структура("set,field,value,method", Истина, "CompareType", РежимПоиска, "default");
	КонецЕсли;
	Поле = НайтиОбъектРекурсивно(ОкноПоиска, "CompareType", "", "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле поиска не найдено: CompareType";
	КонецЕсли;
	ЦелевоеПредставление = НормализоватьРежимПоискаДинамическогоСпискаMCP(РежимПоиска);
	ЦелевойКод = КодРежимаПоискаДинамическогоСпискаMCP(РежимПоиска);
	Если ПредставлениеРежимаПоискаДинамическогоСпискаMCP(ПредставлениеДанныхПоля(Поле)) = ЦелевоеПредставление Тогда
		Возврат Новый Структура("set,field,value,method", Истина, "CompareType", РежимПоиска, "current");
	КонецЕсли;
	Ошибки = Новый Массив;
	Для НомерПопытки = 1 По 8 Цикл
		Попытка
			Поле.Активизировать();
			Если ЦелевойКод <> Неопределено Тогда
				Поле.ВыбратьВариант(ЦелевойКод);
			Иначе
				Поле.ВыбратьВариант(ЦелевоеПредставление);
			КонецЕсли;
		Исключение
			Если Ошибки.Количество() < 3 Тогда
				Ошибки.Добавить(ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
		НачалоПроверки = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроверки < 500 Цикл
			Если ПредставлениеРежимаПоискаДинамическогоСпискаMCP(ПредставлениеДанныхПоля(Поле)) = ЦелевоеПредставление Тогда
				Возврат Новый Структура("set,field,value,method,selected", Истина, "CompareType", РежимПоиска, "ВыбратьВариант", ЦелевоеПредставление);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ВызватьИсключение "Режим поиска не выбран: " + ЦелевоеПредставление + "; текущее значение: " + ПредставлениеДанныхПоля(Поле) + "; ошибки: " + СтрСоединить(Ошибки, "; ");
КонецФункции

&НаКлиенте
Функция НайтиВДинамическомСпискеMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	ИмяТаблицы = СвойствоСтруктуры(Параметры, "name", "Список");
	ЗаголовокТаблицы = СвойствоСтруктуры(Параметры, "title", "");
	ПолеПоиска = СвойствоСтруктуры(Параметры, "field", "");
	ТекстПоиска = СвойствоСтруктуры(Параметры, "text", СвойствоСтруктуры(Параметры, "pattern", ""));
	РежимПоиска = СвойствоСтруктуры(Параметры, "compare_type", СвойствоСтруктуры(Параметры, "search_mode", ""));
	Если ПустаяСтрока(ТекстПоиска) Тогда
		ВызватьИсключение "Не задан текст поиска dynamic list.";
	КонецЕсли;

	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицы, 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,searched,error", Ложь, Ложь, "Таблица не найдена");
	КонецЕсли;

	Ошибки = Новый Массив;
	Попытка
		Таблица.Активизировать();
	Исключение
		Ошибки.Добавить("Активизировать таблицу: " + ОписаниеОшибки());
	КонецПопытки;

	ЗаголовокОкнаДо = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	Кнопка = Неопределено;
	Попытка
		Кнопка = НайтиКнопку(АктивноеОкно, ИмяТаблицы + "КонтекстноеМенюНайти", "", 0);
		Если Кнопка = Неопределено Тогда
			Кнопка = НайтиКнопку(АктивноеОкно, "", "Расширенный поиск", 0);
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			Кнопка = НайтиКнопку(АктивноеОкно, "", "Найти...", 0);
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			Кнопка = НайтиКнопку(АктивноеОкно, "", "Найти", 0);
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			Возврат Новый Структура("found,searched,errors,error", Ложь, Ложь, Ошибки, "Команда расширенного поиска не найдена");
		КонецЕсли;
		Кнопка.Нажать();
	Исключение
		Возврат Новый Структура("found,searched,errors,error", Ложь, Ложь, Ошибки, ОписаниеОшибки());
	КонецПопытки;

	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОкноПоиска = Неопределено;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 5000 Цикл
		ОкноПоиска = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(ОкноПоиска, "Заголовок", "") <> ЗаголовокОкнаДо Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ОкноПоиска = Неопределено Или БезопасноеСвойство(ОкноПоиска, "Заголовок", "") = ЗаголовокОкнаДо Тогда
		Возврат Новый Структура("found,searched,errors,error", Ложь, Ложь, Ошибки, "Окно поиска не открылось");
	КонецЕсли;

	Попытка
		УстановкаПоля = УстановитьПолеГдеИскатьОкнаПоискаMCP(ОкноПоиска, ПолеПоиска);
	Исключение
		Ошибки.Добавить("FieldSelector: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УстановкаТекста = УстановитьТекстовоеПолеОкнаПоискаMCP(ОкноПоиска, "Pattern", ТекстПоиска);
	Исключение
		Ошибки.Добавить("Pattern: " + ОписаниеОшибки());
	КонецПопытки;

	Если Не ПустаяСтрока(РежимПоиска) Тогда
		Попытка
			УстановкаРежима = УстановитьРежимПоискаОкнаПоискаMCP(ОкноПоиска, РежимПоиска);
		Исключение
			Ошибки.Добавить("CompareType: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		ЗакрытиеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
		Возврат Новый Структура("found,searched,matched,match_reason,match_method,modal_title,field,text,compare_type,errors,modal_close", Ложь, Ложь, Ложь, "search_dialog_setup_failed", "standard_find_dialog", БезопасноеСвойство(ОкноПоиска, "Заголовок", ""), ПолеПоиска, ТекстПоиска, РежимПоиска, Ошибки, ЗакрытиеПоиска);
	КонецЕсли;

	Попытка
		КнопкаНайти = НайтиКнопку(ОкноПоиска, "Find", "", 0);
		Если КнопкаНайти = Неопределено Тогда
			КнопкаНайти = НайтиКнопку(ОкноПоиска, "", "&Найти", 0);
		КонецЕсли;
		Если КнопкаНайти = Неопределено Тогда
			КнопкаНайти = НайтиКнопку(ОкноПоиска, "", "Найти", 0);
		КонецЕсли;
		Если КнопкаНайти = Неопределено Тогда
			ЗакрытиеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
			Возврат Новый Структура("found,searched,matched,match_reason,match_method,modal_title,field,text,compare_type,errors,error,modal_close", Ложь, Ложь, Ложь, "find_button_not_found", "standard_find_dialog", БезопасноеСвойство(ОкноПоиска, "Заголовок", ""), ПолеПоиска, ТекстПоиска, РежимПоиска, Ошибки, "Кнопка Найти в модальном окне не найдена", ЗакрытиеПоиска);
		КонецЕсли;
		КнопкаНайти.Нажать();
	Исключение
		ЗакрытиеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
		Возврат Новый Структура("found,searched,matched,match_reason,match_method,modal_title,field,text,compare_type,errors,error,modal_close", Ложь, Ложь, Ложь, "find_button_press_failed", "standard_find_dialog", БезопасноеСвойство(ОкноПоиска, "Заголовок", ""), ПолеПоиска, ТекстПоиска, РежимПоиска, Ошибки, ОписаниеОшибки(), ЗакрытиеПоиска);
	КонецПопытки;

	ЗакрытиеПоискаПослеПоиска = Новый Структура("closed,method,errors", Истина, "not_open", Новый Массив);
	Попытка
		АктивноеОкноПослеНажатия = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкноПослеНажатия, "Заголовок", "") = БезопасноеСвойство(ОкноПоиска, "Заголовок", "") Тогда
			ЗакрытиеПоискаПослеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
		КонецЕсли;
	Исключение
		ЗакрытиеПоискаПослеПоиска.errors.Добавить("Проверка активного окна после поиска: " + ОписаниеОшибки());
	КонецПопытки;

	ТекущаяСтрока = Неопределено;
	Попытка
		АктивноеОкноПосле = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		ТаблицаПосле = НайтиТаблицуПоПараметрам(АктивноеОкноПосле, ИмяТаблицы, ЗаголовокТаблицы, 0);
		Если ТаблицаПосле <> Неопределено Тогда
			ТаблицаПосле.Активизировать();
			ТекущаяСтрока = СоответствиеВСтруктуру(ТаблицаПосле.ПолучитьТекущуюСтроку());
		Иначе
			Ошибки.Добавить("Таблица после поиска не найдена");
		КонецЕсли;
	Исключение
		Ошибки.Добавить("ПолучитьТекущуюСтроку после поиска: " + ОписаниеОшибки());
	КонецПопытки;
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Новый Структура("available,pairs", Ложь, Новый Массив);
	КонецЕсли;
	СовпадениеНайдено = СвойствоСтруктуры(ТекущаяСтрока, "available", Ложь)
		И СвойствоСтруктуры(ТекущаяСтрока, "pairs", Новый Массив).Количество() > 0
		И СтрНайти(НРег(ЗначениеВJSON(ТекущаяСтрока)), НРег(ТекстПоиска)) > 0;
	ПричинаОтсутствияСовпадения = ?(СовпадениеНайдено, "", "no_current_row_after_search");

	Возврат Новый Структура("found,searched,matched,match_reason,match_method,table,field,text,compare_type,errors,current_row,modal_close", СовпадениеНайдено, Истина, СовпадениеНайдено, ПричинаОтсутствияСовпадения, "standard_find_dialog", ИмяТаблицы, ПолеПоиска, ТекстПоиска, РежимПоиска, Ошибки, ТекущаяСтрока, ЗакрытиеПоискаПослеПоиска);
КонецФункции
&НаКлиенте
Функция ОчиститьНастройкиДинамическогоСпискаMCP(Параметры)
	СписокКнопок = Новый Массив;
	Кнопка = СвойствоСтруктуры(Параметры, "button", СвойствоСтруктуры(Параметры, "command", ""));
	Если Не ПустаяСтрока(Кнопка) Тогда СписокКнопок.Добавить(Новый Структура("name,title", Кнопка, "")); КонецЕсли;
	СписокКнопок.Добавить(Новый Структура("name,title", "СписокУстановитьСтандартныеНастройки", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "ФормаУстановитьСтандартныеНастройки", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Установить стандартные настройки"));
	РезультатКнопки = НажатьПервуюКнопкуОкна(СписокКнопок);
	Возврат Новый Структура("cleared,button", Истина, РезультатКнопки.button);
КонецФункции

&НаКлиенте
Функция ОткрытьНастройкуФормыMCP(Параметры)
	СписокКнопок = Новый Массив;
	Кнопка = СвойствоСтруктуры(Параметры, "button", СвойствоСтруктуры(Параметры, "command", ""));
	Если Не ПустаяСтрока(Кнопка) Тогда СписокКнопок.Добавить(Новый Структура("name,title", Кнопка, "")); КонецЕсли;
	СписокКнопок.Добавить(Новый Структура("name,title", "ФормаИзменитьФорму", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Изменить форму..."));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Изменить форму"));
	РезультатКнопки = НажатьПервуюКнопкуОкна(СписокКнопок);
	Возврат Новый Структура("opened,button", Истина, РезультатКнопки.button);
КонецФункции

&НаКлиенте
Функция НажатьПервуюКнопкуОкна(Кнопки)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Ошибки = Новый Массив;
	Для Каждого ОписаниеКнопки Из Кнопки Цикл
		ИмяКнопки = СвойствоСтруктуры(ОписаниеКнопки, "name", "");
		ЗаголовокКнопки = СвойствоСтруктуры(ОписаниеКнопки, "title", "");
		Если ПустаяСтрока(ИмяКнопки) И ПустаяСтрока(ЗаголовокКнопки) Тогда Продолжить; КонецЕсли;
		Попытка
			Кнопка = НайтиКнопку(АктивноеОкно, ИмяКнопки, ЗаголовокКнопки, 0);
			Если Кнопка = Неопределено Тогда
				Ошибки.Добавить(?(ПустаяСтрока(ИмяКнопки), ЗаголовокКнопки, ИмяКнопки) + ": кнопка не найдена");
				Продолжить;
			КонецЕсли;
			Кнопка.Нажать();
			Возврат Новый Структура("button", ?(ПустаяСтрока(ИмяКнопки), ЗаголовокКнопки, ИмяКнопки));
		Исключение
			Ошибки.Добавить(?(ПустаяСтрока(ИмяКнопки), ЗаголовокКнопки, ИмяКнопки) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "Ни одна кнопка не нажалась: " + Строка(Ошибки);
КонецФункции

&НаКлиенте
Функция СоздатьНовыйЭлемент(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Попытка
		КнопкаСоздать = НайтиКнопку(АктивноеОкно, "ФормаСоздать", "", 0);
		Если КнопкаСоздать <> Неопределено Тогда
			КнопкаСоздать.Нажать();
			Возврат Новый Структура("created,method", Истина, "button");
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Попытка
		КнопкаСоздать = НайтиКнопку(АктивноеОкно, "", "Создать", 0);
		Если КнопкаСоздать <> Неопределено Тогда
			КнопкаСоздать.Нажать();
			Возврат Новый Структура("created,method", Истина, "title");
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Попытка
		Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, "", "", 0);
		Если Таблица <> Неопределено Тогда
			Таблица.Активизировать();
			Таблица.ДобавитьСтроку();
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			Возврат Новый Структура("created,method,table,current_row", Истина, "table_add_row", ОбъектВСтруктуру(Таблица, 0), СоответствиеВСтруктуру(ТекущаяСтрока));
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	ВызватьИсключение "Кнопка Создать не найдена и строку таблицы добавить не удалось";
КонецФункции

&НаКлиенте
Функция СохранитьФорму()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокДоСохранения = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	ФормаДоСохранения = НайтиОбъектРекурсивно(АктивноеОкно, "", "", "ТестируемаяФорма", 0);
	Попытка
		КнопкаЗаписать = НайтиКнопку(АктивноеОкно, "ФормаЗаписать", "", 0);
		Если КнопкаЗаписать <> Неопределено Тогда
			КнопкаЗаписать.Нажать();
			РезультатКнопки = Новый Структура("saved,method", Истина, "button");
			ДобавитьСостояниеОкнаПослеДействияMCP(РезультатКнопки, ЗаголовокДоСохранения, ФормаДоСохранения, Ложь);
			Возврат РезультатКнопки;
		КонецЕсли;
		АктивноеОкно.Записать();
		РезультатОкна = Новый Структура("saved,method", Истина, "window");
		ДобавитьСостояниеОкнаПослеДействияMCP(РезультатОкна, ЗаголовокДоСохранения, ФормаДоСохранения, Ложь);
		Возврат РезультатОкна;
	Исключение
		Лог("СохранитьФорму: " + ОписаниеОшибки());
		ВызватьИсключение "Ошибка сохранения: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ЗакрытьФорму()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокДоЗакрытия = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	ФормаДоЗакрытия = НайтиОбъектРекурсивно(АктивноеОкно, "", "", "ТестируемаяФорма", 0);
	Результат = Новый Структура("closed", Ложь);
	Попытка
		АктивноеОкно.Закрыть();
		// Не вызываем здесь Форма.ОжидатьЗакрытие(): если 1С открыла штатный
		// MessageBox "Сохранить изменения?", исходная форма не закроется до
		// ответа пользователя, и ожидание зависнет до тайм-аута bridge.
		ДобавитьСостояниеОкнаПослеДействияMCP(Результат, ЗаголовокДоЗакрытия, ФормаДоЗакрытия, Ложь);
		Если СвойствоСтруктуры(Результат, "window_changed", Ложь) Тогда
			// Активное окно/форма уже изменились — исходная форма закрыта или ушла
			// с фокуса. Не диагностируем новое обычное окно как modal/dialog только
			// потому, что в нем есть кнопки и тексты.
			Результат.closed = Истина;
			Результат.Вставить("reason", "closed_or_window_changed");
			Возврат Результат;
		КонецЕсли;
		ДобавитьДиагностикуАктивногоОкнаMCP(Результат, "modal", Ложь);
		Если СвойствоСтруктуры(Результат, "modal_looks_like_dialog", Ложь) Тогда
			Результат.closed = Ложь;
			Результат.Вставить("reason", "close_blocked_by_modal_dialog");
		Иначе
			Результат.Вставить("warning", "После вызова Закрыть() активное окно не изменилось; действие, возможно, заблокировано состоянием UI.");
		КонецЕсли;
		Возврат Результат;
	Исключение
		ИнфоЗакрытия = ИнформацияОбОшибке();
		ТекстОшибкиЗакрытия = ПодробноеПредставлениеОшибки(ИнфоЗакрытия);
		Лог("ЗакрытьФорму: " + ТекстОшибкиЗакрытия);
		Результат.Вставить("close_error", ТекстОшибкиЗакрытия);
		ДобавитьСостояниеОкнаПослеДействияMCP(Результат, ЗаголовокДоЗакрытия, ФормаДоЗакрытия, Ложь);
		Если СвойствоСтруктуры(Результат, "window_changed", Ложь) Тогда
			Результат.closed = Истина;
			Результат.Вставить("reason", "closed_or_window_changed_after_exception");
			Возврат Результат;
		КонецЕсли;
		Результат.Вставить("reason", "close_failed");
		ДобавитьДиагностикуАктивногоОкнаMCP(Результат, "modal", Ложь);
		Если СвойствоСтруктуры(Результат, "modal_looks_like_dialog", Ложь) Тогда
			Результат.reason = "close_blocked_by_modal_dialog";
		КонецЕсли;
		Возврат Результат;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ПроверитьСостояниеКлиентаПослеШага(ЗаголовокОкнаДоКоманды = "", ИмяФормыОкнаДоКоманды = "")
	Результат = Новый Структура;
	СообщенияПользователю = Новый Массив;
	Результат.Вставить("user_messages", СообщенияПользователю);
	Результат.Вставить("error_info", "");
	Результат.Вставить("modal_closed", Ложь);
	Результат.Вставить("modal_opened", Ложь);
	Результат.Вставить("modal_title", "");
	Результат.Вставить("modal_buttons", Новый Массив);
	Результат.Вставить("modal_texts", Новый Массив);
	Результат.Вставить("modal_text", "");
	Результат.Вставить("modal_is_error_window", Ложь);
	Результат.Вставить("modal_looks_like_dialog", Ложь);
	Результат.Вставить("validation_messages", Новый Массив);
	Результат.Вставить("events", Новый Массив);
	Результат.Вставить("has_user_messages", Ложь);
	Результат.Вставить("has_validation_messages", Ложь);
	Результат.Вставить("has_error_info", Ложь);
	Результат.Вставить("has_dialog", Ложь);

	Если ТестируемоеПриложение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	АктивноеОкно = Неопределено;
	Попытка
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Попытка
		СнимокСообщений = СообщенияПользователяMCP();
		Если СвойствоСтруктуры(СнимокСообщений, "available", Ложь) Тогда
			Для Каждого СообщениеПользователю Из СнимокСообщений.messages Цикл
				СообщенияПользователю.Добавить(СообщениеПользователю);
			КонецЦикла;
			Результат.Вставить("user_message_texts", СнимокСообщений.message_texts);
			Результат.Вставить("user_messages_cleared", СнимокСообщений.cleared);
			Если Не ПустаяСтрока(СнимокСообщений.clear_error) Тогда
				Результат.Вставить("user_messages_clear_error", СнимокСообщений.clear_error);
			КонецЕсли;
		Иначе
			ПричинаСообщений = СвойствоСтруктуры(СнимокСообщений, "reason", "");
			ОшибкаСообщений = СвойствоСтруктуры(СнимокСообщений, "error", "");
			Если ПричинаСообщений <> "user_messages_panel_closed" Тогда
				Результат.Вставить("user_messages_reason", ПричинаСообщений);
				Если Не ПустаяСтрока(ОшибкаСообщений) Тогда
					Результат.Вставить("user_messages_error", ОшибкаСообщений);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ИнфоСообщений = ИнформацияОбОшибке();
		Лог("Не удалось получить сообщения пользователю: " + ПодробноеПредставлениеОшибки(ИнфоСообщений));
	КонецПопытки;

	Попытка
		ИнформацияТекущейОшибки = ТестируемоеПриложение.ПолучитьТекущуюИнформациюОбОшибке();
		Если ИнформацияТекущейОшибки <> Неопределено Тогда
			Результат.error_info = ПодробноеПредставлениеОшибки(ИнформацияТекущейОшибки);
		КонецЕсли;
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		Лог("Не удалось получить текущую информацию об ошибке: " + ПодробноеПредставлениеОшибки(ИнфоОшибки));
	КонецПопытки;

	ДобавитьСообщенияВалидацииТекущегоЭлементаMCP(АктивноеОкно, Результат.validation_messages);

	Результат.has_user_messages = СообщенияПользователю.Количество() > 0;
	Результат.has_validation_messages = Результат.validation_messages.Количество() > 0;
	Результат.has_error_info = Не ПустаяСтрока(Результат.error_info);
	Если Результат.has_user_messages Тогда
		Результат.events.Добавить(Новый Структура("kind,texts,messages", "user_messages", СвойствоСтруктуры(Результат, "user_message_texts", Новый Массив), СообщенияПользователю));
	КонецЕсли;
	Если Результат.has_validation_messages Тогда
		Результат.events.Добавить(Новый Структура("kind,messages", "validation_messages", Результат.validation_messages));
	КонецЕсли;
	Если Результат.has_error_info Тогда
		Результат.events.Добавить(Новый Структура("kind,text", "error_info", Результат.error_info));
	КонецЕсли;

	ЗаголовокОкна = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	ФормаАктивногоОкна = НайтиОбъектРекурсивно(АктивноеОкно, "", "", "ТестируемаяФорма", 0);
	ИмяФормыАктивногоОкна = БезопасноеСвойство(ФормаАктивногоОкна, "ИмяФормы", "");
	НормЗаголовок = НРег(ЗаголовокОкна);
	Результат.Вставить("active_window_title", ЗаголовокОкна);
	Результат.Вставить("active_form_name", ИмяФормыАктивногоОкна);
	Результат.Вставить("active_window_changed", НормализоватьЗаголовокОкнаMCP(ЗаголовокОкна) <> НормализоватьЗаголовокОкнаMCP(ЗаголовокОкнаДоКоманды)
		Или ИмяФормыАктивногоОкна <> ИмяФормыОкнаДоКоманды);
	Если Результат.active_window_changed Тогда
		Результат.events.Добавить(Новый Структура("kind,title,form_name", "active_window_changed", ЗаголовокОкна, ИмяФормыАктивногоОкна));
	КонецЕсли;
	Результат.modal_title = ЗаголовокОкна;
	Результат.Вставить("modal_form_name", ИмяФормыАктивногоОкна);
	Результат.modal_is_error_window = ЕстьФормаОшибкиРекурсивно(АктивноеОкно, 0);
	ОкноПохожеНаДиалог = ИмяФормыАктивногоОкна = "MessageBox"
		Или СтрНайти(НормЗаголовок, "предупреж") > 0
		Или СтрНайти(НормЗаголовок, "ошиб") > 0
		Или СтрНайти(НормЗаголовок, "исключ") > 0
		Или Результат.has_error_info
		Или Результат.modal_is_error_window;

	Если ОкноПохожеНаДиалог Тогда
		ДобавитьДиагностикуАктивногоОкнаMCP(Результат, "modal", Ложь);
		Результат.modal_opened = Истина;
	КонецЕсли;
	Результат.has_dialog = СвойствоСтруктуры(Результат, "modal_looks_like_dialog", Ложь);
	Если Результат.has_dialog Тогда
		Результат.events.Добавить(Новый Структура("kind,title,form_name,text,buttons,is_error_window", "dialog", Результат.modal_title, СвойствоСтруктуры(Результат, "modal_form_name", ""), Результат.modal_text, Результат.modal_buttons, Результат.modal_is_error_window));
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ЕстьФормаОшибкиРекурсивно(РодительскийОбъект, ТекущаяГлубина)
	Попытка
		Если БезопасноеСвойство(РодительскийОбъект, "ИмяФормы", "") = "ErrorWindow" Тогда
			Возврат Истина;
		КонецЕсли;
		Для Каждого Подчиненный Из БезопасныеПодчиненные(РодительскийОбъект) Цикл
			Если ЕстьФормаОшибкиРекурсивно(Подчиненный, ТекущаяГлубина + 1) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение при поиске ErrorWindow: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ДобавитьТекстЕслиЕсть(Тексты, Текст)
	Текст = СокрЛП(Строка(Текст));
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого УжеЕсть Из Тексты Цикл
		Если УжеЕсть = Текст Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Тексты.Добавить(Текст);
КонецПроцедуры

&НаКлиенте
Функция ПохожеНаСообщениеВалидацииMCP(Текст)
	НормТекст = НРег(СокрЛП(Строка(Текст)));
	Если ПустаяСтрока(НормТекст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(НормТекст, "ошибка") > 0
		Или СтрНайти(НормТекст, "не заполн") > 0
		Или СтрНайти(НормТекст, "не выбран") > 0
		Или СтрНайти(НормТекст, "обязател") > 0
		Или СтрНайти(НормТекст, "не указан") > 0;
КонецФункции

&НаКлиенте
Процедура ДобавитьСообщениеВалидацииЕслиЕстьMCP(Сообщения, Объект, Текст)
	Текст = СокрЛП(Строка(Текст));
	Если Не ПохожеНаСообщениеВалидацииMCP(Текст) Тогда
		Возврат;
	КонецЕсли;

	Имя = БезопасноеСвойство(Объект, "Имя", "");
	Заголовок = БезопасныйЗаголовок(Объект);
	Для Каждого УжеЕсть Из Сообщения Цикл
		Если СвойствоСтруктуры(УжеЕсть, "text", "") = Текст
			И СвойствоСтруктуры(УжеЕсть, "name", "") = Имя Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Сообщения.Добавить(Новый Структура("name,title,text", Имя, Заголовок, Текст));
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщенияВалидацииТекущегоЭлементаMCP(АктивноеОкно, Сообщения)
	// Не сканируем все окно: ПолучитьТекстПодсказки() на большом дереве форм может быть дорогим.
	// После ошибки ввода/проведения платформа обычно переводит фокус на проблемный элемент.
	Попытка
		ТекущийЭлемент = АктивноеОкно.ПолучитьТекущийЭлемент();
	Исключение
		Возврат;
	КонецПопытки;
	Если ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСообщениеВалидацииЕслиЕстьMCP(Сообщения, ТекущийЭлемент, БезопасноеСвойство(ТекущийЭлемент, "ТекстЗаголовка", ""));
	ДобавитьСообщениеВалидацииЕслиЕстьMCP(Сообщения, ТекущийЭлемент, БезопасныйЗаголовок(ТекущийЭлемент));
	Попытка
		ДобавитьСообщениеВалидацииЕслиЕстьMCP(Сообщения, ТекущийЭлемент, ТекущийЭлемент.ПолучитьПредставлениеДанных());
	Исключение
		// Не у всех тестируемых объектов есть представление данных.
	КонецПопытки;
	Попытка
		ДобавитьСообщениеВалидацииЕслиЕстьMCP(Сообщения, ТекущийЭлемент, ТекущийЭлемент.ПолучитьТекстПодсказки());
	Исключение
		// Не у всех тестируемых объектов есть текст подсказки.
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НайтиТекстыОкнаРекурсивно(РодительскийОбъект, Тексты, ТекущаяГлубина)
	Попытка
		Если ОбъектВидимИДоступенMCP(РодительскийОбъект) Тогда
			ДобавитьТекстЕслиЕсть(Тексты, БезопасноеСвойство(РодительскийОбъект, "ТекстЗаголовка", ""));
			ДобавитьТекстЕслиЕсть(Тексты, БезопасныйЗаголовок(РодительскийОбъект));
			Попытка
				ПредставлениеДанных = РодительскийОбъект.ПолучитьПредставлениеДанных();
				ДобавитьТекстЕслиЕсть(Тексты, ПредставлениеДанных);
			Исключение
				// Не у всех тестируемых объектов есть представление данных.
			КонецПопытки;
		КонецЕсли;
		Для Каждого Подчиненный Из БезопасныеПодчиненные(РодительскийОбъект) Цикл
			НайтиТекстыОкнаРекурсивно(Подчиненный, Тексты, ТекущаяГлубина + 1);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение при поиске текстов окна: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НайтиКнопкиРекурсивно(РодительскийОбъект, Кнопки, ТекущаяГлубина)
	Попытка
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если (ТипТек = "тестируемаякнопкакоманднойпанели" Или ТипТек = "тестируемаякнопкаформы")
				И ОбъектВидимИДоступенMCP(Подчиненный) Тогда
				Кнопки.Добавить(Подчиненный);
			КонецЕсли;
			НайтиКнопкиРекурсивно(Подчиненный, Кнопки, ТекущаяГлубина + 1);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение при поиске кнопок: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Сериализация

&НаКлиенте
Функция ОбъектВСтруктуру(Объект, ТекущаяГлубина, ПоказыватьСкрытые = Истина, РодительскаяВидимость = Истина, РодительскаяДоступность = Истина, РодительТолькоПросмотр = Ложь, КешСериализации = Неопределено, ВключатьДанные = Истина, СериализоватьДетей = Истина, СчетчикУзлов = Неопределено, ВключатьКомандныеПанели = Истина)
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если КешСериализации = Неопределено Тогда
		КешСериализации = НовыйКешПоискаКнопкиMCP();
	КонецЕсли;
	Если СчетчикУзлов <> Неопределено Тогда
		СчетчикУзлов.nodes = СчетчикУзлов.nodes + 1;
	КонецЕсли;
	Если ЭтоСкрываемаяГруппа(Объект) Тогда
		Возврат "__skip__";
	КонецЕсли;
	СобственнаяВидимость = БезопасноеЗначениеМетодаСКешемMCP(Объект, "ТекущаяВидимость", БезопасноеСвойствоСКешемMCP(Объект, "Видимость", Истина, КешСериализации), КешСериализации);
	СобственнаяДоступность = БезопасноеЗначениеМетодаСКешемMCP(Объект, "ТекущаяДоступность", БезопасноеСвойствоСКешемMCP(Объект, "Доступность", Истина, КешСериализации), КешСериализации);
	СобственноеТолькоПросмотр = БезопасноеЗначениеМетодаСКешемMCP(Объект, "ТекущееТолькоПросмотр", БезопасноеСвойствоСКешемMCP(Объект, "ТолькоПросмотр", Ложь, КешСериализации), КешСериализации);
	Видимость = СобственнаяВидимость;
	Доступность = СобственнаяДоступность;
	ТолькоПросмотр = СобственноеТолькоПросмотр;
	Если Не ПоказыватьСкрытые И ТекущаяГлубина > 0 И Не Видимость Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипСтрокой = Строка(ТипЗнч(Объект));
	ТипОбъекта = НРег(НормализованноеИмяТипа(ТипСтрокой));
	Результат = Новый Структура;
	Результат.Вставить("type", ТипСтрокой);
	Результат.Вставить("name", БезопасноеСвойствоСКешемMCP(Объект, "Имя", "", КешСериализации));
	Результат.Вставить("title", БезопасныйЗаголовокСКешемMCP(Объект, КешСериализации));
	Результат.Вставить("form_name", БезопасноеСвойствоСКешемMCP(Объект, "ИмяФормы", "", КешСериализации));
	Результат.Вставить("navigation_url", БезопасноеСвойствоСКешемMCP(Объект, "НавигационнаяСсылка", "", КешСериализации));
	Результат.Вставить("main", БезопасноеСвойствоСКешемMCP(Объект, "Основное", БезопасноеСвойствоСКешемMCP(Объект, "ГлавноеОкно", Ложь, КешСериализации), КешСериализации));
	Результат.Вставить("home", БезопасноеСвойствоСКешемMCP(Объект, "НачальнаяСтраница", Ложь, КешСериализации));
	Результат.Вставить("visible", Видимость);
	Результат.Вставить("available", Доступность);
	Результат.Вставить("enabled", Доступность);
	Результат.Вставить("read_only", ТолькоПросмотр);
	Результат.Вставить("current_visible", СобственнаяВидимость);
	Результат.Вставить("current_available", СобственнаяДоступность);
	Результат.Вставить("current_read_only", СобственноеТолькоПросмотр);

	Если ВключатьДанные И (ТипОбъекта = "тестируемоеполеформы" Или ТипОбъекта = "тестируемаякнопкаформы"
		Или ТипОбъекта = "тестируемаякнопкакоманднойпанели" Или ТипОбъекта = "тестируемаятаблицаформы"
		Или ТипОбъекта = "тестируемыенадпись" Или ТипОбъекта = "тестируемыйпереключатель"
		Или ТипОбъекта = "тестируемыйфлажок" Или ТипОбъекта = "тестируемоеполевводасписком") Тогда
		Попытка
			Текст = Объект.ПолучитьПредставлениеДанных();
			Если ТипЗнч(Текст) = Тип("Строка") Тогда
				Результат.Вставить("data", Текст);
			Иначе
				Результат.Вставить("data", Строка(Текст));
			КонецЕсли;
		Исключение
			Результат.Вставить("data", "");
		КонецПопытки;
	Иначе
		Результат.Вставить("data", "");
	КонецЕсли;

	Если Не СериализоватьДетей Тогда
		Возврат Результат;
	КонецЕсли;

	Дети = БезопасныеПодчиненныеСКешемMCP(Объект, КешСериализации);
	МассивДетей = Новый Массив;
	ИмяТекущейСтраницы = "";
	ТекущаяСтраницаГруппы = Неопределено;
	Попытка
		ТекущаяСтраницаГруппы = Объект.ПолучитьТекущуюСтраницу();
		ИмяТекущейСтраницы = БезопасноеСвойствоСКешемMCP(ТекущаяСтраницаГруппы, "Имя", "", КешСериализации);
		Если Не ПустаяСтрока(ИмяТекущейСтраницы) Тогда
			Результат.Вставить("current_page_name", ИмяТекущейСтраницы);
			Результат.Вставить("current_page", ОбъектВСтруктуру(ТекущаяСтраницаГруппы, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, Ложь, СчетчикУзлов, Ложь));
		КонецЕсли;
	Исключение
		ИмяТекущейСтраницы = "";
		ТекущаяСтраницаГруппы = Неопределено;
	КонецПопытки;
	Если Не ПустаяСтрока(ИмяТекущейСтраницы) Тогда
		Страницы = Новый Массив;
		Для Каждого СтраницаГруппы Из Дети Цикл
			ДанныеСтраницы = ОбъектВСтруктуру(СтраницаГруппы, ТекущаяГлубина + 1, Истина, Видимость, Доступность, ТолькоПросмотр, КешСериализации, Ложь, Ложь, СчетчикУзлов, Ложь);
			Если ДанныеСтраницы <> Неопределено Тогда
				ДанныеСтраницы.Вставить("current", БезопасноеСвойствоСКешемMCP(СтраницаГруппы, "Имя", "", КешСериализации) = ИмяТекущейСтраницы);
				Страницы.Добавить(ДанныеСтраницы);
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("pages", Страницы);
	КонецЕсли;
	Если ВключатьКомандныеПанели И (ТипОбъекта = "тестируемаяформа" Или ТипОбъекта = "тестируемоеокно" Или ТипОбъекта = "тестируемаятаблицаформы" Или ТипОбъекта = "тестируемаягруппаформы") Тогда
		Панель = КоманднаяПанельСКешемMCP(Объект, КешСериализации);
		Если Панель <> Неопределено Тогда
			СтруктураПанели = ОбъектВСтруктуру(Панель, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов, ВключатьКомандныеПанели);
			Если СтруктураПанели <> Неопределено Тогда
				МассивДетей.Добавить(СтруктураПанели);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СкрытыхДетей = 0;
	Для Каждого Ребенок Из Дети Цикл
		ИмяРебенка = БезопасноеСвойствоСКешемMCP(Ребенок, "Имя", "", КешСериализации);
		Если Не ПоказыватьСкрытые И Не ПустаяСтрока(ИмяТекущейСтраницы) И ИмяРебенка <> ИмяТекущейСтраницы Тогда
			СкрытыхДетей = СкрытыхДетей + 1;
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(ИмяТекущейСтраницы) И ИмяРебенка = ИмяТекущейСтраницы Тогда
			Продолжить;
		КонецЕсли;
		СтруктураРебенка = ОбъектВСтруктуру(Ребенок, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов, ВключатьКомандныеПанели);
		Если СтруктураРебенка <> Неопределено Тогда
			Если СтруктураРебенка = "__skip__" Тогда
				ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, Ребенок, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, СчетчикУзлов, ВключатьКомандныеПанели);
			Иначе
				МассивДетей.Добавить(СтруктураРебенка);
			КонецЕсли;
		Иначе
			СкрытыхДетей = СкрытыхДетей + 1;
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("children", МассивДетей);
	Если СкрытыхДетей > 0 Тогда
		Результат.Вставить("hidden_children_count", СкрытыхДетей);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, ПропущеннаяГруппа, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации = Неопределено, ВключатьДанные = Истина, СчетчикУзлов = Неопределено, ВключатьКомандныеПанели = Истина)
	ПодчиненныеПропущенной = БезопасныеПодчиненныеСКешемMCP(ПропущеннаяГруппа, КешСериализации);
	Для Каждого ПодчиненныйПропущенной Из ПодчиненныеПропущенной Цикл
		СтруктураПодчиненного = ОбъектВСтруктуру(ПодчиненныйПропущенной, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов, ВключатьКомандныеПанели);
		Если СтруктураПодчиненного <> Неопределено Тогда
			Если СтруктураПодчиненного = "__skip__" Тогда
				ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, ПодчиненныйПропущенной, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации, ВключатьДанные, СчетчикУзлов, ВключатьКомандныеПанели);
			Иначе
				МассивДетей.Добавить(СтруктураПодчиненного);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Попытка
		ПанельГруппы = КоманднаяПанельСКешемMCP(ПропущеннаяГруппа, КешСериализации);
		Если ПанельГруппы <> Неопределено Тогда
			ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, ПанельГруппы, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации, ВключатьДанные, СчетчикУзлов, ВключатьКомандныеПанели);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область Утилиты

&НаКлиенте
Функция СвойствоСтруктуры(Структура, ИмяСвойства, ЗначениеПоУмолчанию)
	Если Структура = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Структура.Свойство(ИмяСвойства) Тогда
		Возврат Структура[ИмяСвойства];
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
КонецФункции

#КонецОбласти
