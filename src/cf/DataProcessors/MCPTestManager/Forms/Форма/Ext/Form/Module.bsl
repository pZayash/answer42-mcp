&НаКлиенте
Функция ЗапуститьКлиентТестирования(ПутьПлатформы, ТипПодключения, СтрокаПодключения, Пользователь, Пароль, Порт, ДопАргументы = "", ПараметрC = "", ВнешняяОбработка = "")
	КаталогЛогов = КаталогЛоговТестКлиента();
	СоздатьКаталог(КаталогЛогов);
	ИмяЛога = "test_client_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".log";
	ПолноеИмяЛога = КаталогЛогов + ИмяЛога;
	ПолноеИмяStdoutЛога = КаталогЛогов + "stdout_" + ИмяЛога;
	ФайлЛогаТестКлиента = ПолноеИмяЛога;

	ДополнительнаяКоманднаяСтрока = НормализованныеДопАргументыКоманднойСтроки(ДопАргументы, ПараметрC, ВнешняяОбработка);
	ПараметрПодключения = ПараметрКоманднойСтрокиПодключенияТестКлиента(ТипПодключения, СтрокаПодключения);
	КомандаЗапуска = """" + ПутьПлатформы + """" + " ENTERPRISE " + ПараметрПодключения + " /Lru /VLru_RU /DisableStartupMessages /DisableStartupDialogs /DisableUnrecoverableErrorMessage /Out " + """" + ПолноеИмяЛога + """" + " " + ДополнительнаяКоманднаяСтрока + " /TESTCLIENT -TPort" + Формат(Порт, "ЧГ=");
	Если Не ПустаяСтрока(Пользователь) Тогда
		КомандаЗапуска = КомандаЗапуска + " /N " + """" + Пользователь + """" + " /P " + """" + Пароль + """";
	КонецЕсли;
	КомандаЗапуска = КомандаЗапускаКлиентаВФоне(КомандаЗапуска, ПолноеИмяStdoutЛога);
	КомандаЗапускаДляЛога = КомандаЗапуска;
	Если Не ПустаяСтрока(Пароль) Тогда
		КомандаЗапускаДляЛога = СтрЗаменить(КомандаЗапускаДляЛога, " /P " + """" + Пароль + """", " /P " + """" + "***" + """");
	КонецЕсли;
	Лог("ЗапуститьКлиентТестирования: " + КомандаЗапускаДляЛога);
	Сообщить("MCP: запускаю тест-клиент: " + КомандаЗапускаДляЛога);

	Попытка
		КомандаСистемы(КомандаЗапуска, КаталогЛогов);
		Лог("ЗапуститьКлиентТестирования: клиент запущен через КомандаСистемы в фоне");
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ЗапуститьКлиентТестирования: исключение " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;

	Возврат Новый Структура("ИдентификаторПроцесса,Команда,Лог", 0, КомандаЗапуска, ПолноеИмяЛога);
КонецФункции

&НаКлиенте
Функция ЭтоWindowsMCP()
	Возврат ПолучитьРазделительПути() = "\\";
КонецФункции

&НаКлиенте
Функция КомандаЗапускаКлиентаВФоне(КомандаЗапуска, ПолноеИмяStdoutЛога)
	Если ЭтоWindowsMCP() Тогда
		Возврат "cmd /C start """" /B " + КомандаЗапуска + " > " + """" + ПолноеИмяStdoutЛога + """" + " 2>&1";
	КонецЕсли;
	Возврат КомандаЗапуска + " > " + """" + ПолноеИмяStdoutЛога + """" + " 2>&1 &";
КонецФункции

&НаКлиенте
Функция ПараметрКоманднойСтрокиПодключенияТестКлиента(ТипПодключения, СтрокаПодключения)
	Если ТипПодключения = "ws" Или ТипПодключения = "http" Тогда
		ИмяПараметра = "/WS";
	ИначеЕсли ТипПодключения = "server" Тогда
		ИмяПараметра = "/S";
	ИначеЕсли ТипПодключения = "file-direct" Или ТипПодключения = "direct-file" Или ТипПодключения = "file_direct" Или ТипПодключения = "direct_file" Тогда
		ИмяПараметра = "/F";
	Иначе
		ВызватьИсключение "Неподдерживаемый тип подключения тест-клиента: " + ТипПодключения;
	КонецЕсли;

	Возврат ИмяПараметра + " " + """" + СтрокаПодключения + """";
КонецФункции

&НаКлиенте
Функция НормализованныеДопАргументыКоманднойСтроки(ДопАргументы, ПараметрC, ВнешняяОбработка)
	Результат = СокрЛП(ДопАргументы);
	Если Не ПустаяСтрока(ВнешняяОбработка) Тогда
		Результат = Результат + " /Execute " + """" + ВнешняяОбработка + """";
	КонецЕсли;
	Если Не ПустаяСтрока(ПараметрC) Тогда
		СтарыйПараметрC = ЗначениеПараметраКоманднойСтроки(Результат, "/C");
		Если Не ПустаяСтрока(СтарыйПараметрC) Тогда
			Результат = УдалитьПараметрКоманднойСтроки(Результат, "/C");
			Результат = Результат + " /C " + """" + СтарыйПараметрC + ";" + ПараметрC + """";
		Иначе
			Результат = Результат + " /C " + """" + ПараметрC + """";
		КонецЕсли;
	КонецЕсли;
	Возврат СокрЛП(Результат);
КонецФункции

&НаКлиенте
Функция ЗначениеПараметраКоманднойСтроки(КоманднаяСтрока, ИмяПараметра)
	Позиция = СтрНайти(НРег(КоманднаяСтрока), НРег(ИмяПараметра));
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = СокрЛП(Сред(КоманднаяСтрока, Позиция + СтрДлина(ИмяПараметра)));
	Если ПустаяСтрока(Хвост) Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Хвост, 1) = """" Тогда
		КонецКавычки = СтрНайти(Сред(Хвост, 2), """");
		Если КонецКавычки > 0 Тогда
			Возврат Лев(Сред(Хвост, 2), КонецКавычки - 1);
		КонецЕсли;
		Возврат Сред(Хвост, 2);
	КонецЕсли;
	ПозицияПробела = СтрНайти(Хвост, " ");
	Если ПозицияПробела = 0 Тогда
		Возврат Хвост;
	КонецЕсли;
	Возврат Лев(Хвост, ПозицияПробела - 1);
КонецФункции

&НаКлиенте
Функция УдалитьПараметрКоманднойСтроки(КоманднаяСтрока, ИмяПараметра)
	Позиция = СтрНайти(НРег(КоманднаяСтрока), НРег(ИмяПараметра));
	Если Позиция = 0 Тогда
		Возврат КоманднаяСтрока;
	КонецЕсли;
	ЛеваяЧасть = Лев(КоманднаяСтрока, Позиция - 1);
	Хвост = СокрЛП(Сред(КоманднаяСтрока, Позиция + СтрДлина(ИмяПараметра)));
	Если ПустаяСтрока(Хвост) Тогда
		Возврат СокрЛП(ЛеваяЧасть);
	КонецЕсли;
	Если Лев(Хвост, 1) = """" Тогда
		КонецКавычки = СтрНайти(Сред(Хвост, 2), """");
		Если КонецКавычки > 0 Тогда
			ПраваяЧасть = Сред(Сред(Хвост, 2), КонецКавычки + 1);
		Иначе
			ПраваяЧасть = "";
		КонецЕсли;
	Иначе
		ПозицияПробела = СтрНайти(Хвост, " ");
		Если ПозицияПробела = 0 Тогда
			ПраваяЧасть = "";
		Иначе
			ПраваяЧасть = Сред(Хвост, ПозицияПробела + 1);
		КонецЕсли;
	КонецЕсли;
	Возврат СокрЛП(ЛеваяЧасть + " " + ПраваяЧасть);
КонецФункции

&НаКлиенте
Функция КаталогЛоговТестКлиента()
	Возврат КаталогВременныхФайлов() + "mcp_test_client" + ПолучитьРазделительПути();
КонецФункции

&НаКлиенте
Функция ХвостФайлаТестаКлиента(ИмяФайла, КоличествоСтрок = 80)
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;
	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		Возврат "Файл лога тест-клиента не найден: " + ИмяФайла;
	КонецЕсли;
	Строки = Новый Массив;
	Попытка
		Чтение = Новый ЧтениеТекста(ИмяФайла);
		Пока Истина Цикл
			СтрокаЛога = Чтение.ПрочитатьСтроку();
			Если СтрокаЛога = Неопределено Тогда
				Прервать;
			КонецЕсли;
			Строки.Добавить(СтрокаЛога);
			Если Строки.Количество() > КоличествоСтрок Тогда
				Строки.Удалить(0);
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Возврат "Не удалось прочитать лог тест-клиента " + ИмяФайла + ": " + ОписаниеОшибки();
	КонецПопытки;
	Результат = "";
	Для Каждого СтрокаЛога Из Строки Цикл
		Результат = Результат + СтрокаЛога + Символы.ПС;
	КонецЦикла;
	Возврат Результат;
КонецФункции

