&НаКлиенте
Функция СписокОконКакСтруктуру(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	АктивныйЗаголовок = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	АктивнаяСсылка = БезопасноеСвойство(АктивноеОкно, "НавигационнаяСсылка", "");
	ВсеОкна = ОкнаТестируемогоПриложения();
	Результат = Новый Массив;
	Индекс = 0;
	Для Каждого ТекущееОкно Из ВсеОкна Цикл
		СтрокаОкна = ОбъектВСтруктуру(ТекущееОкно, 0);
		СтрокаОкна.Вставить("index", Индекс);
		ЗаголовокОкна = БезопасноеСвойство(ТекущееОкно, "Заголовок", "");
		СсылкаОкна = БезопасноеСвойство(ТекущееОкно, "НавигационнаяСсылка", "");
		СтрокаОкна.Вставить("active", ЗаголовокОкна = АктивныйЗаголовок И СсылкаОкна = АктивнаяСсылка);
		СтрокаОкна.Вставить("navigation_link", СсылкаОкна);
		Результат.Добавить(СтрокаОкна);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Новый Структура("count,active_title,active_navigation_link,windows", Результат.Количество(), АктивныйЗаголовок, АктивнаяСсылка, Результат);
КонецФункции

&НаКлиенте
Функция АктивироватьОкноMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Индекс = СвойствоСтруктуры(Параметры, "index", -1);
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	ВсеОкна = ОкнаТестируемогоПриложения();
	НайденноеОкно = Неопределено;
	НайденныйИндекс = -1;
	ТекущийИндекс = 0;

	Для Каждого ТекущееОкно Из ВсеОкна Цикл
		Если Индекс >= 0 И ТекущийИндекс = Индекс Тогда
			НайденноеОкно = ТекущееОкно;
			НайденныйИндекс = ТекущийИндекс;
			Прервать;
		КонецЕсли;
		ОкноИмя = БезопасноеСвойство(ТекущееОкно, "Имя", "");
		ОкноЗаголовок = БезопасноеСвойство(ТекущееОкно, "Заголовок", "");
		Если (Имя <> "" И ОкноИмя = Имя)
			Или (Заголовок <> "" И СтрНайти(НРег(ОкноЗаголовок), НРег(Заголовок)) > 0) Тогда
			НайденноеОкно = ТекущееОкно;
			НайденныйИндекс = ТекущийИндекс;
			Прервать;
		КонецЕсли;
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;

	Если НайденноеОкно = Неопределено Тогда
		Возврат Новый Структура("activated,index,count,reason", Ложь, Индекс, ВсеОкна.Количество(), "window_not_found");
	КонецЕсли;

	НайденноеОкно.Активизировать();
	Возврат Новый Структура("activated,index,count,window", Истина, НайденныйИндекс, ВсеОкна.Количество(), ОбъектВСтруктуру(НайденноеОкно, 0));
КонецФункции

&НаКлиенте
Функция ПерейтиАктивнымОкномMCP(Действие, Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИсходноеОкно = ОбъектВСтруктуру(АктивноеОкно, 0);
	Если Действие = "start_page" Тогда
		АктивноеОкно.ПерейтиКНачальнойСтранице();
	ИначеЕсли Действие = "previous_window" Тогда
		АктивноеОкно.ПерейтиКПредыдущемуОкну();
	ИначеЕсли Действие = "next_window" Тогда
		АктивноеОкно.ПерейтиКСледующемуОкну();
	Иначе
		ВызватьИсключение "Неизвестное действие окна: " + Действие;
	КонецЕсли;
	НовоеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Возврат Новый Структура("performed,action,before,active_window", Истина, Действие, ИсходноеОкно, ОбъектВСтруктуру(НовоеОкно, 0));
КонецФункции

&НаКлиенте
Функция ОжидатьОбъектMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	ТипОбъекта = СвойствоСтруктуры(Параметры, "type", "");
	Таймаут = СвойствоСтруктуры(Параметры, "timeout", 15);

	ПараметрыПоиска = Новый Структура;
	Если Имя <> "" Тогда ПараметрыПоиска.Вставить("Имя", Имя); КонецЕсли;
	Если Заголовок <> "" Тогда ПараметрыПоиска.Вставить("Заголовок", Заголовок); КонецЕсли;
	Если ТипОбъекта <> "" Тогда ПараметрыПоиска.Вставить("Тип", ТипОбъекта); КонецЕсли;

	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецОжидания = Начало + Таймаут * 1000;
	НайденныйОбъект = Неопределено;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() <= КонецОжидания Цикл
		НайденныйОбъект = НайтиОбъектРекурсивно(АктивноеОкно, Имя, Заголовок, ТипОбъекта, 0);
		Если НайденныйОбъект <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Прошло = (Конец - Начало) / 1000;

	Если НайденныйОбъект = Неопределено Тогда
		Возврат Новый Структура("found,elapsed_seconds,reason", Ложь, Прошло, "object_not_found");
	Иначе
		Возврат Новый Структура("found,elapsed_seconds,object", Истина, Прошло, ОбъектВСтруктуру(НайденныйОбъект, 0));
	КонецЕсли;
КонецФункции

