Функция НайтиРодительскуюСтраницу(Объект)
	Текущий = Объект;
	Пока Текущий <> Неопределено Цикл
		Попытка
			Если Найти(НРег(Строка(ТипЗнч(Текущий))), "тестируемаягруппаформы") > 0 Тогда
				Вид = Строка(Текущий.Вид);
				Если Вид = "Страница" Тогда
					Возврат Текущий;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Текущий = Текущий.ПолучитьРодителя();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПроверитьАктивностьСтраницыРодителя(Объект)
	Страница = НайтиРодительскуюСтраницу(Объект);
	Если Страница = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяСтраницы = БезопасноеСвойство(Страница, "Имя", "");
	ЗаголовокСтраницы = БезопасныйЗаголовок(Страница);
	РодительСтраницы = Неопределено;
	Попытка
		РодительСтраницы = Страница.ПолучитьРодителя();
	Исключение
	КонецПопытки;
	Если РодительСтраницы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекущаяСтраница = Неопределено;
	Попытка
		ТекущаяСтраница = РодительСтраницы.ПолучитьТекущуюСтраницу();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТекущаяСтраница = Страница Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяТекущей = БезопасноеСвойство(ТекущаяСтраница, "Имя", "");
	ТекстОшибки = "Элемент находится на неактивной странице '" + ?(ПустаяСтрока(ЗаголовокСтраницы), ИмяСтраницы, ЗаголовокСтраницы) + "'";
	Если Не ПустаяСтрока(ИмяТекущей) Тогда
		ТекстОшибки = ТекстОшибки + ". Активная страница: '" + ИмяТекущей + "'";
	КонецЕсли;
	ТекстОшибки = ТекстОшибки + ". Активируйте страницу '" + ?(ПустаяСтрока(ЗаголовокСтраницы), ИмяСтраницы, ЗаголовокСтраницы) + "' через focus_object";
	Возврат ТекстОшибки;
КонецФункции
&НаКлиенте
Функция АктивизироватьПоле(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ?(ИскатьПоЗаголовку, ИмяПоля, ""), "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;
	Если ВидГруппыФормы(Поле) <> "Страница" Тогда
		ОшибкаАктивности = ПроверитьАктивностьСтраницыРодителя(Поле);
		Если ОшибкаАктивности <> Неопределено Тогда
			ВызватьИсключение ОшибкаАктивности;
		КонецЕсли;
	КонецЕсли;
	Поле.Активизировать();
	Возврат Новый Структура("activated,field", Истина, ИмяПоля);
КонецФункции

&НаКлиенте
Функция ВыбратьПолеИзСпискаMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ?(ИскатьПоЗаголовку, ИмяПоля, ""), "", 0);
	Если Поле = Неопределено Тогда
		Попытка
			Поле = ТестируемоеПриложение.ПолучитьОбъект(Неопределено, ?(ИскатьПоЗаголовку, ИмяПоля, ""), ИмяПоля, 2);
		Исключение
			Поле = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;
	Поле.Активизировать();
	Поле.Выбрать();
	Возврат Новый Структура("opened,field", Истина, ИмяПоля);
КонецФункции

&НаКлиенте
Функция ВыбратьПервуюСтрокуПоляMCP(Параметры)
	ИсходноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИсходныйЗаголовок = БезопасноеСвойство(ИсходноеОкно, "Заголовок", "");
	РезультатОткрытия = ВыбратьПолеИзСпискаMCP(Параметры);

	// Ждем появления формы выбора, отличной от исходной формы объекта.
	АктивноеОкно = Неопределено;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 5000 Цикл
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") <> ИсходныйЗаголовок Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если АктивноеОкно = Неопределено Тогда
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	КонецЕсли;

	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, "Список", "", 0);
	Если Таблица = Неопределено Тогда
		Попытка
			Таблица = ТестируемоеПриложение.ПолучитьОбъект(Тип("ТестируемаяТаблицаФормы"), "", "Список", 2);
		Исключение
			Таблица = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Таблица = Неопределено Тогда
		ВызватьИсключение "Таблица выбора не найдена в форме: " + БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	КонецЕсли;

	Таблица.Активизировать();
	// В некоторых формах выбора для управляемого списка штатно отрабатывает команда контекстного меню "Выбрать".
	КнопкаВыбратьСтроку = НайтиКнопку(АктивноеОкно, "СписокКонтекстноеМенюВыбрать", "", 0);
	Если КнопкаВыбратьСтроку <> Неопределено Тогда
		КнопкаВыбратьСтроку.Нажать();
	Иначе
		Таблица.Выбрать();
	КонецЕсли;

	// Даем форме выбора закрыться и исходной форме принять выбранную ссылку.
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 3000 Цикл
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") = ИсходныйЗаголовок Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("selected,field,source_window", Истина, СвойствоСтруктуры(Параметры, "field_name", ""), ИсходныйЗаголовок);
КонецФункции

