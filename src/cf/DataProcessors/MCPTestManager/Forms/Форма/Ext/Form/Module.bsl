#Область Логирование
// BSLLS:DeprecatedCurrentDate-off

&НаКлиенте
Процедура Лог(Сообщение)
	Если ФайлЛога = Неопределено Тогда
		Если ПустаяСтрока(ИмяФайлаЛога) Тогда
			ИмяФайлаЛога = КаталогВременныхФайлов() + "mcp_manager_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "") + ".log";
		КонецЕсли;
		ФайлЛога = Новый Файл(ИмяФайлаЛога);
	КонецЕсли;
	Запись = Новый ЗаписьТекста(ФайлЛога.ПолноеИмя,,, Истина);
	Запись.ЗаписатьСтроку(Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + " | " + Сообщение);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КлючСоединенияWebSocket = "MCPTestManagerBridge";
	АдресWebSocket = АдресWebSocketИзПараметраЗапуска();
	WebSocketПодключен = Ложь;

	Лог("ПриОткрытии: ПараметрЗапуска=" + Строка(ПараметрЗапуска));
	Лог("ПриОткрытии: АдресWebSocket=" + АдресWebSocket);

	Попытка
		WS_Обработчики = Новый ОбработчикиWebSocketКлиентСоединения;
		WS_Обработчики.Модуль = ЭтаФорма;
		WS_Обработчики.ОбработчикОткрытияСоединения = "ПриОткрытииСоединения";
		WS_Обработчики.ОбработчикПолученияСообщения = "ПриПолученииСообщения";
		WS_Обработчики.ОбработчикОшибки = "ПриОшибкеСоединения";
		WS_Обработчики.ОбработчикЗакрытияСоединения = "ПриЗакрытииСоединения";

		Лог("ПриОткрытии: обработчики WS созданы, отложенный запуск через 1с");
		ПодключитьОбработчикОжидания("ОткрытьWebSocket", 1, Ложь);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ПриОткрытии: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
		Сообщить("MCP: ошибка при подготовке WebSocket: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция АдресWebSocketИзПараметраЗапуска()
	АдресПоУмолчанию = "ws://localhost:8765/bridge";
	Параметр = СокрЛП(Строка(ПараметрЗапуска));
	Если ПустаяСтрока(Параметр) Тогда
		Лог("АдресWebSocketИзПараметраЗапуска: пустой /C, fallback=" + АдресПоУмолчанию);
		Возврат АдресПоУмолчанию;
	КонецЕсли;

	Если Лев(НРег(Параметр), 5) = "ws://" Или Лев(НРег(Параметр), 6) = "wss://" Тогда
		Возврат Параметр;
	КонецЕсли;

	Лог("АдресWebSocketИзПараметраЗапуска: некорректный /C=" + Параметр + ", fallback=" + АдресПоУмолчанию);
	Возврат АдресПоУмолчанию;
КонецФункции

&НаКлиенте
Процедура ОткрытьWebSocket() Экспорт
	Если WS_Обработчики = Неопределено Тогда
		Лог("ОткрытьWebSocket: обработчики не инициализированы - пропуск");
		Возврат;
	КонецЕсли;

	Если WebSocketПодключен Тогда
		Лог("ОткрытьWebSocket: соединение уже открыто - пропуск");
		Возврат;
	КонецЕсли;

	Попытка
		ПараметрыСоединения = Новый ПараметрыWebSocketКлиентСоединения;
		ПараметрыСоединения.Таймаут = 10;
		Лог("ОткрытьWebSocket: вызываю WebSocketКлиентСоединения.ОткрытьСоединение");
		СоединениеWebSocket = WebSocketКлиентСоединения.ОткрытьСоединение(КлючСоединенияWebSocket, АдресWebSocket, WS_Обработчики);
		Лог("ОткрытьWebSocket: ОткрытьСоединение вернул " + Строка(СоединениеWebSocket));
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ОткрытьWebSocket: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область JSON

&НаКлиенте
Функция ЗначениеВJSON(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаКлиенте
Функция JSONВЗначение(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON);
КонецФункции

#КонецОбласти

#Область WebSocket

&НаКлиенте
Процедура ПриОткрытииСоединения(Соединение) Экспорт
	WebSocketПодключен = Истина;
	Лог("ПриОткрытииСоединения: WS открыт, отправляю hello");
	Сообщить("MCP: WebSocket соединение открыто, отправляю hello");
	Ответ = Новый Структура;
	Ответ.Вставить("type", "hello");
	Ответ.Вставить("role", "bridge");
	Ответ.Вставить("version", "0.1.0");
	Ответ.Вставить("platform", "1c-enterprise");
	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
	Лог("ПриОткрытииСоединения: hello отправлен");
КонецПроцедуры

&НаКлиенте
Процедура ПриПолученииСообщения(Соединение, Сообщение) Экспорт
	Лог("ПриПолученииСообщения: " + Строка(Сообщение));
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Сообщение = ПолучитьСтрокуИзДвоичныхДанных(Сообщение, КодировкаТекста.UTF8);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("type", "response");

	Попытка
		Запрос = JSONВЗначение(Сообщение);
		Идентификатор = СвойствоСтруктуры(Запрос, "id", "");
		Метод = СвойствоСтруктуры(Запрос, "method", "");
		ПараметрыКоманды = СвойствоСтруктуры(Запрос, "params", Новый Структура);
		Ответ.Вставить("id", Идентификатор);

		Результат = ВыполнитьКоманду(Метод, ПараметрыКоманды);
		ДиагностикаКлиента = ПроверитьСостояниеКлиентаПослеШага();
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Результат.Вставить("client_diagnostics", ДиагностикаКлиента);
		КонецЕсли;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", Результат);
		Лог("ПриПолученииСообщения: метод=" + Метод + " выполнен");
	Исключение
		Инфо = ИнформацияОбОшибке();
		Если Не Ответ.Свойство("id") Тогда
			Ответ.Вставить("id", "");
		КонецЕсли;
		Ответ.Вставить("ok", Ложь);
		Ответ.Вставить("error", ПодробноеПредставлениеОшибки(Инфо));
		Лог("ПриПолученииСообщения: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;

	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеСоединения(Соединение, КодОшибки, Описание) Экспорт
	Лог("ПриОшибкеСоединения: код=" + Строка(КодОшибки) + " описание=" + Описание);
	Сообщить("MCP: ошибка WebSocket " + Строка(КодОшибки) + ": " + Описание);
	СоединениеWebSocket = Неопределено;
	WebSocketПодключен = Ложь;
	ЗапланироватьПереподключениеWebSocket();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииСоединения(Соединение, КодЗакрытия) Экспорт
	Лог("ПриЗакрытииСоединения: код=" + Строка(КодЗакрытия));
	Сообщить("MCP: WebSocket закрыт, код=" + Строка(КодЗакрытия));
	СоединениеWebSocket = Неопределено;
	WebSocketПодключен = Ложь;
	ЗапланироватьПереподключениеWebSocket();
КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьПереподключениеWebSocket()

	Если WS_Обработчики = Неопределено Тогда
		Лог("ЗапланироватьПереподключениеWebSocket: обработчики не инициализированы");
		Возврат;
	КонецЕсли;

	Попытка
		ОтключитьОбработчикОжидания("ОткрытьWebSocket");
	Исключение
		// Обработчик мог быть ещё не подключен.
	КонецПопытки;

	Лог("ЗапланироватьПереподключениеWebSocket: повтор через 3с");
	ПодключитьОбработчикОжидания("ОткрытьWebSocket", 3, Ложь);

КонецПроцедуры

