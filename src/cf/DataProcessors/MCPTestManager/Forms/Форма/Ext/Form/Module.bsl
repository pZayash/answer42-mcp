&НаКлиенте
Функция ВариантыВыпадающегоСпискаПоляMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Таймаут = СвойствоСтруктуры(Параметры, "timeout", 10);
	// выпадающего списка.  Глубина поиска поля управляется отдельно, чтобы
	// глубокие формы не ломали получение простого списка выбора.
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();

	ИскомоеИмя = ?(ИскатьПоЗаголовку, "", ИмяПоля);
	ИскомыйЗаголовок = ?(ИскатьПоЗаголовку, ИмяПоля, "");
	Диагностика = Новый Массив;
	Поле = НайтиПолеФормыДляВыпадающегоСпискаMCP(АктивноеОкно, ИскомоеИмя, ИскомыйЗаголовок, Диагностика);

	Если Поле = Неопределено Тогда
		Возврат Новый Структура("found,name,title,opened,items,diagnostics", Ложь, ИмяПоля, "", Ложь, Новый Массив, Диагностика);
	КонецЕсли;

	Варианты = Новый Массив;
	Открыт = Ложь;
	Источник = "choice_list_presentations_opened";

	Попытка
		Поле.Активизировать();
	Исключение
		Диагностика.Добавить("activate_before_presentations_failed: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		// Для ссылочных полей платформа часто заполняет представления списка выбора
		// только после фактического открытия dropdown. Поэтому сначала открываем
		// список, затем читаем ПолучитьПредставлениеСпискаВыбора().
		Поле.ОткрытьВыпадающийСписок();
		Поле.ОжидатьФормированияВыпадающегоСписка(Таймаут);
		Открыт = ОткрытВыпадающийСписокПоляMCP(Поле);
		Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
		ВариантыИзПредставленийСпискаВыбора(Представления, Варианты);
		Попытка
			Поле.ЗакрытьВыпадающийСписок();
		Исключение
			Диагностика.Добавить("close_after_presentations_failed: " + ОписаниеОшибки());
		КонецПопытки;
		Если Варианты.Количество() > 0 Тогда
			Возврат Новый Структура("found,field,opened,items,diagnostics,source", Истина, ОбъектВСтруктуру(Поле, 0), Открыт, Варианты, Диагностика, Источник);
		КонецЕсли;
	Исключение
		Диагностика.Добавить("choice_list_presentations_opened_failed: " + ОписаниеОшибки());
		Попытка
			Поле.ЗакрытьВыпадающийСписок();
		Исключение
		КонецПопытки;
	КонецПопытки;

	Источник = "choice_list_presentations_closed";
	Попытка
		// Неинтерактивный fallback для полей, где список выбора доступен без открытия.
		Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
		ВариантыИзПредставленийСпискаВыбора(Представления, Варианты);
		Если Варианты.Количество() > 0 Тогда
			Возврат Новый Структура("found,field,opened,items,diagnostics,source", Истина, ОбъектВСтруктуру(Поле, 0), Ложь, Варианты, Диагностика, Источник);
		КонецЕсли;
	Исключение
		Диагностика.Добавить("choice_list_presentations_closed_failed: " + ОписаниеОшибки());
	КонецПопытки;

	Источник = "choice_list_property";
	Попытка
		СписокВыбора = БезопасноеСвойство(Поле, "СписокВыбора", Неопределено);
		Если СписокВыбора <> Неопределено Тогда
			ВариантыИзСпискаЗначений(СписокВыбора, Варианты);
			Если Варианты.Количество() > 0 Тогда
				Возврат Новый Структура("found,field,opened,items,diagnostics,source", Истина, ОбъектВСтруктуру(Поле, 0), Ложь, Варианты, Диагностика, Источник);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Диагностика.Добавить("choice_list_property_failed: " + ОписаниеОшибки());
	КонецПопытки;

	Источник = "dropdown_children_fallback";
	Попытка
		Поле.Активизировать();
	Исключение
		Диагностика.Добавить("activate_failed: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Если Не ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
			Поле.ОткрытьВыпадающийСписок();
		КонецЕсли;
	Исключение
		Возврат Новый Структура("found,field,opened,items,diagnostics,source,reason,error", Истина, ОбъектВСтруктуру(Поле, 0), Ложь, Варианты, Диагностика, Источник, "open_dropdown_failed", ОписаниеОшибки());
	КонецПопытки;

