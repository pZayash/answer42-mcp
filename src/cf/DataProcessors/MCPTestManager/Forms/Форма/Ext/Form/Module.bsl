&НаКлиенте
Функция НайтиПолеТаблицыРекурсивноMCP(Элемент, ИмяПоля, ИскатьПоЗаголовку, Глубина, МаксимальнаяГлубина)
	Если Элемент = Неопределено Или Глубина > МаксимальнаяГлубина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Подчиненные = БезопасныеПодчиненные(Элемент);
	Для Каждого Подчиненный Из Подчиненные Цикл
		ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
		Если ТипТек = "тестируемоеполеформы" Тогда
			ИмяТек = БезопасноеСвойство(Подчиненный, "Имя", "");
			ЗаголовокТек = БезопасныйЗаголовок(Подчиненный);
			Если (ИскатьПоЗаголовку И ЗаголовокТек = ИмяПоля) Или ((Не ИскатьПоЗаголовку) И ИмяТек = ИмяПоля) Тогда
				Возврат Подчиненный;
			КонецЕсли;
		КонецЕсли;
		НайденноеПоле = НайтиПолеТаблицыРекурсивноMCP(Подчиненный, ИмяПоля, ИскатьПоЗаголовку, Глубина + 1, МаксимальнаяГлубина);
		Если НайденноеПоле <> Неопределено Тогда
			Возврат НайденноеПоле;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
