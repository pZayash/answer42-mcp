&НаКлиенте
Функция ТекстТабличногоДокументаИзПоля(Поле, Параметры)
	Попытка
		Размеры = РазмерыТабличногоДокументаИзПоля(Поле);
		Если Размеры.Свойство("error") Тогда
			Возврат Новый Структура("error", Размеры.error);
		КонецЕсли;
		КоличествоСтрок = Размеры.rows;
		КоличествоКолонок = Размеры.columns;
		Если КоличествоСтрок = 0 Или КоличествоКолонок = 0 Тогда
			Возврат Новый Структура("rows,columns,address,row_start,row_end,column_start,column_end,cells", 0, 0, "", 0, 0, 0, 0, Новый Массив);
		КонецЕсли;
		НачальнаяСтрока = Макс(1, СвойствоСтруктуры(Параметры, "row_start", 1));
		НачальнаяКолонка = Макс(1, СвойствоСтруктуры(Параметры, "column_start", 1));
		КонечнаяСтрока = СвойствоСтруктуры(Параметры, "row_end", 0);
		КонечнаяКолонка = СвойствоСтруктуры(Параметры, "column_end", 0);
		МаксСтрок = СвойствоСтруктуры(Параметры, "max_rows", 50);
		МаксКолонок = СвойствоСтруктуры(Параметры, "max_columns", 20);
		Если КонечнаяСтрока <= 0 Тогда
			КонечнаяСтрока = ?(МаксСтрок > 0, НачальнаяСтрока + МаксСтрок - 1, КоличествоСтрок);
		КонецЕсли;
		Если КонечнаяКолонка <= 0 Тогда
			КонечнаяКолонка = ?(МаксКолонок > 0, НачальнаяКолонка + МаксКолонок - 1, КоличествоКолонок);
		КонецЕсли;
		КонечнаяСтрока = Мин(КоличествоСтрок, КонечнаяСтрока);
		КонечнаяКолонка = Мин(КоличествоКолонок, КонечнаяКолонка);
		Если НачальнаяСтрока > КоличествоСтрок Или НачальнаяКолонка > КоличествоКолонок Или КонечнаяСтрока < НачальнаяСтрока Или КонечнаяКолонка < НачальнаяКолонка Тогда
			Возврат Новый Структура("rows,columns,address,row_start,row_end,column_start,column_end,cells", КоличествоСтрок, КоличествоКолонок, "", НачальнаяСтрока, КонечнаяСтрока, НачальнаяКолонка, КонечнаяКолонка, Новый Массив);
		КонецЕсли;
		АдресОбласти = АдресОбластиТабличногоДокументаMCP(НачальнаяСтрока, НачальнаяКолонка, КонечнаяСтрока, КонечнаяКолонка);
		Ячейки = Новый Массив;
		Для НомерСтроки = НачальнаяСтрока По КонечнаяСтрока Цикл
			СтрокаТекстов = Новый Массив;
			Для НомерКолонки = НачальнаяКолонка По КонечнаяКолонка Цикл
				Попытка
					АдресЯчейки = АдресОбластиТабличногоДокументаMCP(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
					СтрокаТекстов.Добавить(Поле.ПолучитьТекстОбласти(АдресЯчейки));
				Исключение
					СтрокаТекстов.Добавить("");
				КонецПопытки;
			КонецЦикла;
			Ячейки.Добавить(СтрокаТекстов);
		КонецЦикла;
		Возврат Новый Структура("rows,columns,address,row_start,row_end,column_start,column_end,cells", КоличествоСтрок, КоличествоКолонок, АдресОбласти, НачальнаяСтрока, КонечнаяСтрока, НачальнаяКолонка, КонечнаяКолонка, Ячейки);
	Исключение
		Возврат Новый Структура("error", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция АдресОбластиТабличногоДокументаMCP(НачальнаяСтрока, НачальнаяКолонка, КонечнаяСтрока, КонечнаяКолонка)
	Начало = "R" + XMLСтрока(НачальнаяСтрока) + "C" + XMLСтрока(НачальнаяКолонка);
	Конец = "R" + XMLСтрока(КонечнаяСтрока) + "C" + XMLСтрока(КонечнаяКолонка);
	Возврат Начало + ":" + Конец;
КонецФункции

&НаКлиенте
Функция ОтображениеСостоянияТабличногоДокументаMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	Поле = НайтиТабличныйДокументПоПараметрам(АктивноеОкно, Имя, Заголовок, 0);
	Если Поле = Неопределено Тогда
		Возврат Новый Структура("found", Ложь);
	КонецЕсли;
	Попытка
		Отображение = Поле.ПолучитьОтображениеСостояния();
		Если Отображение = Неопределено Тогда
			Возврат Новый Структура("found,state_display", Истина, Неопределено);
		КонецЕсли;
		Состояние = Новый Структура;
		Состояние.Вставить("display_variant", Строка(БезопасноеСвойство(Отображение, "ВариантОтображения", "")));
		Состояние.Вставить("visible", БезопасноеСвойство(Отображение, "Видимость", Ложь));
		Состояние.Вставить("additional_show_mode", Строка(БезопасноеСвойство(Отображение, "ДополнительныйРежимОтображения", "")));
		Состояние.Вставить("command_name", Строка(БезопасноеСвойство(Отображение, "ИмяКоманды", "")));
		Состояние.Вставить("picture", Строка(БезопасноеСвойство(Отображение, "Картинка", "")));
		Состояние.Вставить("text", Строка(БезопасноеСвойство(Отображение, "Текст", "")));
		Возврат Новый Структура("found,state_display", Истина, Состояние);
	Исключение
		Возврат Новый Структура("found,error", Истина, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

