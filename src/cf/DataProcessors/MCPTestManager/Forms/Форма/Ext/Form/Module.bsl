&НаКлиенте
Функция НайтиОбъектИнтерфейса(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	ТипОбъекта = СвойствоСтруктуры(Параметры, "type", "");
	Глубина = СвойствоСтруктуры(Параметры, "max_depth", 8);
	НайденныйОбъект = НайтиОбъектРекурсивно(АктивноеОкно, Имя, Заголовок, ТипОбъекта, 0, Глубина);
	Если НайденныйОбъект = Неопределено Тогда
		Возврат Новый Структура("found,name,title", Ложь, Имя, Заголовок);
	КонецЕсли;
	Возврат Новый Структура("found,object", Истина, ОбъектВСтруктуру(НайденныйОбъект, 0, 0));
КонецФункции

&НаКлиенте
Функция НайтиОбъектРекурсивно(РодительскийОбъект, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина, МаксимальнаяГлубина)
	Если ТекущаяГлубина > МаксимальнаяГлубина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ИмяТекущего = БезопасноеСвойство(РодительскийОбъект, "Имя", "");
		ЗаголовокТекущего = БезопасныйЗаголовок(РодительскийОбъект);
		ТипТекущего = Строка(ТипЗнч(РодительскийОбъект));
		НормализованныйТип = НормализованноеИмяТипа(ТипТекущего);
		Если ОбъектСоответствует(ИмяТекущего, ЗаголовокТекущего, НормализованныйТип, Имя, Заголовок, ТипОбъекта) Тогда
			Возврат РодительскийОбъект;
		КонецЕсли;
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			РезультатПоиска = НайтиОбъектРекурсивно(Подчиненный, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина + 1, МаксимальнаяГлубина);
			Если РезультатПоиска <> Неопределено Тогда
				Возврат РезультатПоиска;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ОбъектСоответствует(ИмяОбъекта, ЗаголовокОбъекта, ТипОбъекта, ИскомоеИмя, ИскомыйЗаголовок, ИскомыйТип)
	НормализованноеИмя = НРег(СокрЛП(ИмяОбъекта));
	НормализованныйЗаголовок = НРег(СокрЛП(ЗаголовокОбъекта));
	Если Не ПустаяСтрока(ИскомоеИмя) И НормализованноеИмя <> НРег(СокрЛП(ИскомоеИмя)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(ИскомыйЗаголовок) И НРег(СокрЛП(ИскомыйЗаголовок)) <> НормализованныйЗаголовок Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(ИскомыйТип) И ТипОбъекта <> НРег(СокрЛП(ИскомыйТип)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция НормализованноеИмяТипа(ИсходныйТип)
	ИсходныйТип = СокрЛП(ИсходныйТип);
	Результат = "";
	Для Позиция = 1 По СтрДлина(ИсходныйТип) Цикл
		Символ = Сред(ИсходныйТип, Позиция, 1);
		Если Символ = " " Тогда
			Продолжить;
		КонецЕсли;
		Если Позиция > 1 И (Сред(ИсходныйТип, Позиция - 1, 1) <> "") Тогда
			Если КодСимвола(Сред(Результат, СтрДлина(Результат), 1)) >= 97 И КодСимвола(Сред(ИсходныйТип, Позиция, 1)) <= 122 Тогда
				Результат = Результат + НРег(Символ);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + НРег(Символ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция БезопасноеСвойство(Объект, ИмяСвойства, ЗначениеПоУмолчанию)
	Попытка
		Если Объект = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Значение = Объект[ИмяСвойства];
		Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция БезопасныеПодчиненные(Объект)
	Попытка
		Возврат Объект.ПолучитьПодчиненныеОбъекты();
	Исключение
		Возврат Новый Массив;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция БезопасныйЗаголовок(Объект)
	Заголовок = БезопасноеСвойство(Объект, "Заголовок", "");
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = БезопасноеСвойство(Объект, "ТекстЗаголовка", "");
	КонецЕсли;
	Возврат Заголовок;
КонецФункции

&НаКлиенте
Функция НажатьКнопку(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяКнопки = СвойствоСтруктуры(Параметры, "name", "");
	ПоискПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокПоиска = ?(ПоискПоЗаголовку, ИмяКнопки, "");
	Кнопка = НайтиКнопку(АктивноеОкно, ИмяКнопки, ЗаголовокПоиска, 0, СвойствоСтруктуры(Параметры, "max_depth", 8));
	Если Кнопка = Неопределено Тогда
		ВызватьИсключение "Кнопка не найдена: " + ИмяКнопки;
	КонецЕсли;
	Кнопка.Нажать();
	Возврат Новый Структура("pressed,name", Истина, ИмяКнопки);
КонецФункции

&НаКлиенте
Функция НайтиКнопку(РодительскийОбъект, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина, МаксимальнаяГлубина)
	Если ТекущаяГлубина > МаксимальнаяГлубина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Попытка
			ПанельРодителя = РодительскийОбъект.ПолучитьКоманднуюПанель();
			Результат = НайтиКнопку(ПанельРодителя, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина + 1, МаксимальнаяГлубина);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			ИмяТек = БезопасноеСвойство(Подчиненный, "Имя", "");
			ЗаголовокТек = БезопасныйЗаголовок(Подчиненный);
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если ТипТек = "тестируемаякнопкакоманднойпанели" Или ТипТек = "тестируемаякнопкакомандногоинтерфейса" Или ТипТек = "тестируемаякнопкаформы" Тогда
				Если КнопкаСовпадает(ИмяТек, ЗаголовокТек, ИмяКнопки, ЗаголовокКнопки) Тогда
					Возврат Подчиненный;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Попытка
				Панель = Подчиненный.ПолучитьКоманднуюПанель();
				Результат = НайтиКнопку(Панель, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина + 1, МаксимальнаяГлубина);
				Если Результат <> Неопределено Тогда
					Возврат Результат;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Результат = НайтиКнопку(Подчиненный, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина + 1, МаксимальнаяГлубина);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция КнопкаСовпадает(ИмяТек, ЗаголовокТек, ИмяКнопки, ЗаголовокКнопки)
	Если Не ПустаяСтрока(ЗаголовокКнопки) Тогда
		Возврат ЗаголовокТек = ЗаголовокКнопки Или СтрНайти(НРег(ЗаголовокТек), НРег(ЗаголовокКнопки)) > 0;
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяКнопки) Тогда
		Возврат ИмяТек = ИмяКнопки Или ЗаголовокТек = ИмяКнопки Или СтрНайти(НРег(ИмяТек), НРег(ИмяКнопки)) > 0 Или СтрНайти(НРег(ЗаголовокТек), НРег(ИмяКнопки)) > 0;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ПолучитьОбъектПриложенияMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	Таймаут = СвойствоСтруктуры(Параметры, "timeout", 0);
	ТипОбъектаСтрокой = СвойствоСтруктуры(Параметры, "type", "");
	ТипОбъекта = Неопределено;
	Если Не ПустаяСтрока(ТипОбъектаСтрокой) Тогда
		Попытка
			ТипОбъекта = Тип(ТипОбъектаСтрокой);
		Исключение
			ТипОбъекта = Неопределено;
		КонецПопытки;
