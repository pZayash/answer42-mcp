&НаКлиенте
Процедура НайтиТабличныеДокументыРекурсивно(Объект, Результат, ВключатьТекст, ТекущаяГлубина, МаксимальнаяГлубина)
	Если ТекущаяГлубина > МаксимальнаяГлубина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Подчиненные = БезопасныеПодчиненные(Объект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если ТипТек = "тестируемоеполетабличногодокументаформы" Тогда
				Элемент = Новый Структура;
				Элемент.Вставить("name", БезопасноеСвойство(Подчиненный, "Имя", ""));
				Элемент.Вставить("title", БезопасноеСвойство(Подчиненный, "Заголовок", ""));
				Если ВключатьТекст Тогда
					Попытка
						Область = Подчиненный.ПолучитьТекущуюОбласть();
						Текст = БезопасныйАдресТекущейОбласти(Область);
						Элемент.Вставить("text", Текст);
					Исключение
						Элемент.Вставить("text_error", ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
				Результат.Добавить(Элемент);
			КонецЕсли;
			НайтиТабличныеДокументыРекурсивно(Подчиненный, Результат, ВключатьТекст, ТекущаяГлубина + 1, МаксимальнаяГлубина);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
