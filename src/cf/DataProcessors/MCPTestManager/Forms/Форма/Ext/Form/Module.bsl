&НаКлиенте
Функция НайтиОбъектИнтерфейса(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	ТипОбъекта = СвойствоСтруктуры(Параметры, "type", "");
	Лог("find_object: start name='" + Имя + "' title='" + Заголовок + "' type='" + ТипОбъекта + "'");
	ОтправитьСобытиеПрогрессаMCP("find_object", "start");
	КешПоиска = НовыйКешПоискаКнопкиMCP();
	СчетчикУзлов = Новый Структура("nodes", 0);
	НайденныйОбъект = НайтиОбъектБыстроMCP(АктивноеОкно, Имя, Заголовок, ТипОбъекта, КешПоиска);
	ОтправитьСобытиеПрогрессаMCP("find_object", "fast_done", КешПоиска.Статистика);
	Если НайденныйОбъект = Неопределено Тогда
		Если ПустаяСтрока(КешПоиска.Статистика.method) Тогда
			КешПоиска.Статистика.method = "dfs_fallback";
		КонецЕсли;
		НайденныйОбъект = НайтиОбъектРекурсивно(АктивноеОкно, Имя, Заголовок, ТипОбъекта, 0, СчетчикУзлов, КешПоиска);
	КонецЕсли;
	Время = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	КешПоиска.Статистика.nodes = СчетчикУзлов.nodes;
	ОтправитьСобытиеПрогрессаMCP("find_object", "done", Новый Структура("nodes,found,ms", СчетчикУзлов.nodes, НайденныйОбъект <> Неопределено, Время));
	Лог("find_object: done ms=" + Строка(Время) + " nodes=" + Строка(СчетчикУзлов.nodes) + " found=" + Строка(НайденныйОбъект <> Неопределено));
	Если НайденныйОбъект = Неопределено Тогда
		Возврат Новый Структура("found,name,title,search_ms,nodes_visited,search_stats", Ложь, Имя, Заголовок, Время, СчетчикУзлов.nodes, КешПоиска.Статистика);
	КонецЕсли;
	Возврат Новый Структура("found,object,search_ms,nodes_visited,search_stats", Истина, ОбъектВСтруктуру(НайденныйОбъект, 0, Истина, Истина, Истина, Ложь, КешПоиска, Истина, Ложь), Время, СчетчикУзлов.nodes, КешПоиска.Статистика);
КонецФункции


&НаКлиенте
Функция НайтиОбъектБыстроMCP(РодительскийОбъект, Имя, Заголовок, ТипОбъектаСтрокой, КешПоиска = Неопределено)
	// Быстрый платформенный путь для точного поиска объекта. Семантика проверяется
	// тем же ОбъектСоответствует/ОбъектИнтерактивноДоступенMCP, затем остается DFS fallback.
	Если ПустаяСтрока(Имя) И ПустаяСтрока(Заголовок) Тогда
		Возврат Неопределено;
	КонецЕсли;
	НачалоБыстрогоПоиска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если КешПоиска <> Неопределено Тогда
		КешПоиска.Статистика.fast_attempts = КешПоиска.Статистика.fast_attempts + 1;
	КонецЕсли;
	ТипОбъекта = Неопределено;
	Если Не ПустаяСтрока(ТипОбъектаСтрокой) Тогда
		Попытка
			ТипОбъекта = Тип(ТипОбъектаСтрокой);
		Исключение
			ТипОбъекта = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Кандидат = Неопределено;
	Попытка
		Кандидат = РодительскийОбъект.НайтиОбъект(ТипОбъекта, Заголовок, Имя, 0);
	Исключение
		Кандидат = Неопределено;
	КонецПопытки;
	Если Кандидат <> Неопределено Тогда
		ИмяТек = БезопасноеСвойствоСКешемMCP(Кандидат, "Имя", "", КешПоиска);
		ЗаголовокТек = БезопасныйЗаголовокСКешемMCP(Кандидат, КешПоиска);
		ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Кандидат)));
		Если ОбъектСоответствует(ИмяТек, ЗаголовокТек, ТипТек, Имя, Заголовок, ТипОбъектаСтрокой)
			И ОбъектИнтерактивноДоступенMCP(Кандидат) Тогда
			Если КешПоиска <> Неопределено Тогда
				КешПоиска.Статистика.fast_found = Истина;
				КешПоиска.Статистика.fast_ms = КешПоиска.Статистика.fast_ms + (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБыстрогоПоиска);
				КешПоиска.Статистика.method = "fast_platform_search";
			КонецЕсли;
			Возврат Кандидат;
		КонецЕсли;
	КонецЕсли;
	Если КешПоиска <> Неопределено Тогда
		КешПоиска.Статистика.fast_ms = КешПоиска.Статистика.fast_ms + (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБыстрогоПоиска);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция НайтиОбъектРекурсивно(РодительскийОбъект, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина, СчетчикУзлов = Неопределено, КешПоиска = Неопределено)
	// В формах 1С нередко есть несколько runtime-элементов с одинаковым именем:
	// видимое поле ввода и скрытые служебные/неактивные одноименные элементы
	// на других страницах или в подчиненных группах. Для интерактивных действий
	// нельзя возвращать первый попавшийся невидимый элемент: пользователь видит
	// и может редактировать именно текущий видимый/доступный экземпляр. Поэтому
	// поиск предпочитает интерактивно доступное совпадение, но сохраняет скрытое
	// как fallback для диагностических сценариев.
	Попытка
		Если СчетчикУзлов <> Неопределено Тогда
			СчетчикУзлов.nodes = СчетчикУзлов.nodes + 1;
		КонецЕсли;
		ЛокальныйFallback = Неопределено;
		ИмяТекущего = БезопасноеСвойствоСКешемMCP(РодительскийОбъект, "Имя", "", КешПоиска);
		ЗаголовокТекущего = БезопасныйЗаголовокСКешемMCP(РодительскийОбъект, КешПоиска);
		ТипТекущего = Строка(ТипЗнч(РодительскийОбъект));
		НормализованныйТип = НормализованноеИмяТипа(ТипТекущего);
		Если ОбъектСоответствует(ИмяТекущего, ЗаголовокТекущего, НормализованныйТип, Имя, Заголовок, ТипОбъекта) Тогда
			Если ОбъектИнтерактивноДоступенMCP(РодительскийОбъект) Тогда
				Возврат РодительскийОбъект;
			КонецЕсли;
			ЛокальныйFallback = РодительскийОбъект;
		КонецЕсли;
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			РезультатПоиска = НайтиОбъектРекурсивно(Подчиненный, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина + 1, СчетчикУзлов);
			Если РезультатПоиска <> Неопределено Тогда
				Если ОбъектИнтерактивноДоступенMCP(РезультатПоиска) Тогда
					Возврат РезультатПоиска;
				КонецЕсли;
				Если ЛокальныйFallback = Неопределено Тогда
					ЛокальныйFallback = РезультатПоиска;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат ЛокальныйFallback;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ОбъектИнтерактивноДоступенMCP(Объект)
	Видимость = БезопасноеЗначениеМетода(Объект, "ТекущаяВидимость", БезопасноеСвойство(Объект, "Видимость", Истина));
	Доступность = БезопасноеЗначениеМетода(Объект, "ТекущаяДоступность", БезопасноеСвойство(Объект, "Доступность", Истина));
	Если Не Видимость Или Не Доступность Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипОбъекта = НормализованноеИмяТипа(Строка(ТипЗнч(Объект)));
	Если ТипОбъекта = "тестируемоеполеформы" Тогда
		ТолькоПросмотр = БезопасноеЗначениеМетода(Объект, "ТекущееТолькоПросмотр", БезопасноеСвойство(Объект, "РежимТолькоПросмотр", БезопасноеСвойство(Объект, "ТолькоПросмотр", Ложь)));
		Возврат Не ТолькоПросмотр;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ОбъектВидимИДоступенMCP(Объект)
	Видимость = БезопасноеЗначениеМетода(Объект, "ТекущаяВидимость", БезопасноеСвойство(Объект, "Видимость", Истина));
	Доступность = БезопасноеЗначениеМетода(Объект, "ТекущаяДоступность", БезопасноеСвойство(Объект, "Доступность", Истина));
	Возврат Видимость И Доступность;
КонецФункции

&НаКлиенте
Функция НайтиВсеОбъектыИнтерфейса(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
	ТипОбъекта = СвойствоСтруктуры(Параметры, "type", "");
	Лимит = СвойствоСтруктуры(Параметры, "limit", 50);
	ВключатьДетей = СвойствоСтруктуры(Параметры, "include_children", Ложь);
	Лог("search_objects: start name='" + Имя + "' title='" + Заголовок + "' type='" + ТипОбъекта + "' limit=" + Строка(Лимит));
	ОтправитьСобытиеПрогрессаMCP("search_objects", "start");
	Найденные = Новый Массив;
	СчетчикУзлов = Новый Структура("nodes", 0);
	КешПоиска = НовыйКешПоискаКнопкиMCP();
	КешПоиска.Статистика.method = "dfs_fallback";
	НайтиВсеОбъектыРекурсивно(АктивноеОкно, Имя, Заголовок, ТипОбъекта, 0, Лимит, Найденные, СчетчикУзлов, КешПоиска, ВключатьДетей);
	Найденные = ПостФильтрНайденныхОбъектовMCP(Найденные, Имя, Заголовок, ТипОбъекта);
	Время = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	КешПоиска.Статистика.nodes = СчетчикУзлов.nodes;
	Лог("search_objects: done ms=" + Строка(Время) + " nodes=" + Строка(СчетчикУзлов.nodes) + " count=" + Строка(Найденные.Количество()));
	ОтправитьСобытиеПрогрессаMCP("search_objects", "done", Новый Структура("nodes,count,ms", СчетчикУзлов.nodes, Найденные.Количество(), Время));
	Возврат Новый Структура("found,count,limit,objects,search_ms,nodes_visited,search_stats", Найденные.Количество() > 0, Найденные.Количество(), Лимит, Найденные, Время, СчетчикУзлов.nodes, КешПоиска.Статистика);
КонецФункции

&НаКлиенте
Функция ПостФильтрНайденныхОбъектовMCP(Найденные, Имя, Заголовок, ТипОбъекта)
	// Защитный фильтр результата: в некоторых runtime-контекстах платформы
	// первичный predicate может вернуть лишние элементы. Перед ответом еще раз
	// фильтруем уже сериализованные структуры простыми строковыми сравнениями.
	Если ПустаяСтрока(Имя) И ПустаяСтрока(Заголовок) И ПустаяСтрока(ТипОбъекта) Тогда
		Возврат Найденные;
	КонецЕсли;
	ИскомоеИмяСтрокой = НРег(СокрЛП(Строка(Имя)));
	ИскомыйЗаголовокСтрокой = НРег(СокрЛП(Строка(Заголовок)));
	ИскомыйТипСтрокой = НормализованноеИмяТипа(СокрЛП(Строка(ТипОбъекта)));
	Отфильтрованные = Новый Массив;
	Для Каждого НайденнаяСтрока Из Найденные Цикл
		ИмяОбъекта = НРег(СокрЛП(Строка(СвойствоСтруктуры(НайденнаяСтрока, "name", ""))));
		ЗаголовокОбъекта = НРег(СокрЛП(Строка(СвойствоСтруктуры(НайденнаяСтрока, "title", ""))));
		ТипОбъектаСтрокой = НормализованноеИмяТипа(СокрЛП(Строка(СвойствоСтруктуры(НайденнаяСтрока, "type", ""))));
		Если СтрДлина(ИскомоеИмяСтрокой) > 0 И ИмяОбъекта <> ИскомоеИмяСтрокой Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(ИскомыйЗаголовокСтрокой) > 0 И СтрНайти(ЗаголовокОбъекта, ИскомыйЗаголовокСтрокой) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(ИскомыйТипСтрокой) > 0 И ТипОбъектаСтрокой <> ИскомыйТипСтрокой Тогда
			Продолжить;
		КонецЕсли;
		Отфильтрованные.Добавить(НайденнаяСтрока);
	КонецЦикла;
	Возврат Отфильтрованные;
КонецФункции

&НаКлиенте
Процедура НайтиВсеОбъектыРекурсивно(РодительскийОбъект, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина, Лимит, Найденные, СчетчикУзлов = Неопределено, КешПоиска = Неопределено, ВключатьДетей = Ложь)
	Если Найденные.Количество() >= Лимит Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если СчетчикУзлов <> Неопределено Тогда
			СчетчикУзлов.nodes = СчетчикУзлов.nodes + 1;
		КонецЕсли;
		ИмяТекущего = БезопасноеСвойствоСКешемMCP(РодительскийОбъект, "Имя", "", КешПоиска);
		ЗаголовокТекущего = БезопасныйЗаголовокСКешемMCP(РодительскийОбъект, КешПоиска);
		ТипТекущего = Строка(ТипЗнч(РодительскийОбъект));
		НормализованныйТип = НормализованноеИмяТипа(ТипТекущего);
		Если ОбъектСоответствует(ИмяТекущего, ЗаголовокТекущего, НормализованныйТип, Имя, Заголовок, ТипОбъекта) Тогда
			Найденные.Добавить(ОбъектВСтруктуру(РодительскийОбъект, 0, Истина, Истина, Истина, Ложь, КешПоиска, Истина, ВключатьДетей));
		КонецЕсли;
		Если СчетчикУзлов <> Неопределено И СчетчикУзлов.nodes > 0 И СчетчикУзлов.nodes % 500 = 0 Тогда
			ОтправитьСобытиеПрогрессаMCP("search_objects", "visited", Новый Структура("nodes,count", СчетчикУзлов.nodes, Найденные.Количество()));
		КонецЕсли;
		Подчиненные = БезопасныеПодчиненныеСКешемMCP(РодительскийОбъект, КешПоиска);
		Для Каждого Подчиненный Из Подчиненные Цикл
			Если Найденные.Количество() >= Лимит Тогда
				Прервать;
			КонецЕсли;
			НайтиВсеОбъектыРекурсивно(Подчиненный, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина + 1, Лимит, Найденные, СчетчикУзлов, КешПоиска, ВключатьДетей);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ОбъектСоответствует(ИмяОбъекта, ЗаголовокОбъекта, ТипОбъекта, ИскомоеИмя, ИскомыйЗаголовок, ИскомыйТип)
	НормализованноеИмя = НРег(СокрЛП(Строка(ИмяОбъекта)));
	НормализованныйЗаголовок = НРег(СокрЛП(Строка(ЗаголовокОбъекта)));
	ИскомоеИмяСтрокой = СокрЛП(Строка(ИскомоеИмя));
	ИскомыйЗаголовокСтрокой = СокрЛП(Строка(ИскомыйЗаголовок));
	ИскомыйТипСтрокой = СокрЛП(Строка(ИскомыйТип));
	Если СтрДлина(ИскомоеИмяСтрокой) > 0 И НормализованноеИмя <> НРег(ИскомоеИмяСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(ИскомыйЗаголовокСтрокой) > 0 И СтрНайти(НормализованныйЗаголовок, НРег(ИскомыйЗаголовокСтрокой)) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(ИскомыйТипСтрокой) > 0 И ТипОбъекта <> НормализованноеИмяТипа(ИскомыйТипСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция НормализованноеИмяТипа(ИсходныйТип)
	ИсходныйТип = СокрЛП(ИсходныйТип);
	Результат = "";
	Для Позиция = 1 По СтрДлина(ИсходныйТип) Цикл
		Символ = Сред(ИсходныйТип, Позиция, 1);
		Если Символ = " " Тогда
			Продолжить;
		КонецЕсли;
		Если Позиция > 1 И (Сред(ИсходныйТип, Позиция - 1, 1) <> "") Тогда
			Если КодСимвола(Сред(Результат, СтрДлина(Результат), 1)) >= 97 И КодСимвола(Сред(ИсходныйТип, Позиция, 1)) <= 122 Тогда
				Результат = Результат + НРег(Символ);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + НРег(Символ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция БулевоИзЗначенияMCP(Значение, ЗначениеПоУмолчанию = Ложь)
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Представление = НРег(СокрЛП(Строка(Значение)));
	Если Представление = "истина" Или Представление = "да" Или Представление = "true" Или Представление = "1" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Представление = "ложь" Или Представление = "нет" Или Представление = "false" Или Представление = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

&НаКлиенте
Функция БезопасноеЗначениеМетода(Объект, ИмяМетода, ЗначениеПоУмолчанию)
	Попытка
		Если ИмяМетода = "ТекущаяВидимость" Тогда
			Возврат Объект.ТекущаяВидимость();
		ИначеЕсли ИмяМетода = "ТекущаяДоступность" Тогда
			Возврат Объект.ТекущаяДоступность();
		ИначеЕсли ИмяМетода = "ТекущееТолькоПросмотр" Тогда
			Возврат Объект.ТекущееТолькоПросмотр();
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

&НаКлиенте
Функция БезопасноеСвойство(Объект, ИмяСвойства, ЗначениеПоУмолчанию)
	Попытка
		Если Объект = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Значение = Объект[ИмяСвойства];
		Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция БезопасныеПодчиненные(Объект)
	Попытка
		Возврат Объект.ПолучитьПодчиненныеОбъекты();
	Исключение
		Возврат Новый Массив;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция БезопасныйЗаголовок(Объект)
	Заголовок = БезопасноеСвойство(Объект, "Заголовок", "");
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = БезопасноеСвойство(Объект, "ТекстЗаголовка", "");
	КонецЕсли;
	Возврат Заголовок;
КонецФункции

&НаКлиенте
Функция НажатьКнопку(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	НачалоКоманды = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИмяКнопки = СвойствоСтруктуры(Параметры, "name", "");
	ПоискПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Лог("click_button: start name='" + ИмяКнопки + "' search_by_title=" + Строка(ПоискПоЗаголовку));
	НачалоАктивногоОкна = ТекущаяУниверсальнаяДатаВМиллисекундах();
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокДоНажатия = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	Лог("click_button: active_window_ms=" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоАктивногоОкна) + " title='" + ЗаголовокДоНажатия + "'");
	ОтправитьСобытиеПрогрессаMCP("click_button", "active_window_done", Новый Структура("window_title", ЗаголовокДоНажатия));
	ЗаголовокПоиска = ?(ПоискПоЗаголовку, ИмяКнопки, "");
	КешПоиска = НовыйКешПоискаКнопкиMCP();
	НачалоПоиска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Кнопка = НайтиКнопку(АктивноеОкно, ИмяКнопки, ЗаголовокПоиска, 0, Истина, Истина, Ложь, КешПоиска);
	СтатистикаПоиска = КешПоиска.Статистика;
	ВремяПоиска = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПоиска;
	Лог("click_button: search_done ms=" + Строка(ВремяПоиска)
		+ " method=" + СтатистикаПоиска.method
		+ " nodes=" + Строка(СтатистикаПоиска.nodes)
		+ " buttons=" + Строка(СтатистикаПоиска.buttons_checked)
		+ " children_arrays=" + Строка(СтатистикаПоиска.children_arrays)
		+ " fast_attempts=" + Строка(СтатистикаПоиска.fast_attempts)
		+ " fast_ms=" + Строка(СтатистикаПоиска.fast_ms));
	ОтправитьСобытиеПрогрессаMCP("click_button", "search_done", Новый Структура("search_ms,stats", ВремяПоиска, СтатистикаПоиска));
	Если Кнопка = Неопределено Тогда
		ВызватьИсключение "Кнопка не найдена: " + ИмяКнопки;
	КонецЕсли;
	ОшибкаАктивности = ПроверитьАктивностьСтраницыРодителя(Кнопка);
	Если ОшибкаАктивности <> Неопределено Тогда
		ВызватьИсключение ОшибкаАктивности;
	КонецЕсли;
	ЗаголовокКнопки = БезопасныйЗаголовок(Кнопка);
	Лог("click_button: found name='" + БезопасноеСвойство(Кнопка, "Имя", "") + "' title='" + ЗаголовокКнопки + "'");
	ФормаДоНажатия = НайтиРодительскуюФорму(Кнопка);
	ОжидатьЗакрытияФормы = СтрНайти(ИмяКнопки, "Закрыть") > 0 Или СтрНайти(ЗаголовокКнопки, "закрыть") > 0;
	НачалоНажатия = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Лог("click_button: press_start name='" + ИмяКнопки + "'");
	ОтправитьСобытиеПрогрессаMCP("click_button", "press_start", Новый Структура("button", ИмяКнопки));
	Кнопка.Нажать();
	ВремяНажатия = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоНажатия;
	Лог("click_button: press_done ms=" + Строка(ВремяНажатия));
	ОтправитьСобытиеПрогрессаMCP("click_button", "press_done", Новый Структура("press_ms", ВремяНажатия));
	Результат = Новый Структура("pressed,name,search_ms,press_ms,search_stats", Истина, ИмяКнопки, ВремяПоиска, ВремяНажатия, СтатистикаПоиска);
	НачалоСостояния = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДобавитьСостояниеОкнаПослеДействияMCP(Результат, ЗаголовокДоНажатия, ФормаДоНажатия, ОжидатьЗакрытияФормы);
	Лог("click_button: window_state_done ms=" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСостояния)
		+ " total_ms=" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКоманды));
	ОтправитьСобытиеПрогрессаMCP("click_button", "window_state_done", Новый Структура("total_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКоманды));
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция НовыйКешПоискаКнопкиMCP()
	Статистика = Новый Структура("nodes,children_arrays,buttons_checked,fast_attempts,fast_found,fast_ms,method", 0, 0, 0, 0, Ложь, 0, "");
	Возврат Новый Структура("Методы,Свойства,Подчиненные,КомандныеПанели,ТекущиеСтраницы,Статистика", Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Статистика);
КонецФункции

&НаКлиенте
Функция КлючСвойстваКешаMCP(ИмяСвойства)
	Возврат "property:" + ИмяСвойства;
КонецФункции

&НаКлиенте
Функция БезопасноеЗначениеМетодаСКешемMCP(Объект, ИмяМетода, ЗначениеПоУмолчанию, КешПоиска)
	Если КешПоиска = Неопределено Тогда
		Возврат БезопасноеЗначениеМетода(Объект, ИмяМетода, ЗначениеПоУмолчанию);
	КонецЕсли;
	Ключ = "method:" + ИмяМетода;
	Карта = КешПоиска.Методы.Получить(Ключ);
	Если Карта = Неопределено Тогда
		Карта = Новый Соответствие;
		КешПоиска.Методы.Вставить(Ключ, Карта);
	КонецЕсли;
	Запись = Карта.Получить(Объект);
	Если Запись <> Неопределено Тогда
		Возврат Запись.value;
	КонецЕсли;
	Значение = БезопасноеЗначениеМетода(Объект, ИмяМетода, ЗначениеПоУмолчанию);
	Карта.Вставить(Объект, Новый Структура("value", Значение));
	Возврат Значение;
КонецФункции

&НаКлиенте
Функция БезопасноеСвойствоСКешемMCP(Объект, ИмяСвойства, ЗначениеПоУмолчанию, КешПоиска)
	Если КешПоиска = Неопределено Тогда
		Возврат БезопасноеСвойство(Объект, ИмяСвойства, ЗначениеПоУмолчанию);
	КонецЕсли;
	Ключ = КлючСвойстваКешаMCP(ИмяСвойства);
	Карта = КешПоиска.Свойства.Получить(Ключ);
	Если Карта = Неопределено Тогда
		Карта = Новый Соответствие;
		КешПоиска.Свойства.Вставить(Ключ, Карта);
	КонецЕсли;
	Запись = Карта.Получить(Объект);
	Если Запись <> Неопределено Тогда
		Возврат Запись.value;
	КонецЕсли;
	Значение = БезопасноеСвойство(Объект, ИмяСвойства, ЗначениеПоУмолчанию);
	Карта.Вставить(Объект, Новый Структура("value", Значение));
	Возврат Значение;
КонецФункции

&НаКлиенте
Функция БезопасныйЗаголовокСКешемMCP(Объект, КешПоиска)
	Заголовок = БезопасноеСвойствоСКешемMCP(Объект, "Заголовок", "", КешПоиска);
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = БезопасноеСвойствоСКешемMCP(Объект, "ТекстЗаголовка", "", КешПоиска);
	КонецЕсли;
	Возврат Заголовок;
КонецФункции

&НаКлиенте
Функция БезопасныеПодчиненныеСКешемMCP(Объект, КешПоиска)
	Если КешПоиска = Неопределено Тогда
		Возврат БезопасныеПодчиненные(Объект);
	КонецЕсли;
	Запись = КешПоиска.Подчиненные.Получить(Объект);
	Если Запись <> Неопределено Тогда
		Возврат Запись.value;
	КонецЕсли;
	Значение = БезопасныеПодчиненные(Объект);
	КешПоиска.Подчиненные.Вставить(Объект, Новый Структура("value", Значение));
	Возврат Значение;
КонецФункции

&НаКлиенте
Функция КоманднаяПанельСКешемMCP(Объект, КешПоиска)
	Если КешПоиска <> Неопределено Тогда
		Запись = КешПоиска.КомандныеПанели.Получить(Объект);
		Если Запись <> Неопределено Тогда
			Возврат Запись.value;
		КонецЕсли;
	КонецЕсли;
	Панель = Неопределено;
	Попытка
		Панель = Объект.ПолучитьКоманднуюПанель();
	Исключение
		Панель = Неопределено;
	КонецПопытки;
	Если КешПоиска <> Неопределено Тогда
		КешПоиска.КомандныеПанели.Вставить(Объект, Новый Структура("value", Панель));
	КонецЕсли;
	Возврат Панель;
КонецФункции

&НаКлиенте
Функция ИмяТекущейСтраницыСКешемMCP(Объект, КешПоиска)
	Если КешПоиска <> Неопределено Тогда
		Запись = КешПоиска.ТекущиеСтраницы.Получить(Объект);
		Если Запись <> Неопределено Тогда
			Возврат Запись.value;
		КонецЕсли;
	КонецЕсли;
	ИмяСтраницы = "";
	Попытка
		ТекущаяСтраница = Объект.ПолучитьТекущуюСтраницу();
		ИмяСтраницы = БезопасноеСвойствоСКешемMCP(ТекущаяСтраница, "Имя", "", КешПоиска);
	Исключение
		ИмяСтраницы = "";
	КонецПопытки;
	Если КешПоиска <> Неопределено Тогда
		КешПоиска.ТекущиеСтраницы.Вставить(Объект, Новый Структура("value", ИмяСтраницы));
	КонецЕсли;
	Возврат ИмяСтраницы;
КонецФункции

&НаКлиенте
Функция НайтиКнопкуБыстроMCP(РодительскийОбъект, ИмяКнопки, ЗаголовокКнопки, КешПоиска = Неопределено)
	// Быстрый платформенный путь через штатные методы тест-клиента НайтиОбъект/ПолучитьОбъект.
	// По справке они ищут среди иерархии подчиненных объектов. DFS ниже остается fallback
	// для partial match, дублей, скрытых элементов и нестандартных командных панелей.
	НачалоБыстрогоПоиска = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если КешПоиска <> Неопределено Тогда
		КешПоиска.Статистика.fast_attempts = КешПоиска.Статистика.fast_attempts + 1;
	КонецЕсли;
	ТипыКнопок = Новый Массив;
	ТипыКнопок.Добавить("ТестируемаяКнопкаФормы");
	ТипыКнопок.Добавить("ТестируемаяКнопкаКоманднойПанели");
	ТипыКнопок.Добавить("ТестируемаяКнопкаКомандногоИнтерфейса");
	Для Каждого ИмяТипа Из ТипыКнопок Цикл
		ТипКнопки = Неопределено;
		Попытка
			ТипКнопки = Тип(ИмяТипа);
		Исключение
			ТипКнопки = Неопределено;
		КонецПопытки;
		Если ТипКнопки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Варианты = Новый Массив;
		Если Не ПустаяСтрока(ИмяКнопки) Тогда
			Варианты.Добавить(Новый Структура("title,name", "", ИмяКнопки));
		КонецЕсли;
		Если Не ПустаяСтрока(ЗаголовокКнопки) Тогда
			Варианты.Добавить(Новый Структура("title,name", ЗаголовокКнопки, ""));
		КонецЕсли;
		Для Каждого Вариант Из Варианты Цикл
			Кандидат = Неопределено;
			Попытка
				Кандидат = РодительскийОбъект.НайтиОбъект(ТипКнопки, Вариант.title, Вариант.name, 0);
			Исключение
				Кандидат = Неопределено;
			КонецПопытки;
			Если Кандидат = Неопределено Тогда
				Попытка
					Кандидат = РодительскийОбъект.ПолучитьОбъект(ТипКнопки, Вариант.title, Вариант.name, 0);
				Исключение
					Кандидат = Неопределено;
				КонецПопытки;
			КонецЕсли;
			Если Кандидат <> Неопределено Тогда
				ИмяТек = БезопасноеСвойство(Кандидат, "Имя", "");
				ЗаголовокТек = БезопасныйЗаголовок(Кандидат);
				Если КнопкаСовпадает(ИмяТек, ЗаголовокТек, ИмяКнопки, ЗаголовокКнопки)
					И БезопасноеЗначениеМетода(Кандидат, "ТекущаяВидимость", БезопасноеСвойство(Кандидат, "Видимость", Истина))
					И БезопасноеЗначениеМетода(Кандидат, "ТекущаяДоступность", БезопасноеСвойство(Кандидат, "Доступность", Истина)) Тогда
					Если КешПоиска <> Неопределено Тогда
						КешПоиска.Статистика.fast_found = Истина;
						КешПоиска.Статистика.fast_ms = КешПоиска.Статистика.fast_ms + (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБыстрогоПоиска);
						КешПоиска.Статистика.method = "fast_platform_search";
					КонецЕсли;
					Возврат Кандидат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если КешПоиска <> Неопределено Тогда
		КешПоиска.Статистика.fast_ms = КешПоиска.Статистика.fast_ms + (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБыстрогоПоиска);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция НайтиКнопку(РодительскийОбъект, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина, РодительскаяВидимость = Истина, РодительскаяДоступность = Истина, РодительТолькоПросмотр = Ложь, КешПоиска = Неопределено)
	Если КешПоиска = Неопределено Тогда
		КешПоиска = НовыйКешПоискаКнопкиMCP();
	КонецЕсли;
	Если ТекущаяГлубина = 0 Тогда
		КнопкаБыстро = НайтиКнопкуБыстроMCP(РодительскийОбъект, ИмяКнопки, ЗаголовокКнопки, КешПоиска);
		Если КнопкаБыстро <> Неопределено Тогда
			Возврат КнопкаБыстро;
		КонецЕсли;
		Если ПустаяСтрока(КешПоиска.Статистика.method) Тогда
			КешПоиска.Статистика.method = "dfs_fallback";
		КонецЕсли;
	КонецЕсли;
	КешПоиска.Статистика.nodes = КешПоиска.Статистика.nodes + 1;
	СобственнаяВидимость = БезопасноеЗначениеМетодаСКешемMCP(РодительскийОбъект, "ТекущаяВидимость", БезопасноеСвойствоСКешемMCP(РодительскийОбъект, "Видимость", Истина, КешПоиска), КешПоиска);
	СобственнаяДоступность = БезопасноеЗначениеМетодаСКешемMCP(РодительскийОбъект, "ТекущаяДоступность", БезопасноеСвойствоСКешемMCP(РодительскийОбъект, "Доступность", Истина, КешПоиска), КешПоиска);
	СобственноеТолькоПросмотр = БезопасноеЗначениеМетодаСКешемMCP(РодительскийОбъект, "ТекущееТолькоПросмотр", БезопасноеСвойствоСКешемMCP(РодительскийОбъект, "ТолькоПросмотр", Ложь, КешПоиска), КешПоиска);
	ЭффективнаяВидимость = СобственнаяВидимость;
	ЭффективнаяДоступность = СобственнаяДоступность;
	ЭффективноеТолькоПросмотр = СобственноеТолькоПросмотр;
	Если Не ЭффективнаяВидимость Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ПанельРодителя = КоманднаяПанельСКешемMCP(РодительскийОбъект, КешПоиска);
		Если ПанельРодителя <> Неопределено Тогда
			КешПоиска.Статистика.children_arrays = КешПоиска.Статистика.children_arrays + 1;
			Результат = НайтиКнопку(ПанельРодителя, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина + 1, ЭффективнаяВидимость, ЭффективнаяДоступность, ЭффективноеТолькоПросмотр, КешПоиска);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Подчиненные = БезопасныеПодчиненныеСКешемMCP(РодительскийОбъект, КешПоиска);
		КешПоиска.Статистика.children_arrays = КешПоиска.Статистика.children_arrays + 1;
		ИмяТекущейСтраницы = ИмяТекущейСтраницыСКешемMCP(РодительскийОбъект, КешПоиска);
		Для Каждого Подчиненный Из Подчиненные Цикл
			Если Не ПустаяСтрока(ИмяТекущейСтраницы) И БезопасноеСвойствоСКешемMCP(Подчиненный, "Имя", "", КешПоиска) <> ИмяТекущейСтраницы Тогда
				Продолжить;
			КонецЕсли;
			ИмяТек = БезопасноеСвойствоСКешемMCP(Подчиненный, "Имя", "", КешПоиска);
			ЗаголовокТек = БезопасныйЗаголовокСКешемMCP(Подчиненный, КешПоиска);
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если ТипТек = "тестируемаякнопкакоманднойпанели" Или ТипТек = "тестируемаякнопкакомандногоинтерфейса" Или ТипТек = "тестируемаякнопкаформы" Тогда
				КешПоиска.Статистика.buttons_checked = КешПоиска.Статистика.buttons_checked + 1;
				ДоступностьКнопки = БезопасноеЗначениеМетодаСКешемMCP(Подчиненный, "ТекущаяДоступность", БезопасноеСвойствоСКешемMCP(Подчиненный, "Доступность", Истина, КешПоиска), КешПоиска);
				Если ДоступностьКнопки И КнопкаСовпадает(ИмяТек, ЗаголовокТек, ИмяКнопки, ЗаголовокКнопки) Тогда
					Возврат Подчиненный;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Если Не ПустаяСтрока(ИмяТекущейСтраницы) И БезопасноеСвойствоСКешемMCP(Подчиненный, "Имя", "", КешПоиска) <> ИмяТекущейСтраницы Тогда
				Продолжить;
			КонецЕсли;
			Панель = КоманднаяПанельСКешемMCP(Подчиненный, КешПоиска);
			Если Панель <> Неопределено Тогда
				КешПоиска.Статистика.children_arrays = КешПоиска.Статистика.children_arrays + 1;
				Результат = НайтиКнопку(Панель, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина + 1, ЭффективнаяВидимость, ЭффективнаяДоступность, ЭффективноеТолькоПросмотр, КешПоиска);
				Если Результат <> Неопределено Тогда
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
			Результат = НайтиКнопку(Подчиненный, ИмяКнопки, ЗаголовокКнопки, ТекущаяГлубина + 1, ЭффективнаяВидимость, ЭффективнаяДоступность, ЭффективноеТолькоПросмотр, КешПоиска);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция КнопкаСовпадает(ИмяТек, ЗаголовокТек, ИмяКнопки, ЗаголовокКнопки)
	Если Не ПустаяСтрока(ЗаголовокКнопки) Тогда
		Возврат ЗаголовокТек = ЗаголовокКнопки Или СтрНайти(НРег(ЗаголовокТек), НРег(ЗаголовокКнопки)) > 0;
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяКнопки) Тогда
		Если ИмяТек = ИмяКнопки Или ЗаголовокТек = ИмяКнопки Тогда
			Возврат Истина;
		КонецЕсли;
		// Технические имена команд формы ищем строго: иначе ФормаПровести совпадает
		// с ФормаПровестиИЗакрыть и может нажать не ту кнопку.
		Если СтрНайти(ИмяКнопки, "Форма") = 1 Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат СтрНайти(НРег(ИмяТек), НРег(ИмяКнопки)) > 0 Или СтрНайти(НРег(ЗаголовокТек), НРег(ИмяКнопки)) > 0;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ПолучитьОбъектПриложенияMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	Заголовок = СвойствоСтруктуры(Параметры, "title", "");
