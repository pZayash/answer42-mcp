	РезультатЯчейки = Новый Структура;
	Если ПустаяСтрока(ИмяЯчейки) Тогда
		// Без параметра — текущая ячейка
		Попытка
			Текст = Таблица.ПолучитьТекстЯчейки();
			РезультатЯчейки.Вставить("cell_text", Текст);
			РезультатЯчейки.Вставить("cell_param", "");
