&НаКлиенте
Функция НомерЭлементаНастроекСпискаMCP(Раздел)
	НормРаздел = НРег(СокрЛП(Раздел));
	Если НормРаздел = "order" Или НормРаздел = "orders" Или НормРаздел = "sort" Или НормРаздел = "sorting" Или НормРаздел = "сортировка" Или НормРаздел = "порядок" Тогда
		Возврат 1;
	ИначеЕсли НормРаздел = "conditional" Или НормРаздел = "conditional_appearance" Или НормРаздел = "appearance" Или НормРаздел = "условное оформление" Тогда
		Возврат 2;
	ИначеЕсли НормРаздел = "group" Или НормРаздел = "groups" Или НормРаздел = "grouping" Или НормРаздел = "группировка" Тогда
		Возврат 3;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаКлиенте
Функция ЗаголовокЭлементаНастроекСпискаMCP(Раздел)
	Номер = НомерЭлементаНастроекСпискаMCP(Раздел);
	Если Номер = 1 Тогда Возврат "Сортировка"; КонецЕсли;
	Если Номер = 2 Тогда Возврат "Условное оформление"; КонецЕсли;
	Если Номер = 3 Тогда Возврат "Группировка"; КонецЕсли;
	Возврат "Отбор";
КонецФункции

&НаКлиенте
Функция ИмяЭлементаНастроекСпискаMCP(Раздел)
	// Не используем Формат(..., "ЧГ="): для 0 он возвращает пустую строку,
	// из-за чего filter-раздел искался как "...ЭлементДоступныеПоляТаблица"
	// вместо реального имени "...Элемент0ДоступныеПоляТаблица".
	Возврат "КомпоновщикНастроекПользовательскиеНастройкиЭлемент" + Строка(НомерЭлементаНастроекСпискаMCP(Раздел));
КонецФункции

&НаКлиенте
Функция ОбеспечитьОкноНастроекСпискаMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") = "Настройка списка" Тогда
		// Не сериализуем всю форму настроек списка: дерево компоновщика большое,
		// а после удаления depth cap полный обход может занимать минуты.
		Возврат Новый Структура("opened,already_open,title", Истина, Истина, БезопасноеСвойство(АктивноеОкно, "Заголовок", ""));
	КонецЕсли;
	Возврат ОткрытьНастройкуДинамическогоСпискаMCP(Параметры);
КонецФункции

&НаКлиенте
Функция АктивироватьРазделНастроекСпискаMCP(Раздел)
	// Для формы "Настройка списка" не используем общий
	// АктивироватьСтраницуГруппыMCP(): он возвращает ОбъектВСтруктуру(page),
	// а после удаления depth cap полная сериализация страниц компоновщика может
	// занимать минуты. Здесь нужна только смена вкладки и лёгкий результат.
	ИмяГруппы = "КомпоновщикНастроекПользовательскиеНастройки";
	ИмяСтраницы = ИмяЭлементаНастроекСпискаMCP(Раздел);
	ЗаголовокСтраницы = ЗаголовокЭлементаНастроекСпискаMCP(Раздел);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Группа = НайтиОбъектРекурсивно(АктивноеОкно, ИмяГруппы, "", "", 0);
	Если Группа = Неопределено Тогда
		ВызватьИсключение "Не удалось открыть раздел настроек списка: " + ЗаголовокСтраницы + "; причина: group_not_found";
	КонецЕсли;
	Дети = БезопасныеПодчиненные(Группа);
	Для Каждого Страница Из Дети Цикл
		ИмяТек = БезопасноеСвойство(Страница, "Имя", "");
		ЗаголовокТек = БезопасныйЗаголовок(Страница);
		Если ИмяТек = ИмяСтраницы Или ЗаголовокТек = ЗаголовокСтраницы Тогда
			Попытка
				Страница.Нажать();
			Исключение
				Страница.Активизировать();
			КонецПопытки;
			Возврат Новый Структура("activated,page_name,page_title", Истина, ИмяТек, ЗаголовокТек);
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не удалось открыть раздел настроек списка: " + ЗаголовокСтраницы + "; причина: page_not_found";
КонецФункции

&НаКлиенте
Функция ИмяТаблицыДоступныхПолейНастроекСпискаMCP(Раздел)
	Возврат ИмяЭлементаНастроекСпискаMCP(Раздел) + "ДоступныеПоляТаблица";
КонецФункции

&НаКлиенте
Функция ИмяТаблицыЭлементовНастроекСпискаMCP(Раздел)
	Номер = НомерЭлементаНастроекСпискаMCP(Раздел);
	Если Номер = 1 Тогда
		Возврат "КомпоновщикНастроекПользовательскиеНастройкиЭлемент1Порядок";
	ИначеЕсли Номер = 3 Тогда
		Возврат "КомпоновщикНастроекПользовательскиеНастройкиЭлемент3Группировка";
	КонецЕсли;
	Возврат "КомпоновщикНастроекПользовательскиеНастройкиЭлемент0Отбор";
КонецФункции

&НаКлиенте
Процедура ПопробоватьРазвернутьТекущуюСтрокуMCP(Таблица, Ошибки)
	Попытка
		Таблица.Развернуть();
	Исключение
		Если Ошибки <> Неопределено Тогда
			Ошибки.Добавить("Развернуть текущую строку: " + ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ЗначениеПарыСтрокиMCP(СтрокаТаблицы, ИмяКолонки)
	Если СтрокаТаблицы = Неопределено Тогда Возврат ""; КонецЕсли;
	Если СтрокаТаблицы.Свойство("pairs") Тогда
		Для Каждого Пара Из СтрокаТаблицы.pairs Цикл
			Если Пара.Свойство("key") И Пара.Свойство("value") И (ПустаяСтрока(ИмяКолонки) Или Пара.key = ИмяКолонки) Тогда
				Возврат Строка(Пара.value);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Функция ПолучитьДоступныеПоляНастроекСпискаMCP(Таблица, Лимит, РазворачиватьДерево)
	Ошибки = Новый Массив;
	Поля = Новый Массив;
	Уникальные = Новый Соответствие;
	Попытка
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
	Исключение
		Возврат Новый Структура("fields,count,errors", Поля, 0, Ошибки);
	КонецПопытки;

	ПредыдущаяСтрокаJSON = "";
	Пока Поля.Количество() < Лимит Цикл
		Попытка
			Если РазворачиватьДерево Тогда ПопробоватьРазвернутьТекущуюСтрокуMCP(Таблица, Неопределено); КонецЕсли;
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			Если ТекущаяСтрока = Неопределено Тогда Прервать; КонецЕсли;
			СтруктураСтроки = СоответствиеВСтруктуру(ТекущаяСтрока);
			СтрокаJSON = ЗначениеВJSON(СтруктураСтроки);
			Если СтрокаJSON = ПредыдущаяСтрокаJSON Тогда Прервать; КонецЕсли;
			ПредыдущаяСтрокаJSON = СтрокаJSON;
			ЗначениеПоля = ЗначениеПарыСтрокиMCP(СтруктураСтроки, "Доступные поля");
			Если Не ПустаяСтрока(ЗначениеПоля) И Уникальные[ЗначениеПоля] = Неопределено Тогда
				Уникальные.Вставить(ЗначениеПоля, Истина);
				Элемент = Новый Структура;
				Элемент.Вставить("title", ЗначениеПоля);
				Элемент.Вставить("presentation", ЗначениеПоля);
				Элемент.Вставить("row", СтруктураСтроки);
				Поля.Добавить(Элемент);
			КонецЕсли;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		Исключение
			Ошибки.Добавить(ОписаниеОшибки());
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Возврат Новый Структура("fields,count,errors", Поля, Поля.Количество(), Ошибки);
КонецФункции

&НаКлиенте
Функция ДоступныеПоляНастроекДинамическогоСпискаMCP(Параметры)
	Раздел = СвойствоСтруктуры(Параметры, "section", СвойствоСтруктуры(Параметры, "kind", "filter"));
	Лимит = СвойствоСтруктуры(Параметры, "limit", 500);
	РазворачиватьДерево = СвойствоСтруктуры(Параметры, "expand_tree", Истина);
	Закрывать = СвойствоСтруктуры(Параметры, "close", Ложь);
	Открытие = ОбеспечитьОкноНастроекСпискаMCP(Параметры);
	Активация = АктивироватьРазделНастроекСпискаMCP(Раздел);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = ИмяТаблицыДоступныхПолейНастроекСпискаMCP(Раздел);
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "Доступные поля", 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,section,table,error,open,activate", Ложь, Раздел, ИмяТаблицы, "Таблица доступных полей не найдена", Открытие, Активация);
	КонецЕсли;
	Поля = ПолучитьДоступныеПоляНастроекСпискаMCP(Таблица, Лимит, РазворачиватьДерево);
	Если Закрывать Тогда
		Попытка ЗакрытьФорму(); Исключение КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("found,section,section_title,table,fields,count,errors,open,activate", Истина, Раздел, ЗаголовокЭлементаНастроекСпискаMCP(Раздел), ИмяТаблицы, Поля.fields, Поля.count, Поля.errors, Открытие, Активация);
КонецФункции

&НаКлиенте
Функция НормализоватьНаправлениеСортировкиMCP(Направление)
	НормНаправление = НРег(СокрЛП(Строка(Направление)));
	Если ПустаяСтрока(НормНаправление) Тогда
		Возврат "";
	КонецЕсли;
	Если НормНаправление = "asc" Или НормНаправление = "ascending" Или НормНаправление = "возр" Или НормНаправление = "возрастание" Или НормНаправление = "по возрастанию" Тогда
		Возврат "По возрастанию";
	КонецЕсли;
	Если НормНаправление = "desc" Или НормНаправление = "descending" Или НормНаправление = "убыв" Или НормНаправление = "убывание" Или НормНаправление = "по убыванию" Тогда
		Возврат "По убыванию";
	КонецЕсли;
	Возврат Строка(Направление);
КонецФункции

&НаКлиенте
Функция НайтиФормуРодителяMCP(Объект)
	Пока Объект <> Неопределено Цикл
		Попытка
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Объект)));
			Если ТипТек = "тестируемаяформа" Тогда
				Возврат Объект;
			КонецЕсли;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		Попытка
			Объект = Объект.ПолучитьРодителя();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ДобавитьЭлементНастройкиСпискаMCP(Раздел, Поле, Значение, ВидСравнения, Направление)
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = ИмяТаблицыЭлементовНастроекСпискаMCP(Раздел);
	Ошибки = Новый Массив;

	// Правильный путь добавления настройки: на вкладке раздела выбрать нужное поле
	// в дереве "Доступные поля" и нажать кнопку "Выбрать", которая добавляет
	// выбранное поле в таблицу настроек текущего раздела. Не создаём пустую строку
	// и не пытаемся ввести поле текстом: колонка "Поле" в таблицах компоновщика —
	// это поле выбора, и ВвестиТекст() для него не работает.

	// 1. Найти таблицу доступных полей текущего раздела.
	ИмяТаблицыДоступных = ИмяТаблицыДоступныхПолейНастроекСпискаMCP(Раздел);
	ТаблицаДоступных = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицыДоступных, "Доступные поля", 0);
	Если ТаблицаДоступных = Неопределено Тогда
		Ошибки.Добавить("Таблица доступных полей не найдена: " + ИмяТаблицыДоступных);
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецЕсли;

	// 2. Перейти к строке с нужным полем в дереве доступных полей.
	РезультатПоиска = ПерейтиКСтрокеТаблицыПоТекстуMCP(ТаблицаДоступных, Поле, 500);
	Если Не РезультатПоиска.found Тогда
		Ошибки.Добавить("Поле '" + Поле + "' не найдено в доступных полях раздела " + ЗаголовокЭлементаНастроекСпискаMCP(Раздел));
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецЕсли;

	// 3. Нажать кнопку "Выбрать", которая добавляет выбранное поле в таблицу настроек.
	// Ищем кнопку строго в родительской группе таблицы доступных полей, а не по всему
	// окну: рекурсивный обход всего окна настроек списка (дерево компоновщика) может
	// занимать десятки секунд.
	КнопкаВыбрать = Неопределено;
	Попытка
		РодительДоступных = ТаблицаДоступных.ПолучитьРодителя();
		Если РодительДоступных <> Неопределено Тогда
			КнопкаВыбрать = НайтиКнопку(РодительДоступных, "", "Выбрать", 0);
			Если КнопкаВыбрать = Неопределено Тогда
				КнопкаВыбрать = НайтиКнопку(РодительДоступных, "КомпоновщикНастроекПользовательскиеНастройкиВыбрать", "", 0);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Ошибки.Добавить("Поиск кнопки 'Выбрать': " + ОписаниеОшибки());
	КонецПопытки;
	Если КнопкаВыбрать = Неопределено Тогда
		Ошибки.Добавить("Кнопка 'Выбрать' для добавления поля не найдена");
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецЕсли;
	Попытка
		КнопкаВыбрать.Нажать();
	Исключение
		Ошибки.Добавить("Нажать 'Выбрать': " + ОписаниеОшибки());
		Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ложь, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
	КонецПопытки;

	// 4. Для сортировки задать направление в добавленной строке.
	// После добавления поля через "Выбрать" платформа сама выставляет направление
	// по умолчанию ("По возрастанию" для Asc). Поле направления — это поле выбора,
	// ВвестиТекст() для него не работает. Поэтому сначала читаем фактическое текущее
	// значение: если оно уже совпадает с целевым — ничего не пишем. Если отличается —
	// пробуем установить штатным способом.
	Если НомерЭлементаНастроекСпискаMCP(Раздел) = 1 И Не ПустаяСтрока(Направление) Тогда
		Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
		Если Таблица <> Неопределено Тогда
			ЦелевоеНаправление = НормализоватьНаправлениеСортировкиMCP(Направление);
			ТекущееНаправление = ТекущееЗначениеПоляНастройкиСпискаMCP(Таблица, ИмяТаблицы, "Направление");
			Если Не (ПустаяСтрока(ТекущееНаправление) И ЦелевоеНаправление = "По возрастанию") И (ПустаяСтрока(ТекущееНаправление) Или ТекущееНаправление <> ЦелевоеНаправление) Тогда
				УстановитьПолеЭлементаНастройкиСпискаMCP(Таблица, ИмяТаблицы, "Направление", ЦелевоеНаправление, Ошибки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("applied,section,field,value,comparison,direction,errors", Ошибки.Количество() = 0, Раздел, Поле, Значение, ВидСравнения, Направление, Ошибки);
КонецФункции



&НаКлиенте
Функция ТекущееЗначениеПоляНастройкиСпискаMCP(Таблица, ИмяТаблицы, ИмяПоля)
	// Для полей выбора в таблицах настроек списка чтение значения через объект
	// редактора ненадёжно (ПредставлениеДанныхПоля может вернуть пустую строку).
	// Надёжнее читать значение из текущей строки таблицы через пары колонок.
	Попытка
		Таблица.Активизировать();
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		Если ТекущаяСтрока <> Неопределено Тогда
			СтруктураСтроки = СоответствиеВСтруктуру(ТекущаяСтрока);
			// Для направления сортировки колонка может называться по-разному.
			ВозможныеИмена = Новый Массив;
			ВозможныеИмена.Добавить("Направление");
			ВозможныеИмена.Добавить("Тип упорядочивания");
			ВозможныеИмена.Добавить("ТипУпорядочивания");
			Для Каждого ИмяКолонки Из ВозможныеИмена Цикл
				ЗначениеКолонки = ЗначениеПарыСтрокиMCP(СтруктураСтроки, ИмяКолонки);
				Если Не ПустаяСтрока(ЗначениеКолонки) Тогда
					Возврат ЗначениеКолонки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции

&НаКлиенте
Процедура УстановитьПолеЭлементаНастройкиСпискаMCP(Таблица, ИмяТаблицы, ИмяПоля, Значение, Ошибки)
	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Таблица.Активизировать();
		Если Не Таблица.ТекущийРежимРедактирование() Тогда
			Таблица.ИзменитьСтроку();
		КонецЕсли;
	Исключение
		Попытка
			Таблица.ИзменитьСтроку();
		Исключение
			Ошибки.Добавить(ИмяПоля + ": начать редактирование: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	КонецПопытки;

	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ПолеРедактора = НайтиПолеРедактораТаблицыMCP(Таблица, Таблица, ИмяТаблицы, ИмяПоля, Истина);
	Если ПолеРедактора = Неопределено Тогда
		ФормаНастроек = НайтиФормуРодителяMCP(Таблица);
		Если ФормаНастроек = Неопределено Тогда
			ФормаНастроек = АктивноеОкно;
		КонецЕсли;
		ПолеРедактора = НайтиПолеРедактораТаблицыMCP(ФормаНастроек, Таблица, ИмяТаблицы, ИмяПоля, Ложь);
	КонецЕсли;
	Если ПолеРедактора = Неопределено Тогда
		Ошибки.Добавить(ИмяПоля + ": поле редактора не найдено");
		Возврат;
	КонецЕсли;

	ПараметрыПоля = Новый Структура("field_name,value,search_by_title", БезопасноеСвойство(ПолеРедактора, "Имя", ""), Значение, Ложь);
	Попытка
		УстановитьЗначениеПоля(ПараметрыПоля);
	Исключение
		Ошибки.Добавить(ИмяПоля + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция УстановитьНастройкиДинамическогоСпискаMCP(Параметры)
	Закрывать = СвойствоСтруктуры(Параметры, "close", Истина);
	РезультатОчистки = Неопределено;
	Если СвойствоСтруктуры(Параметры, "clear_first", Ложь) Тогда
		АктивноеОкноПередОчисткой = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкноПередОчисткой, "Заголовок", "") = "Настройка списка" Тогда
			// dynamic_list_settings_available_fields по умолчанию оставляет окно
			// настроек открытым. Команда стандартных настроек принадлежит форме
			// списка, поэтому сначала возвращаемся к списку, затем честно очищаем
			// настройки и снова открываем форму ниже через ОбеспечитьОкно...
			Попытка
				ЗакрытьФорму();
			Исключение
				Попытка АктивноеОкноПередОчисткой.Закрыть(); Исключение КонецПопытки;
			КонецПопытки;
		КонецЕсли;
		РезультатОчистки = ОчиститьНастройкиДинамическогоСпискаMCP(Параметры);
	КонецЕсли;
	Открытие = ОбеспечитьОкноНастроекСпискаMCP(Параметры);
	Результаты = Новый Массив;
	Если Параметры.Свойство("filters") Тогда
		АктивацияОтбора = АктивироватьРазделНастроекСпискаMCP("filter");
		Для Каждого Спек Из Параметры.filters Цикл
			Результаты.Добавить(ДобавитьЭлементНастройкиСпискаMCP("filter", СвойствоСтруктуры(Спек, "field", ""), СвойствоСтруктуры(Спек, "value", ""), СвойствоСтруктуры(Спек, "comparison", "Равно"), ""));
		КонецЦикла;
	КонецЕсли;
	Если Параметры.Свойство("orders") Тогда
		АктивацияПорядка = АктивироватьРазделНастроекСпискаMCP("order");
		Для Каждого Спек Из Параметры.orders Цикл
			Результаты.Добавить(ДобавитьЭлементНастройкиСпискаMCP("order", СвойствоСтруктуры(Спек, "field", ""), "", "", СвойствоСтруктуры(Спек, "direction", СвойствоСтруктуры(Спек, "order", ""))));
		КонецЦикла;
	КонецЕсли;
	Если Закрывать Тогда
		Попытка
			Кнопка = НайтиКнопку(ТестируемоеПриложение.ПолучитьАктивноеОкно(), "ФормаЗакончитьРедактирование", "", 0);
			Если Кнопка = Неопределено Тогда Кнопка = НайтиКнопку(ТестируемоеПриложение.ПолучитьАктивноеОкно(), "", "Завершить редактирование", 0); КонецЕсли;
			Если Кнопка <> Неопределено Тогда Кнопка.Нажать(); Иначе ЗакрытьФорму(); КонецЕсли;
		Исключение
			Попытка ЗакрытьФорму(); Исключение КонецПопытки;
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("applied,open,clear,items", Истина, Открытие, РезультатОчистки, Результаты);
КонецФункции

&НаКлиенте
Функция ТекущиеНастройкиДинамическогоСпискаMCP(Параметры)
	Раздел = СвойствоСтруктуры(Параметры, "section", СвойствоСтруктуры(Параметры, "kind", "filter"));
	Закрывать = СвойствоСтруктуры(Параметры, "close", Ложь);
	Открытие = ОбеспечитьОкноНастроекСпискаMCP(Параметры);
	Активация = АктивироватьРазделНастроекСпискаMCP(Раздел);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = ИмяТаблицыЭлементовНастроекСпискаMCP(Раздел);
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,section,table,error,open,activate", Ложь, Раздел, ИмяТаблицы, "Таблица элементов настройки не найдена", Открытие, Активация);
	КонецЕсли;
	ЭлементыНастройки = Новый Массив;
	Ошибки = Новый Массив;
	Попытка
		Таблица.Активизировать();
		Таблица.ПерейтиКПервойСтроке();
	Исключение
		Ошибки.Добавить("Активизировать/ПерейтиКПервойСтроке: " + ОписаниеОшибки());
	КонецПопытки;
	ПредыдущаяСтрокаJSON = "";
	Пока Истина Цикл
		Попытка
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			Если ТекущаяСтрока = Неопределено Тогда Прервать; КонецЕсли;
			СтруктураСтроки = СоответствиеВСтруктуру(ТекущаяСтрока);
			СтрокаJSON = ЗначениеВJSON(СтруктураСтроки);
			Если СтрокаJSON = ПредыдущаяСтрокаJSON Тогда Прервать; КонецЕсли;
			ПредыдущаяСтрокаJSON = СтрокаJSON;
			Элемент = Новый Структура;
			Элемент.Вставить("row", СтруктураСтроки);
			ЭлементыНастройки.Добавить(Элемент);
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		Исключение
			Ошибки.Добавить(ОписаниеОшибки());
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Если Закрывать Тогда
		Попытка ЗакрытьФорму(); Исключение КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("found,section,section_title,table,items,count,errors,open,activate", Истина, Раздел, ЗаголовокЭлементаНастроекСпискаMCP(Раздел), ИмяТаблицы, ЭлементыНастройки, ЭлементыНастройки.Количество(), Ошибки, Открытие, Активация);
КонецФункции


&НаКлиенте
Процедура ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска)
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("FieldSelector");
	ИменаПолей.Добавить("Pattern");
	ИменаПолей.Добавить("CompareType");
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Попытка
			Поле = НайтиОбъектРекурсивно(ОкноПоиска, ИмяПоля, "", "", 0);
			Если Поле <> Неопределено И ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
				Поле.ЗакрытьВыпадающийСписок();
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска)
	Результат = Новый Структура("closed,method,errors", Ложь, "", Новый Массив);
	Если ОкноПоиска = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ЗаголовокОкнаПоиска = БезопасноеСвойство(ОкноПоиска, "Заголовок", "");
	ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска);
	Попытка
		КнопкаЗакрыть = НайтиКнопку(ОкноПоиска, "Cancel", "", 0);
		Если КнопкаЗакрыть = Неопределено Тогда
			КнопкаЗакрыть = НайтиКнопку(ОкноПоиска, "", "Закрыть", 0);
		КонецЕсли;
		Если КнопкаЗакрыть <> Неопределено Тогда
			КнопкаЗакрыть.Нажать();
			Результат.method = "Cancel";
		КонецЕсли;
	Исключение
		Результат.errors.Добавить("Cancel: " + ОписаниеОшибки());
	КонецПопытки;

	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 1000 Цикл
		Попытка
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") <> ЗаголовокОкнаПоиска Тогда
				Результат.closed = Истина;
				Возврат Результат;
			КонецЕсли;
		Исключение
			Результат.closed = Истина;
			Возврат Результат;
		КонецПопытки;
	КонецЦикла;

	КомандыЗакрытия = Новый Массив;
	КомандыЗакрытия.Добавить("Cancel");
	КомандыЗакрытия.Добавить("ФормаЗакрыть");
	КомандыЗакрытия.Добавить("Закрыть");
	Для Каждого ИмяКомандыЗакрытия Из КомандыЗакрытия Цикл
		Попытка
			ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска);
			ОкноПоиска.ВыполнитьКоманду(ИмяКомандыЗакрытия);
			Результат.method = ?(ПустаяСтрока(Результат.method), "command:" + ИмяКомандыЗакрытия, Результат.method + "+command:" + ИмяКомандыЗакрытия);
		Исключение
			Результат.errors.Добавить("Command(" + ИмяКомандыЗакрытия + "): " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 1000 Цикл
			Попытка
				АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
				Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") <> ЗаголовокОкнаПоиска Тогда
					Результат.closed = Истина;
					Возврат Результат;
				КонецЕсли;
			Исключение
				Результат.closed = Истина;
				Возврат Результат;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Попытка
		ЗакрытьВыпадающиеСпискиОкнаПоискаMCP(ОкноПоиска);
		ОкноПоиска.Закрыть();
		Результат.method = ?(ПустаяСтрока(Результат.method), "window.close", Результат.method + "+window.close");
	Исключение
		Результат.errors.Добавить("Window.Close: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 2000 Цикл
		Попытка
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			Если БезопасноеСвойство(АктивноеОкно, "Заголовок", "") <> ЗаголовокОкнаПоиска Тогда
				Результат.closed = Истина;
				Возврат Результат;
			КонецЕсли;
		Исключение
			Результат.closed = Истина;
			Возврат Результат;
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция УстановитьТекстовоеПолеОкнаПоискаMCP(ОкноПоиска, ИмяПоля, Значение)
	Поле = НайтиОбъектРекурсивно(ОкноПоиска, ИмяПоля, "", "", 0);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле поиска не найдено: " + ИмяПоля;
	КонецЕсли;
	Поле.Активизировать();
	Поле.ВвестиТекст(Значение);
	Попытка
		Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
			Поле.ЗакрытьВыпадающийСписок();
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Новый Структура("set,field,value,method", Истина, ИмяПоля, Значение, "ВвестиТекстБезПодтверждения");
КонецФункции

&НаКлиенте
Функция НайтиВДинамическомСпискеMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	ИмяТаблицы = СвойствоСтруктуры(Параметры, "name", "Список");
	ЗаголовокТаблицы = СвойствоСтруктуры(Параметры, "title", "");
	ПолеПоиска = СвойствоСтруктуры(Параметры, "field", "");
	ТекстПоиска = СвойствоСтруктуры(Параметры, "text", СвойствоСтруктуры(Параметры, "pattern", ""));
	ВидСравненияПоиска = СвойствоСтруктуры(Параметры, "compare_type", "");
	Если ПустаяСтрока(ТекстПоиска) Тогда
		ВызватьИсключение "Не задан текст поиска dynamic list.";
	КонецЕсли;

	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицы, 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,searched,error", Ложь, Ложь, "Таблица не найдена");
	КонецЕсли;

	Ошибки = Новый Массив;
	Попытка
		Таблица.Активизировать();
	Исключение
		Ошибки.Добавить("Активизировать таблицу: " + ОписаниеОшибки());
	КонецПопытки;

	ЗаголовокОкнаДо = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	Кнопка = Неопределено;
	Попытка
		Кнопка = НайтиКнопку(АктивноеОкно, ИмяТаблицы + "КонтекстноеМенюНайти", "", 0);
		Если Кнопка = Неопределено Тогда
			Кнопка = НайтиКнопку(АктивноеОкно, "", "Расширенный поиск", 0);
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			Кнопка = НайтиКнопку(АктивноеОкно, "", "Найти...", 0);
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			Кнопка = НайтиКнопку(АктивноеОкно, "", "Найти", 0);
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			Возврат Новый Структура("found,searched,errors,error", Истина, Ложь, Ошибки, "Команда контекстного меню расширенного поиска не найдена");
		КонецЕсли;
		Кнопка.Нажать();
	Исключение
		Возврат Новый Структура("found,searched,errors,error", Истина, Ложь, Ошибки, ОписаниеОшибки());
	КонецПопытки;

	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОкноПоиска = Неопределено;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания < 5000 Цикл
		ОкноПоиска = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(ОкноПоиска, "Заголовок", "") <> ЗаголовокОкнаДо Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ОкноПоиска = Неопределено Или БезопасноеСвойство(ОкноПоиска, "Заголовок", "") = ЗаголовокОкнаДо Тогда
		Возврат Новый Структура("found,searched,errors,error", Истина, Ложь, Ошибки, "Окно поиска не открылось");
	КонецЕсли;

	Попытка
		Если Не ПустаяСтрока(ПолеПоиска) Тогда
			УстановитьЗначениеПоля(Новый Структура("field_name,value", "FieldSelector", ПолеПоиска));
		КонецЕсли;
	Исключение
		Ошибки.Добавить("FieldSelector: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		УстановитьТекстовоеПолеОкнаПоискаMCP(ОкноПоиска, "Pattern", ТекстПоиска);
	Исключение
		Ошибки.Добавить("Pattern: " + ОписаниеОшибки());
	КонецПопытки;

	Если Не ПустаяСтрока(ВидСравненияПоиска) Тогда
		Попытка
			УстановитьЗначениеПоля(Новый Структура("field_name,value", "CompareType", ВидСравненияПоиска));
		Исключение
			Ошибки.Добавить("CompareType: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		ЗакрытиеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
		Возврат Новый Структура("found,searched,modal_title,field,text,compare_type,errors,modal_close", Истина, Ложь, БезопасноеСвойство(ОкноПоиска, "Заголовок", ""), ПолеПоиска, ТекстПоиска, ВидСравненияПоиска, Ошибки, ЗакрытиеПоиска);
	КонецЕсли;

	Попытка
		КнопкаНайти = НайтиКнопку(ОкноПоиска, "Find", "", 0);
		Если КнопкаНайти = Неопределено Тогда
			КнопкаНайти = НайтиКнопку(ОкноПоиска, "", "&Найти", 0);
		КонецЕсли;
		Если КнопкаНайти = Неопределено Тогда
			КнопкаНайти = НайтиКнопку(ОкноПоиска, "", "Найти", 0);
		КонецЕсли;
		Если КнопкаНайти = Неопределено Тогда
			ЗакрытиеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
			Возврат Новый Структура("found,searched,modal_title,field,text,compare_type,errors,error,modal_close", Истина, Ложь, БезопасноеСвойство(ОкноПоиска, "Заголовок", ""), ПолеПоиска, ТекстПоиска, ВидСравненияПоиска, Ошибки, "Кнопка Найти в модальном окне не найдена", ЗакрытиеПоиска);
		КонецЕсли;
		КнопкаНайти.Нажать();
	Исключение
		ЗакрытиеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
		Возврат Новый Структура("found,searched,modal_title,field,text,compare_type,errors,error,modal_close", Истина, Ложь, БезопасноеСвойство(ОкноПоиска, "Заголовок", ""), ПолеПоиска, ТекстПоиска, ВидСравненияПоиска, Ошибки, ОписаниеОшибки(), ЗакрытиеПоиска);
	КонецПопытки;

	ЗакрытиеПоискаПослеПоиска = Новый Структура("closed,method,errors", Истина, "not_open", Новый Массив);
	Попытка
		АктивноеОкноПослеНажатия = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкноПослеНажатия, "Заголовок", "") = БезопасноеСвойство(ОкноПоиска, "Заголовок", "") Тогда
			ЗакрытиеПоискаПослеПоиска = ЗакрытьОкноПоискаДинамическогоСпискаMCP(ОкноПоиска);
		КонецЕсли;
	Исключение
		ЗакрытиеПоискаПослеПоиска.errors.Добавить("Проверка активного окна после поиска: " + ОписаниеОшибки());
	КонецПопытки;

	ТекущаяСтрока = Неопределено;
	Попытка
		АктивноеОкноПосле = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		ТаблицаПосле = НайтиТаблицуПоПараметрам(АктивноеОкноПосле, ИмяТаблицы, ЗаголовокТаблицы, 0);
		Если ТаблицаПосле <> Неопределено Тогда
			ТекущаяСтрока = СоответствиеВСтруктуру(ТаблицаПосле.ПолучитьТекущуюСтроку());
		КонецЕсли;
	Исключение
		Ошибки.Добавить("ПолучитьТекущуюСтроку после поиска: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Новый Структура("found,searched,table,field,text,compare_type,errors,current_row,modal_close", Истина, Истина, ИмяТаблицы, ПолеПоиска, ТекстПоиска, ВидСравненияПоиска, Ошибки, ТекущаяСтрока, ЗакрытиеПоискаПослеПоиска);
КонецФункции

&НаКлиенте
Функция ОтборДинамическогоСпискаПоТекущемуЗначениюMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "name", "Список");
	ЗаголовокТаблицы = СвойствоСтруктуры(Параметры, "title", "");
	ИмяЯчейки = СвойствоСтруктуры(Параметры, "cell", СвойствоСтруктуры(Параметры, "field", ""));
	ТекстСтроки = СвойствоСтруктуры(Параметры, "text", "");
	ЛимитПоиска = СвойствоСтруктуры(Параметры, "limit", 200);

	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицы, 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,filtered,error", Ложь, Ложь, "Таблица не найдена");
	КонецЕсли;

	РезультатПоиска = Неопределено;
	Если Не ПустаяСтрока(ТекстСтроки) Тогда
		РезультатПоиска = ПерейтиКСтрокеТаблицыMCP(Новый Структура("name,title,text,limit", ИмяТаблицы, ЗаголовокТаблицы, ТекстСтроки, ЛимитПоиска));
		Если Не СвойствоСтруктуры(РезультатПоиска, "found", Ложь) Тогда
			Возврат Новый Структура("found,filtered,search", Истина, Ложь, РезультатПоиска);
		КонецЕсли;
	КонецЕсли;

	ЗначениеЯчейки = "";
	Ошибки = Новый Массив;
	Если Не ПустаяСтрока(ИмяЯчейки) Тогда
		// ПолучитьТекстЯчейки(<ИмяЯчейки>) не только возвращает текст, но и надежно
		// делает указанную колонку текущей для команды контекстного меню
		// "Найти по текущему значению".
		Попытка
			ЗначениеЯчейки = Таблица.ПолучитьТекстЯчейки(ИмяЯчейки);
		Исключение
			Ошибки.Добавить("ПолучитьТекстЯчейки(" + ИмяЯчейки + "): " + ОписаниеОшибки());
		КонецПопытки;
		Попытка
			Таблица.АктивизироватьЯчейку(ИмяЯчейки);
		Исключение
			// В разных версиях/типах таблиц достаточно ПолучитьТекстЯчейки; отсутствие
			// явной АктивизироватьЯчейку не считаем фатальным.
			Ошибки.Добавить("АктивизироватьЯчейку(" + ИмяЯчейки + "): " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Попытка
			ЗначениеЯчейки = Таблица.ПолучитьТекстЯчейки();
		Исключение
			Ошибки.Добавить("ПолучитьТекстЯчейки(): " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Попытка
		Кнопка = НайтиКнопку(АктивноеОкно, ИмяТаблицы + "КонтекстноеМенюПоискПоТекущемуЗначению", "", 0);
		Если Кнопка = Неопределено Тогда
			Кнопка = НайтиКнопку(АктивноеОкно, "", "Найти по текущему значению", 0);
		КонецЕсли;
		Если Кнопка = Неопределено Тогда
			Возврат Новый Структура("found,filtered,cell,cell_text,search,errors,error", Истина, Ложь, ИмяЯчейки, ЗначениеЯчейки, РезультатПоиска, Ошибки, "Команда контекстного меню 'Найти по текущему значению' не найдена");
		КонецЕсли;
		Кнопка.Нажать();
	Исключение
		Возврат Новый Структура("found,filtered,cell,cell_text,search,errors,error", Истина, Ложь, ИмяЯчейки, ЗначениеЯчейки, РезультатПоиска, Ошибки, ОписаниеОшибки());
	КонецПопытки;

	ТекущаяСтрока = Неопределено;
	Попытка
		ТекущаяСтрока = СоответствиеВСтруктуру(Таблица.ПолучитьТекущуюСтроку());
	Исключение
		Ошибки.Добавить("ПолучитьТекущуюСтроку после отбора: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Новый Структура("found,filtered,table,cell,cell_text,search,errors,current_row", Истина, Истина, ИмяТаблицы, ИмяЯчейки, ЗначениеЯчейки, РезультатПоиска, Ошибки, ТекущаяСтрока);
КонецФункции

&НаКлиенте
Функция ОчиститьНастройкиДинамическогоСпискаMCP(Параметры)
	СписокКнопок = Новый Массив;
	Кнопка = СвойствоСтруктуры(Параметры, "button", СвойствоСтруктуры(Параметры, "command", ""));
	Если Не ПустаяСтрока(Кнопка) Тогда СписокКнопок.Добавить(Новый Структура("name,title", Кнопка, "")); КонецЕсли;
	СписокКнопок.Добавить(Новый Структура("name,title", "СписокУстановитьСтандартныеНастройки", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "ФормаУстановитьСтандартныеНастройки", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Установить стандартные настройки"));
	РезультатКнопки = НажатьПервуюКнопкуОкна(СписокКнопок);
	Возврат Новый Структура("cleared,button", Истина, РезультатКнопки.button);
КонецФункции

&НаКлиенте
Функция ОткрытьНастройкуФормыMCP(Параметры)
	СписокКнопок = Новый Массив;
	Кнопка = СвойствоСтруктуры(Параметры, "button", СвойствоСтруктуры(Параметры, "command", ""));
	Если Не ПустаяСтрока(Кнопка) Тогда СписокКнопок.Добавить(Новый Структура("name,title", Кнопка, "")); КонецЕсли;
	СписокКнопок.Добавить(Новый Структура("name,title", "ФормаИзменитьФорму", ""));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Изменить форму..."));
	СписокКнопок.Добавить(Новый Структура("name,title", "", "Изменить форму"));
	РезультатКнопки = НажатьПервуюКнопкуОкна(СписокКнопок);
	Возврат Новый Структура("opened,button", Истина, РезультатКнопки.button);
КонецФункции

&НаКлиенте
Функция НажатьПервуюКнопкуОкна(Кнопки)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Ошибки = Новый Массив;
	Для Каждого ОписаниеКнопки Из Кнопки Цикл
		ИмяКнопки = СвойствоСтруктуры(ОписаниеКнопки, "name", "");
		ЗаголовокКнопки = СвойствоСтруктуры(ОписаниеКнопки, "title", "");
		Если ПустаяСтрока(ИмяКнопки) И ПустаяСтрока(ЗаголовокКнопки) Тогда Продолжить; КонецЕсли;
		Попытка
			Кнопка = НайтиКнопку(АктивноеОкно, ИмяКнопки, ЗаголовокКнопки, 0);
			Если Кнопка = Неопределено Тогда
				Ошибки.Добавить(?(ПустаяСтрока(ИмяКнопки), ЗаголовокКнопки, ИмяКнопки) + ": кнопка не найдена");
				Продолжить;
			КонецЕсли;
			Кнопка.Нажать();
			Возврат Новый Структура("button", ?(ПустаяСтрока(ИмяКнопки), ЗаголовокКнопки, ИмяКнопки));
		Исключение
			Ошибки.Добавить(?(ПустаяСтрока(ИмяКнопки), ЗаголовокКнопки, ИмяКнопки) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "Ни одна кнопка не нажалась: " + Строка(Ошибки);
КонецФункции

&НаКлиенте
Функция СоздатьНовыйЭлемент(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Попытка
		КнопкаСоздать = НайтиКнопку(АктивноеОкно, "ФормаСоздать", "", 0);
		Если КнопкаСоздать <> Неопределено Тогда
			КнопкаСоздать.Нажать();
			Возврат Новый Структура("created,method", Истина, "button");
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Попытка
		КнопкаСоздать = НайтиКнопку(АктивноеОкно, "", "Создать", 0);
		Если КнопкаСоздать <> Неопределено Тогда
			КнопкаСоздать.Нажать();
			Возврат Новый Структура("created,method", Истина, "title");
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Попытка
		Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, "", "", 0);
		Если Таблица <> Неопределено Тогда
			Таблица.Активизировать();
			Таблица.ДобавитьСтроку();
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			Возврат Новый Структура("created,method,table,current_row", Истина, "table_add_row", ОбъектВСтруктуру(Таблица, 0), СоответствиеВСтруктуру(ТекущаяСтрока));
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	ВызватьИсключение "Кнопка Создать не найдена и строку таблицы добавить не удалось";
КонецФункции

&НаКлиенте
Функция СохранитьФорму()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокДоСохранения = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	ФормаДоСохранения = НайтиОбъектРекурсивно(АктивноеОкно, "", "", "ТестируемаяФорма", 0);
	Попытка
		КнопкаЗаписать = НайтиКнопку(АктивноеОкно, "ФормаЗаписать", "", 0);
		Если КнопкаЗаписать <> Неопределено Тогда
			КнопкаЗаписать.Нажать();
			РезультатКнопки = Новый Структура("saved,method", Истина, "button");
			ДобавитьСостояниеОкнаПослеДействияMCP(РезультатКнопки, ЗаголовокДоСохранения, ФормаДоСохранения, Ложь);
			Возврат РезультатКнопки;
		КонецЕсли;
		АктивноеОкно.Записать();
		РезультатОкна = Новый Структура("saved,method", Истина, "window");
		ДобавитьСостояниеОкнаПослеДействияMCP(РезультатОкна, ЗаголовокДоСохранения, ФормаДоСохранения, Ложь);
		Возврат РезультатОкна;
	Исключение
		Лог("СохранитьФорму: " + ОписаниеОшибки());
		ВызватьИсключение "Ошибка сохранения: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ЗакрытьФорму()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокДоЗакрытия = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	ФормаДоЗакрытия = НайтиОбъектРекурсивно(АктивноеОкно, "", "", "ТестируемаяФорма", 0);
	Попытка
		АктивноеОкно.Закрыть();
		Результат = Новый Структура("closed", Ложь);
		ДобавитьСостояниеОкнаПослеДействияMCP(Результат, ЗаголовокДоЗакрытия, ФормаДоЗакрытия, Истина);
		Результат.closed = СвойствоСтруктуры(Результат, "form_closed", Ложь);
		Если Не Результат.closed Тогда
			Результат.Вставить("warning", "После вызова Закрыть() форма не подтвердила закрытие через ОжидатьЗакрытие(); действие, возможно, заблокировано состоянием UI.");
		КонецЕсли;
		Возврат Результат;
	Исключение
		Лог("ЗакрытьФорму: " + ОписаниеОшибки());
		ВызватьИсключение "Ошибка закрытия формы: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ПроверитьСостояниеКлиентаПослеШага()
	Результат = Новый Структура;
	СообщенияПользователю = Новый Массив;
	Результат.Вставить("user_messages", СообщенияПользователю);
	Результат.Вставить("error_info", "");
	Результат.Вставить("modal_closed", Ложь);
	Результат.Вставить("modal_title", "");
	Результат.Вставить("modal_buttons", Новый Массив);
	Результат.Вставить("modal_texts", Новый Массив);
	Результат.Вставить("modal_text", "");
	Результат.Вставить("modal_is_error_window", Ложь);

	Если ТестируемоеПриложение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	АктивноеОкно = Неопределено;
	Попытка
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Попытка
		ТекстыСообщений = АктивноеОкно.ПолучитьТекстыСообщенийПользователю();
		Для Каждого ТекстСообщения Из ТекстыСообщений Цикл
			СообщенияПользователю.Добавить(Строка(ТекстСообщения));
		КонецЦикла;
		Если СообщенияПользователю.Количество() > 0 Тогда
			Попытка
				АктивноеОкно.ЗакрытьПанельСообщенийПользователю();
			Исключение
				ИнфоЗакрытияСообщений = ИнформацияОбОшибке();
				Лог("Не удалось закрыть панель сообщений: " + ПодробноеПредставлениеОшибки(ИнфоЗакрытияСообщений));
			КонецПопытки;
		КонецЕсли;
	Исключение
		// Если окно сообщений закрыто, платформа генерирует "Метод не может быть вызван для данного объекта" — это штатно.
	КонецПопытки;

	Попытка
		ИнформацияТекущейОшибки = ТестируемоеПриложение.ПолучитьТекущуюИнформациюОбОшибке();
		Если ИнформацияТекущейОшибки <> Неопределено Тогда
			Результат.error_info = ПодробноеПредставлениеОшибки(ИнформацияТекущейОшибки);
		КонецЕсли;
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		Лог("Не удалось получить текущую информацию об ошибке: " + ПодробноеПредставлениеОшибки(ИнфоОшибки));
	КонецПопытки;

	ЗаголовокОкна = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	Результат.modal_title = ЗаголовокОкна;
	Результат.modal_is_error_window = ЕстьФормаОшибкиРекурсивно(АктивноеОкно, 0);
	НормЗаголовок = НРег(ЗаголовокОкна);
	ОкноПохожеНаОшибка = СтрНайти(НормЗаголовок, "предупреж") > 0
		Или СтрНайти(НормЗаголовок, "ошиб") > 0
		Или СтрНайти(НормЗаголовок, "исключ") > 0
		Или Не ПустаяСтрока(Результат.error_info)
		Или Результат.modal_is_error_window;

	Если ОкноПохожеНаОшибка Тогда
		НайтиТекстыОкнаРекурсивно(АктивноеОкно, Результат.modal_texts, 0);
		Результат.modal_text = СтрСоединить(Результат.modal_texts, Символы.ПС);
		Кнопки = Новый Массив;
		НайтиКнопкиРекурсивно(АктивноеОкно, Кнопки, 0);
		Для Каждого Кнопка Из Кнопки Цикл
			Результат.modal_buttons.Добавить(Новый Структура("name,title", БезопасноеСвойство(Кнопка, "Имя", ""), БезопасноеСвойство(Кнопка, "Заголовок", "")));
		КонецЦикла;
		Если Кнопки.Количество() = 1 Тогда
			Попытка
				Кнопки[0].Нажать();
				Результат.modal_closed = Истина;
			Исключение
				ИнфоЗакрытия = ИнформацияОбОшибке();
				Результат.Вставить("modal_close_error", ПодробноеПредставлениеОшибки(ИнфоЗакрытия));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ЕстьФормаОшибкиРекурсивно(РодительскийОбъект, ТекущаяГлубина)
	Попытка
		Если БезопасноеСвойство(РодительскийОбъект, "ИмяФормы", "") = "ErrorWindow" Тогда
			Возврат Истина;
		КонецЕсли;
		Для Каждого Подчиненный Из БезопасныеПодчиненные(РодительскийОбъект) Цикл
			Если ЕстьФормаОшибкиРекурсивно(Подчиненный, ТекущаяГлубина + 1) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение при поиске ErrorWindow: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ДобавитьТекстЕслиЕсть(Тексты, Текст)
	Текст = СокрЛП(Строка(Текст));
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого УжеЕсть Из Тексты Цикл
		Если УжеЕсть = Текст Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Тексты.Добавить(Текст);
КонецПроцедуры

&НаКлиенте
Процедура НайтиТекстыОкнаРекурсивно(РодительскийОбъект, Тексты, ТекущаяГлубина)
	Попытка
		ДобавитьТекстЕслиЕсть(Тексты, БезопасноеСвойство(РодительскийОбъект, "ТекстЗаголовка", ""));
		ДобавитьТекстЕслиЕсть(Тексты, БезопасныйЗаголовок(РодительскийОбъект));
		Попытка
			ПредставлениеДанных = РодительскийОбъект.ПолучитьПредставлениеДанных();
			ДобавитьТекстЕслиЕсть(Тексты, ПредставлениеДанных);
		Исключение
			// Не у всех тестируемых объектов есть представление данных.
		КонецПопытки;
		Для Каждого Подчиненный Из БезопасныеПодчиненные(РодительскийОбъект) Цикл
			НайтиТекстыОкнаРекурсивно(Подчиненный, Тексты, ТекущаяГлубина + 1);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение при поиске текстов окна: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НайтиКнопкиРекурсивно(РодительскийОбъект, Кнопки, ТекущаяГлубина)
	Попытка
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если ТипТек = "тестируемаякнопкакоманднойпанели" Или ТипТек = "тестируемаякнопкаформы" Тогда
				Кнопки.Добавить(Подчиненный);
			КонецЕсли;
			НайтиКнопкиРекурсивно(Подчиненный, Кнопки, ТекущаяГлубина + 1);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение при поиске кнопок: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Сериализация

&НаКлиенте
Функция ОбъектВСтруктуру(Объект, ТекущаяГлубина, ПоказыватьСкрытые = Истина, РодительскаяВидимость = Истина, РодительскаяДоступность = Истина, РодительТолькоПросмотр = Ложь, КешСериализации = Неопределено, ВключатьДанные = Истина, СериализоватьДетей = Истина, СчетчикУзлов = Неопределено)
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если КешСериализации = Неопределено Тогда
		КешСериализации = НовыйКешПоискаКнопкиMCP();
	КонецЕсли;
	Если СчетчикУзлов <> Неопределено Тогда
		СчетчикУзлов.nodes = СчетчикУзлов.nodes + 1;
	КонецЕсли;
	Если ЭтоСкрываемаяГруппа(Объект) Тогда
		Возврат "__skip__";
	КонецЕсли;
	СобственнаяВидимость = БезопасноеЗначениеМетодаСКешемMCP(Объект, "ТекущаяВидимость", БезопасноеСвойствоСКешемMCP(Объект, "Видимость", Истина, КешСериализации), КешСериализации);
	СобственнаяДоступность = БезопасноеЗначениеМетодаСКешемMCP(Объект, "ТекущаяДоступность", БезопасноеСвойствоСКешемMCP(Объект, "Доступность", Истина, КешСериализации), КешСериализации);
	СобственноеТолькоПросмотр = БезопасноеЗначениеМетодаСКешемMCP(Объект, "ТекущееТолькоПросмотр", БезопасноеСвойствоСКешемMCP(Объект, "ТолькоПросмотр", Ложь, КешСериализации), КешСериализации);
	Видимость = СобственнаяВидимость;
	Доступность = СобственнаяДоступность;
	ТолькоПросмотр = СобственноеТолькоПросмотр;
	Если Не ПоказыватьСкрытые И ТекущаяГлубина > 0 И Не Видимость Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипСтрокой = Строка(ТипЗнч(Объект));
	ТипОбъекта = НРег(НормализованноеИмяТипа(ТипСтрокой));
	Результат = Новый Структура;
	Результат.Вставить("type", ТипСтрокой);
	Результат.Вставить("name", БезопасноеСвойствоСКешемMCP(Объект, "Имя", "", КешСериализации));
	Результат.Вставить("title", БезопасныйЗаголовокСКешемMCP(Объект, КешСериализации));
	Результат.Вставить("form_name", БезопасноеСвойствоСКешемMCP(Объект, "ИмяФормы", "", КешСериализации));
	Результат.Вставить("navigation_url", БезопасноеСвойствоСКешемMCP(Объект, "НавигационнаяСсылка", "", КешСериализации));
	Результат.Вставить("main", БезопасноеСвойствоСКешемMCP(Объект, "Основное", БезопасноеСвойствоСКешемMCP(Объект, "ГлавноеОкно", Ложь, КешСериализации), КешСериализации));
	Результат.Вставить("home", БезопасноеСвойствоСКешемMCP(Объект, "НачальнаяСтраница", Ложь, КешСериализации));
	Результат.Вставить("visible", Видимость);
	Результат.Вставить("available", Доступность);
	Результат.Вставить("enabled", Доступность);
	Результат.Вставить("read_only", ТолькоПросмотр);
	Результат.Вставить("current_visible", СобственнаяВидимость);
	Результат.Вставить("current_available", СобственнаяДоступность);
	Результат.Вставить("current_read_only", СобственноеТолькоПросмотр);

	Если ВключатьДанные И (ТипОбъекта = "тестируемоеполеформы" Или ТипОбъекта = "тестируемаякнопкаформы"
		Или ТипОбъекта = "тестируемаякнопкакоманднойпанели" Или ТипОбъекта = "тестируемаятаблицаформы"
		Или ТипОбъекта = "тестируемыенадпись" Или ТипОбъекта = "тестируемыйпереключатель"
		Или ТипОбъекта = "тестируемыйфлажок" Или ТипОбъекта = "тестируемоеполевводасписком") Тогда
		Попытка
			Текст = Объект.ПолучитьПредставлениеДанных();
			Если ТипЗнч(Текст) = Тип("Строка") Тогда
				Результат.Вставить("data", Текст);
			Иначе
				Результат.Вставить("data", Строка(Текст));
			КонецЕсли;
		Исключение
			Результат.Вставить("data", "");
		КонецПопытки;
	Иначе
		Результат.Вставить("data", "");
	КонецЕсли;

	Если Не СериализоватьДетей Тогда
		Возврат Результат;
	КонецЕсли;

	Дети = БезопасныеПодчиненныеСКешемMCP(Объект, КешСериализации);
	МассивДетей = Новый Массив;
	ИмяТекущейСтраницы = "";
	ТекущаяСтраницаГруппы = Неопределено;
	Попытка
		ТекущаяСтраницаГруппы = Объект.ПолучитьТекущуюСтраницу();
		ИмяТекущейСтраницы = БезопасноеСвойствоСКешемMCP(ТекущаяСтраницаГруппы, "Имя", "", КешСериализации);
		Если Не ПустаяСтрока(ИмяТекущейСтраницы) Тогда
			Результат.Вставить("current_page", ОбъектВСтруктуру(ТекущаяСтраницаГруппы, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов));
		КонецЕсли;
	Исключение
		ИмяТекущейСтраницы = "";
		ТекущаяСтраницаГруппы = Неопределено;
	КонецПопытки;
	Если Не ПустаяСтрока(ИмяТекущейСтраницы) Тогда
		Страницы = Новый Массив;
		Для Каждого СтраницаГруппы Из Дети Цикл
			ДанныеСтраницы = ОбъектВСтруктуру(СтраницаГруппы, ТекущаяГлубина + 1, Истина, Видимость, Доступность, ТолькоПросмотр, КешСериализации, Ложь, Ложь, СчетчикУзлов);
			Если ДанныеСтраницы <> Неопределено Тогда
				ДанныеСтраницы.Вставить("current", БезопасноеСвойствоСКешемMCP(СтраницаГруппы, "Имя", "", КешСериализации) = ИмяТекущейСтраницы);
				Страницы.Добавить(ДанныеСтраницы);
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("pages", Страницы);
	КонецЕсли;
	Если ТипОбъекта = "тестируемаяформа" Или ТипОбъекта = "тестируемоеокно" Или ТипОбъекта = "тестируемаятаблицаформы" Или ТипОбъекта = "тестируемаягруппаформы" Тогда
		Панель = КоманднаяПанельСКешемMCP(Объект, КешСериализации);
		Если Панель <> Неопределено Тогда
			СтруктураПанели = ОбъектВСтруктуру(Панель, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов);
			Если СтруктураПанели <> Неопределено Тогда
				МассивДетей.Добавить(СтруктураПанели);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СкрытыхДетей = 0;
	Для Каждого Ребенок Из Дети Цикл
		ИмяРебенка = БезопасноеСвойствоСКешемMCP(Ребенок, "Имя", "", КешСериализации);
		Если Не ПоказыватьСкрытые И Не ПустаяСтрока(ИмяТекущейСтраницы) И ИмяРебенка <> ИмяТекущейСтраницы Тогда
			СкрытыхДетей = СкрытыхДетей + 1;
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(ИмяТекущейСтраницы) И ИмяРебенка = ИмяТекущейСтраницы Тогда
			Продолжить;
		КонецЕсли;
		СтруктураРебенка = ОбъектВСтруктуру(Ребенок, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов);
		Если СтруктураРебенка <> Неопределено Тогда
			Если СтруктураРебенка = "__skip__" Тогда
				ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, Ребенок, ТекущаяГлубина + 1, ПоказыватьСкрытые, Видимость, Доступность, ТолькоПросмотр, КешСериализации, ВключатьДанные, СчетчикУзлов);
			Иначе
				МассивДетей.Добавить(СтруктураРебенка);
			КонецЕсли;
		Иначе
			СкрытыхДетей = СкрытыхДетей + 1;
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("children", МассивДетей);
	Если СкрытыхДетей > 0 Тогда
		Результат.Вставить("hidden_children_count", СкрытыхДетей);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, ПропущеннаяГруппа, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации = Неопределено, ВключатьДанные = Истина, СчетчикУзлов = Неопределено)
	ПодчиненныеПропущенной = БезопасныеПодчиненныеСКешемMCP(ПропущеннаяГруппа, КешСериализации);
	Для Каждого ПодчиненныйПропущенной Из ПодчиненныеПропущенной Цикл
		СтруктураПодчиненного = ОбъектВСтруктуру(ПодчиненныйПропущенной, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов);
		Если СтруктураПодчиненного <> Неопределено Тогда
			Если СтруктураПодчиненного = "__skip__" Тогда
				ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, ПодчиненныйПропущенной, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации, ВключатьДанные, СчетчикУзлов);
			Иначе
				МассивДетей.Добавить(СтруктураПодчиненного);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Попытка
		ПанельГруппы = КоманднаяПанельСКешемMCP(ПропущеннаяГруппа, КешСериализации);
		Если ПанельГруппы <> Неопределено Тогда
			ДобавитьПодчиненныеПропущеннойГруппыMCP(МассивДетей, ПанельГруппы, ТекущаяГлубина, ПоказыватьСкрытые, РодительскаяВидимость, РодительскаяДоступность, РодительТолькоПросмотр, КешСериализации, ВключатьДанные, СчетчикУзлов);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область Утилиты

&НаКлиенте
Функция СвойствоСтруктуры(Структура, ИмяСвойства, ЗначениеПоУмолчанию)
	Если Структура = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Структура.Свойство(ИмяСвойства) Тогда
		Возврат Структура[ИмяСвойства];
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
КонецФункции

#КонецОбласти
