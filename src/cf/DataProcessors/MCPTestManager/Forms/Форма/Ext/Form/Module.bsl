	ВключатьКомандныеПанели = СвойствоСтруктуры(Параметры, "include_command_panels", Истина);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Лог("ui_tree: start include_hidden=" + Строка(ПоказыватьСкрытые) + " include_data=" + Строка(ВключатьДанные));
	ОтправитьСобытиеПрогрессаMCP("ui_tree", "start", Новый Структура("include_hidden,include_data", ПоказыватьСкрытые, ВключатьДанные));
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ОтправитьСобытиеПрогрессаMCP("ui_tree", "active_window_done");
	КешСериализации = НовыйКешПоискаКнопкиMCP();
	СчетчикУзлов = Новый Структура("nodes", 0);
	Результат = ОбъектВСтруктуру(АктивноеОкно, 0, ПоказыватьСкрытые, Истина, Истина, Ложь, КешСериализации, ВключатьДанные, Истина, СчетчикУзлов, ВключатьКомандныеПанели);
	Время = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Если Результат <> Неопределено И Результат <> "__skip__" Тогда
		Результат.Вставить("_tree_ms", Время);
		Результат.Вставить("_nodes_serialized", СчетчикУзлов.nodes);
	КонецЕсли;
	Лог("ui_tree: done ms=" + Строка(Время) + " nodes=" + Строка(СчетчикУзлов.nodes));
	ОтправитьСобытиеПрогрессаMCP("ui_tree", "done", Новый Структура("nodes,ms", СчетчикУзлов.nodes, Время));
	Возврат Результат;
