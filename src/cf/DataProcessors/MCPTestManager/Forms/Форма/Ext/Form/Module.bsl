	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ВключатьТекст = СвойствоСтруктуры(Параметры, "include_text", Ложь);
	Результат = Новый Массив;
	НайтиТабличныеДокументыРекурсивно(АктивноеОкно, Результат, ВключатьТекст, Параметры, 0);
	Возврат Новый Структура("count,items", Результат.Количество(), Результат);
КонецФункции

&НаКлиенте
Процедура НайтиТабличныеДокументыРекурсивно(Объект, Результат, ВключатьТекст, ПараметрыТекста, ТекущаяГлубина)
	Попытка
		Подчиненные = БезопасныеПодчиненные(Объект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			Если ЭтоИскомоеПолеТабличногоДокумента(Подчиненный, "", "") Тогда
				Элемент = Новый Структура;
				Элемент.Вставить("name", БезопасноеСвойство(Подчиненный, "Имя", ""));
				Элемент.Вставить("title", БезопасныйЗаголовок(Подчиненный));
				Элемент.Вставить("type", Строка(ТипЗнч(Подчиненный)));
				Элемент.Вставить("data", БезопасноеПредставлениеДанныхПоля(Подчиненный));
				РазмерыДокумента = РазмерыТабличногоДокументаИзПоля(Подчиненный);
				Если РазмерыДокумента.Свойство("error") Тогда
					Элемент.Вставить("dimensions_error", РазмерыДокумента.error);
				Иначе
					Элемент.Вставить("rows", РазмерыДокумента.rows);
					Элемент.Вставить("columns", РазмерыДокумента.columns);
				КонецЕсли;
				Если ВключатьТекст Тогда
					ТекстДокумента = ТекстТабличногоДокументаИзПоля(Подчиненный, ПараметрыТекста);
					Если ТекстДокумента.Свойство("error") Тогда
						Элемент.Вставить("text_error", ТекстДокумента.error);
					Иначе
						Элемент.Вставить("rows", ТекстДокумента.rows);
						Элемент.Вставить("columns", ТекстДокумента.columns);
						Элемент.Вставить("address", ТекстДокумента.address);
						Элемент.Вставить("row_start", ТекстДокумента.row_start);
						Элемент.Вставить("row_end", ТекстДокумента.row_end);
						Элемент.Вставить("column_start", ТекстДокумента.column_start);
						Элемент.Вставить("column_end", ТекстДокумента.column_end);
						Элемент.Вставить("cells", ТекстДокумента.cells);
					КонецЕсли;
				КонецЕсли;
				Результат.Добавить(Элемент);
			КонецЕсли;
			НайтиТабличныеДокументыРекурсивно(Подчиненный, Результат, ВключатьТекст, ПараметрыТекста, ТекущаяГлубина + 1);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

