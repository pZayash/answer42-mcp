Функция ОткрытьНавигационнуюСсылку(Параметры)
	НавигационнаяСсылка = СвойствоСтруктуры(Параметры, "navigation_link", "");
	Если Лев(НавигационнаяСсылка, 6) <> "e1cib/" Тогда
		ВызватьИсключение "open_navigation_link принимает только явные навигационные ссылки e1cib/...; ссылка отклонена: " + НавигационнаяСсылка;
	КонецЕсли;
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ОшибкаАктивногоОкна = "";
	Попытка
		АктивноеОкно.ВыполнитьКоманду(НавигационнаяСсылка);
	Исключение
		ОшибкаАктивногоОкна = ОписаниеОшибки();
		ОткрытоЧерезДругоеОкно = Ложь;
		ОшибкиОкон = Новый Массив;
		Для Каждого ТекущееОкно Из ОкнаТестируемогоПриложения() Цикл
			Если ТекущееОкно = АктивноеОкно Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Если Не БезопасноеСвойство(ТекущееОкно, "Доступность", Истина) Тогда
					Продолжить;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Попытка
				ТекущееОкно.ВыполнитьКоманду(НавигационнаяСсылка);
				ОткрытоЧерезДругоеОкно = Истина;
				Прервать;
			Исключение
				ОшибкиОкон.Добавить(ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
		Если Не ОткрытоЧерезДругоеОкно Тогда
			ВызватьИсключение "Не удалось перейти по навигационной ссылке " + НавигационнаяСсылка + ": " + ОшибкаАктивногоОкна + "
|Проверьте имя метаданных через rag_lookup_object/rag_query или metadata_objects_from_catalog.";
		КонецЕсли;
	КонецПопытки;
	Диагностика = ПроверитьСостояниеКлиентаПослеШага();
	Если Диагностика.modal_is_error_window Тогда
		ВызватьИсключение "Не удалось перейти по навигационной ссылке " + НавигационнаяСсылка + ": " + Диагностика.modal_text + "
|Проверьте имя метаданных через rag_lookup_object/rag_query или metadata_objects_from_catalog.";
	КонецЕсли;
	Возврат Новый Структура("opened,navigation_link", Истина, НавигационнаяСсылка);
КонецФункции

