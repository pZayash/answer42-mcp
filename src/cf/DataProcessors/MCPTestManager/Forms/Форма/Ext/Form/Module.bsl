Функция ЗакрытьФорму()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Попытка
		АктивноеОкно.Закрыть();
		Возврат Новый Структура("closed", Истина);
	Исключение
		Лог("ЗакрытьФорму: " + ОписаниеОшибки());
		ВызватьИсключение "Ошибка закрытия формы: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Сериализация

&НаКлиенте
Функция ОбъектВСтруктуру(Объект, ТекущаяГлубина, МаксимальнаяГлубина)
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТекущаяГлубина > МаксимальнаяГлубина Тогда
		Возврат Строка(Объект);
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("type", Строка(ТипЗнч(Объект)));
	Результат.Вставить("name", БезопасноеСвойство(Объект, "Имя", ""));
	Результат.Вставить("title", БезопасноеСвойство(Объект, "Заголовок", ""));
	Результат.Вставить("form_name", БезопасноеСвойство(Объект, "ИмяФормы", ""));
	Результат.Вставить("navigation_url", БезопасноеСвойство(Объект, "НавигационнаяСсылка", ""));
	Результат.Вставить("main", БезопасноеСвойство(Объект, "ГлавноеОкно", Ложь));
	Результат.Вставить("home", БезопасноеСвойство(Объект, "НачальнаяСтраница", Ложь));

	Попытка
		Текст = Объект.ПолучитьПредставлениеДанных();
		Если ТипЗнч(Текст) = Тип("Строка") Тогда
			Результат.Вставить("data", Текст);
		Иначе
			Результат.Вставить("data", Строка(Текст));
		КонецЕсли;
	Исключение
		Результат.Вставить("data", "");
	КонецПопытки;

	Если ТекущаяГлубина < МаксимальнаяГлубина Тогда
		Дети = БезопасныеПодчиненные(Объект);
		МассивДетей = Новый Массив;
		Для Каждого Ребенок Из Дети Цикл
			МассивДетей.Добавить(ОбъектВСтруктуру(Ребенок, ТекущаяГлубина + 1, МаксимальнаяГлубина));
		КонецЦикла;
		Результат.Вставить("children", МассивДетей);
	КонецЕсли;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Утилиты

&НаКлиенте
Функция СвойствоСтруктуры(Структура, ИмяСвойства, ЗначениеПоУмолчанию)
	Если Структура = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Структура.Свойство(ИмяСвойства) Тогда
		Возврат Структура[ИмяСвойства];
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
КонецФункции

#КонецОбласти
