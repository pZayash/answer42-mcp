&НаКлиенте
Функция НайтиПолеФормыДляВыпадающегоСпискаMCP(АктивноеОкно, ИскомоеИмя, ИскомыйЗаголовок, Диагностика)
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИскомоеИмя, ИскомыйЗаголовок, "тестируемоеполеформы", 0);
	Если Поле <> Неопределено Тогда
		Диагностика.Добавить("field_found");
		Возврат Поле;
	КонецЕсли;
	Диагностика.Добавить("field_not_found");
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПредставлениеВариантаСпискаВыбораMCP(Представление)
	Если ТипЗнч(Представление) = Тип("Структура") Тогда
		Если Представление.Свойство("ПредставлениеДанных") Тогда
			Возврат Строка(Представление.ПредставлениеДанных);
		ИначеЕсли Представление.Свойство("ОтображаемыйТекст") Тогда
			Возврат Строка(Представление.ОтображаемыйТекст);
		ИначеЕсли Представление.Свойство("Представление") Тогда
			Возврат Строка(Представление.Представление);
		ИначеЕсли Представление.Свойство("Значение") Тогда
			Возврат Строка(Представление.Значение);
		КонецЕсли;
	КонецЕсли;
	Возврат Строка(Представление);
КонецФункции

&НаКлиенте
Процедура ВариантыИзПредставленийСпискаВыбора(Представления, Варианты)
	Для Каждого Представление Из Представления Цикл
		Вариант = Новый Структура;
		Если ТипЗнч(Представление) = Тип("Структура") Тогда
			Для Каждого Пара Из Представление Цикл
				Вариант.Вставить(Пара.Ключ, ?(Пара.Значение = Неопределено, "", Строка(Пара.Значение)));
			КонецЦикла;
			ЗаполнитьКлючиПредставленияВарианта(Вариант, Представление);
		Иначе
			Вариант.Вставить("presentation", Строка(Представление));
			Вариант.Вставить("text", Строка(Представление));
		КонецЕсли;
		Варианты.Добавить(Вариант);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВариантыИзСпискаЗначений(СписокВыбора, Варианты)
	Для Каждого ЭлементСписка Из СписокВыбора Цикл
		Вариант = Новый Структура;
		ЗначениеВарианта = БезопасноеСвойство(ЭлементСписка, "Значение", Неопределено);
		ПредставлениеВарианта = БезопасноеСвойство(ЭлементСписка, "Представление", "");
		Если ПустаяСтрока(ПредставлениеВарианта) Тогда
			ПредставлениеВарианта = БезопасноеСвойство(ЭлементСписка, "Текст", "");
		КонецЕсли;
		Если ПустаяСтрока(ПредставлениеВарианта) И ЗначениеВарианта <> Неопределено Тогда
			ПредставлениеВарианта = Строка(ЗначениеВарианта);
		КонецЕсли;
		Вариант.Вставить("presentation", ПредставлениеВарианта);
		Вариант.Вставить("text", ПредставлениеВарианта);
		Вариант.Вставить("value", ?(ЗначениеВарианта = Неопределено, "", Строка(ЗначениеВарианта)));
		Варианты.Добавить(Вариант);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиПредставленияВарианта(Вариант, Представление)
	Если Вариант.Свойство("ПредставлениеДанных") Тогда
		Вариант.Вставить("presentation", Вариант.ПредставлениеДанных);
		Вариант.Вставить("text", Вариант.ПредставлениеДанных);
	ИначеЕсли Вариант.Свойство("ОтображаемыйТекст") Тогда
		Вариант.Вставить("presentation", Вариант.ОтображаемыйТекст);
		Вариант.Вставить("text", Вариант.ОтображаемыйТекст);
	ИначеЕсли Вариант.Свойство("Представление") Тогда
		Вариант.Вставить("presentation", Вариант.Представление);
		Вариант.Вставить("text", Вариант.Представление);
	ИначеЕсли Вариант.Свойство("Значение") Тогда
		Вариант.Вставить("presentation", Вариант.Значение);
		Вариант.Вставить("text", Вариант.Значение);
	Иначе
		Вариант.Вставить("presentation", Строка(Представление));
		Вариант.Вставить("text", Строка(Представление));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СледующийЭлементФормыMCP()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	Попытка
		АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
