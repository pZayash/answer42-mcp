Функция ПереключитьПолеMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	Значение = СвойствоСтруктуры(Параметры, "value", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, "", "", 0, 10);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;
	НужноДа = (Значение = Истина) Или (НРег(Строка(Значение)) = "да") Или (НРег(Строка(Значение)) = "true") Или (Строка(Значение) = "1");
	Попытка
		Если НужноДа Тогда
			Поле.УстановитьФлажок();
		Иначе
			Поле.СнятьФлажок();
		КонецЕсли;
	Исключение
		ОшибкаФлажок = ОписаниеОшибки();
		Попытка
			Поле.Активизировать();
			Поле.Выбрать();
		Исключение
			ВызватьИсключение "Не удалось переключить поле " + ИмяПоля + ": " + ОшибкаФлажок + "; " + ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;
	Возврат Новый Структура("toggled,field,value", Истина, ИмяПоля, Значение);
КонецФункции

&НаКлиенте
Функция УстановитьЗначениеПоля(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	Значение = СвойствоСтруктуры(Параметры, "value", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Если ПустаяСтрока(ИмяПоля) Тогда
		ВызватьИсключение "Не задано имя поля.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокПоля = ?(ИскатьПоЗаголовку, ИмяПоля, "");
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИмяПоля, ЗаголовокПоля, "", 0, 8);
	Если Поле = Неопределено Тогда
		Попытка
			Поле = ТестируемоеПриложение.ПолучитьОбъект(Неопределено, ЗаголовокПоля, ИмяПоля, 1);
		Исключение
			Поле = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле не найдено: " + ИмяПоля;
	КонецЕсли;
	Попытка
		Поле.ВвестиТекст(Значение);
	Исключение
		ОшибкаВвестиТекст = ОписаниеОшибки();
		Попытка
			Поле.Значение = Значение;
		Исключение
			ОшибкаЗначение = ОписаниеОшибки();
			Попытка
				Поле.Текст = Значение;
			Исключение
				ОшибкаТекст = ОписаниеОшибки();
				Попытка
					Поле.УстановитьЗначение(Значение);
				Исключение
					ВызватьИсключение "Не удалось установить поле " + ИмяПоля + ": ВвестиТекст=" + ОшибкаВвестиТекст + "; Значение=" + ОшибкаЗначение + "; Текст=" + ОшибкаТекст + "; УстановитьЗначение=" + ОписаниеОшибки();
				КонецПопытки;
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;
	Возврат Новый Структура("set,field,value", Истина, ИмяПоля, Значение);
КонецФункции

