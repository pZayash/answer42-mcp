&НаКлиенте
Функция НайтиТаблицуПоПараметрам(РодительскийОбъект, ИмяТаблицы, ЗаголовокТаблицы, ТекущаяГлубина, МаксимальнаяГлубина)
	Если ТекущаяГлубина > МаксимальнаяГлубина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			ИмяТек = БезопасноеСвойство(Подчиненный, "Имя", "");
			ЗаголовокТек = БезопасныйЗаголовок(Подчиненный);
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если ТипТек = "тестируемаятаблицаформы" Тогда
				Если (ПустаяСтрока(ИмяТаблицы) Или ИмяТек = ИмяТаблицы) И (ПустаяСтрока(ЗаголовокТаблицы) Или ЗаголовокТек = ЗаголовокТаблицы) Тогда
					Возврат Подчиненный;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Результат = НайтиТаблицуПоПараметрам(Подчиненный, ИмяТаблицы, ЗаголовокТаблицы, ТекущаяГлубина + 1, МаксимальнаяГлубина);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция СоответствиеВСтруктуру(Соответствие)
	// ВАЖНО: заголовки колонок могут содержать пробелы и другие символы,
	// недопустимые для ключей Структуры. Поэтому не делаем Результат.Вставить(КЗ.Ключ, ...),
	// а возвращаем JSON-safe представление: available + pairs[{key,value}].
	Результат = Новый Структура;
	Результат.Вставить("available", Ложь);
	Результат.Вставить("pairs", Новый Массив);
	Если Соответствие = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.available = Истина;
	Попытка
		Для Каждого КЗ Из Соответствие Цикл
			Результат.pairs.Добавить(Новый Структура("key,value", Строка(КЗ.Ключ), Строка(КЗ.Значение)));
		КонецЦикла;
	Исключение
		Результат.Вставить("error", ОписаниеОшибки());
		Лог("СоответствиеВСтруктуру: ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

