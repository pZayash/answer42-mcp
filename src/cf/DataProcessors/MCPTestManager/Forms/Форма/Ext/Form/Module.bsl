&НаКлиенте
Функция ИнформацияПоляMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;

	ИмяПоля = СвойствоСтруктуры(Параметры, "field_name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();

	ИскомоеИмя = ?(ИскатьПоЗаголовку, "", ИмяПоля);
	ИскомыйЗаголовок = ?(ИскатьПоЗаголовку, ИмяПоля, "");
	Поле = НайтиОбъектРекурсивно(АктивноеОкно, ИскомоеИмя, ИскомыйЗаголовок, "", 0);

	Если Поле = Неопределено Тогда
		Возврат Новый Структура("found,name,title", Ложь, ИмяПоля, "");
	КонецЕсли;

	Результат = Новый Структура;
	Попытка
		Результат.Вставить("found", Истина);
		Результат.Вставить("name", БезопасноеСвойство(Поле, "Имя", ""));
		Результат.Вставить("title", БезопасноеСвойство(Поле, "Заголовок", ""));
		Результат.Вставить("вид", Строка(ТипЗнч(Поле)));
		Попытка
			Результат.Вставить("field_kind", Строка(Поле.Вид));
		Исключение
			Результат.Вставить("field_kind_error", ОписаниеОшибки());
		КонецПопытки;
		Попытка
			Результат.Вставить("data_text", Поле.ПолучитьПредставлениеДанных());
		Исключение
			Результат.Вставить("data_text_error", ОписаниеОшибки());
		КонецПопытки;
		Результат.Вставить("visible", БезопасноеСвойство(Поле, "Видимость", Истина));
		Результат.Вставить("available", БезопасноеСвойство(Поле, "Доступность", Истина));
		Результат.Вставить("readonly", БезопасноеСвойство(Поле, "РежимТолькоПросмотр", Ложь));
		Возврат Результат;
	Исключение
		Результат.Вставить("found", Истина);
		Результат.Вставить("error", ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
КонецФункции

