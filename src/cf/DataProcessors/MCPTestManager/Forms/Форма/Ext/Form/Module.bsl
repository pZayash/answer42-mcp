&НаКлиенте
Процедура НайтиВсеОбъектыРекурсивно(РодительскийОбъект, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина, Лимит, Найденные)
	Если Найденные.Количество() >= Лимит Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ИмяТекущего = БезопасноеСвойство(РодительскийОбъект, "Имя", "");
		ЗаголовокТекущего = БезопасныйЗаголовок(РодительскийОбъект);
		ТипТекущего = Строка(ТипЗнч(РодительскийОбъект));
		НормализованныйТип = НормализованноеИмяТипа(ТипТекущего);
		Если ОбъектСоответствует(ИмяТекущего, ЗаголовокТекущего, НормализованныйТип, Имя, Заголовок, ТипОбъекта) Тогда
			Найденные.Добавить(ОбъектВСтруктуру(РодительскийОбъект, 0));
		КонецЕсли;
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			Если Найденные.Количество() >= Лимит Тогда
				Прервать;
			КонецЕсли;
			НайтиВсеОбъектыРекурсивно(Подчиненный, Имя, Заголовок, ТипОбъекта, ТекущаяГлубина + 1, Лимит, Найденные);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ОбъектСоответствует(ИмяОбъекта, ЗаголовокОбъекта, ТипОбъекта, ИскомоеИмя, ИскомыйЗаголовок, ИскомыйТип)
	НормализованноеИмя = НРег(СокрЛП(ИмяОбъекта));
	НормализованныйЗаголовок = НРег(СокрЛП(ЗаголовокОбъекта));
	Если Не ПустаяСтрока(ИскомоеИмя) И НормализованноеИмя <> НРег(СокрЛП(ИскомоеИмя)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(ИскомыйЗаголовок) И НРег(СокрЛП(ИскомыйЗаголовок)) <> НормализованныйЗаголовок Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(ИскомыйТип) И ТипОбъекта <> НормализованноеИмяТипа(ИскомыйТип) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция НормализованноеИмяТипа(ИсходныйТип)
	ИсходныйТип = СокрЛП(ИсходныйТип);
	Результат = "";
	Для Позиция = 1 По СтрДлина(ИсходныйТип) Цикл
		Символ = Сред(ИсходныйТип, Позиция, 1);
		Если Символ = " " Тогда
			Продолжить;
		КонецЕсли;
		Если Позиция > 1 И (Сред(ИсходныйТип, Позиция - 1, 1) <> "") Тогда
			Если КодСимвола(Сред(Результат, СтрДлина(Результат), 1)) >= 97 И КодСимвола(Сред(ИсходныйТип, Позиция, 1)) <= 122 Тогда
				Результат = Результат + НРег(Символ);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + НРег(Символ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
