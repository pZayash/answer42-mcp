#Область ТестовыйКлиент

&НаКлиенте
Функция ПодключитьКлиентТестирования(Параметры)
	ПроверитьВерсиюПротоколаМенеджераMCP(Параметры);
	URLБазы = СвойствоСтруктуры(Параметры, "base_url", "");
	ТипПодключения = НРег(СвойствоСтруктуры(Параметры, "connection_mode", "ws"));
	СтрокаПодключения = СвойствоСтруктуры(Параметры, "connection_value", URLБазы);
	Пользователь = СвойствоСтруктуры(Параметры, "username", "");
	Пароль = СвойствоСтруктуры(Параметры, "password", "");
	Порт = СвойствоСтруктуры(Параметры, "port", 1538);
	ПутьПлатформы = СвойствоСтруктуры(Параметры, "onec_path", "1cv8c");
	АдресКлиентаТестирования = СвойствоСтруктуры(Параметры, "host", "localhost");

	Если ПустаяСтрока(СтрокаПодключения) Тогда
		ВызватьИсключение "Параметр base_url или connection_value обязателен для подключения тест-клиента";
	КонецЕсли;

	Лог("ПодключитьКлиентТестирования: mode=" + ТипПодключения + " value=" + СтрокаПодключения + " Порт=" + Строка(Порт));
	ОстановитьПроцессТестКлиента();

	ДопАргументы = СвойствоСтруктуры(Параметры, "extra_args", "");
	ПараметрC = СвойствоСтруктуры(Параметры, "command_parameter", "");
	ВнешняяОбработка = СвойствоСтруктуры(Параметры, "execute", "");
	ПроцессТестКлиента = ЗапуститьКлиентТестирования(ПутьПлатформы, ТипПодключения, СтрокаПодключения, Пользователь, Пароль, Порт, ДопАргументы, ПараметрC, ВнешняяОбработка);
	Если ПроцессТестКлиента = Неопределено Тогда
		ВызватьИсключение "Не удалось запустить процесс тест-клиента " + ПутьПлатформы;
	КонецЕсли;

	ТестируемоеПриложение = Новый ТестируемоеПриложение(АдресКлиентаТестирования, Порт);
	ПодключитьсяКТестовомуКлиенту(Пользователь, ФайлЛогаТестКлиента);
	РезультатМаксимизации = РазвернутьОкноКлиентаТестирования();

	Результат = Новый Структура;
	Результат.Вставить("connected", Истина);
	Результат.Вставить("base_url", URLБазы);
	Результат.Вставить("connection_mode", ТипПодключения);
	Результат.Вставить("connection_value", СтрокаПодключения);
	Результат.Вставить("port", Порт);
	Результат.Вставить("client_pid", ПроцессТестКлиента.ИдентификаторПроцесса);
	Результат.Вставить("client_log", ПроцессТестКлиента.Лог);
	Результат.Вставить("maximized", РезультатМаксимизации);
	Возврат Результат;
КонецФункции

&НаКлиенте
