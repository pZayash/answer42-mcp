		Попытка
			ТестируемоеПриложение.РазорватьСоединение();
		Исключение
			Лог("ОтключитьКлиентТестирования: ошибка разрыва " + ОписаниеОшибки());
		КонецПопытки;
		ТестируемоеПриложение = Неопределено;
	КонецЕсли;
	ОстановитьПроцессТестКлиента();
	Возврат Новый Структура("connected", Ложь);
КонецФункции

