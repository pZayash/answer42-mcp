&НаКлиенте
Процедура КомандныйИнтерфейсПодчиненныеРекурсивноВнутр(Объект, ИскомыйТип, Результат)
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Подчиненный Из БезопасныеПодчиненные(Объект) Цикл
		Если НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный))) = ИскомыйТип Тогда
			Результат.Добавить(Подчиненный);
		КонецЕсли;
		КомандныйИнтерфейсПодчиненныеРекурсивноВнутр(Подчиненный, ИскомыйТип, Результат);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КомандныйИнтерфейсОбъектВСтруктуру(Объект, ТекущаяГлубина)
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	ТипОбъекта = Строка(ТипЗнч(Объект));
	НормТип = НормализованноеИмяТипа(ТипОбъекта);
	Результат.Вставить("type", ТипОбъекта);
	Результат.Вставить("kind", НормТип);
	Результат.Вставить("title", БезопасныйЗаголовок(Объект));
	Результат.Вставить("navigation_url", БезопасноеСвойство(Объект, "НавигационнаяСсылка", ""));

	Если НормТип = "тестируемыйкомандныйинтерфейс" Тогда
		Результат.Вставить("role", "root");
	ИначеЕсли НормТип = "тестируемаягруппакомандногоинтерфейса" Тогда
		Результат.Вставить("role", "section");
	ИначеЕсли НормТип = "тестируемаякнопкакомандногоинтерфейса" Тогда
		Результат.Вставить("role", "command");
	Иначе
		Результат.Вставить("role", "object");
	КонецЕсли;

	Попытка
		Результат.Вставить("visible", Объект.ТекущаяВидимость());
	Исключение
		Результат.Вставить("visible", Истина);
	КонецПопытки;
	Попытка
		Результат.Вставить("available", Объект.ТекущаяДоступность());
	Исключение
		Результат.Вставить("available", Истина);
	КонецПопытки;

	Если Истина Тогда
		Дети = Новый Массив;
		Для Каждого Подчиненный Из БезопасныеПодчиненные(Объект) Цикл
			ДанныеПодчиненного = КомандныйИнтерфейсОбъектВСтруктуру(Подчиненный, ТекущаяГлубина + 1);
			Если ДанныеПодчиненного <> Неопределено Тогда
				Дети.Добавить(ДанныеПодчиненного);
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("children", Дети);
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КомандыКомандногоИнтерфейса(Корень, ИсключатьСлужебныеПанели = Ложь)
	Результат = Новый Массив;
	КомандыКомандногоИнтерфейсаРекурсивно(Корень, Результат, Новый Массив, ИсключатьСлужебныеПанели);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура КомандыКомандногоИнтерфейсаРекурсивно(Объект, Результат, Путь, ИсключатьСлужебныеПанели)
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипОбъекта = НормализованноеИмяТипа(Строка(ТипЗнч(Объект)));
	Заголовок = БезопасныйЗаголовок(Объект);
	СлужебнаяПанель = ИсключатьСлужебныеПанели И КомандныйИнтерфейсПутьСодержитСлужебнуюПанель(Путь);
	Если ТипОбъекта = "тестируемаякнопкакомандногоинтерфейса" И Не СлужебнаяПанель Тогда
		Команда = Новый Структура;
		Команда.Вставить("title", Заголовок);
		Команда.Вставить("navigation_url", БезопасноеСвойство(Объект, "НавигационнаяСсылка", ""));
		Команда.Вставить("path", Путь);
		Результат.Добавить(Команда);
	КонецЕсли;

	НовыйПуть = Новый Массив;
	Для Каждого ЭлементПути Из Путь Цикл
		НовыйПуть.Добавить(ЭлементПути);
	КонецЦикла;
	Если ТипОбъекта = "тестируемаягруппакомандногоинтерфейса" И Не ПустаяСтрока(Заголовок) Тогда
		НовыйПуть.Добавить(Заголовок);
	КонецЕсли;

	Для Каждого Подчиненный Из БезопасныеПодчиненные(Объект) Цикл
		КомандыКомандногоИнтерфейсаРекурсивно(Подчиненный, Результат, НовыйПуть, ИсключатьСлужебныеПанели);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция КомандныйИнтерфейсПутьСодержитСлужебнуюПанель(Путь)
	Для Каждого ЭлементПути Из Путь Цикл
		НормЭлемент = НРег(ЭлементПути);
		Если СтрНайти(НормЭлемент, "панель разделов") > 0
			Или СтрНайти(НормЭлемент, "панель открытых") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ПоискВКомандахКомандногоИнтерфейса(Команды, СтрокаПоиска, Максимум)
	Результат = Новый Массив;
	НормПоиск = НРег(СтрокаПоиска);
	КороткийПоиск = НормПоиск;
	Если СтрДлина(КороткийПоиск) > 3 Тогда
		КороткийПоиск = Лев(КороткийПоиск, СтрДлина(КороткийПоиск) - 1);
	КонецЕсли;
	Для Каждого Команда Из Команды Цикл
		Заголовок = СвойствоСтруктуры(Команда, "title", "");
		Ссылка = СвойствоСтруктуры(Команда, "navigation_url", "");
		Путь = СвойствоСтруктуры(Команда, "path", Новый Массив);
		ТекстПути = КомандныйИнтерфейсПутьВСтроку(Путь);
		ТекстДляПоиска = НРег(Заголовок + " " + ТекстПути + " " + Ссылка);
		Если СтрНайти(ТекстДляПоиска, НормПоиск) > 0
			Или (КороткийПоиск <> НормПоиск И СтрНайти(ТекстДляПоиска, КороткийПоиск) > 0) Тогда
			Совпадение = Новый Структура;
			Совпадение.Вставить("title", Заголовок);
			Совпадение.Вставить("navigation_url", Ссылка);
			Совпадение.Вставить("path", Путь);
			Совпадение.Вставить("path_text", ТекстПути);
			Совпадение.Вставить("score", КомандныйИнтерфейсОценкаСовпадения(Заголовок, ТекстПути, Ссылка, НормПоиск));
			Результат.Добавить(Совпадение);
			Если Максимум > 0 И Результат.Количество() >= Максимум Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КомандныйИнтерфейсПутьВСтроку(Путь)
	Результат = "";
	Для Каждого ЭлементПути Из Путь Цикл
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + " / ";
		КонецЕсли;
		Результат = Результат + ЭлементПути;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КомандныйИнтерфейсОценкаСовпадения(Заголовок, ТекстПути, Ссылка, НормПоиск)
	Если НРег(Заголовок) = НормПоиск Тогда
		Возврат 100;
	КонецЕсли;
	Если СтрНайти(НРег(Заголовок), НормПоиск) > 0 Тогда
		Возврат 80;
	КонецЕсли;
	Если СтрНайти(НРег(ТекстПути), НормПоиск) > 0 Тогда
		Возврат 50;
	КонецЕсли;
	Если СтрНайти(НРег(Ссылка), НормПоиск) > 0 Тогда
		Возврат 30;
	КонецЕсли;
	Возврат 0;
КонецФункции

