&НаКлиенте
Функция ТекстИзТекущейСтрокиДоступныхПолейMCP(Таблица)
	Попытка
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		ПервоеНепустое = "";
		Для Каждого КЗ Из ТекущаяСтрока Цикл
			ЗначениеКолонки = СокрЛП(Строка(КЗ.Значение));
			Если ПустаяСтрока(ЗначениеКолонки) Тогда
				Продолжить;
			КонецЕсли;
			ИмяКолонки = НРег(Строка(КЗ.Ключ));
			Если СтрНайти(ИмяКолонки, "доступ") > 0 Или СтрНайти(ИмяКолонки, "пол") > 0 Или СтрНайти(ИмяКолонки, "представ") > 0 Тогда
				Возврат ЗначениеКолонки;
			КонецЕсли;
			Если ПустаяСтрока(ПервоеНепустое)
				И ЗначениеКолонки <> "Да" И ЗначениеКолонки <> "Нет" Тогда
				ПервоеНепустое = ЗначениеКолонки;
			КонецЕсли;
		КонецЦикла;
		Возврат ПервоеНепустое;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ТекстТекущегоДоступногоПоляНастроекСпискаMCP(Таблица)
