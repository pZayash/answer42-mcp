			РезультатЯчейки.Вставить("error", ОписаниеОшибки());
		КонецПопытки;
	Иначе
		// По имени элемента/индексу
		Попытка
			Текст = Таблица.ПолучитьТекстЯчейки(ИмяЯчейки);
			РезультатЯчейки.Вставить("cell_text", Текст);
			РезультатЯчейки.Вставить("cell_param", ИмяЯчейки);
