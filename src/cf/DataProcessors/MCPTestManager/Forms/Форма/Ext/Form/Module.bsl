	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если СтрНайти(НРег(ЗначениеВJSON(СтрокаТаблицы)), ИскомыйТекст) > 0 Тогда
			Таблица.Активизировать();
			Таблица.ПерейтиКПервойСтроке();
			Для НомерШага = 1 По ИндексСтроки Цикл
				Таблица.ПерейтиКСледующейСтроке();
			КонецЦикла;
			Возврат Новый Структура("found,row,index", Истина, СтрокаТаблицы, ИндексСтроки);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат Новый Структура("found,rows_checked", Ложь, МассивСтрок.Количество());
КонецФункции

&НаКлиенте
Функция ПереместитьТекущуюСтрокуТаблицыMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "name", "");
	ЗаголовокТаблицы = СвойствоСтруктуры(Параметры, "title", "");
	Направление = НРег(СвойствоСтруктуры(Параметры, "direction", "next"));
	Шагов = СвойствоСтруктуры(Параметры, "steps", 1);
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицы, 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,name,title", Ложь, ИмяТаблицы, ЗаголовокТаблицы);
	КонецЕсли;
	Таблица.Активизировать();
	Для НомерШага = 1 По Шагов Цикл
		Если Направление = "next" Или Направление = "следующая" Или Направление = "down" Тогда
			Таблица.ПерейтиКСледующейСтроке();
		ИначеЕсли Направление = "previous" Или Направление = "prev" Или Направление = "предыдущая" Или Направление = "up" Тогда
			Таблица.ПерейтиКПредыдущейСтроке();
		ИначеЕсли Направление = "first" Или Направление = "первая" Тогда
			Таблица.ПерейтиКПервойСтроке();
		ИначеЕсли Направление = "last" Или Направление = "последняя" Тогда
			Таблица.ПерейтиКПоследнейСтроке();
		ИначеЕсли Направление = "expand" Или Направление = "развернуть" Тогда
			Таблица.Развернуть();
		ИначеЕсли Направление = "collapse" Или Направление = "свернуть" Тогда
			Таблица.Свернуть();
		ИначеЕсли Направление = "level_down" Или Направление = "downlevel" Или Направление = "науровеньвниз" Тогда
			Таблица.ПерейтиНаУровеньВниз();
		ИначеЕсли Направление = "level_up" Или Направление = "uplevel" Или Направление = "науровеньвверх" Тогда
			Таблица.ПерейтиНаУровеньВверх();
		Иначе
			ВызватьИсключение "Неизвестное направление перехода: " + Направление;
		КонецЕсли;
	КонецЦикла;
	ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
	Возврат Новый Структура("found,moved,direction,steps,current_row", Истина, Истина, Направление, Шагов, СоответствиеВСтруктуру(ТекущаяСтрока));
КонецФункции

&НаКлиенте
Функция ДобавитьСтрокуТаблицыMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "name", "");
	ЗаголовокТаблицы = СвойствоСтруктуры(Параметры, "title", "");
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицы, 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,name,title,added", Ложь, ИмяТаблицы, ЗаголовокТаблицы, Ложь);
	КонецЕсли;
	Таблица.Активизировать();
	ТекущаяСтрокаДоJSON = "";
	Попытка
		ТекущаяСтрокаДоJSON = ЗначениеВJSON(СоответствиеВСтруктуру(Таблица.ПолучитьТекущуюСтроку()));
	Исключение
		ТекущаяСтрокаДоJSON = "";
	КонецПопытки;
	ОшибкаДобавленияСтроки = "";
	Попытка
		Таблица.ДобавитьСтроку();
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		ТекущаяСтрокаПослеJSON = ЗначениеВJSON(СоответствиеВСтруктуру(ТекущаяСтрока));
		РежимРедактирования = ТаблицаВРежимеРедактированияMCP(Таблица);
		Если РежимРедактирования Или ТекущаяСтрокаДоJSON <> ТекущаяСтрокаПослеJSON Тогда
			Возврат Новый Структура("found,added,method,editing,current_row", Истина, Истина, "api_add_row", РежимРедактирования, СоответствиеВСтруктуру(ТекущаяСтрока));
		КонецЕсли;
	Исключение
		ОшибкаДобавленияСтроки = ОписаниеОшибки();
	КонецПопытки;

	КнопкаДобавления = НайтиКнопкуДобавленияСтрокиТаблицыMCP(АктивноеОкно, Таблица, ИмяТаблицы);
	Если КнопкаДобавления <> Неопределено Тогда
		ИмяКнопки = БезопасноеСвойство(КнопкаДобавления, "Имя", "");
		ЗаголовокКнопки = БезопасныйЗаголовок(КнопкаДобавления);
		КнопкаДобавления.Нажать();
		НовоеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		МодальноеОкноОткрыто = НовоеОкно <> Неопределено И НовоеОкно <> АктивноеОкно;
		Возврат Новый Структура("found,added,method,button_name,button_title,modal_opened,modal_title,api_add_error", Истина, Истина, "command_button", ИмяКнопки, ЗаголовокКнопки, МодальноеОкноОткрыто, ?(МодальноеОкноОткрыто, БезопасноеСвойство(НовоеОкно, "Заголовок", ""), ""), ОшибкаДобавленияСтроки);
	КонецЕсли;
	Если Не ПустаяСтрока(ОшибкаДобавленияСтроки) Тогда
		Возврат Новый Структура("found,added,method,editing,reason,error", Истина, Ложь, "api_add_row_failed", ТаблицаВРежимеРедактированияMCP(Таблица), "api_add_row_exception", ОшибкаДобавленияСтроки);
	КонецЕсли;
	ТекущаяСтрокаИтог = Новый Структура("available,pairs", Ложь, Новый Массив);
	ОшибкаТекущейСтрокиИтог = "";
	Попытка
		ТекущаяСтрокаИтог = СоответствиеВСтруктуру(Таблица.ПолучитьТекущуюСтроку());
	Исключение
		ОшибкаТекущейСтрокиИтог = ОписаниеОшибки();
		Если ПустаяСтрока(ОшибкаТекущейСтрокиИтог) Тогда
			ОшибкаТекущейСтрокиИтог = "ПолучитьТекущуюСтроку() завершился исключением без текста";
		КонецЕсли;
	КонецПопытки;
	Возврат Новый Структура("found,added,method,editing,current_row,reason,row_error", Истина, Ложь, "api_add_row_no_effect", ТаблицаВРежимеРедактированияMCP(Таблица), ТекущаяСтрокаИтог, "api_add_row_no_effect", ОшибкаТекущейСтрокиИтог);
КонецФункции

&НаКлиенте
Функция НайтиКнопкуДобавленияСтрокиТаблицыMCP(АктивноеОкно, Таблица, ИмяТаблицы)
	Кандидаты = Новый Массив;
	Если Не ПустаяСтрока(ИмяТаблицы) Тогда
		Кандидаты.Добавить(ИмяТаблицы + "ДобавитьЭлементПорядка");
		Кандидаты.Добавить(ИмяТаблицы + "ДобавитьЭлемент");
		Кандидаты.Добавить(ИмяТаблицы + "ДобавитьСтроку");
		Кандидаты.Добавить(ИмяТаблицы + "Добавить");
	КонецЕсли;
	Кандидаты.Добавить("ДобавитьЭлементПорядка");
	Кандидаты.Добавить("Добавить новый элемент порядка");
	Кандидаты.Добавить("Добавить");

	Для Каждого ИмяКнопки Из Кандидаты Цикл
		Попытка
			Кнопка = НайтиКнопку(Таблица, ИмяКнопки, "", 0);
			Если Кнопка <> Неопределено Тогда
				Возврат Кнопка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Если АктивноеОкно <> Неопределено Тогда
		Для Каждого ИмяКнопки Из Кандидаты Цикл
			Попытка
				Кнопка = НайтиКнопку(АктивноеОкно, ИмяКнопки, "", 0);
				Если Кнопка <> Неопределено Тогда
					Возврат Кнопка;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокиТаблицыКакМассив(Таблица, Лимит)
	// Метод 1: ПолучитьСтроки() — работает на обычных таблицах форм (не динамических списках).
	// Метода ПолучитьДанные() в API ТестируемаяТаблицаФормы НЕТ — это ошибка в старом коде.
	Результат = Новый Массив;
	РезультатПолучитьСтроки = Новый Массив;
	Попытка
		Строки = Таблица.ПолучитьСтроки();
		Количество = 0;
		Для Каждого СтрокаТаблицы Из Строки Цикл
			РезультатПолучитьСтроки.Добавить(СоответствиеВСтруктуру(СтрокаТаблицы));
			Количество = Количество + 1;
			Если Количество >= Лимит Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если РезультатПолучитьСтроки.Количество() >= Лимит Тогда
			Возврат РезультатПолучитьСтроки;
		КонецЕсли;
	Исключение
		// ПолучитьСтроки не сработал — пробуем навигационный метод
	КонецПопытки;

	// Метод 2: Навигационный — ПерейтиКПервойСтроке → ПолучитьТекущуюСтроку → ПерейтиКСледующейСтроке.
	// Это единственный штатный способ обхода строк динамического списка в API тест-клиента 1С.
	Попытка
		Таблица.ПерейтиКПервойСтроке();
		ПредыдущаяСтрокаJSON = "";
		ПовторыБезСмещения = 0;
		Пока Истина Цикл
			ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
			Если ТекущаяСтрока = Неопределено Тогда
				Прервать;
			КонецЕсли;
			СтрокаJSON = ЗначениеВJSON(СоответствиеВСтруктуру(ТекущаяСтрока));
			Если СтрокаJSON = ПредыдущаяСтрокаJSON Тогда
				// Динамические списки иногда на один-два шага оставляют текущую строку
				// прежней при подгрузке следующей порции данных. Это не конец списка:
				// например на dev-area catalog ИдентификаторыОбъектовМетаданных строка
				// 99 повторяется на 100-м шаге, а на 101-м курсор снова движется.
				// Считаем концом только несколько повторов подряд.
				ПовторыБезСмещения = ПовторыБезСмещения + 1;
				Если ПовторыБезСмещения >= 5 Тогда
					Прервать;
				КонецЕсли;
			Иначе
				ПовторыБезСмещения = 0;
				ПредыдущаяСтрокаJSON = СтрокаJSON;
				Результат.Добавить(СоответствиеВСтруктуру(ТекущаяСтрока));
				Если Результат.Количество() >= Лимит Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать; // Дошли до конца списка или динамический список не поддерживает переход
			КонецПопытки;
		КонецЦикла;
		Если Результат.Количество() >= РезультатПолучитьСтроки.Количество() Тогда
			Возврат Результат;
		Иначе
			Возврат РезультатПолучитьСтроки;
		КонецЕсли;
	Исключение
		Если РезультатПолучитьСтроки.Количество() > 0 Тогда
			Возврат РезультатПолучитьСтроки;
		КонецЕсли;
		ВызватьИсключение "Не удалось получить строки таблицы (ни ПолучитьСтроки, ни навигация): " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ПолеТаблицыСовпадаетMCP(ИмяТек, ЗаголовокТек, ИмяПоля, ИскатьПоЗаголовку)
	НормИмяТек = НРег(Строка(ИмяТек));
	НормЗаголовокТек = НРег(Строка(ЗаголовокТек));
	НормИмяПоля = НРег(Строка(ИмяПоля));
	ИмяПоляБезПробелов = СтрЗаменить(НормИмяПоля, " ", "");
	ЗаголовокБезПробелов = СтрЗаменить(НормЗаголовокТек, " ", "");

	// В таблице порядка СКД техническое имя свойства — ТипУпорядочивания,
	// а видимый заголовок/editor — "Направление сортировки". Без этого alias-а
	// поиск активного редактора после ИзменитьСтроку() отвергал правильную ячейку
	// и дальше находил одноимённую колонку формы вне edit-mode, у которой dropdown
	// не открывается: "Неподходящий тип элемента управления".
	Если СтрНайти(ИмяПоляБезПробелов, "типупорядочивания") > 0
		И (ЗаголовокБезПробелов = "направлениесортировки" Или ЗаголовокБезПробелов = "направление") Тогда
		Возврат Истина;
	КонецЕсли;

	Если ИскатьПоЗаголовку Тогда
		Возврат ЗаголовокТек = ИмяПоля Или СтрНайти(НормЗаголовокТек, НормИмяПоля) > 0;
	КонецЕсли;
	Возврат ИмяТек = ИмяПоля Или ЗаголовокТек = ИмяПоля Или СтрНайти(НормИмяТек, НормИмяПоля) > 0 Или СтрНайти(НормЗаголовокТек, НормИмяПоля) > 0;
КонецФункции

&НаКлиенте
Функция КлючСтрокиСоответствуетПолюMCP(Ключ, ИмяПоля, ИскатьПоЗаголовку)
	КлючСтрокой = Строка(Ключ);
	КлючНРег = НРег(КлючСтрокой);
	ИмяПоляНРег = НРег(Строка(ИмяПоля));
	КлючБезПробелов = СтрЗаменить(КлючНРег, " ", "");
	ИмяПоляБезПробелов = СтрЗаменить(ИмяПоляНРег, " ", "");

	Если ИскатьПоЗаголовку Тогда
		Возврат КлючСтрокой = ИмяПоля Или СтрНайти(КлючНРег, ИмяПоляНРег) > 0 Или СтрНайти(КлючБезПробелов, ИмяПоляБезПробелов) > 0;
	КонецЕсли;

	Если КлючСтрокой = ИмяПоля Или СтрНайти(КлючНРег, ИмяПоляНРег) > 0 Или СтрНайти(КлючБезПробелов, ИмяПоляБезПробелов) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	// В таблицах настроек СКД техническое имя редактора ячейки не всегда
	// совпадает с ключом текущей строки. Например, редактор
	// ...ОтборПравоеЗначение отображается в строке как колонка "Значение".
	Если ИмяПоляБезПробелов = "правоезначение" И КлючБезПробелов = "значение" Тогда
		Возврат Истина;
	КонецЕсли;
	Если ИмяПоляБезПробелов = "видсравнения" И КлючБезПробелов = "видсравнения" Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ИмяПоляБезПробелов, "типупорядочивания") > 0
		И (КлючБезПробелов = "направление" Или КлючБезПробелов = "направлениесортировки") Тогда
		Возврат Истина;
	КонецЕсли;
	Если ИмяПоляБезПробелов = "направлениесортировки" И КлючБезПробелов = "направлениесортировки" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция НормализоватьЗначениеДляПроверкиMCP(Значение)
	Результат = НРег(СокрЛП(Строка(Значение)));
	Результат = СтрЗаменить(Результат, Символ(160), "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, ",", ".");
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ЗначенияСовпадаютДляПроверкиMCP(ФактическоеЗначение, ОжидаемоеЗначение)
	Факт = НормализоватьЗначениеДляПроверкиMCP(ФактическоеЗначение);
	Ожидание = НормализоватьЗначениеДляПроверкиMCP(ОжидаемоеЗначение);
	Если Факт = Ожидание Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ПустаяСтрока(Ожидание) И СтрНайти(Факт, Ожидание) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ПустаяСтрока(Факт) И СтрНайти(Ожидание, Факт) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ЗначениеКолонкиТекущейСтрокиMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку)
	Попытка
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
	Исключение
		Возврат Новый Структура("found,key,value,error", Ложь, "", "", ОписаниеОшибки());
	КонецПопытки;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат Новый Структура("found,key,value", Ложь, "", "");
	КонецЕсли;
	Для Каждого КЗ Из ТекущаяСтрока Цикл
		Если КлючСтрокиСоответствуетПолюMCP(КЗ.Ключ, ИмяПоля, ИскатьПоЗаголовку) Тогда
			Возврат Новый Структура("found,key,value", Истина, Строка(КЗ.Ключ), Строка(КЗ.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("found,key,value", Ложь, "", "");
КонецФункции

&НаКлиенте
Функция ОбеспечитьРедактированиеЧерезКомандуТаблицыMCP(Таблица, ИмяТаблицы, Ошибки)
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат Новый Структура("editing,changed,error,method", Ложь, Ложь, "Имя таблицы пустое, точную команду изменения строки определить нельзя", "");
	КонецЕсли;
	// Ищем только точную команду таблицы, например
	// КомпоновщикНастроек...ОтборИзменить. По заголовку "Изменить" искать нельзя:
	// на форме настроек рядом есть глобальная команда "Изменить форму...", которая
	// открывает настройку формы вместо редактирования строки таблицы.
	ИмяКомандыИзменить = ИмяТаблицы + "Изменить";
	Попытка
		Панель = Таблица.ПолучитьКоманднуюПанель();
	Исключение
		Если Ошибки <> Неопределено Тогда Ошибки.Добавить("ПолучитьКоманднуюПанель: " + ОписаниеОшибки()); КонецЕсли;
		Панель = Неопределено;
	КонецПопытки;
	Если Панель <> Неопределено Тогда
		Попытка
			КнопкаИзменить = НайтиКнопку(Панель, ИмяКомандыИзменить, "", 0);
			Если КнопкаИзменить <> Неопределено Тогда
				КнопкаИзменить.Нажать();
				Если ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
					Возврат Новый Структура("editing,changed,error,method", Истина, Истина, "", "command_panel_edit:" + ИмяКомандыИзменить);
				КонецЕсли;
			КонецЕсли;
		Исключение
			Если Ошибки <> Неопределено Тогда Ошибки.Добавить(ИмяКомандыИзменить + ": " + ОписаниеОшибки()); КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	Попытка
		Меню = Таблица.ПолучитьКонтекстноеМеню();
	Исключение
		Если Ошибки <> Неопределено Тогда Ошибки.Добавить("ПолучитьКонтекстноеМеню: " + ОписаниеОшибки()); КонецЕсли;
		Меню = Неопределено;
	КонецПопытки;
	Если Меню <> Неопределено Тогда
		Попытка
			КнопкаИзменить = НайтиКнопку(Меню, ИмяКомандыИзменить, "", 0);
			Если КнопкаИзменить <> Неопределено Тогда
				КнопкаИзменить.Нажать();
				Если ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
					Возврат Новый Структура("editing,changed,error,method", Истина, Истина, "", "context_menu_edit:" + ИмяКомандыИзменить);
				КонецЕсли;
			КонецЕсли;
		Исключение
			Если Ошибки <> Неопределено Тогда Ошибки.Добавить(ИмяКомандыИзменить + ": " + ОписаниеОшибки()); КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура("editing,changed,error,method", Ложь, Ложь, ?(Ошибки = Неопределено Или Ошибки.Количество() = 0, "Точная команда таблицы '" + ИмяКомандыИзменить + "' не найдена или не включила редактирование", СтрСоединить(Ошибки, "; ")), "");
КонецФункции

&НаКлиенте
Функция ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица, ИмяТаблицы = "")
	Таблица.Активизировать();
	УжеРедактируется = ТаблицаВРежимеРедактированияMCP(Таблица);
	Если УжеРедактируется Тогда
		Возврат Новый Структура("editing,changed,error,method", Истина, Ложь, "", "already_editing");
	КонецЕсли;
	ОшибкаИзменитьСтроку = "";
	Попытка
		Таблица.ИзменитьСтроку();
		РежимПослеИзменитьСтроку = ТаблицаВРежимеРедактированияMCP(Таблица);
		Если РежимПослеИзменитьСтроку Тогда
			Возврат Новый Структура("editing,changed,error,method", Истина, Истина, "", "ИзменитьСтроку");
		КонецЕсли;
		ОшибкаИзменитьСтроку = "ИзменитьСтроку() выполнен, но ТекущийРежимРедактирование() остался Ложь";
	Исключение
		ОшибкаИзменитьСтроку = ОписаниеОшибки();
		Если ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
			Возврат Новый Структура("editing,changed,error,method", Истина, Истина, "", "ИзменитьСтроку_exception_but_editing");
		КонецЕсли;
	КонецПопытки;

	ОшибкиКоманды = Новый Массив;
	РезультатКоманды = ОбеспечитьРедактированиеЧерезКомандуТаблицыMCP(Таблица, ИмяТаблицы, ОшибкиКоманды);
	Если СвойствоСтруктуры(РезультатКоманды, "editing", Ложь) Тогда
		Возврат РезультатКоманды;
	КонецЕсли;
	Возврат Новый Структура("editing,changed,error,method", Ложь, Ложь, ОшибкаИзменитьСтроку + "; " + СвойствоСтруктуры(РезультатКоманды, "error", ""), "");
КонецФункции

&НаКлиенте
Функция ТаблицаВРежимеРедактированияMCP(Таблица)
	Попытка
		Возврат Таблица.ТекущийРежимРедактирование();
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ДиагностикаТаблицыMCP(Таблица)
	Если Таблица = Неопределено Тогда
		Возврат "table=Неопределено";
	КонецЕсли;
	Диагностика = "type=" + Строка(ТипЗнч(Таблица));
	Диагностика = Диагностика + ";name=" + БезопасноеСвойство(Таблица, "Имя", "");
	Диагностика = Диагностика + ";title=" + БезопасныйЗаголовок(Таблица);
	Попытка
		Диагностика = Диагностика + ";edit=" + Строка(Таблица.ТекущийРежимРедактирование());
	Исключение
		Диагностика = Диагностика + ";edit_error=" + ОписаниеОшибки();
	КонецПопытки;
	Попытка
		КоманднаяПанель = Таблица.ПолучитьКоманднуюПанель();
		Диагностика = Диагностика + ";command_panel_type=" + Строка(ТипЗнч(КоманднаяПанель));
	Исключение
		Диагностика = Диагностика + ";command_panel_error=" + ОписаниеОшибки();
	КонецПопытки;
	Попытка
		КонтекстноеМеню = Таблица.ПолучитьКонтекстноеМеню();
		Диагностика = Диагностика + ";context_menu_type=" + Строка(ТипЗнч(КонтекстноеМеню));
	Исключение
		Диагностика = Диагностика + ";context_menu_error=" + ОписаниеОшибки();
	КонецПопытки;
	Возврат Диагностика;
КонецФункции

&НаКлиенте
Функция ЗавершитьРедактированиеСтрокиТаблицыMCP(Таблица)
	ОшибкаЗавершения = "";
	БылаВРедактировании = ТаблицаВРежимеРедактированияMCP(Таблица);
	Попытка
		Если БылаВРедактировании Тогда
			Таблица.ЗакончитьРедактированиеСтроки(Ложь);
		КонецЕсли;
	Исключение
		ОшибкаЗавершения = ОписаниеОшибки();
	КонецПопытки;

	ОсталасьВРедактировании = ТаблицаВРежимеРедактированияMCP(Таблица);
	ОтменаВыполнена = Ложь;
	ОшибкаОтмены = "";
	Если ОсталасьВРедактировании Тогда
		Попытка
			Таблица.ЗакончитьРедактированиеСтроки(Истина);
			ОтменаВыполнена = Истина;
		Исключение
			ОшибкаОтмены = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;

	ВсеЕщеВРедактировании = ТаблицаВРежимеРедактированияMCP(Таблица);
	Возврат Новый Структура("was_editing,commit_error,remained_editing,cancel_done,cancel_error,still_editing", БылаВРедактировании, ОшибкаЗавершения, ОсталасьВРедактировании, ОтменаВыполнена, ОшибкаОтмены, ВсеЕщеВРедактировании);
КонецФункции

&НаКлиенте
Функция НайтиРодительскуюТаблицуMCP(Объект)
	Текущий = Объект;
	Пока Текущий <> Неопределено Цикл
		Если НормализованноеИмяТипа(ТипЗнч(Текущий)) = "тестируемаятаблицаформы" Тогда
			Возврат Текущий;
		КонецЕсли;
		Попытка
			Текущий = Текущий.ПолучитьРодителя();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ПроверитьРедактированиеРодительскойТаблицыПередВводомMCP(Поле, Контекст)
	Таблица = НайтиРодительскуюТаблицуMCP(Поле);
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
		ВызватьИсключение Контекст + ": поле таблицы нельзя изменять, пока таблица не находится в режиме редактирования строки. Сначала вызовите ТестируемаяТаблицаФормы.ИзменитьСтроку() и проверьте ТекущийРежимРедактирование() = Истина.";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРедактированиеПоляЕслиНужноMCP(Поле)
	Попытка
		Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
			Поле.ЗакрытьВыпадающийСписок();
		КонецЕсли;
	Исключение
	КонецПопытки;
	Таблица = НайтиРодительскуюТаблицуMCP(Поле);
	Если Таблица <> Неопределено И ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
		Попытка
			Таблица.ЗакончитьРедактированиеСтроки(Истина);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция НайтиПолеТаблицыMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку)
	Возврат НайтиПолеТаблицыРекурсивноMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку, 0);
КонецФункции

&НаКлиенте
Функция НайтиВидимыйРедакторПоляНастройкиСпискаMCP(РодительскийОбъект, ИмяПоля, Глубина = 0)
	Если РодительскийОбъект = Неопределено Или Глубина > 30 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ИмяТекущего = БезопасноеСвойство(РодительскийОбъект, "Имя", "");
		ЗаголовокТекущего = БезопасныйЗаголовок(РодительскийОбъект);
		ТипТекущего = НормализованноеИмяТипа(ТипЗнч(РодительскийОбъект));
		Если ТипТекущего = "тестируемоеполеформы"
			И ПолеТаблицыСовпадаетMCP(ИмяТекущего, ЗаголовокТекущего, ИмяПоля, Ложь) Тогда
			Видим = БулевоИзЗначенияMCP(БезопасноеЗначениеМетода(РодительскийОбъект, "ТекущаяВидимость", Ложь), Ложь);
			Доступен = БулевоИзЗначенияMCP(БезопасноеЗначениеМетода(РодительскийОбъект, "ТекущаяДоступность", Ложь), Ложь);
			ТолькоПросмотр = БулевоИзЗначенияMCP(БезопасноеЗначениеМетода(РодительскийОбъект, "ТекущееТолькоПросмотр", Истина), Истина);
			Представление = ПредставлениеДанныхПоля(РодительскийОбъект);
			Лог("НайтиВидимыйРедакторПоляНастройкиСпискаMCP: candidate name=" + ИмяТекущего
				+ " title=" + ЗаголовокТекущего
				+ " data=" + Представление
				+ " visible=" + Строка(Видим)
				+ " available=" + Строка(Доступен)
				+ " readonly=" + Строка(ТолькоПросмотр));
			Если Видим И Доступен И Не ТолькоПросмотр Тогда
				Возврат РодительскийОбъект;
			КонецЕсли;
		КонецЕсли;
		Для Каждого Подчиненный Из БезопасныеПодчиненные(РодительскийОбъект) Цикл
			Найденный = НайтиВидимыйРедакторПоляНастройкиСпискаMCP(Подчиненный, ИмяПоля, Глубина + 1);
			Если Найденный <> Неопределено Тогда
				Возврат Найденный;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Лог("НайтиВидимыйРедакторПоляНастройкиСпискаMCP: exception " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция НайтиВидимыйРедакторПоляНастройкиСпискаСОжиданиемMCP(ИмяПоля, МаксимумМс = 6000)
	// Web-клиент 8.5 создаёт editor ячейки таблицы настроек СКД асинхронно после
	// ИзменитьСтроку(). Синхронный поиск сразу после входа в edit-mode часто не
	// видит его и возвращает одноимённую колонку/служебный объект без рабочего
	// dropdown. Поэтому опрашиваем активное окно с задержкой, пока не появится
	// видимый editor с данными.
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < МаксимумМс Цикл
		Попытка
			АктивноеОкноРедактора = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Исключение
			АктивноеОкноРедактора = Неопределено;
		КонецПопытки;
		Если АктивноеОкноРедактора <> Неопределено Тогда
			Поле = НайтиВидимыйРедакторПоляНастройкиСпискаMCP(АктивноеОкноРедактора, ИмяПоля);
			Если Поле <> Неопределено Тогда
				Лог("НайтиВидимыйРедакторПоляНастройкиСпискаСОжиданиемMCP: найден " + ИмяПоля + " через " + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) + "мс");
				Возврат Поле;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Лог("НайтиВидимыйРедакторПоляНастройкиСпискаСОжиданиемMCP: не найден " + ИмяПоля + " за " + Строка(МаксимумМс) + "мс");
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция НайтиПолеРедактораТаблицыMCP(АктивноеОкно, Таблица, ИмяТаблицы, ИмяПоля, ИскатьПоЗаголовку)
	// В режиме редактирования обычной табличной части в дереве формы могут
	// одновременно присутствовать и колонка таблицы, и реальный активный редактор
	// текущей ячейки. Поиск по дереву часто находит не тот объект. Сначала берём
	// именно текущий элемент таблицы после явной навигации к колонке.
	//
	// Для таблиц формы "Настройка списка" (КомпоновщикНастроек...) этот вызов на
	// web-клиенте 8.5 иногда зависает внутри платформы. Исключение — таблица
	// сортировки: её колонка "Направление сортировки" не имеет отдельного quick-поля,
	// поэтому после явной активации текущей строки берём текущий редактор ячейки.
	РазрешитьТекущийЭлементКомпоновщика = Лев(ИмяТаблицы, СтрДлина("КомпоновщикНастроек")) <> "КомпоновщикНастроек"
		Или СтрНайти(ИмяТаблицы, "Порядок") > 0;
	Если РазрешитьТекущийЭлементКомпоновщика Тогда
		Попытка
			Если СтрНайти(НРег(ИмяПоля), "направ") > 0 Или СтрНайти(НРег(ИмяПоля), "упорядоч") > 0 Тогда
				// В строке порядка после добавления активной может быть любая колонка
				// (Использование/Поле/Направление). Один шаг вправо ненадёжен: если стартуем
				// с "Использование", попадём в "Поле" и получим не тот редактор. Ищем
				// колонку по видимому заголовку и только затем берём текущий элемент.
				АктивизироватьКолонкуТаблицыMCP(Таблица, "Направление сортировки", Истина);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			ТекущийЭлементТаблицы = Таблица.ПолучитьТекущийЭлемент();
			Лог("НайтиПолеРедактораТаблицыMCP: current name=" + БезопасноеСвойство(ТекущийЭлементТаблицы, "Имя", "")
				+ " title=" + БезопасныйЗаголовок(ТекущийЭлементТаблицы)
				+ " data=" + ПредставлениеДанныхПоля(ТекущийЭлементТаблицы)
				+ " target=" + ИмяПоля
				+ " match=" + Строка(ЭлементТаблицыСоответствуетПолюMCP(ТекущийЭлементТаблицы, ИмяПоля, ИскатьПоЗаголовку))
				+ " edit=" + Строка(ТаблицаВРежимеРедактированияMCP(Таблица)));
			Если ЭлементТаблицыСоответствуетПолюMCP(ТекущийЭлементТаблицы, ИмяПоля, ИскатьПоЗаголовку) Тогда
				Возврат ТекущийЭлементТаблицы;
			КонецЕсли;
		Исключение
			Лог("НайтиПолеРедактораТаблицыMCP: current exception " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Если Не ПустаяСтрока(ИмяТаблицы) И Не ПустаяСтрока(ИмяПоля) Тогда
		Кандидаты.Добавить(ИмяТаблицы + ИмяПоля);
	КонецЕсли;
	Кандидаты.Добавить(ИмяПоля);

	Для Каждого Кандидат Из Кандидаты Цикл
		Если ПустаяСтрока(Кандидат) Тогда
			Продолжить;
		КонецЕсли;
		Поле = НайтиОбъектРекурсивно(АктивноеОкно, Кандидат, "", "тестируемоеполеформы", 0);
		Если Поле <> Неопределено Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;

	Если ИскатьПоЗаголовку Тогда
		Поле = НайтиОбъектРекурсивно(АктивноеОкно, "", ИмяПоля, "тестируемоеполеформы", 0);
		Если Поле <> Неопределено Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЕсли;

	Возврат НайтиПолеТаблицыMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку);
КонецФункции

&НаКлиенте
Функция ВвестиТекстВРедакторТаблицыMCP(Таблица, Поле, ИмяПоля, Значение)
	ПроверитьРедактированиеРодительскойТаблицыПередВводомMCP(Поле, "Перед прямым вводом поля " + ИмяПоля);
	Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
		ВызватьИсключение "Таблица вышла из режима редактирования перед прямым вводом поля " + ИмяПоля;
	КонецЕсли;
	Поле.Активизировать();
	Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
		ВызватьИсключение "Таблица вышла из режима редактирования после активизации редактора поля " + ИмяПоля;
	КонецЕсли;

	Поле.ВвестиТекст(Значение);
	МетодВвода = "table_editor.ВвестиТекст";

	// Для ссылочных ячеек web-клиент после ВвестиТекст() часто открывает
	// выпадающий список отфильтрованных вариантов. Его нужно обработать сразу,
	// пока текущая строка еще находится в режиме редактирования. Поздний fallback
	// после завершения строки уже не имеет права вводить значение в колонку.
	НачалоОжиданияСписка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Не ОткрытВыпадающийСписокПоляMCP(Поле)
		И ТаблицаВРежимеРедактированияMCP(Таблица)
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжиданияСписка < 2000 Цикл
	КонецЦикла;

	Если ОткрытВыпадающийСписокПоляMCP(Поле) Тогда
		Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
			ВызватьИсключение "Таблица вышла из режима редактирования перед выбором из выпадающего списка поля " + ИмяПоля;
		КонецЕсли;
		Попытка
			Поле.ОжидатьФормированияВыпадающегоСписка(3);
		Исключение
		КонецПопытки;
		Представления = Поле.ПолучитьПредставлениеСпискаВыбора();
		Если Представления.Количество() = 0 Тогда
			Попытка
				Поле.ЗакрытьВыпадающийСписок();
			Исключение
			КонецПопытки;
			ВызватьИсключение "Выпадающий список редактора поля " + ИмяПоля + " пуст после ввода значения " + Значение;
		КонецЕсли;
		ИндексВыбора = ИндексРелевантногоВариантаСпискаВыбораMCP(Представления, Значение);
		Если ИндексВыбора = Неопределено Тогда
			Попытка
				Поле.ЗакрытьВыпадающийСписок();
			Исключение
			КонецПопытки;
			ВызватьИсключение "В выпадающем списке редактора поля " + ИмяПоля + " нет релевантного варианта для значения " + Значение;
		КонецЕсли;
		ПредставлениеВыбираемогоВарианта = ПредставлениеВариантаСпискаВыбораMCP(Представления[ИндексВыбора]);
		Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
			ВызватьИсключение "Таблица вышла из режима редактирования перед выполнением выбора из списка поля " + ИмяПоля;
		КонецЕсли;
		Попытка
			Поле.ВыполнитьВыборИзСпискаВыбора(ПредставлениеВыбираемогоВарианта);
		Исключение
			Поле.ВыполнитьВыборИзСпискаВыбора(ИндексВыбора);
		КонецПопытки;
		МетодВвода = "table_editor.ВвестиТекст+ВыполнитьВыборИзСпискаВыбора";
	КонецЕсли;

	Возврат Новый Структура("method", МетодВвода);
КонецФункции

&НаКлиенте
Функция НайтиПолеТаблицыРекурсивноMCP(Элемент, ИмяПоля, ИскатьПоЗаголовку, Глубина)
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Подчиненные = БезопасныеПодчиненные(Элемент);
	Для Каждого Подчиненный Из Подчиненные Цикл
		ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
		Если ТипТек = "тестируемоеполеформы" Тогда
			ИмяТек = БезопасноеСвойство(Подчиненный, "Имя", "");
			ЗаголовокТек = БезопасныйЗаголовок(Подчиненный);
			Если ПолеТаблицыСовпадаетMCP(ИмяТек, ЗаголовокТек, ИмяПоля, ИскатьПоЗаголовку) Тогда
				Возврат Подчиненный;
			КонецЕсли;
		КонецЕсли;
		НайденноеПоле = НайтиПолеТаблицыРекурсивноMCP(Подчиненный, ИмяПоля, ИскатьПоЗаголовку, Глубина + 1);
		Если НайденноеПоле <> Неопределено Тогда
			Возврат НайденноеПоле;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПерейтиКСтрокеТаблицыПоТекстуMCP(Таблица, ИскомыйТекст, Лимит)
	ИскомыйТекстНРег = НРег(Строка(ИскомыйТекст));
	Если ПустаяСтрока(ИскомыйТекстНРег) Тогда
		Возврат Новый Структура("found,index,row,rows_checked", Ложь, Неопределено, Неопределено, 0);
	КонецЕсли;

	МассивСтрок = ПолучитьСтрокиТаблицыКакМассив(Таблица, Лимит);
	ИндексСтроки = 0;
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если СтрНайти(НРег(ЗначениеВJSON(СтрокаТаблицы)), ИскомыйТекстНРег) > 0 Тогда
			Таблица.Активизировать();
			Попытка
				Таблица.ПерейтиКПервойСтроке();
				Для НомерШага = 1 По ИндексСтроки Цикл
					Таблица.ПерейтиКСледующейСтроке();
				КонецЦикла;
			Исключение
				// Если таблица выбора не поддерживает навигацию, оставляем активной
				// текущую строку и ниже вернём диагностическую строку поиска.
			КонецПопытки;
			Возврат Новый Структура("found,index,row,rows_checked", Истина, ИндексСтроки, СтрокаТаблицы, МассивСтрок.Количество());
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат Новый Структура("found,index,row,rows_checked", Ложь, Неопределено, Неопределено, МассивСтрок.Количество());
КонецФункции

&НаКлиенте
Процедура ВыбратьТекущуюСтрокуФормыВыбораMCP(АктивноеОкноВыбора, ТаблицаВыбора)
	ТаблицаВыбора.Активизировать();
	КнопкаВыбратьСтроку = НайтиКнопку(АктивноеОкноВыбора, "СписокКонтекстноеМенюВыбрать", "", 0);
	Если КнопкаВыбратьСтроку <> Неопределено Тогда
		КнопкаВыбратьСтроку.Нажать();
		Возврат;
	КонецЕсли;

	КнопкаВыбрать = НайтиКнопку(АктивноеОкноВыбора, "ФормаВыбрать", "", 0);
	Если КнопкаВыбрать = Неопределено Тогда
		КнопкаВыбрать = НайтиКнопку(АктивноеОкноВыбора, "Выбрать", "", 0);
	КонецЕсли;
	Если КнопкаВыбрать <> Неопределено Тогда
		КнопкаВыбрать.Нажать();
	Иначе
		ТаблицаВыбора.Выбрать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЭлементТаблицыСоответствуетПолюMCP(Элемент, ИмяПоля, ИскатьПоЗаголовку)
	Если Элемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяТек = БезопасноеСвойство(Элемент, "Имя", "");
	ЗаголовокТек = БезопасныйЗаголовок(Элемент);
	Возврат ПолеТаблицыСовпадаетMCP(ИмяТек, ЗаголовокТек, ИмяПоля, ИскатьПоЗаголовку);
КонецФункции

&НаКлиенте
Функция АктивизироватьКолонкуТаблицыMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку)
	Таблица.Активизировать();
	Попытка
		Если ЭлементТаблицыСоответствуетПолюMCP(Таблица.ПолучитьТекущийЭлемент(), ИмяПоля, ИскатьПоЗаголовку) Тогда
			Возврат Новый Структура("activated,steps,direction", Истина, 0, "current");
		КонецЕсли;
	Исключение
	КонецПопытки;

	Для НомерШага = 1 По 80 Цикл
		Попытка
			Таблица.ПерейтиКСледующемуЭлементу();
		Исключение
			Прервать;
		КонецПопытки;
		Попытка
			Если ЭлементТаблицыСоответствуетПолюMCP(Таблица.ПолучитьТекущийЭлемент(), ИмяПоля, ИскатьПоЗаголовку) Тогда
				Возврат Новый Структура("activated,steps,direction", Истина, НомерШага, "next");
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для НомерШага = 1 По 80 Цикл
		Попытка
			Таблица.ПерейтиКПредыдущемуЭлементу();
		Исключение
			Прервать;
		КонецПопытки;
		Попытка
			Если ЭлементТаблицыСоответствуетПолюMCP(Таблица.ПолучитьТекущийЭлемент(), ИмяПоля, ИскатьПоЗаголовку) Тогда
				Возврат Новый Структура("activated,steps,direction", Истина, НомерШага, "previous");
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Новый Структура("activated,steps,direction", Ложь, Неопределено, "");
КонецФункции

&НаКлиенте
Функция ВыбратьЗначениеПоляЧерезФормуВыбораMCP(Поле, Значение, Таблица = Неопределено, ИмяПоля = "", ИскатьПоЗаголовку = Ложь)
	ИсходноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИсходныйЗаголовок = БезопасноеСвойство(ИсходноеОкно, "Заголовок", "");

	ОшибкиОткрытия = Новый Массив;
	Если Таблица <> Неопределено Тогда
		РезультатРедактированияПередВыбором = ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица);
		Если Не РезультатРедактированияПередВыбором.editing Тогда
			ОшибкиОткрытия.Добавить("РежимРедактирования=" + РезультатРедактированияПередВыбором.error);
		КонецЕсли;
	КонецЕсли;
	Поле.Активизировать();
	Попытка
		Поле.Выбрать();
	Исключение
		ОшибкиОткрытия.Добавить("Поле.Выбрать=" + ОписаниеОшибки());
		Если Таблица = Неопределено Тогда
			ВызватьИсключение СтрСоединить(ОшибкиОткрытия, "; ");
		КонецЕсли;
		РезультатПовторногоРедактирования = ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица);
		Если Не РезультатПовторногоРедактирования.editing Тогда
			ОшибкиОткрытия.Добавить("ПовторныйРежимРедактирования=" + РезультатПовторногоРедактирования.error);
			ВызватьИсключение СтрСоединить(ОшибкиОткрытия, "; ");
		КонецЕсли;
		Если Не ПустаяСтрока(ИмяПоля) Тогда
			АктивизироватьКолонкуТаблицыMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку);
			АктивноеОкноПовтора = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			ПовторноеПоле = НайтиПолеРедактораТаблицыMCP(АктивноеОкноПовтора, Таблица, БезопасноеСвойство(Таблица, "Имя", ""), ИмяПоля, ИскатьПоЗаголовку);
			Если ПовторноеПоле <> Неопределено Тогда
				Поле = ПовторноеПоле;
				Поле.Активизировать();
			КонецЕсли;
		КонецЕсли;
		Попытка
			Поле.Выбрать();
		Исключение
			ОшибкиОткрытия.Добавить("ПовторноеПоле.Выбрать=" + ОписаниеОшибки());
			ВызватьИсключение СтрСоединить(ОшибкиОткрытия, "; ");
		КонецПопытки;
	КонецПопытки;

	АктивноеОкноВыбора = Неопределено;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 5000 Цикл
		АктивноеОкноВыбора = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкноВыбора, "Заголовок", "") <> ИсходныйЗаголовок Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если АктивноеОкноВыбора = Неопределено Тогда
		АктивноеОкноВыбора = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	КонецЕсли;
	ЗаголовокОкнаВыбора = БезопасноеСвойство(АктивноеОкноВыбора, "Заголовок", "");
	Если ЗаголовокОкнаВыбора = ИсходныйЗаголовок Тогда
		ДополнениеОткрытия = ?(ОшибкиОткрытия.Количество() = 0, "", "; попытки открытия: " + СтрСоединить(ОшибкиОткрытия, "; "));
		ВызватьИсключение "Форма выбора не открылась" + ДополнениеОткрытия;
	КонецЕсли;

	ТаблицаВыбора = НайтиТаблицуПоПараметрам(АктивноеОкноВыбора, "Список", "", 0);
	Если ТаблицаВыбора = Неопределено Тогда
		Попытка
			ТаблицаВыбора = ТестируемоеПриложение.ПолучитьОбъект(Тип("ТестируемаяТаблицаФормы"), "", "Список", 2);
		Исключение
			ТаблицаВыбора = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ТаблицаВыбора = Неопределено Тогда
		ВызватьИсключение "Таблица выбора не найдена в форме: " + ЗаголовокОкнаВыбора;
	КонецЕсли;

	РезультатПоиска = ПерейтиКСтрокеТаблицыПоТекстуMCP(ТаблицаВыбора, Значение, 200);
	Если Не РезультатПоиска.found Тогда
		ВызватьИсключение "Строка выбора для значения " + Строка(Значение) + " не найдена в форме " + ЗаголовокОкнаВыбора + "; проверено строк: " + Строка(РезультатПоиска.rows_checked);
	КонецЕсли;

	ВыбратьТекущуюСтрокуФормыВыбораMCP(АктивноеОкноВыбора, ТаблицаВыбора);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 5000 Цикл
		АктивноеОкноПослеВыбора = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		Если БезопасноеСвойство(АктивноеОкноПослеВыбора, "Заголовок", "") = ИсходныйЗаголовок Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("selected,source_window,selection_window,search", Истина, ИсходныйЗаголовок, ЗаголовокОкнаВыбора, РезультатПоиска);
КонецФункции

&НаКлиенте
Функция УстановитьПолеТаблицыMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "table", "ДополнительнаяИнформация");
	ИмяПоля = СвойствоСтруктуры(Параметры, "field", "");
	Значение = СвойствоСтруктуры(Параметры, "value", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
	Если Таблица = Неопределено Тогда
		ВызватьИсключение "Таблица не найдена: " + ИмяТаблицы;
	КонецЕсли;

	РезультатНачалаРедактирования = ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица);
	Если Не РезультатНачалаРедактирования.editing Тогда
		ВызватьИсключение "Таблица " + ИмяТаблицы + " не вошла в режим редактирования строки; ввод в поле " + ИмяПоля + " запрещен. Ошибка: " + РезультатНачалаРедактирования.error;
	КонецЕсли;
	РезультатАктивизацииКолонки = АктивизироватьКолонкуТаблицыMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку);
	Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
		ВызватьИсключение "Таблица " + ИмяТаблицы + " вышла из режима редактирования до поиска редактора поля " + ИмяПоля;
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Поле = НайтиПолеРедактораТаблицыMCP(АктивноеОкно, Таблица, ИмяТаблицы, ИмяПоля, ИскатьПоЗаголовку);
	Если Поле = Неопределено Тогда
		ДополнениеОшибкиРедактирования = ?(ПустаяСтрока(РезультатНачалаРедактирования.error), "", "; ошибка начала редактирования: " + РезультатНачалаРедактирования.error);
		ДополнениеОшибкиАктивизации = ?(РезультатАктивизацииКолонки.activated, "", "; колонка не активизирована");
		ВызватьИсключение "Поле редактора таблицы не найдено: " + ИмяПоля + ДополнениеОшибкиРедактирования + ДополнениеОшибкиАктивизации;
	КонецЕсли;
	ИмяРедактора = БезопасноеСвойство(Поле, "Имя", "");
	Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
		ВызватьИсключение "Таблица " + ИмяТаблицы + " не в режиме редактирования перед активизацией редактора " + ИмяРедактора;
	КонецЕсли;
	Поле.Активизировать();
	ПроверитьРедактированиеРодительскойТаблицыПередВводомMCP(Поле, "Перед вводом поля " + ИмяПоля);

	ОшибкаУстановки = "";
	РезультатУстановки = Новый Структура("method", "table_editor.ВвестиТекст");
	РезультатВыбораЧерезФорму = Неопределено;
	Попытка
		РезультатУстановки = ВвестиТекстВРедакторТаблицыMCP(Таблица, Поле, ИмяПоля, Значение);
	Исключение
		// Для некоторых редакторов ячеек ВвестиТекст() может бросить исключение уже
		// после фактического изменения значения. Завершаем редактирование и ниже
		// проверяем строку. Если значение не подтвердится, для ссылочных полей будет
		// отдельный fallback через штатную форму выбора.
		ОшибкаУстановки = ОписаниеОшибки();
	КонецПопытки;

	РезультатЗавершенияРедактирования = ЗавершитьРедактированиеСтрокиТаблицыMCP(Таблица);
	Если Не ПустаяСтрока(РезультатЗавершенияРедактирования.commit_error) Тогда
		ВызватьИсключение "Не удалось завершить редактирование строки таблицы " + ИмяТаблицы + ": " + РезультатЗавершенияРедактирования.commit_error;
	КонецЕсли;
	Если РезультатЗавершенияРедактирования.still_editing Тогда
		ВызватьИсключение "Таблица " + ИмяТаблицы + " осталась в режиме редактирования после попытки завершить и отменить редактирование строки";
	КонецЕсли;

	Проверка = ЗначениеКолонкиТекущейСтрокиMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку);
	Проверено = Проверка.found И ЗначенияСовпадаютДляПроверкиMCP(Проверка.value, Значение);
	Если Не Проверено Тогда
		// Ссылочные поля табличных частей (типичный пример — Номенклатура в
		// Товары) в web-клиенте иногда не принимают прямой ВвестиТекст()/dropdown
		// через редактор ячейки, но штатно принимают выбор из формы списка.
		// Пробуем этот путь только после неуспешной проверки строки, чтобы не
		// ломать числовые поля, где исключение ВвестиТекст() может быть ложным,
		// а значение подтверждается после завершения редактирования.
		Попытка
			РезультатНачалаРедактированияВыбора = ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица);
			Если Не РезультатНачалаРедактированияВыбора.editing Тогда
				ВызватьИсключение "Таблица " + ИмяТаблицы + " не вошла в режим редактирования перед выбором значения поля " + ИмяПоля + "; ошибка: " + РезультатНачалаРедактированияВыбора.error;
			КонецЕсли;
			АктивизироватьКолонкуТаблицыMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку);
			Если Не ТаблицаВРежимеРедактированияMCP(Таблица) Тогда
				ВызватьИсключение "Таблица " + ИмяТаблицы + " вышла из режима редактирования перед выбором значения поля " + ИмяПоля;
			КонецЕсли;
			АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
			ПолеВыбора = НайтиПолеРедактораТаблицыMCP(АктивноеОкно, Таблица, ИмяТаблицы, ИмяПоля, ИскатьПоЗаголовку);
			Если ПолеВыбора = Неопределено Тогда
				ВызватьИсключение "Поле редактора таблицы не найдено для выбора: " + ИмяПоля;
			КонецЕсли;
			ПроверитьРедактированиеРодительскойТаблицыПередВводомMCP(ПолеВыбора, "Перед открытием формы выбора поля " + ИмяПоля);
			РезультатВыбораЧерезФорму = ВыбратьЗначениеПоляЧерезФормуВыбораMCP(ПолеВыбора, Значение, Таблица, ИмяПоля, ИскатьПоЗаголовку);
			РезультатЗавершенияВыбора = ЗавершитьРедактированиеСтрокиТаблицыMCP(Таблица);
			Если Не ПустаяСтрока(РезультатЗавершенияВыбора.commit_error) Тогда
				ВызватьИсключение "Не удалось завершить строку после выбора: " + РезультатЗавершенияВыбора.commit_error;
			КонецЕсли;
			Проверка = ЗначениеКолонкиТекущейСтрокиMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку);
			Проверено = Проверка.found И ЗначенияСовпадаютДляПроверкиMCP(Проверка.value, Значение);
			Если Проверено Тогда
				РезультатУстановки = Новый Структура("method,selection,edit_start,edit_finish", "ФормаВыбора", РезультатВыбораЧерезФорму, РезультатНачалаРедактированияВыбора, РезультатЗавершенияВыбора);
			КонецЕсли;
		Исключение
			ОшибкаУстановки = ?(ПустаяСтрока(ОшибкаУстановки), "", ОшибкаУстановки + "; ") + "ФормаВыбора=" + ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	Если Не Проверено Тогда
		ДополнениеОшибки = ?(ПустаяСтрока(ОшибкаУстановки), "", "; ошибка set_field_value: " + ОшибкаУстановки);
		ВызватьИсключение "Поле таблицы " + ИмяПоля + " установлено через " + ИмяРедактора + ", но значение не подтвердилось; текущее значение: " + Проверка.value
			+ ". Если это ссылочное поле, значение могло не найтись в справочнике: " + ПодсказкаСозданияСсылочногоЗначенияMCP(ИмяПоля, Значение)
			+ ДополнениеОшибки;
	КонецЕсли;

	МетодУстановки = СвойствоСтруктуры(РезультатУстановки, "method", "set_field_value");
	Если Не ПустаяСтрока(ОшибкаУстановки) Тогда
		МетодУстановки = МетодУстановки + "+verified_after_exception";
	КонецЕсли;
	Возврат Новый Структура("set,table,field,value,editor_field,verified,verified_key,verified_value,method,edit_start,column_activation,edit_finish,current_row,selection", Истина, ИмяТаблицы, ИмяПоля, Значение, ИмяРедактора, Проверено, Проверка.key, Проверка.value, МетодУстановки, РезультатНачалаРедактирования, РезультатАктивизацииКолонки, РезультатЗавершенияРедактирования, СоответствиеВСтруктуру(Таблица.ПолучитьТекущуюСтроку()), РезультатВыбораЧерезФорму);
КонецФункции

&НаКлиенте
Функция СтруктураИзJSONПараметраMCP(Параметры, ИмяПараметра)
	СтрокаJSON = СвойствоСтруктуры(Параметры, ИмяПараметра, "{}");
	Если ТипЗнч(СтрокаJSON) = Тип("Структура") Тогда
		Возврат СтрокаJSON;
	КонецЕсли;
	Возврат JSONВЗначение(СтрокаJSON);
КонецФункции

&НаКлиенте
Функция УстановитьЗначенияСтрокиТаблицыMCP(Параметры)
	Значения = СтруктураИзJSONПараметраMCP(Параметры, "values");
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "table", "ДополнительнаяИнформация");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Результаты = Новый Массив;
	Для Каждого КЗ Из Значения Цикл
		ПараметрыПоля = Новый Структура("table,field,value,search_by_title", ИмяТаблицы, Строка(КЗ.Ключ), Строка(КЗ.Значение), ИскатьПоЗаголовку);
		Результаты.Добавить(УстановитьПолеТаблицыMCP(ПараметрыПоля));
	КонецЦикла;
	Возврат Новый Структура("set,table,values,results", Истина, ИмяТаблицы, Значения, Результаты);
КонецФункции

&НаКлиенте
Функция УстановитьЗначенияПолейФормыMCP(Параметры)
	Значения = СтруктураИзJSONПараметраMCP(Параметры, "values");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Результаты = Новый Массив;
	Для Каждого КЗ Из Значения Цикл
		ПараметрыПоля = Новый Структура("field_name,value,search_by_title", Строка(КЗ.Ключ), Строка(КЗ.Значение), ИскатьПоЗаголовку);
		Результаты.Добавить(УстановитьЗначениеПоля(ПараметрыПоля));
	КонецЦикла;
	Возврат Новый Структура("set,values,results", Истина, Значения, Результаты);
КонецФункции

&НаКлиенте
Функция ВыбратьПолеТаблицыИзСпискаMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "table", "ДополнительнаяИнформация");
	ИмяПоля = СвойствоСтруктуры(Параметры, "field", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
	Если Таблица = Неопределено Тогда
		ВызватьИсключение "Таблица не найдена: " + ИмяТаблицы;
	КонецЕсли;
	Таблица.Активизировать();
	Попытка
		Если Не Таблица.ТекущийРежимРедактирование() Тогда
			Таблица.ИзменитьСтроку();
		КонецЕсли;
	Исключение
		Попытка
			Таблица.ИзменитьСтроку();
		Исключение
		КонецПопытки;
	КонецПопытки;
	Поле = НайтиПолеРедактораТаблицыMCP(АктивноеОкно, Таблица, ИмяТаблицы, ИмяПоля, ИскатьПоЗаголовку);
	Если Поле = Неопределено Тогда
		ВызватьИсключение "Поле таблицы не найдено: " + ИмяПоля;
	КонецЕсли;
	ОшибкиОткрытия = Новый Массив;
	РезультатРедактированияПередВыбором = ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица);
	Если Не РезультатРедактированияПередВыбором.editing Тогда
		ОшибкиОткрытия.Добавить("РежимРедактирования=" + РезультатРедактированияПередВыбором.error);
	КонецЕсли;
	Поле.Активизировать();
	Попытка
		Поле.Выбрать();
	Исключение
		ОшибкиОткрытия.Добавить("Поле.Выбрать=" + ОписаниеОшибки());
		РезультатПовторногоРедактирования = ОбеспечитьРедактированиеТекущейСтрокиТаблицыMCP(Таблица);
		Если Не РезультатПовторногоРедактирования.editing Тогда
			ОшибкиОткрытия.Добавить("ПовторныйРежимРедактирования=" + РезультатПовторногоРедактирования.error);
			ВызватьИсключение СтрСоединить(ОшибкиОткрытия, "; ");
		КонецЕсли;
		АктивизироватьКолонкуТаблицыMCP(Таблица, ИмяПоля, ИскатьПоЗаголовку);
		АктивноеОкноПовтора = ТестируемоеПриложение.ПолучитьАктивноеОкно();
		ПовторноеПоле = НайтиПолеРедактораТаблицыMCP(АктивноеОкноПовтора, Таблица, ИмяТаблицы, ИмяПоля, ИскатьПоЗаголовку);
		Если ПовторноеПоле <> Неопределено Тогда
			Поле = ПовторноеПоле;
			Поле.Активизировать();
		КонецЕсли;
		Попытка
			Поле.Выбрать();
		Исключение
			ОшибкиОткрытия.Добавить("ПовторноеПоле.Выбрать=" + ОписаниеОшибки());
			ВызватьИсключение СтрСоединить(ОшибкиОткрытия, "; ");
		КонецПопытки;
	КонецПопытки;
	Возврат Новый Структура("opened,table,field", Истина, ИмяТаблицы, ИмяПоля);
КонецФункции

&НаКлиенте
Функция ИнформацияРедактированияТаблицыMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "table", "ДополнительнаяИнформация");
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, "", 0);
	Если Таблица = Неопределено Тогда
		ВызватьИсключение "Таблица не найдена: " + ИмяТаблицы;
	КонецЕсли;
	Таблица.Активизировать();
	Попытка
		Если Не Таблица.ТекущийРежимРедактирование() Тогда
			Таблица.ИзменитьСтроку();
		КонецЕсли;
	Исключение
		Попытка
			Таблица.ИзменитьСтроку();
		Исключение
		КонецПопытки;
	КонецПопытки;
	Результат = Новый Структура;
	Результат.Вставить("table", ОбъектВСтруктуру(Таблица, 0));
	Попытка
		Текущий = Таблица.ПолучитьТекущийЭлемент();
		Результат.Вставить("current", ОбъектВСтруктуру(Текущий, 0));
	Исключение
		Результат.Вставить("current_error", ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции


&НаКлиенте
Функция УстановитьПорядокДинамическогоСпискаMCP(Параметры)
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "name", "Список");
	ЗаголовокТаблицы = СвойствоСтруктуры(Параметры, "title", "");
	ЗаголовокКолонки = СвойствоСтруктуры(Параметры, "column_title", "");
	Если ПустаяСтрока(ЗаголовокКолонки) Тогда
		ВызватьИсключение "Не задан column_title для УстановитьПорядок";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицы, 0);
	Если Таблица = Неопределено Тогда
		ВызватьИсключение "Динамический список/таблица не найдены: " + ИмяТаблицы;
	КонецЕсли;
	Попытка
		Таблица.УстановитьПорядок(ЗаголовокКолонки);
	Исключение
