#Область ОписаниеПеременных

&НаКлиенте
Перем СоединениеWebSocket;

&НаКлиенте
Перем ТестируемоеПриложение;

&НаКлиенте
Перем КлючСоединенияWebSocket;

&НаКлиенте
Перем АдресWebSocket;

&НаКлиенте
Перем ПроцессТестКлиента;

&НаКлиенте
Перем ФайлЛога;

&НаКлиенте
Перем WS_Обработчики;

#КонецОбласти

#Область Логирование
// BSLLS:DeprecatedCurrentDate-off

&НаКлиенте
Процедура Лог(Сообщение)
	Если ФайлЛога = Неопределено Тогда
		ИмяФайла = КаталогВременныхФайлов() + "mcp_manager.log";
		ФайлЛога = Новый Файл(ИмяФайла);
	КонецЕсли;
	Запись = Новый ЗаписьТекста(ФайлЛога.ПолноеИмя,,, Истина);
	Запись.ЗаписатьСтроку(Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + " | " + Сообщение);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КлючСоединенияWebSocket = "MCPTestManagerBridge";
	АдресWebSocket = "ws://localhost:8765/bridge";

	Лог("ПриОткрытии: ПараметрЗапуска=" + Строка(ПараметрЗапуска));
	Лог("ПриОткрытии: АдресWebSocket=" + АдресWebSocket);

	Попытка
		WS_Обработчики = Новый ОбработчикиWebSocketКлиентСоединения;
		WS_Обработчики.Модуль = ЭтаФорма;
		WS_Обработчики.ОбработчикОткрытияСоединения = "ПриОткрытииСоединения";
		WS_Обработчики.ОбработчикПолученияСообщения = "ПриПолученииСообщения";
		WS_Обработчики.ОбработчикОшибки = "ПриОшибкеСоединения";
		WS_Обработчики.ОбработчикЗакрытияСоединения = "ПриЗакрытииСоединения";

		Лог("ПриОткрытии: обработчики WS созданы, отложенный запуск через 1с");
		ПодключитьОбработчикОжидания("ОткрытьWebSocket", 1, Ложь);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ПриОткрытии: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
		Сообщить("MCP: ошибка при подготовке WebSocket: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьWebSocket() Экспорт
	Если WS_Обработчики = Неопределено Тогда
		Лог("ОткрытьWebSocket: обработчики не инициализированы - пропуск");
		Возврат;
	КонецЕсли;
	Попытка
		ПараметрыСоединения = Новый ПараметрыWebSocketКлиентСоединения;
		ПараметрыСоединения.Таймаут = 10;
		Лог("ОткрытьWebSocket: вызываю WebSocketКлиентСоединения.ОткрытьСоединение");
		СоединениеWebSocket = WebSocketКлиентСоединения.ОткрытьСоединение(КлючСоединенияWebSocket, АдресWebSocket, WS_Обработчики);
		Лог("ОткрытьWebSocket: ОткрытьСоединение вернул " + Строка(СоединениеWebSocket));
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ОткрытьWebSocket: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область JSON

&НаКлиенте
Функция ЗначениеВJSON(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаКлиенте
Функция JSONВЗначение(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON);
КонецФункции

#КонецОбласти

#Область WebSocket

&НаКлиенте
Процедура ПриОткрытииСоединения(Соединение) Экспорт
	Лог("ПриОткрытииСоединения: WS открыт, отправляю hello");
	Сообщить("MCP: WebSocket соединение открыто, отправляю hello");
	Ответ = Новый Структура;
	Ответ.Вставить("type", "hello");
	Ответ.Вставить("role", "bridge");
	Ответ.Вставить("version", "0.1.0");
	Ответ.Вставить("platform", "1c-enterprise");
	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
	Лог("ПриОткрытииСоединения: hello отправлен");
КонецПроцедуры

&НаКлиенте
Процедура ПриПолученииСообщения(Соединение, Сообщение) Экспорт
	Лог("ПриПолученииСообщения: " + Строка(Сообщение));
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Сообщение = ПолучитьСтрокуИзДвоичныхДанных(Сообщение, КодировкаТекста.UTF8);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("type", "response");

	Попытка
		Запрос = JSONВЗначение(Сообщение);
		Идентификатор = СвойствоСтруктуры(Запрос, "id", "");
		Метод = СвойствоСтруктуры(Запрос, "method", "");
		ПараметрыКоманды = СвойствоСтруктуры(Запрос, "params", Новый Структура);
		Ответ.Вставить("id", Идентификатор);

		Результат = ВыполнитьКоманду(Метод, ПараметрыКоманды);
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", Результат);
		Лог("ПриПолученииСообщения: метод=" + Метод + " выполнен");
	Исключение
		Инфо = ИнформацияОбОшибке();
		Если Не Ответ.Свойство("id") Тогда
			Ответ.Вставить("id", "");
		КонецЕсли;
		Ответ.Вставить("ok", Ложь);
		Ответ.Вставить("error", ПодробноеПредставлениеОшибки(Инфо));
		Лог("ПриПолученииСообщения: ИСКЛЮЧЕНИЕ " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;

	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеСоединения(Соединение, КодОшибки, Описание) Экспорт
	Лог("ПриОшибкеСоединения: код=" + Строка(КодОшибки) + " описание=" + Описание);
	Сообщить("MCP: ошибка WebSocket " + Строка(КодОшибки) + ": " + Описание);
	СоединениеWebSocket = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииСоединения(Соединение, КодЗакрытия) Экспорт
	Лог("ПриЗакрытииСоединения: код=" + Строка(КодЗакрытия));
	Сообщить("MCP: WebSocket закрыт, код=" + Строка(КодЗакрытия));
	СоединениеWebSocket = Неопределено;
КонецПроцедуры

#КонецОбласти

#Область КомандыMCP

&НаКлиенте
Функция ВыполнитьКоманду(Метод, Параметры)
	Если Метод = "ping" Тогда
		Лог("ВыполнитьКоманду: ping");
		Возврат Новый Структура("pong", Истина);
	ИначеЕсли Метод = "connect_test_client" Тогда
		Лог("ВыполнитьКоманду: connect_test_client");
		Возврат ПодключитьКлиентТестирования(Параметры);
	ИначеЕсли Метод = "disconnect_test_client" Тогда
		Лог("ВыполнитьКоманду: disconnect_test_client");
		Возврат ОтключитьКлиентТестирования();
	ИначеЕсли Метод = "active_window" Тогда
		Возврат АктивноеОкноКакСтруктуру();
	ИначеЕсли Метод = "maximize_test_client_window" Тогда
		Возврат РазвернутьОкноКлиентаТестирования();
	ИначеЕсли Метод = "ui_tree" Тогда
		Возврат ДеревоИнтерфейса(Параметры);
	ИначеЕсли Метод = "command_bar" Тогда
		Возврат КоманднаяПанель();
	ИначеЕсли Метод = "click_button" Тогда
		Возврат НажатьКнопку(Параметры);
	ИначеЕсли Метод = "find_object" Тогда
		Возврат НайтиОбъектИнтерфейса(Параметры);
	ИначеЕсли Метод = "get_object" Тогда
		Возврат ПолучитьОбъектПриложенияMCP(Параметры);
	ИначеЕсли Метод = "activate_object" Тогда
		Возврат АктивизироватьОбъектИнтерфейса(Параметры);
	ИначеЕсли Метод = "execute_window_command" Тогда
		Возврат ВыполнитьКомандуОкна(Параметры);
	ИначеЕсли Метод = "current_element" Тогда
		Возврат ТекущийЭлементФормы();
	ИначеЕсли Метод = "table_current_row" Тогда
		Возврат ТекущаяСтрокаТаблицы(Параметры);
	ИначеЕсли Метод = "table_selected_rows" Тогда
		Возврат ВыделенныеСтрокиТаблицы(Параметры);
	ИначеЕсли Метод = "tabular_documents" Тогда
		Возврат ТабличныеДокументы(Параметры);
	ИначеЕсли Метод = "tabular_document_text" Тогда
		Возврат ТекстТабличногоДокумента(Параметры);
	ИначеЕсли Метод = "set_field_value" Тогда
		Возврат УстановитьЗначениеПоля(Параметры);
	ИначеЕсли Метод = "activate_field" Тогда
		Возврат АктивизироватьПоле(Параметры);
	ИначеЕсли Метод = "toggle_field" Тогда
		Возврат ПереключитьПолеMCP(Параметры);
	ИначеЕсли Метод = "choose_field_from_list" Тогда
		Возврат ВыбратьПолеИзСпискаMCP(Параметры);
	ИначеЕсли Метод = "choose_field_first_row" Тогда
		Возврат ВыбратьПервуюСтрокуПоляMCP(Параметры);
	ИначеЕсли Метод = "choose_current_row" Тогда
		Возврат ВыбратьТекущуюСтрокуMCP(Параметры);
	ИначеЕсли Метод = "dynamic_list_set_order" Тогда
		Возврат УстановитьПорядокДинамическогоСпискаMCP(Параметры);
	ИначеЕсли Метод = "dynamic_list_output" Тогда
		Возврат ВывестиДинамическийСписокMCP(Параметры);
	ИначеЕсли Метод = "dynamic_list_open_settings" Тогда
		Возврат ОткрытьНастройкуДинамическогоСпискаMCP(Параметры);
	ИначеЕсли Метод = "dynamic_list_clear_settings" Тогда
		Возврат ОчиститьНастройкиДинамическогоСпискаMCP(Параметры);
	ИначеЕсли Метод = "dynamic_list_open_form_settings" Тогда
		Возврат ОткрытьНастройкуФормыMCP(Параметры);
	ИначеЕсли Метод = "table_rows" Тогда
		Возврат СтрокиТаблицы(Параметры);
	ИначеЕсли Метод = "table_find_row" Тогда
		Возврат НайтиСтрокуТаблицы(Параметры);
	ИначеЕсли Метод = "table_goto_row" Тогда
		Возврат ПерейтиКСтрокеТаблицыMCP(Параметры);
	ИначеЕсли Метод = "table_set_field" Тогда
		Возврат УстановитьПолеТаблицыMCP(Параметры);
	ИначеЕсли Метод = "table_edit_info" Тогда
		Возврат ИнформацияРедактированияТаблицыMCP(Параметры);
	ИначеЕсли Метод = "create_new_item" Тогда
		Возврат СоздатьНовыйЭлемент(Параметры);
	ИначеЕсли Метод = "save_form" Тогда
		Возврат СохранитьФорму();
	ИначеЕсли Метод = "close_form" Тогда
		Возврат ЗакрытьФорму();
	Иначе
		Лог("ВыполнитьКоманду: неизвестный метод " + Метод);
		ВызватьИсключение "Неизвестная команда MCP: " + Метод;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область ТестовыйКлиент

&НаКлиенте
Функция ПодключитьКлиентТестирования(Параметры)
	URLБазы = СвойствоСтруктуры(Параметры, "base_url", "<TARGET_INFOBASE_URL>");
	Пользователь = СвойствоСтруктуры(Параметры, "username", "");
	Пароль = СвойствоСтруктуры(Параметры, "password", "");
	Порт = СвойствоСтруктуры(Параметры, "port", 1538);
	ПутьПлатформы = СвойствоСтруктуры(Параметры, "onec_path", "1cv8c");
	АдресКлиентаТестирования = СвойствоСтруктуры(Параметры, "host", "localhost");

	Лог("ПодключитьКлиентТестирования: URL=" + URLБазы + " Порт=" + Строка(Порт));
	ОстановитьПроцессТестКлиента();

	ДопАргументы = СвойствоСтруктуры(Параметры, "extra_args", "");
	ПроцессТестКлиента = ЗапуститьКлиентТестирования(ПутьПлатформы, URLБазы, Пользователь, Пароль, Порт, ДопАргументы);
	Если ПроцессТестКлиента = Неопределено Тогда
		ВызватьИсключение "Не удалось запустить процесс тест-клиента " + ПутьПлатформы;
	КонецЕсли;

	ТестируемоеПриложение = Новый ТестируемоеПриложение(АдресКлиентаТестирования, Порт);
	ПодключитьсяКТестовомуКлиенту();

	Результат = Новый Структура;
	Результат.Вставить("connected", Истина);
	Результат.Вставить("base_url", URLБазы);
	Результат.Вставить("port", Порт);
	Результат.Вставить("client_pid", ПроцессТестКлиента.ИдентификаторПроцесса);
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ЗапуститьКлиентТестирования(ПутьПлатформы, URLБазы, Пользователь, Пароль, Порт, ДопАргументы = "")
	КаталогЛогов = КаталогЛоговТестКлиента();
	СоздатьКаталог(КаталогЛогов);
	ИмяЛога = "test_client_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".log";
	ПолноеИмяЛога = КаталогЛогов + ИмяЛога;

	КомандаЗапуска = СтрШаблон("""%1"" ENTERPRISE /WS ""%2"" /Lru /VLru_RU /N ""%3"" /P ""%4"" %6 /TESTCLIENT -TPort%5 > ""%7"" 2>&1 &",
		ПутьПлатформы, URLБазы, Пользователь, Пароль, Формат(Порт, "ЧГ="), ДопАргументы, ПолноеИмяЛога);
	Лог("ЗапуститьКлиентТестирования: " + КомандаЗапуска);
	Сообщить("MCP: запускаю тест-клиент: " + КомандаЗапуска);

	Попытка
		КомандаСистемы(КомандаЗапуска, КаталогЛогов);
		Лог("ЗапуститьКлиентТестирования: клиент запущен через КомандаСистемы в фоне");
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ЗапуститьКлиентТестирования: исключение " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;

	Возврат Новый Структура("ИдентификаторПроцесса", 0, "Команда", КомандаЗапуска, "Лог", ПолноеИмяЛога);
КонецФункции

&НаКлиенте
Функция КаталогЛоговТестКлиента()
	Возврат КаталогВременныхФайлов() + "mcp_test_client" + ПолучитьРазделительПути();
КонецФункции

// BSLLS:DeprecatedCurrentDate-off
&НаКлиенте
Процедура ПодключитьсяКТестовомуКлиенту()
	Лог("ПодключитьсяКТестовомуКлиенту: ждём 3с перед попыткой соединения");
	Пауза = ТекущаяДата() + 3;
	Пока ТекущаяДата() < Пауза Цикл
	КонецЦикла;
	Лог("ПодключитьсяКТестовомуКлиенту: начинаем попытки установки соединения");
	ВремяОкончанияОжидания = ТекущаяДата() + 120;
	ПоследняяОшибка = "";
	Пока Не ТекущаяДата() >= ВремяОкончанияОжидания Цикл
		Попытка
			ТестируемоеПриложение.УстановитьСоединение();
			Лог("ПодключитьсяКТестовомуКлиенту: соединение установлено");
			Возврат;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	Лог("ПодключитьсяКТестовомуКлиенту: тайм-аут, " + ПоследняяОшибка);
	ВызватьИсключение "Ошибка подключения к клиенту тестирования: " + ПоследняяОшибка;
КонецПроцедуры
// BSLLS:DeprecatedCurrentDate-on

&НаКлиенте
Функция ОтключитьКлиентТестирования()
	Если ТестируемоеПриложение <> Неопределено Тогда
		Попытка
			ТестируемоеПриложение.РазорватьСоединение();
		Исключение
			Лог("ОтключитьКлиентТестирования: ошибка разрыва " + ОписаниеОшибки());
		КонецПопытки;
		ТестируемоеПриложение = Неопределено;
	КонецЕсли;
	ОстановитьПроцессТестКлиента();
	Возврат Новый Структура("connected", Ложь);
КонецФункции

&НаКлиенте
Процедура ОстановитьПроцессТестКлиента()
	Попытка
		КомандаСистемы("pkill -9 -f ""1cv8c.*TESTCLIENT.*-TPort""", КаталогВременныхФайлов());
		Лог("ОстановитьПроцессТестКлиента: pkill выполнен");
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ОстановитьПроцессТестКлиента: ошибка pkill " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	ПроцессТестКлиента = Неопределено;
КонецПроцедуры

#КонецОбласти

#Область UI

&НаКлиенте
Функция АктивноеОкноКакСтруктуру()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Возврат ОбъектВСтруктуру(АктивноеОкно, 0, 0);
КонецФункции

&НаКлиенте
Функция РазвернутьОкноКлиентаТестирования()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Ошибки = Новый Массив;
	Попытка
		АктивноеОкно.Активизировать();
	Исключение
		Ошибки.Добавить("Активизировать: " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		АктивноеОкно.Развернуть();
