КонецФункции

&НаКлиенте
Функция ТекстЯчейкиТаблицыMCP(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ИмяТаблицы = СвойствоСтруктуры(Параметры, "name", "");
	ЗаголовокТаблицы = СвойствоСтруктуры(Параметры, "title", "");
	ИмяЯчейки = СвойствоСтруктуры(Параметры, "cell", "");
	Таблица = НайтиТаблицуПоПараметрам(АктивноеОкно, ИмяТаблицы, ЗаголовокТаблицы, 0);
	Если Таблица = Неопределено Тогда
		Возврат Новый Структура("found,name,title", Ложь, ИмяТаблицы, ЗаголовокТаблицы);
	КонецЕсли;
	РезультатЯчейки = Новый Структура;
	Если ПустаяСтрока(ИмяЯчейки) Тогда
		// Без параметра — текущая ячейка
		Попытка
			Текст = Таблица.ПолучитьТекстЯчейки();
			РезультатЯчейки.Вставить("cell_text", Текст);
			РезультатЯчейки.Вставить("cell_param", "");
		Исключение
			РезультатЯчейки.Вставить("error", ОписаниеОшибки());
		КонецПопытки;
	Иначе
		// По имени элемента/индексу
		Попытка
			Текст = Таблица.ПолучитьТекстЯчейки(ИмяЯчейки);
			РезультатЯчейки.Вставить("cell_text", Текст);
			РезультатЯчейки.Вставить("cell_param", ИмяЯчейки);
		Исключение
			ИнфоЯчейки = ИнформацияОбОшибке();
			РезультатЯчейки.Вставить("error", ПодробноеПредставлениеОшибки(ИнфоЯчейки));
		КонецПопытки;
	КонецЕсли;
	// Также вернём текущую строку (если доступна)
	Попытка
		ТекущаяСтрока = Таблица.ПолучитьТекущуюСтроку();
		РезультатЯчейки.Вставить("current_row", СоответствиеВСтруктуру(ТекущаяСтрока));
	Исключение
		РезультатЯчейки.Вставить("current_row_error", ОписаниеОшибки());
	КонецПопытки;
	Возврат Новый Структура("found,cell", Истина, РезультатЯчейки);
КонецФункции

&НаКлиенте
Функция НайтиТаблицуПоПараметрам(РодительскийОбъект, ИмяТаблицы, ЗаголовокТаблицы, ТекущаяГлубина)
	Попытка
		Подчиненные = БезопасныеПодчиненные(РодительскийОбъект);
		Для Каждого Подчиненный Из Подчиненные Цикл
			ИмяТек = БезопасноеСвойство(Подчиненный, "Имя", "");
			ЗаголовокТек = БезопасныйЗаголовок(Подчиненный);
			ТипТек = НормализованноеИмяТипа(Строка(ТипЗнч(Подчиненный)));
			Если ТипТек = "тестируемаятаблицаформы" Тогда
				Если (ПустаяСтрока(ИмяТаблицы) Или ИмяТек = ИмяТаблицы) И (ПустаяСтрока(ЗаголовокТаблицы) Или ЗаголовокТек = ЗаголовокТаблицы) Тогда
					Возврат Подчиненный;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Подчиненный Из Подчиненные Цикл
			Результат = НайтиТаблицуПоПараметрам(Подчиненный, ИмяТаблицы, ЗаголовокТаблицы, ТекущаяГлубина + 1);
			Если Результат <> Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("Подавленное исключение: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция СоответствиеВСтруктуру(Соответствие)
	// ВАЖНО: заголовки колонок могут содержать пробелы и другие символы,
	// недопустимые для ключей Структуры. Поэтому не делаем Результат.Вставить(КЗ.Ключ, ...),
	// а возвращаем JSON-safe представление: available + pairs[{key,value}].
	Результат = Новый Структура;
	Результат.Вставить("available", Ложь);
	Результат.Вставить("pairs", Новый Массив);
	Если Соответствие = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.available = Истина;
	Попытка
		Для Каждого КЗ Из Соответствие Цикл
			Результат.pairs.Добавить(Новый Структура("key,value", Строка(КЗ.Ключ), Строка(КЗ.Значение)));
		КонецЦикла;
	Исключение
		Результат.Вставить("error", ОписаниеОшибки());
		Лог("СоответствиеВСтруктуру: ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

