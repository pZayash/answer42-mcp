		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Результат = Форма.ОжидатьЗакрытие(Таймаут);
		Конец = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Прошло = (Конец - Начало) / 1000;

		Возврат Новый Структура("closed,elapsed_seconds", Истина, Прошло);
	Исключение
		Возврат Новый Структура("closed,reason,error", Ложь, "not_supported", ОписаниеОшибки());
