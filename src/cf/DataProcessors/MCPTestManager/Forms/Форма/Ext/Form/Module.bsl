&НаКлиенте
Процедура ОстановитьПроцессТестКлиента()
	Попытка
		Если ПортТестКлиента <> Неопределено Тогда
			Если ЭтоWindowsMCP() Тогда
				КомандаPkill = "powershell -NoProfile -ExecutionPolicy Bypass -Command ""Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*TESTCLIENT*' -and $_.CommandLine -like '*-TPort" + Формат(ПортТестКлиента, "ЧГ=") + "*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }""";
			Иначе
				КомандаPkill = "pkill -9 -f ""1cv8c.*TESTCLIENT.*-TPort" + Формат(ПортТестКлиента, "ЧГ=") + """";
			КонецЕсли;
			КомандаСистемы(КомандаPkill, КаталогВременныхФайлов());
			Лог("ОстановитьПроцессТестКлиента: команда остановки выполнена для порта " + Формат(ПортТестКлиента, "ЧГ="));
		Иначе
			Лог("ОстановитьПроцессТестКлиента: порт тест-клиента неизвестен, pkill пропущен");
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог("ОстановитьПроцессТестКлиента: ошибка pkill " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	ПроцессТестКлиента = Неопределено;
КонецПроцедуры

