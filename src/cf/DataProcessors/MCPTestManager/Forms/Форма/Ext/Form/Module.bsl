Функция НажатьКнопку(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяКнопки = СвойствоСтруктуры(Параметры, "name", "");
	ПоискПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	ЗаголовокПоиска = ?(ПоискПоЗаголовку, ИмяКнопки, "");
	Кнопка = НайтиКнопку(АктивноеОкно, ИмяКнопки, ЗаголовокПоиска, 0);
	Если Кнопка = Неопределено Тогда
		ВызватьИсключение "Кнопка не найдена: " + ИмяКнопки;
	КонецЕсли;
	ОшибкаАктивности = ПроверитьАктивностьСтраницыРодителя(Кнопка);
	Если ОшибкаАктивности <> Неопределено Тогда
		ВызватьИсключение ОшибкаАктивности;
	КонецЕсли;
	ЗаголовокДоНажатия = БезопасноеСвойство(АктивноеОкно, "Заголовок", "");
	ЗаголовокКнопки = БезопасныйЗаголовок(Кнопка);
	ФормаДоНажатия = НайтиРодительскуюФорму(Кнопка);
	ОжидатьЗакрытияФормы = СтрНайти(ИмяКнопки, "Закрыть") > 0 Или СтрНайти(ЗаголовокКнопки, "закрыть") > 0;
	Кнопка.Нажать();
	Результат = Новый Структура("pressed,name", Истина, ИмяКнопки);
	ДобавитьСостояниеОкнаПослеДействияMCP(Результат, ЗаголовокДоНажатия, ФормаДоНажатия, ОжидатьЗакрытияФормы);
	Возврат Результат;
КонецФункции

