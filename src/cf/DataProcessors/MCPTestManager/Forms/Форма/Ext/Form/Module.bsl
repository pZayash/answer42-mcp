&НаКлиенте
Процедура ПодключитьсяКТестовомуКлиенту(Пользователь = "", ИмяФайлаЛога = "")
	Лог("ПодключитьсяКТестовомуКлиенту: ждём 3с перед попыткой соединения");
	Пауза = ТекущаяДата() + 3;
	Пока ТекущаяДата() < Пауза Цикл
	КонецЦикла;
	Лог("ПодключитьсяКТестовомуКлиенту: начинаем попытки установки соединения");
	ВремяОкончанияОжидания = ТекущаяДата() + 150;
	ПоследняяОшибка = "";
	Пока Не ТекущаяДата() >= ВремяОкончанияОжидания Цикл
		Попытка
			ТестируемоеПриложение.УстановитьСоединение();
			Лог("ПодключитьсяКТестовомуКлиенту: соединение установлено");
			Возврат;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	ХвостЛога = ХвостФайлаТестаКлиента(ИмяФайлаЛога, 80);
	Подсказка = "";
	Если Не ПустаяСтрока(Пользователь) Тогда
		Подсказка = Символы.ПС + "Возможная причина: клиент тестирования не стартовал из-за ошибки аутентификации (проверьте логин/пароль пользователя " + Пользователь + ").";
	КонецЕсли;
	Лог("ПодключитьсяКТестовомуКлиенту: тайм-аут, " + ПоследняяОшибка + Подсказка + Символы.ПС + ХвостЛога);
	ВызватьИсключение "Ошибка подключения к клиенту тестирования: " + ПоследняяОшибка + Подсказка + Символы.ПС + "Лог тест-клиента: " + ИмяФайлаЛога + Символы.ПС + ХвостЛога;
КонецПроцедуры
