#Область ОписаниеПеременных

Перем СоединениеWebSocket;
Перем ТестируемоеПриложение;
Перем ПортТестовогоКлиента;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Запускает WebSocket-мост к MCP-серверу.
//
// Параметры:
//  URLСервера - Строка - URL WebSocket-сервера MCP.
//
Процедура Запустить(URLСервера = "") Экспорт
	Если ПустаяСтрока(URLСервера) Тогда
		URLСервера = ПараметрЗапуска;
	КонецЕсли;

	Если ПустаяСтрока(URLСервера) Тогда
		ВызватьИсключение "Не задан URL WebSocket-сервера. Передайте его через /C или параметр Запустить().";
	КонецЕсли;

	ПортТестовогоКлиента = 1538;
	ПодключитьсяКWebSocket(URLСервера);
КонецПроцедуры

// Обработчик открытия WebSocket-соединения.
//
// Параметры:
//  Соединение - WebSocketКлиентСоединение - Открытое соединение.
//
Процедура ПриОткрытииСоединения(Соединение) Экспорт
	Ответ = Новый Структура;
	Ответ.Вставить("type", "hello");
	Ответ.Вставить("role", "bridge");
	Ответ.Вставить("version", "0.1.0");
	Ответ.Вставить("platform", "1c-enterprise");
	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
КонецПроцедуры

// Обработчик получения команды от MCP-сервера.
//
// Параметры:
//  Соединение - WebSocketКлиентСоединение - Соединение.
//  Сообщение - Строка, ДвоичныеДанные - JSON-команда.
//
Процедура ПриПолученииСообщения(Соединение, Сообщение) Экспорт
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Сообщение = ДвоичныеДанныеВСтроку(Сообщение);
	КонецЕсли;

	Запрос = JSONВЗначение(Сообщение);
	Идентификатор = СвойствоСтруктуры(Запрос, "id", "");
	Метод = СвойствоСтруктуры(Запрос, "method", "");
	Параметры = СвойствоСтруктуры(Запрос, "params", Новый Структура);

	Ответ = Новый Структура;
	Ответ.Вставить("type", "response");
	Ответ.Вставить("id", Идентификатор);

	Попытка
		Результат = ВыполнитьКоманду(Метод, Параметры);
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", Результат);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Ответ.Вставить("ok", Ложь);
		Ответ.Вставить("error", ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;

	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
КонецПроцедуры

// Обработчик ошибки WebSocket.
//
// Параметры:
//  Соединение - WebSocketКлиентСоединение - Соединение.
//  КодОшибки - Строка - Код ошибки.
//  Описание - Строка - Описание ошибки.
//
Процедура ПриОшибкеСоединения(Соединение, КодОшибки, Описание) Экспорт
	ЗаписьЖурналаРегистрации("MCPTestManager.WebSocket", УровеньЖурналаРегистрации.Ошибка, , , КодОшибки + ": " + Описание);
КонецПроцедуры

// Обработчик закрытия WebSocket.
//
// Параметры:
//  Соединение - WebSocketКлиентСоединение - Соединение.
//  КодЗакрытия - Число - Код закрытия.
//
Процедура ПриЗакрытииСоединения(Соединение, КодЗакрытия) Экспорт
	СоединениеWebSocket = Неопределено;
	ЗаписьЖурналаРегистрации("MCPTestManager.WebSocket", УровеньЖурналаРегистрации.Информация, , , "Соединение закрыто: " + Строка(КодЗакрытия));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодключитьсяКWebSocket(URLСервера)
	Обработчики = Новый ОбработчикиWebSocketКлиентСоединения;
	Обработчики.Модуль = ЭтотОбъект;
	Обработчики.ОбработчикОткрытияСоединения = "ПриОткрытииСоединения";
	Обработчики.ОбработчикПолученияСообщения = "ПриПолученииСообщения";
	Обработчики.ОбработчикОшибки = "ПриОшибкеСоединения";
	Обработчики.ОбработчикЗакрытияСоединения = "ПриЗакрытииСоединения";

	ПараметрыСоединения = Новый ПараметрыWebSocketКлиентСоединения;
	ПараметрыСоединения.Таймаут = 30;

	СоединениеWebSocket = WebSocketКлиентСоединения.ОткрытьСоединение(URLСервера, Обработчики, ПараметрыСоединения);
КонецПроцедуры

Функция ВыполнитьКоманду(Метод, Параметры)
	Если Метод = "connect_test_client" Тогда
		Возврат ПодключитьКлиентТестирования(Параметры);
	ИначеЕсли Метод = "disconnect_test_client" Тогда
		Возврат ОтключитьКлиентТестирования();
	ИначеЕсли Метод = "active_window" Тогда
		Возврат АктивноеОкноКакСтруктура();
	ИначеЕсли Метод = "ui_tree" Тогда
		Возврат ДеревоИнтерфейса(Параметры);
	ИначеЕсли Метод = "command_bar" Тогда
		Возврат КоманднаяПанель();
	ИначеЕсли Метод = "click_button" Тогда
		Возврат НажатьКнопку(Параметры);
	Иначе
		ВызватьИсключение "Неизвестная команда MCP: " + Метод;
	КонецЕсли;
КонецФункции

Функция ПодключитьКлиентТестирования(Параметры)
	URLБазы = СвойствоСтруктуры(Параметры, "base_url", "<TARGET_INFOBASE_URL>");
	Пользователь = СвойствоСтруктуры(Параметры, "username", "");
	Пароль = СвойствоСтруктуры(Параметры, "password", "");
	ПортТестовогоКлиента = СвойствоСтруктуры(Параметры, "port", 1538);
	ПутьПлатформы = СвойствоСтруктуры(Параметры, "onec_path", "1cv8");

	Если ТестируемоеПриложение <> Неопределено Тогда
		Попытка
			ТестируемоеПриложение.РазорватьСоединение();
		Исключение
			Инфо = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("MCPTestManager.TestClient", УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(Инфо));
		КонецПопытки;
	КонецЕсли;

	КомандаЗапуска = СтрШаблон("""%1"" ENTERPRISE /WS "%2" /N "%3" /P "%4" /TESTCLIENT -TPort%5", ПутьПлатформы, URLБазы, Пользователь, Пароль, ПортТестовогоКлиента);
	ЗапуститьПриложение(КомандаЗапуска);

	ТестируемоеПриложение = Новый ТестируемоеПриложение(ПортТестовогоКлиента);
	ТестируемоеПриложение.УстановитьСоединение();

	Результат = Новый Структура;
	Результат.Вставить("connected", Истина);
	Результат.Вставить("base_url", URLБазы);
	Результат.Вставить("port", ПортТестовогоКлиента);
	Возврат Результат;
КонецФункции

Функция ОтключитьКлиентТестирования()
	Если ТестируемоеПриложение <> Неопределено Тогда
		ТестируемоеПриложение.РазорватьСоединение();
		ТестируемоеПриложение = Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("connected", Ложь);
	Возврат Результат;
КонецФункции

Функция АктивноеОкноКакСтруктура()
	ПроверитьПодключениеКлиента();
	Окно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Возврат ОбъектИнтерфейсаКакСтруктура(Окно, 0, 0);
КонецФункции

Функция ДеревоИнтерфейса(Параметры)
	ПроверитьПодключениеКлиента();
	МаксимальнаяГлубина = СвойствоСтруктуры(Параметры, "max_depth", 4);
	Окно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Возврат ОбъектИнтерфейсаКакСтруктура(Окно, 0, МаксимальнаяГлубина);
КонецФункции

Функция КоманднаяПанель()
	ПроверитьПодключениеКлиента();
	Окно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	КомандныйИнтерфейс = БезопасноВызвать(Окно, "ПолучитьКомандныйИнтерфейс");
	Если КомандныйИнтерфейс <> Неопределено Тогда
		Возврат ОбъектИнтерфейсаКакСтруктура(КомандныйИнтерфейс, 0, 3);
	КонецЕсли;

	Возврат Новый Структура("available", Ложь);
КонецФункции

Функция НажатьКнопку(Параметры)
	ПроверитьПодключениеКлиента();
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Если ПустаяСтрока(Имя) Тогда
		ВызватьИсключение "Не задано имя или заголовок кнопки.";
	КонецЕсли;

	Окно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Кнопка = НайтиКнопку(Окно, Имя, ИскатьПоЗаголовку);
	Если Кнопка = Неопределено Тогда
		ВызватьИсключение "Кнопка не найдена: " + Имя;
	КонецЕсли;

	Кнопка.Нажать();
	Возврат Новый Структура("clicked", Истина, "name", Имя);
КонецФункции

Функция НайтиКнопку(Объект, Имя, ИскатьПоЗаголовку)
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Объект) = Тип("ТестируемаяКнопкаФормы") Тогда
		Если ИскатьПоЗаголовку Тогда
			Если НРег(Объект.ТекстЗаголовка) = НРег(Имя) Тогда
				Возврат Объект;
			КонецЕсли;
		ИначеЕсли НРег(Объект.Имя) = НРег(Имя) Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	Подчиненные = БезопасноПолучитьПодчиненные(Объект);
	Для Каждого Подчиненный Из Подчиненные Цикл
		НайденнаяКнопка = НайтиКнопку(Подчиненный, Имя, ИскатьПоЗаголовку);
		Если НайденнаяКнопка <> Неопределено Тогда
			Возврат НайденнаяКнопка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Функция ОбъектИнтерфейсаКакСтруктура(Объект, Глубина, МаксимальнаяГлубина)
	Результат = Новый Структура;
	Результат.Вставить("type", Строка(ТипЗнч(Объект)));
	ДобавитьСвойствоЕслиЕсть(Результат, Объект, "Имя", "name");
	ДобавитьСвойствоЕслиЕсть(Результат, Объект, "ТекстЗаголовка", "title");
	ДобавитьСвойствоЕслиЕсть(Результат, Объект, "Заголовок", "caption");
	ДобавитьСвойствоЕслиЕсть(Результат, Объект, "ИмяФормы", "form_name");
	ДобавитьСвойствоЕслиЕсть(Результат, Объект, "НавигационнаяСсылка", "navigation_url");
	ДобавитьСвойствоЕслиЕсть(Результат, Объект, "Основное", "main");
	ДобавитьСвойствоЕслиЕсть(Результат, Объект, "НачальнаяСтраница", "home");

	Если МаксимальнаяГлубина > 0 И Глубина < МаксимальнаяГлубина Тогда
		Дочерние = Новый Массив;
		Для Каждого Подчиненный Из БезопасноПолучитьПодчиненные(Объект) Цикл
			Дочерние.Добавить(ОбъектИнтерфейсаКакСтруктура(Подчиненный, Глубина + 1, МаксимальнаяГлубина));
		КонецЦикла;
		Результат.Вставить("children", Дочерние);
	КонецЕсли;

	Возврат Результат;
КонецФункции

Процедура ДобавитьСвойствоЕслиЕсть(Результат, Объект, ИмяСвойства, ИмяJSON)
	Попытка
		Результат.Вставить(ИмяJSON, Объект[ИмяСвойства]);
	Исключение
		Инфо = ИнформацияОбОшибке();
		// Свойство отсутствует у данного типа тестируемого объекта.
	КонецПопытки;
КонецПроцедуры

Функция БезопасноПолучитьПодчиненные(Объект)
	Попытка
		Возврат Объект.ПолучитьПодчиненныеОбъекты();
	Исключение
		Инфо = ИнформацияОбОшибке();
		Возврат Новый Массив;
	КонецПопытки;
КонецФункции

Функция БезопасноВызвать(Объект, ИмяМетода)
	Попытка
		Если ИмяМетода = "ПолучитьКомандныйИнтерфейс" Тогда
			Возврат Объект.ПолучитьКомандныйИнтерфейс();
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Процедура ПроверитьПодключениеКлиента()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
КонецПроцедуры

Функция СвойствоСтруктуры(СтруктураЗначений, ИмяСвойства, ЗначениеПоУмолчанию)
	Если СтруктураЗначений = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	ЗначениеСвойства = Неопределено;
	Если СтруктураЗначений.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ЗначениеВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция JSONВЗначение(ТекстJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ДвоичныеДанныеВСтроку(Данные)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
КонецФункции

#КонецОбласти
