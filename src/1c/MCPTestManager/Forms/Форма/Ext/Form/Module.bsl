#Область ОписаниеПеременных

&НаКлиенте
Перем СоединениеWebSocket;

&НаКлиенте
Перем ТестируемоеПриложение;

&НаКлиенте
Перем КлючСоединенияWebSocket;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КлючСоединенияWebSocket = "MCPTestManagerBridge";
	
	Если ПустаяСтрока(ПараметрЗапуска) Тогда
		Сообщить("MCP: ПараметрЗапуска пуст, WebSocket не открываем");
		Возврат;
	КонецЕсли;
	
	Сообщить("MCP: открываю WebSocket " + ПараметрЗапуска);
	
	Попытка
		Обработчики = Новый ОбработчикиWebSocketКлиентСоединения;
		Обработчики.Модуль = ЭтаФорма;
		Обработчики.ОбработчикОткрытияСоединения = "ПриОткрытииСоединения";
		Обработчики.ОбработчикПолученияСообщения = "ПриПолученииСообщения";
		Обработчики.ОбработчикОшибки = "ПриОшибкеСоединения";
		Обработчики.ОбработчикЗакрытияСоединения = "ПриЗакрытииСоединения";
		
		ПараметрыСоединения = Новый ПараметрыWebSocketКлиентСоединения;
		ПараметрыСоединения.Таймаут = 10;
		
		СоединениеWebSocket = WebSocketКлиентСоединения.ОткрытьСоединение(КлючСоединенияWebSocket, ПараметрЗапуска, Обработчики);
		Сообщить("MCP: ОткрытьСоединение вызван, результат=" + Строка(СоединениеWebSocket));
	Исключение
		Инфо = ИнформацияОбОшибке();
		Сообщить("MCP: ошибка открытия WebSocket: " + ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область WebSocket

&НаКлиенте
Процедура ПриОткрытииСоединения(Соединение) Экспорт
	Сообщить("MCP: WebSocket соединение открыто, отправляю hello");
	Ответ = Новый Структура;
	Ответ.Вставить("type", "hello");
	Ответ.Вставить("role", "bridge");
	Ответ.Вставить("version", "0.1.0");
	Ответ.Вставить("platform", "1c-enterprise");
	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
КонецПроцедуры

&НаКлиенте
Процедура ПриПолученииСообщения(Соединение, Сообщение) Экспорт
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Сообщение = ПолучитьСтрокуИзДвоичныхДанных(Сообщение, КодировкаТекста.UTF8);
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("type", "response");
	
	Попытка
		Запрос = JSONВЗначение(Сообщение);
		Идентификатор = СвойствоСтруктуры(Запрос, "id", "");
		Метод = СвойствоСтруктуры(Запрос, "method", "");
		ПараметрыКоманды = СвойствоСтруктуры(Запрос, "params", Новый Структура);
		Ответ.Вставить("id", Идентификатор);
		
		Результат = ВыполнитьКоманду(Метод, ПараметрыКоманды);
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("result", Результат);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Если Не Ответ.Свойство("id") Тогда
			Ответ.Вставить("id", "");
		КонецЕсли;
		Ответ.Вставить("ok", Ложь);
		Ответ.Вставить("error", ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
	
	Соединение.ОтправитьСообщение(ЗначениеВJSON(Ответ));
КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеСоединения(Соединение, КодОшибки, Описание) Экспорт
	Сообщить("MCP: ошибка WebSocket " + Строка(КодОшибки) + ": " + Описание);
	СоединениеWebSocket = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииСоединения(Соединение, КодЗакрытия) Экспорт
	Сообщить("MCP: WebSocket закрыт, код=" + Строка(КодЗакрытия));
	СоединениеWebSocket = Неопределено;
КонецПроцедуры

#КонецОбласти

#Область КомандыMCP

&НаКлиенте
Функция ВыполнитьКоманду(Метод, Параметры)
	Если Метод = "ping" Тогда
		Возврат Новый Структура("pong", Истина);
	ИначеЕсли Метод = "connect_test_client" Тогда
		Возврат ПодключитьКлиентТестирования(Параметры);
	ИначеЕсли Метод = "disconnect_test_client" Тогда
		Возврат ОтключитьКлиентТестирования();
	ИначеЕсли Метод = "active_window" Тогда
		Возврат АктивноеОкноКакСтруктура();
	ИначеЕсли Метод = "ui_tree" Тогда
		Возврат ДеревоИнтерфейса(Параметры);
	ИначеЕсли Метод = "command_bar" Тогда
		Возврат КоманднаяПанель();
	ИначеЕсли Метод = "click_button" Тогда
		Возврат НажатьКнопку(Параметры);
	ИначеЕсли Метод = "find_object" Тогда
		Возврат НайтиОбъектИнтерфейса(Параметры);
	ИначеЕсли Метод = "activate_object" Тогда
		Возврат АктивизироватьОбъектИнтерфейса(Параметры);
	ИначеЕсли Метод = "execute_window_command" Тогда
		Возврат ВыполнитьКомандуОкна(Параметры);
	ИначеЕсли Метод = "current_element" Тогда
		Возврат ТекущийЭлементФормы();
	ИначеЕсли Метод = "table_current_row" Тогда
		Возврат ТекущаяСтрокаТаблицы(Параметры);
	ИначеЕсли Метод = "table_selected_rows" Тогда
		Возврат ВыделенныеСтрокиТаблицы(Параметры);
	ИначеЕсли Метод = "tabular_documents" Тогда
		Возврат ТабличныеДокументы(Параметры);
	ИначеЕсли Метод = "tabular_document_text" Тогда
		Возврат ТекстТабличногоДокумента(Параметры);
	Иначе
		ВызватьИсключение "Неизвестная команда MCP: " + Метод;
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ПодключитьКлиентТестирования(Параметры)
	URLБазы = СвойствоСтруктуры(Параметры, "base_url", "<TARGET_INFOBASE_URL>");
	Пользователь = СвойствоСтруктуры(Параметры, "username", "");
	Пароль = СвойствоСтруктуры(Параметры, "password", "");
	Порт = СвойствоСтруктуры(Параметры, "port", 1538);
	ПутьПлатформы = СвойствоСтруктуры(Параметры, "onec_path", "1cv8c");
	АдресКлиентаТестирования = СвойствоСтруктуры(Параметры, "host", "localhost");
	
	Если ТестируемоеПриложение <> Неопределено Тогда
		Попытка
			ТестируемоеПриложение.РазорватьСоединение();
		Исключение
			Сообщить("MCP: ошибка разрыва предыдущего соединения: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	КомандаЗапуска = СтрШаблон("""%1"" ENTERPRISE /WS ""%2"" /N ""%3"" /P ""%4"" /TESTCLIENT -TPort%5", ПутьПлатформы, URLБазы, Пользователь, Пароль, Формат(Порт, "ЧГ="));
	Сообщить("MCP: запускаю тест-клиент: " + КомандаЗапуска);
	ЗапуститьПриложение(КомандаЗапуска);
	
	ТестируемоеПриложение = Новый ТестируемоеПриложение(АдресКлиентаТестирования, Порт);
	ПодключитьсяКТестовомуКлиенту();
	
	Результат = Новый Структура;
	Результат.Вставить("connected", Истина);
	Результат.Вставить("base_url", URLБазы);
	Результат.Вставить("port", Порт);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПодключитьсяКТестовомуКлиенту()
	ВремяОкончанияОжидания = ТекущаяДатаСеанса() + 60;
	ПоследняяОшибка = "";
	Пока Не ТекущаяДатаСеанса() >= ВремяОкончанияОжидания Цикл
		Попытка
			ТестируемоеПриложение.УстановитьСоединение();
			Возврат;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение "Ошибка подключения к клиенту тестирования: " + ПоследняяОшибка;
КонецПроцедуры

&НаКлиенте
Функция ОтключитьКлиентТестирования()
	Если ТестируемоеПриложение <> Неопределено Тогда
		ТестируемоеПриложение.РазорватьСоединение();
		ТестируемоеПриложение = Неопределено;
	КонецЕсли;
	Возврат Новый Структура("connected", Ложь);
КонецФункции

&НаКлиенте
Функция АктивноеОкноКакСтруктура()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Возврат ОбъектВСтруктуру(АктивноеОкно, 0, 0);
КонецФункции

&НаКлиенте
Функция ДеревоИнтерфейса(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Глубина = СвойствоСтруктуры(Параметры, "max_depth", 4);
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Возврат ОбъектВСтруктуру(АктивноеОкно, 0, Глубина);
КонецФункции

&НаКлиенте
Функция КоманднаяПанель()
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Попытка
		КИ = АктивноеОкно.ПолучитьКомандныйИнтерфейс();
		Возврат ОбъектВСтруктуру(КИ, 0, 3);
	Исключение
		Возврат Новый Структура("available", Ложь);
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция НажатьКнопку(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	Имя = СвойствоСтруктуры(Параметры, "name", "");
	ИскатьПоЗаголовку = СвойствоСтруктуры(Параметры, "search_by_title", Ложь);
	Если ПустаяСтрока(Имя) Тогда
		ВызватьИсключение "Не задано имя или заголовок кнопки.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	Кнопка = НайтиКнопку(АктивноеОкно, Имя, ИскатьПоЗаголовку);
	Если Кнопка = Неопределено Тогда
		ВызватьИсключение "Кнопка не найдена: " + Имя;
	КонецЕсли;
	Кнопка.Нажать();
	Возврат Новый Структура("clicked", Истина, "name", Имя);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


&НаКлиенте
Функция НайтиОбъектИнтерфейса(Параметры)
	НайденныйОбъект = НайтиОбъектПоПараметрам(Параметры);
	Если НайденныйОбъект = Неопределено Тогда
		ВызватьИсключение "Объект не найден.";
	КонецЕсли;
	Возврат ОбъектВСтруктуру(НайденныйОбъект, 0, СвойствоСтруктуры(Параметры, "max_depth", 0));
КонецФункции

&НаКлиенте
Функция АктивизироватьОбъектИнтерфейса(Параметры)
	НайденныйОбъект = НайтиОбъектПоПараметрам(Параметры);
	Если НайденныйОбъект = Неопределено Тогда
		ВызватьИсключение "Объект не найден.";
	КонецЕсли;
	НайденныйОбъект.Активизировать();
	Возврат Новый Структура("activated", Истина);
КонецФункции

&НаКлиенте
Функция ВыполнитьКомандуОкна(Параметры)
	Если ТестируемоеПриложение = Неопределено Тогда
		ВызватьИсключение "Тестируемое приложение не подключено.";
	КонецЕсли;
	ИмяКоманды = СвойствоСтруктуры(Параметры, "command", "");
	Если ПустаяСтрока(ИмяКоманды) Тогда
		ВызватьИсключение "Не задано имя команды.";
	КонецЕсли;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	АктивноеОкно.ВыполнитьКоманду(ИмяКоманды);
	Возврат Новый Структура("executed", Истина, "command", ИмяКоманды);
КонецФункции

&НаКлиенте
Функция ТекущийЭлементФормы()
	Форма = ПерваяФормаАктивногоОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Активная форма не найдена.";
	КонецЕсли;
	Элемент = Форма.ПолучитьТекущийЭлемент();
	Возврат ОбъектВСтруктуру(Элемент, 0, 1);
КонецФункции

&НаКлиенте
Функция ТекущаяСтрокаТаблицы(Параметры)
	Таблица = НайтиТаблицуПоПараметрам(Параметры);
	Если Таблица = Неопределено Тогда
		ВызватьИсключение "Таблица не найдена.";
	КонецЕсли;
	СтрокаТаблицы = Таблица.ПолучитьТекущуюСтроку();
	Возврат СоответствиеВСтруктуру(СтрокаТаблицы);
КонецФункции

&НаКлиенте
Функция ВыделенныеСтрокиТаблицы(Параметры)
	Таблица = НайтиТаблицуПоПараметрам(Параметры);
	Если Таблица = Неопределено Тогда
		ВызватьИсключение "Таблица не найдена.";
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица.ПолучитьВыделенныеСтроки() Цикл
		Результат.Добавить(СоответствиеВСтруктуру(СтрокаТаблицы));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ТабличныеДокументы(Параметры)
	МаксГлубина = СвойствоСтруктуры(Параметры, "max_depth", 8);
	ВключатьТекст = СвойствоСтруктуры(Параметры, "include_text", Ложь);
	Результат = Новый Массив;
	АктивноеОкно = ТестируемоеПриложение.ПолучитьАктивноеОкно();
	НайтиТабличныеДокументы(АктивноеОкно, Результат, 0, МаксГлубина, ВключатьТекст);
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ТекстТабличногоДокумента(Параметры)
	Документ = НайтиТабличныйДокументПоПараметрам(Параметры);
	Если Документ = Неопределено Тогда
		ВызватьИсключение "Табличный документ не найден.";
	КонецЕсли;
	Возврат ТабличныйДокументВСтруктуру(Документ, Истина);
КонецФункции

&НаКлиенте
Функция НайтиКнопку(ЭлементИнтерфейса, Имя, ИскатьПоЗаголовку)
	Если ЭлементИнтерфейса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ЭлементИнтерфейса) = Тип("ТестируемаяКнопкаФормы") Тогда
		Если ИскатьПоЗаголовку И НРег(ЭлементИнтерфейса.ТекстЗаголовка) = НРег(Имя) Тогда
			Возврат ЭлементИнтерфейса;
		ИначеЕсли НЕ ИскатьПоЗаголовку И НРег(ЭлементИнтерфейса.Имя) = НРег(Имя) Тогда
			Возврат ЭлементИнтерфейса;
		КонецЕсли;
	КонецЕсли;
	Для Каждого П Из БезопасныеПодчиненные(ЭлементИнтерфейса) Цикл
		Р = НайтиКнопку(П, Имя, ИскатьПоЗаголовку);
		Если Р <> Неопределено Тогда
			Возврат Р;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ОбъектВСтруктуру(ЭлементИнтерфейса, Глубина, МаксГлубина)
	Р = Новый Структура;
	Р.Вставить("type", Строка(ТипЗнч(ЭлементИнтерфейса)));
	БезопасноВставить(Р, ЭлементИнтерфейса, "Имя", "name");
	БезопасноВставить(Р, ЭлементИнтерфейса, "ТекстЗаголовка", "title");
	БезопасноВставить(Р, ЭлементИнтерфейса, "Заголовок", "caption");
	БезопасноВставить(Р, ЭлементИнтерфейса, "ИмяФормы", "form_name");
	БезопасноВставить(Р, ЭлементИнтерфейса, "НавигационнаяСсылка", "navigation_url");
	БезопасноВставить(Р, ЭлементИнтерфейса, "Основное", "main");
	БезопасноВставить(Р, ЭлементИнтерфейса, "НачальнаяСтраница", "home");
	Если МаксГлубина > 0 И Глубина < МаксГлубина Тогда
		Дети = Новый Массив;
		Для Каждого П Из БезопасныеПодчиненные(ЭлементИнтерфейса) Цикл
			Дети.Добавить(ОбъектВСтруктуру(П, Глубина + 1, МаксГлубина));
		КонецЦикла;
		Р.Вставить("children", Дети);
	КонецЕсли;
	Возврат Р;
КонецФункции

&НаКлиенте
Процедура БезопасноВставить(Р, ЭлементИнтерфейса, ИмяСв, ИмяJSON)
	Попытка
		Р.Вставить(ИмяJSON, ЭлементИнтерфейса[ИмяСв]);
	Исключение
		Р.Вставить(ИмяJSON, "");
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция БезопасныеПодчиненные(ЭлементИнтерфейса)
	Попытка
		Возврат ЭлементИнтерфейса.ПолучитьПодчиненныеОбъекты();
	Исключение
