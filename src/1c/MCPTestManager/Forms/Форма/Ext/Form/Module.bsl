		НайтиТабличныеДокументы(Подчиненный, Результат, Глубина + 1, МаксГлубина, ВключатьТекст);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ЭтоТабличныйДокумент(ЭлементИнтерфейса)
	Если ЭлементИнтерфейса = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		ЭлементИнтерфейса.ПолучитьРазмерОбластиДанныхДокументаПоВертикали();
		ЭлементИнтерфейса.ПолучитьРазмерОбластиДанныхДокументаПоГоризонтали();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ТабличныйДокументВСтруктуру(Документ, ВключатьТекст)
	Результат = ОбъектВСтруктуру(Документ, 0, 0);
	Высота = Документ.ПолучитьРазмерОбластиДанныхДокументаПоВертикали();
	Ширина = Документ.ПолучитьРазмерОбластиДанныхДокументаПоГоризонтали();
	Результат.Вставить("rows", Высота);
	Результат.Вставить("columns", Ширина);
	Результат.Вставить("current_area", БезопасныйАдресТекущейОбласти(Документ));
	Если ВключатьТекст Тогда
		Результат.Вставить("text", ТекстОбластиТабличногоДокумента(Документ, Высота, Ширина));
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция БезопасныйАдресТекущейОбласти(Документ)
	Попытка
		Возврат Документ.ПолучитьАдресТекущейОбласти();
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ТекстОбластиТабличногоДокумента(Документ, Высота, Ширина)
	Если Высота = 0 Или Ширина = 0 Тогда
		Возврат "";
	КонецЕсли;
	Область = "R1C1:R" + Формат(Высота, "ЧГ=") + "C" + Формат(Ширина, "ЧГ=");
	Попытка
		Возврат Документ.ПолучитьТекстОбласти(Область);
	Исключение
		Попытка
			Возврат Документ.ПолучитьТекстТекущейОбласти();
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

#КонецОбласти