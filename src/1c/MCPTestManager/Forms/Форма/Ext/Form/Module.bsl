&НаКлиенте
Функция НайтиОбъектРекурсивно(ЭлементИнтерфейса, Имя, Заголовок, ИмяТипа, Глубина, МаксГлубина)
	Если ЭлементИнтерфейса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ОбъектСоответствует(ЭлементИнтерфейса, Имя, Заголовок, ИмяТипа) Тогда
		Возврат ЭлементИнтерфейса;
	КонецЕсли;
	Если Глубина >= МаксГлубина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Подчиненный Из БезопасныеПодчиненные(ЭлементИнтерфейса) Цикл
		Найденный = НайтиОбъектРекурсивно(Подчиненный, Имя, Заголовок, ИмяТипа, Глубина + 1, МаксГлубина);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ОбъектСоответствует(ЭлементИнтерфейса, Имя, Заголовок, ИмяТипа)
	Если НЕ ПустаяСтрока(ИмяТипа) И НормализованноеИмяТипа(Строка(ТипЗнч(ЭлементИнтерфейса))) <> НормализованноеИмяТипа(ИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Имя) И НРег(БезопасноеСвойство(ЭлементИнтерфейса, "Имя")) <> НРег(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Заголовок) Тогда
		ТекстЗаголовка = БезопасноеСвойство(ЭлементИнтерфейса, "ТекстЗаголовка");
		Если ПустаяСтрока(ТекстЗаголовка) Тогда
			ТекстЗаголовка = БезопасноеСвойство(ЭлементИнтерфейса, "Заголовок");
		КонецЕсли;
		Если НРег(ТекстЗаголовка) <> НРег(Заголовок) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат НЕ (ПустаяСтрока(Имя) И ПустаяСтрока(Заголовок) И ПустаяСтрока(ИмяТипа));
КонецФункции


&НаКлиенте
Функция НормализованноеИмяТипа(ИмяТипа)
	Результат = НРег(СтрЗаменить(ИмяТипа, " ", ""));
	Результат = СтрЗаменить(Результат, "ё", "е");
	Возврат Результат;
КонецФункции

